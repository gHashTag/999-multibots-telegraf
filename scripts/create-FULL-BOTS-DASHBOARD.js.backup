  get total_income() {
    return this.refills_stars_rub + this.payments_rub;
  },
  get total_outcome() {
    // Рефанды + РАСХОДЫ НА AI (которых нет в данных платежей!)
    // В реальности должны быть траты на Replicate, FAL, OpenAI и др.
    return this.refunds_rub + 35000.00; // Примерная оценка расходов на AI
  },
  get net_balance() {
    return this.total_income - this.total_outcome;
  }
};

