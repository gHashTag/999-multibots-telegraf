server {
    listen ${PORT};
    server_name _;

    # WHY THIS SERVICE EXISTS
    # @supabase/supabase-js builds its REST base as `new URL('rest/v1', baseUrl)`
    # (SupabaseClient.js:78) — the prefix is unconditional, no SUPABASE_URL value
    # removes it. PostgREST serves tables at the ROOT. Without a rewrite the app
    # would ask for /rest/v1/users and PostgREST would look for a table called
    # "rest". This strips the prefix so all 351 existing call sites keep working
    # untouched.

    client_max_body_size 32m;

    # Health, answered here so it does not depend on PostgREST being up.
    #
    # BOTH paths, deliberately. Railway resolves railwayConfigFile against the
    # REPO ROOT, so with none set for this service it picked up the bot's
    # /railway.toml, whose healthcheckPath is "/health" — overriding the
    # "/healthz" set on the service. The first deploy built and ran fine and
    # still failed, on 404s against a path this file did not serve. Answering
    # both makes the service independent of which config wins.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }
    location = /health {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # The trailing slash on proxy_pass is what performs the strip:
    # /rest/v1/users?select=* -> /users?select=*
    location /rest/v1/ {
        proxy_pass http://${POSTGREST_HOST}:${POSTGREST_PORT}/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # supabase-js sends BOTH `apikey` and `Authorization: Bearer <jwt>`,
        # carrying the same value. PostgREST reads Authorization and ignores
        # apikey; both are forwarded unchanged so nothing depends on which.
        proxy_pass_request_headers on;

        # PostgREST answers Range for pagination and supabase-js relies on
        # Content-Range for .range()/counts, so buffering must not rewrite them.
        proxy_buffering off;
    }

    # Storage: supabase/storage-api (service `supabase-storage`), objects in
    # MinIO bucket `supabase-storage`, metadata in the `storage` schema of the
    # same Postgres PostgREST reads. storage-api serves /object, /bucket at the
    # ROOT, so the prefix is stripped exactly like /rest/v1/ above, and every
    # existing .storage.from(...).upload/getPublicUrl/createSignedUrl call site
    # keeps working with only SUPABASE_URL changed.
    location /storage/v1/ {
        proxy_pass http://${STORAGE_HOST}:${STORAGE_PORT}/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;

        # Videos and training archives go through here; the 32m REST limit
        # would refuse them. Stream both ways instead of spooling to disk.
        client_max_body_size 512m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Deliberately NOT implemented, and said out loud rather than 404ing into
    # confusion: this app never signs anyone in (zero .auth call sites).
    location /auth/v1/ {
        add_header Content-Type application/json always;
        return 501 '{"error":"auth is not served here; this deployment has no GoTrue"}';
    }

    location / {
        add_header Content-Type application/json always;
        return 404 '{"error":"only /rest/v1/ and /storage/v1/ are proxied by this gateway"}';
    }
}
