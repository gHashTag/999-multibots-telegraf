# Getting Vibee to TestFlight and the App Store, repeatably.
#
#   fastlane preflight   every blocker at once, in seconds, offline
#   fastlane state       what App Store Connect holds right now (read-only)
#   fastlane certs       make sure an Apple Distribution certificate exists
#   fastlane build_only  a signed App Store .ipa in build/ipa, nothing sent
#   fastlane beta        build and upload to TestFlight (internal testers)
#
# `tri iphone store` runs preflight + state; `tri iphone testflight --yes`
# runs beta. The upload publishes a build under the owner's account, so it is
# never run by a loop or an agent without the owner's "yes".
#
# The release engineering is the one the Leela app shipped with (gHashTag/
# leela, fastlane/Fastfile): an App Store Connect API key instead of an Apple
# ID password, the same key authenticating provisioning during export, macOS's
# own rsync during export, no symbol upload from the export. Each of those was
# a failure there first; the comments below name it.
#
# NO SECRETS HERE. The key lives outside the repository:
#
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8   the .p8 itself
#   ~/.appstoreconnect/fastlane-key.json                 key_id + issuer_id
#
# (`tri iphone` signs device builds with the same pair.) ASC_KEY_ID and
# ASC_ISSUER_ID override the JSON; ASC_KEY_P8 (the .p8 contents) replaces the
# file on a machine that has none, e.g. CI. A .p8 cannot be downloaded twice:
# lose it and a new key has to be issued.

require "json"
require "shellwords"

default_platform(:ios)

# The project is generated from project.yml and Vibee.xcodeproj is ignored by
# git, so a clean machine has to generate it before gym can find it.
XCODEPROJ = "Vibee.xcodeproj"
SCHEME    = "Vibee"
BUNDLE_ID = ENV["VIBEE_BUNDLE_ID"] || "ai.t27.vibee"

# Lanes run with the working directory set to fastlane/, while `sh` runs from
# the project root. Every backtick below therefore goes through IOS_DIR: a
# relative `-project Vibee.xcodeproj` from fastlane/ finds nothing, and the
# destination check used to report "no iOS platform installed" on a machine
# that had it (measured 2026-10-03: -showdestinations listed Any iOS Device).
IOS_DIR = File.expand_path("..", __dir__)

KEY_DIR  = File.expand_path("~/.appstoreconnect/private_keys")
KEY_JSON = File.expand_path("~/.appstoreconnect/fastlane-key.json")

# The build number is the commit count, not a counter in a file.
#
# WHY NOT increment_build_number. It calls agvtool, which edits
# Vibee/Info.plist - a tracked file that xcodegen REGENERATES from project.yml.
# The number stays an uncommitted edit and silently goes back to 1 on the next
# `xcodegen generate` (run.sh calls it unconditionally). Measured: agvtool
# printed "Updated CFBundleVersion ... to 42", xcodegen put back 1, and the
# upload went out with the old number.
#
# The count is monotonic and identical on every machine. Leela asks App Store
# Connect for its latest build instead; here `beta` asks too, but only to
# refuse a number that is not above it (Apple rejects a reused number AFTER
# the upload). VIBEE_BUILD overrides.
def build_number
  return ENV["VIBEE_BUILD"] if ENV["VIBEE_BUILD"].to_s.strip != ""
  Dir.chdir(IOS_DIR) { `git rev-list --count HEAD`.strip }
end

# A development certificate is NOT enough: gym archives with it and then the
# app-store export fails - after minutes of compiling.
def distribution_identity?
  `security find-identity -v -p codesigning 2>/dev/null`.include?("Apple Distribution")
end

# Does the scheme have any usable destination at all? Without one
# `xcodebuild archive` - and so gym - refuses outright ("Found no destinations
# for the scheme 'Vibee' and action archive"). The SDK being present proves
# nothing; the destination list is what archive consults.
def archive_destination_available?
  project = File.join(IOS_DIR, XCODEPROJ).shellescape
  out = `xcodebuild -project #{project} -scheme #{SCHEME} -showdestinations 2>&1`
  out.include?("Available destinations for the \"#{SCHEME}\" scheme:")
end

# Where the App Store Connect key comes from, or why it cannot be found.
# Returns [params, nil] or [nil, reason]. Reads names and paths only; the .p8
# contents are touched only when ASC_KEY_P8 supplies them instead of a file.
def asc_key
  json = File.exist?(KEY_JSON) ? (JSON.parse(File.read(KEY_JSON)) rescue {}) : {}
  key_id = ENV["ASC_KEY_ID"].to_s.strip
  key_id = json["key_id"].to_s if key_id.empty?
  issuer = ENV["ASC_ISSUER_ID"].to_s.strip
  issuer = json["issuer_id"].to_s if issuer.empty?
  return [nil, "no key id: set ASC_KEY_ID or write key_id into #{KEY_JSON}"] if key_id.empty?
  return [nil, "no issuer id: set ASC_ISSUER_ID or write issuer_id into #{KEY_JSON}"] if issuer.empty?

  path = File.join(KEY_DIR, "AuthKey_#{key_id}.p8")
  if File.exist?(path)
    [{ key_id: key_id, issuer_id: issuer, key_filepath: path }, nil]
  elsif ENV["ASC_KEY_P8"].to_s.strip != ""
    [{ key_id: key_id, issuer_id: issuer, key_content: ENV["ASC_KEY_P8"] }, nil]
  else
    [nil, "no key file #{path} (and no ASC_KEY_P8)"]
  end
end

platform :ios do
  before_all do
    # Generate ALWAYS, not only when the project is missing: a stale
    # .xcodeproj from an earlier run ignores project.yml edits. Measured -
    # MARKETING_VERSION 9.9 in project.yml, 1.0 in -showBuildSettings, and
    # `build_only` would have signed the OLD version, green and silent.
    Dir.chdir(IOS_DIR) { sh("xcodegen generate --quiet") }
  end

  desc "App Store Connect API key (from ~/.appstoreconnect or the environment)"
  private_lane :api_key do
    params, why = asc_key
    UI.user_error!("No App Store Connect API key: #{why}.\nSee apps/vibee-ios/README.md.") unless params
    app_store_connect_api_key(**params, in_house: false)
  end

  desc "Every blocker to a TestFlight upload at once, offline"
  lane :preflight do
    # Names ALL blockers in seconds instead of one per ten-minute build. It
    # fixes nothing and talks to nobody.
    blockers = []
    notes    = []

    scheme_path = File.join(IOS_DIR, XCODEPROJ, "xcshareddata/xcschemes/#{SCHEME}.xcscheme")
    if File.exist?(scheme_path)
      notes << "scheme #{SCHEME} is shared - gym will find it"
    else
      blockers << "scheme #{SCHEME} is not shared: gym fails with 'scheme not found'"
    end

    icon = File.join(IOS_DIR, "AppIcon.xcassets/AppIcon.appiconset/AppIcon-1024.png")
    if File.exist?(icon)
      # LOOK INTO THE FILE, not at its name: an 8x8 PNG with alpha passed an
      # existence check, and Apple rejects it twice - size and alpha
      # (ITMS-90717). Most editors export alpha by default.
      props  = `sips -g pixelWidth -g pixelHeight -g hasAlpha #{icon.shellescape} 2>/dev/null`
      width  = props[/pixelWidth: (\d+)/, 1].to_i
      height = props[/pixelHeight: (\d+)/, 1].to_i
      alpha  = props.include?("hasAlpha: yes")
      size_ok = (width == 1024 && height == 1024)
      blockers << "icon is #{width}x#{height}; the App Store wants exactly 1024x1024" unless size_ok
      blockers << "icon has an alpha channel; the App Store rejects it (ITMS-90717)" if alpha
      notes << "1024x1024 icon without alpha in AppIcon.xcassets" if size_ok && !alpha
    else
      blockers << "no #{icon}: App Store Connect rejects an upload without an icon"
    end

    # The catalog joins the target by its own line in project.yml. Without it
    # the .app has no Assets.car - a break that shows only at upload. UTF-8
    # explicitly: fastlane's locale is often US-ASCII, and File.read of a file
    # with Cyrillic comments then dies with "invalid byte sequence".
    spec = File.read(File.join(IOS_DIR, "project.yml"), encoding: "UTF-8")
    if spec.match?(/^\s*-\s*AppIcon\.xcassets\s*$/)
      notes << "AppIcon.xcassets is part of the target"
    else
      blockers << "AppIcon.xcassets is NOT part of the target: add '- AppIcon.xcassets' " \
                  "to the Vibee target's sources in project.yml"
    end

    if archive_destination_available?
      notes << "the scheme has archive destinations (iOS platform installed)"
    else
      blockers << "no destination for the scheme ('Found no destinations'): " \
                  "install the platform with `xcodebuild -downloadPlatform iOS`"
    end

    if distribution_identity?
      notes << "Apple Distribution certificate in the keychain"
    else
      blockers << "no Apple Distribution certificate: run `fastlane certs` " \
                  "(a development certificate cannot sign an App Store export)"
    end

    params, why = asc_key
    if params
      notes << "App Store Connect key #{params[:key_id]} " \
               "(#{params[:key_filepath] ? 'file' : 'ASC_KEY_P8'})"
    else
      blockers << "App Store Connect key: #{why}"
    end

    notes << "build number will be #{build_number} (commit count)"
    notes << "bundle id #{BUNDLE_ID}"

    notes.each { |n| UI.success("  ✓ #{n}") }
    blockers.each { |b| UI.error("  ✗ #{b}") }

    if blockers.empty?
      UI.success("Ready for `fastlane beta`. Next: `fastlane state` asks App Store Connect.")
      next
    end

    # FAIL, do not warn. This used to be UI.important with exit 0: four
    # blockers on screen and `echo $?` printed 0, so `preflight && next-step`
    # went on. All blockers are printed first, then the lane fails.
    UI.user_error!("#{blockers.count} blocker(s); each needs a person with the Apple account or this machine.")
  end

  desc "What App Store Connect holds for this app (read-only)"
  lane :state do
    # Leela carried four beliefs about its TestFlight and store state for
    # weeks and measured none (scripts/asc-state.mjs, 2026-08-23). This asks.
    # It submits nothing and changes nothing.
    api_key

    # Two records, two owners' clicks, and an upload needs both. Measured
    # 2026-10-03: the key sees nine apps (Leela among them) and neither record
    # for ai.t27.vibee - device builds sign without an explicit App ID.
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if bundle
      UI.success("app id    #{bundle.identifier} registered (#{bundle.platform})")
    else
      UI.error("app id    #{BUNDLE_ID} is NOT registered in Certificates, Identifiers & Profiles")
    end
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    unless app
      UI.user_error!(
        "App Store Connect has no app with bundle id #{BUNDLE_ID}.\n" \
        "Both are created once, by the account holder, and an upload to a missing " \
        "record is refused:\n" \
        "  1. the App ID - developer.apple.com -> Identifiers -> + (explicit, " \
        "#{BUNDLE_ID})\n" \
        "  2. the app record - App Store Connect -> Apps -> + -> New App " \
        "(an API key cannot create one; Apple's API has no such call)"
      )
    end
    UI.success("app       #{app.name} (#{app.bundle_id}, id #{app.id})")

    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5)
    if builds.empty?
      UI.important("testflight  no builds yet")
    else
      builds.each do |b|
        UI.message("testflight  #{b.app_version} (#{b.version})  #{b.processing_state}" \
                   "#{b.expired ? ' expired' : ''}  uploaded #{b.uploaded_date}")
      end
    end

    app.get_app_store_versions.first(3).each do |v|
      UI.message("store       #{v.version_string}  #{v.app_store_state}")
    end

    latest = builds.map { |b| b.version.to_i }.max.to_i
    number = build_number.to_i
    if number > latest
      UI.success("next build #{number} is above the latest #{latest}")
    else
      UI.user_error!("next build #{number} is NOT above the latest #{latest}: " \
                     "set VIBEE_BUILD to something larger")
    end
  end

  desc "Make sure an Apple Distribution certificate exists in this keychain"
  lane :certs do
    # Xcode on this machine has no Apple ID. The API key can fetch - or, if
    # the team has none, create - a distribution certificate without anyone
    # typing a password. Creating one is an account change: ask the owner
    # before running this where `preflight` does not already show the cert.
    get_certificates(api_key: api_key, output_path: "build/certs")
  end

  desc "A signed App Store .ipa in build/ipa, nothing sent"
  lane :build_only do
    preflight
    key = asc_key.first

    number = build_number
    UI.message("build number #{number}")

    # The same key authenticates provisioning. Automatic signing makes the
    # export ask App Store Connect for an app-store profile; with no Xcode
    # account Leela's first attempt died on "No Accounts" exactly here.
    auth = if key[:key_filepath]
             "-allowProvisioningUpdates" \
               " -authenticationKeyPath #{key[:key_filepath].shellescape}" \
               " -authenticationKeyID #{key[:key_id]}" \
               " -authenticationKeyIssuerID #{key[:issuer_id]}"
           else
             UI.important("ASC_KEY_P8 without a key file: provisioning updates need the " \
                          "file, so the export relies on profiles already on this machine")
             ""
           end

    # Homebrew out of the way while the archive is exported.
    #
    # `xcodebuild -exportArchive` runs `/usr/bin/rsync -8aPhhE`; -E is
    # Apple's flag. Homebrew's rsync 3.x, if earlier on PATH, becomes the far
    # end and rejects --extended-attributes. The export then fails with
    # "exportArchive Copy failed" naming neither rsync nor the flag - Leela
    # found it only in Xcode's distribution logs. Restored afterwards.
    original_path = ENV["PATH"]
    ENV["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
    begin
      build_app(
        project: File.join(IOS_DIR, XCODEPROJ),
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        # The number is a BUILD SETTING, not a file edit (see build_number);
        # Info.plist reads $(CURRENT_PROJECT_VERSION).
        xcargs: "CURRENT_PROJECT_VERSION=#{number} #{auth}".strip,
        export_xcargs: auth,
        export_options: {
          # With symbols on, the export looks for an Apple ID to send them
          # with, finds none in a non-interactive shell and dies with "Could
          # not connect to the server". upload_to_testflight carries dSYMs.
          uploadSymbols: false,
          manageAppVersionAndBuildNumber: false
        },
        output_directory: File.join(IOS_DIR, "build/ipa"),
        buildlog_path: File.join(IOS_DIR, "build/logs"),
        # Raw xcodebuild output: the stripped PATH also hides Homebrew's
        # xcpretty, and a missing formatter killed Leela's pipe with exit 127
        # AFTER a successful archive.
        xcodebuild_formatter: ""
      )
    ensure
      ENV["PATH"] = original_path
    end
    UI.success("built #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc "Build and upload to TestFlight (internal testers; nothing goes to review)"
  lane :beta do
    # `state` first: it refuses a missing app record and a build number that
    # is not above the latest - both of which Apple reports only after the
    # upload, i.e. after the whole build.
    state
    build_only

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      # Processing takes minutes to an hour; `fastlane state` shows it.
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      # Testers should know what they are testing: the changelog is the last
      # commit unless CHANGELOG says otherwise.
      changelog: (ENV["CHANGELOG"] || last_git_commit[:message].to_s)[0, 4000]
    )
    UI.success("uploaded build #{build_number}; `fastlane state` shows its processing")
  end
end
