# Кто мы для App Store Connect.
#
# ЗДЕСЬ НЕТ И НЕ БУДЕТ СЕКРЕТОВ. Этот файл отслеживается git; всё, что в него
# попало, равносильно опубликованному.
#
# Идентификатор приложения и идентификатор команды — НЕ секреты: первый
# виден в любой ссылке на App Store, второй уже стоит открытым текстом в
# project.yml (DEVELOPMENT_TEAM) и вшит в каждый профиль подписи. Держать их
# здесь значением, а не переменной окружения, — сознательный выбор: без них
# fastlane спрашивает интерактивно, и на чистой машине сборка встаёт молча,
# ожидая ввода. Переопределить всё равно можно окружением.
app_identifier(ENV["VIBEE_BUNDLE_ID"] || "ai.t27.vibee")
team_id(ENV["FASTLANE_TEAM_ID"] || "5EM4M85VSQ")

# А ВОТ ЭТИ ДВА — ТОЛЬКО ИЗ ОКРУЖЕНИЯ.
#
# apple_id — это почта живого человека: персональные данные, которым не
# место в репозитории. Он нужен только при входе по паролю; при работе
# ключом App Store Connect API (наш случай) не требуется вовсе.
apple_id(ENV["FASTLANE_APPLE_ID"])

# itc_team_id обычно совпадает с team_id, но НЕ всегда: у аккаунтов, где
# одна и та же команда заведена и как developer team, и как несколько
# сущностей в App Store Connect, они расходятся. Угадывать здесь нечего —
# либо задано, либо fastlane спросит.
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"])
