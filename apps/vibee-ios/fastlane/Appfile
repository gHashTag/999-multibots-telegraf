# Which app, and whose.
#
# NO SECRETS HERE: this file is tracked by git, and anything in it is public.
#
# The bundle id and the team are not secrets - the first is in every App Store
# link, the second is already in project.yml and in every signing profile. They
# are values, not environment variables, on purpose: without them fastlane asks
# interactively, and on a clean machine the build stalls silently waiting for
# input. The environment still overrides both. Same team as Leela
# (gHashTag/leela fastlane/Appfile).
app_identifier(ENV["VIBEE_BUNDLE_ID"] || "ai.t27.vibee")
team_id(ENV["FASTLANE_TEAM_ID"] || "5EM4M85VSQ")

# ONLY FROM THE ENVIRONMENT. apple_id is a person's e-mail - personal data with
# no place in a repository - and the API key flow (ours) never needs it.
apple_id(ENV["FASTLANE_APPLE_ID"])

# Usually equal to team_id, but not always; there is nothing to guess here.
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"])
