<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Без этого права Keychain отвечает -34018 (errSecMissingEntitlement),
	  и вход по коду проходил на сервере, сжигал код и терял токены.
	  Группа — сам bundle id: общий доступ ни с кем не нужен, нужна
	  собственная группа, иначе её нет вовсе.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ai.t27.vibee</string>
	</array>
</dict>
</plist>
