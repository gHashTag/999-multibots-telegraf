server {
    # ${PORT} is substituted at container start by docker-entrypoint.sh.
    # Railway assigns PORT at RUNTIME and it is not always 8080 — a hardcoded
    # port produces a successful build followed by a healthcheck timeout.
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Directory redirects (/lipsync -> /lipsync/) must be relative. nginx builds
    # them from the scheme it sees and the port it listens on, and behind
    # Railway's TLS edge that is http:// and ${PORT}: measured 2026-09-14,
    # https://app.t27.ai/lipsync, /assets, /icons and /backgrounds all answered
    # 301 -> http://app.t27.ai:8080/..., which times out. A relative Location
    # keeps the browser on https://app.t27.ai.
    absolute_redirect off;

    # Telegram Web (web.telegram.org) runs a Mini App inside an iframe.
    # X-Frame-Options DENY/SAMEORIGIN would render the app blank on Web+Desktop,
    # so frame embedding is allowed for Telegram origins only.
    # https://t27.ai hosts the game: its Queen board has a TRI tab that shows
    # the app's screens (feed, agent, AI, profile, CRM) in a frame with
    # ?embed=1. frame-ancestors is per origin, so this admits every page on
    # t27.ai: every GitHub Pages site of gHashTag published there (t27.ai/leela/,
    # /trinity/, /jscamp/, ...), not only the game. CSP cannot narrow it to a
    # path; the player keeps the browser session out of frames by such pages
    # (player/src/lib/framedSession.ts).
    # Not www.t27.ai: it answers 301 to the apex (measured 2026-09-14).
    add_header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t27.ai;" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Healthcheck — answered by nginx itself, never touches the filesystem.
    # Must not go through the SPA fallback: that returns 200 for every path,
    # which would make the healthcheck pass even with an empty document root.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # HTML entry point — never cache (references hashed JS/CSS filenames).
    # add_header inside a location REPLACES inherited headers, so the
    # server-level ones are repeated here.
    location = /index.html {
        add_header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t27.ai;" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # TRI identity bridge (player/public/bridge/). The game on https://t27.ai
    # frames it when it runs top-level, to learn who the visitor is without
    # holding this app's session: the bridge reads the tab's access token and
    # hands the game a 300 s game token after one click (bridge.js).
    #
    # Its own policy, not the server-level one above:
    #  - frame-ancestors is exactly https://t27.ai. Never 'self': inside /hive
    #    the chain is app.t27.ai > t27.ai > app.t27.ai, and a bridge framed
    #    there would share the player's sessionStorage, Telegram launch data
    #    included (measured in Chrome). Never Telegram: it answers the game only.
    #  - script-src and style-src 'self', connect-src vibee-render, nothing else.
    #  - no-store. Without the ^~ block, /bridge/bridge.js would fall into the
    #    .js location below and be cached as immutable for a year.
    # Exact and ^~ locations win over the regex locations below.
    location = /bridge {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src https://vibee-render-production.up.railway.app; style-src 'self'; frame-ancestors https://t27.ai" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        try_files /bridge/index.html =404;
    }

    # The consent popup the bridge opens (bridge.js, consent.js). Nobody may
    # frame it: a page that frames it could make it invisible and put a decoy
    # over its button, which is exactly what a popup is there to prevent. No
    # connect-src: it sends nothing but a message to its opener.
    location = /bridge/consent.html {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location ^~ /bridge/ {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src https://vibee-render-production.up.railway.app; style-src 'self'; frame-ancestors https://t27.ai" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # The app sign-in code (pages/Pair.tsx). One button that mints a
    # credential, which is the same object class as /bridge/consent.html above
    # — and gets the same treatment, narrowed to the one ancestor under which
    # it can work at all.
    #
    # NOT the server-level policy: that admits 'self' and https://t27.ai, and
    # the comment on /index.html spells out what both mean. t27.ai is every
    # GitHub Pages site published there, and 'self' is the /hive chain
    # app.t27.ai > t27.ai > app.t27.ai, which shares this app's sessionStorage
    # — Telegram launch data included (measured in Chrome).
    #
    # Neither can make a code today: getInitData() returns '' when an ancestor
    # is not Telegram, so the mint answers 401 — fail-closed. What a frame CAN
    # do right now is render the real button, because canAuthorizeRequestsAtom
    # reads wa.initData without checking ancestors; a decoy laid over it is
    # exactly the attack the consent popup's 'none' exists to prevent.
    #
    # Telegram is kept because the Mini App genuinely runs in an iframe on
    # web.telegram.org. Regex, not `location = /pair`: an exact match would
    # leave /pair/ — which React Router resolves to the same page — falling
    # through to `location /` and the permissive policy.
    location ~ ^/pair/?$ {
        add_header Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org;" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        try_files /index.html =404;
    }

    # Данные — до SPA-fallback. Иначе отсутствующий manifest.json отдавался
    # как index.html с кодом 200: парсер получал HTML вместо JSON, и поломка
    # была не видна ни в консоли, ни в логах. Ровно так и случилось.
    location ~* \.(json|txt|xml|webmanifest)$ {
        try_files $uri =404;
    }

    # SPA fallback. Load-bearing for a Mini App: Telegram's WebView reloads the
    # app on resume from background on some Android builds, and a 404 on a deep
    # route is a blank WebView with no way back.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed assets (JS/CSS) — immutable long cache
    location ~* \.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Media files — 24h cache for videos
    location ~* \.(mp4|mp3|webm|ogg|wav|m3u8|ts)$ {
        expires 24h;
        add_header Cache-Control "public, immutable";
        add_header Accept-Ranges "bytes";
        add_header Access-Control-Allow-Origin "*";
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
        add_header Access-Control-Allow-Headers "Range";
        etag on;

        types {
            video/mp4 mp4;
            video/webm webm;
            audio/mpeg mp3;
            audio/ogg ogg;
            audio/wav wav;
            application/vnd.apple.mpegurl m3u8;
            video/mp2t ts;
        }
    }

    # Images/fonts — long cache
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;
}
