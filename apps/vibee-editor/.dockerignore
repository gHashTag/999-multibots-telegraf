# Build context is apps/vibee-editor. This file, NOT the repo-root
# .dockerignore, is what Docker uses once Railway's Root Directory points here.
#
# public/ is deliberately NOT excluded: the app loads /lipsync/lipsync.mp4,
# /audio/music/bgmusic.mp3 and /backgrounds/business/bg*.{mp4,av1.mp4,webm}
# from it at runtime, and index.html prefetches two of them.

**/node_modules
**/dist
**/.vite
**/.tamagui
**/.zig-cache
**/zig-out
**/playwright-report
**/test-results

# Manual content-loop agents contain paid/publish orchestration and are not
# part of the immutable SAFE BETA production artifact. They remain available
# to the owner locally, but Docker never receives these files in its context.
render/scripts/agent-autopilot.ts
render/scripts/morning-summary.ts

# Secrets never belong in a build layer.
**/.env
**/.env.*
!**/.env.example

**/.DS_Store
**/*.log
