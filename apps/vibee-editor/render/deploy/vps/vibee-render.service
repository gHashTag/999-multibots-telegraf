# /etc/systemd/system/vibee-render.service
# Keeps the compose stack up across reboots and restarts it if compose itself
# dies. The container has its own restart policy; this is the second net.
[Unit]
Description=vibee-render (T27OS VPS) -- docker compose stack
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vibee-render
ExecStartPre=/usr/bin/docker compose -f docker-compose.yml pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
