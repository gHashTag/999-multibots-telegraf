# t27ai-render env.example -- every variable the code reads
# (grep 'process.env.' render/src --include='*.ts'; 118 references, these are
# the unique names, grouped by subsystem). Copy to /opt/t27ai-render/.env,
# chmod 600. Values live on the VPS only, never in git.
#
# ── MINIMUM TO BOOT AND SERVE THE COURSE LADDER ──────────────────────────
# Everything below this block is optional for the ladder (key mint, progress,
# CRM touches); each unset subsystem just answers "not configured".
#
# The render's own Postgres (t27ai-render-db.service). Use the in-network host
# name and sslmode=disable: the container network is private and the server
# there does not speak TLS (the pool's default ssl block would refuse it).
#   DATABASE_URL=postgres://t27ai:<password>@t27ai-db:5432/t27ai?sslmode=disable  secret-guard-ok: placeholder, not a value
DATABASE_URL=
# At least 32 characters. The course key's signing secret is derived from it
# (src/agent/course-access.ts); shorter or empty makes the ladder answer
# "keys_off". Changing it invalidates every key already handed out.
SESSION_SIGNING_KEY=
# The server key: the bot sends it as X-Api-Key, the render compares it.
# Set the SAME value in the bot's env (bot.env.example).
RENDER_API_KEY=
# The owner's Telegram id: the course door tells him who arrived. Needs the
# house bot token below to deliver; without it the touch is still filed.
OWNER_TELEGRAM_ID=
# Overridden by the unit (-e PORT=8080); the image's own default is 3333.
PORT=

# ── the model chain (agent-provider-chain.t27) ────────────────────────────
# The key pool: primary first, then the whole pool. THE switch that arms
# rotation (#4048).
GLM_API_KEY=
GLM_API_KEYS=
# zai-lite's own key; unset, it reads GLM_API_KEY
ZAI_LITE_API_KEY=
# the coding endpoint; only changes if z.ai moves it
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
KIE_AI_API_KEY=
KIE_CHAT_MODEL=
# head of the chain + model override (deployment choice)
AGENT_PROVIDER=
AGENT_MODEL=
# reserve route: all three or the leg is absent
RESERVE_BASE_URL=
RESERVE_API_KEY=
RESERVE_MODEL=
RESERVE_TOOLS=
RESERVE_VISION=
RESERVE_MAX_TOKENS=

# ── ollama leg: Railway-internal on prod; on the VPS either expose
#    queen-ollama or leave unset (the chain answers without it) ────────────
OLLAMA_BASE_URL=
OLLAMA_ENABLED=
OLLAMA_MODEL=
OLLAMA_CONTEXT_LENGTH=
OLLAMA_NUM_CTX=
RAILWAY_SERVICE_QUEEN_OLLAMA_URL=

# ── storage and memory ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ZEP_API_URL=
ZEP_API_KEY=
ZEP_AUTH_SECRET=
ZEP_FLAVOR=

# ── telegram (the render answers and sends as the managed bots) ──────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
ADMIN_TELEGRAM_ID=
HOUSE_TELEGRAM_IDS=

# ── zai relay (render's own upstream pass-through) ───────────────────────
ZAI_RELAY_UPSTREAM=
