  },
  {
    "name": "unsafe integer key ID is accepted",
    "file": "src/hive/contributor-keys-route.ts",
    "from": "!Number.isSafeInteger(Number(match[1]))",
    "to": "!Number.isInteger(Number(match[1]))"
  }
