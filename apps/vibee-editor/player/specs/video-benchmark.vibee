# Video Performance Benchmarking Specification
# Methodology based on scientific video streaming research
# Provides before/after comparison with statistical significance

name: video-benchmark
version: "1.0.0"
language: typescript
module: video/benchmark
description: Video performance benchmarking with statistical analysis

behaviors:
  - name: run_startup_benchmark
    given: Test video URLs are available
    when: Startup benchmark is executed
    then:
      - Multiple startup time measurements are taken
      - Statistical analysis is performed (mean, median, p95, p99)
      - Results are stored for comparison
    test_cases:
      - name: benchmark_10_videos
        input: {videoUrls: ["v1.mp4", "v2.mp4"], iterations: 5}
        expected: {measurements: 10, statsCalculated: true}
      - name: single_video_benchmark
        input: {videoUrls: ["test.mp4"], iterations: 10}
        expected: {measurements: 10, meanCalculated: true}

  - name: run_buffer_benchmark
    given: Network throttling is configured
    when: Playback benchmark runs for specified duration
    then:
      - Rebuffer events are counted
      - Buffer health is measured at intervals
      - Network adaptation is tested
    test_cases:
      - name: 3g_network_test
        input: {networkProfile: "3g", duration: 30000, videoUrl: "test.m3u8"}
        expected: {rebufferRatio: "<0.1", completed: true}
      - name: wifi_network_test
        input: {networkProfile: "wifi", duration: 30000, videoUrl: "test.m3u8"}
        expected: {rebufferRatio: "<0.01", completed: true}

  - name: run_memory_benchmark
    given: Video feed with multiple videos
    when: User scrolls through N videos
    then:
      - Memory usage is measured at start, peak, and end
      - Memory leak detection is performed
      - Cleanup effectiveness is verified
    test_cases:
      - name: scroll_20_videos
        input: {videoCount: 20, scrollDelay: 1000}
        expected: {memoryGrowth: "<50MB", leakDetected: false}

  - name: compare_before_after
    given: Baseline metrics exist
    when: New optimization is tested
    then:
      - Improvement percentage is calculated
      - Statistical significance is determined (p < 0.05)
      - Report is generated with recommendations
    test_cases:
      - name: improvement_detected
        input: {baseline: {startup: 2000}, current: {startup: 1500}}
        expected: {improvement: "25%", significant: true}
      - name: no_significant_change
        input: {baseline: {startup: 2000}, current: {startup: 1950}}
        expected: {improvement: "2.5%", significant: false}

  - name: generate_benchmark_report
    given: All benchmarks completed
    when: Report generation is requested
    then:
      - JSON report with all metrics is created
      - Comparison with baseline is included
      - Recommendations are provided
    test_cases:
      - name: full_report
        input: {benchmarks: ["startup", "buffer", "memory"]}
        expected: {reportGenerated: true, sectionsCount: 3}

types:
  BenchmarkResult:
    testName: string
    timestamp: string
    measurements: number[]
    mean: number
    median: number
    p50: number
    p95: number
    p99: number
    stdDev: number
    min: number
    max: number

  StartupBenchmark:
    videoUrl: string
    iterations: number
    results: BenchmarkResult
    networkProfile: string

  BufferBenchmark:
    videoUrl: string
    duration: number
    rebufferEvents: number
    rebufferRatio: number
    avgBufferHealth: number
    networkProfile: string

  MemoryBenchmark:
    initialHeap: number
    peakHeap: number
    finalHeap: number
    memoryGrowth: number
    leakDetected: boolean
    videoCount: number

  ComparisonResult:
    metricName: string
    baseline: number
    current: number
    difference: number
    improvementPercent: number
    pValue: number
    isSignificant: boolean

  BenchmarkReport:
    runId: string
    date: string
    environment: Environment
    results: BenchmarkResult[]
    summary: BenchmarkSummary
    comparison: ComparisonResult[] | null
    recommendations: string[]

  BenchmarkSummary:
    totalTests: number
    passed: number
    failed: number
    avgStartupTime: number
    avgRebufferRatio: number
    memoryLeakDetected: boolean

  Environment:
    browser: string
    browserVersion: string
    os: string
    viewport: {width: number, height: number}
    networkProfile: string

  NetworkProfile:
    name: string
    downloadThroughput: number  # bytes per second
    uploadThroughput: number
    latency: number            # milliseconds

functions:
  - name: runStartupBenchmark
    params: {videoUrls: string[], iterations: number, networkProfile?: string}
    returns: Promise<StartupBenchmark>
    description: Run startup time benchmark

  - name: runBufferBenchmark
    params: {videoUrl: string, duration: number, networkProfile: string}
    returns: Promise<BufferBenchmark>
    description: Run buffer health benchmark

  - name: runMemoryBenchmark
    params: {videoCount: number, scrollDelay: number}
    returns: Promise<MemoryBenchmark>
    description: Run memory usage benchmark

  - name: compareResults
    params: {baseline: BenchmarkResult, current: BenchmarkResult}
    returns: ComparisonResult
    description: Compare current results with baseline

  - name: generateReport
    params: {results: BenchmarkResult[], baseline?: BenchmarkResult[]}
    returns: BenchmarkReport
    description: Generate comprehensive benchmark report

  - name: saveBaseline
    params: {results: BenchmarkResult[]}
    returns: void
    description: Save current results as baseline

  - name: loadBaseline
    params: {}
    returns: BenchmarkResult[] | null
    description: Load baseline from storage

  - name: calculatePValue
    params: {sample1: number[], sample2: number[]}
    returns: number
    description: Calculate p-value for statistical significance

  - name: getNetworkProfile
    params: {name: "slow3G" | "fast3G" | "4G" | "wifi"}
    returns: NetworkProfile
    description: Get predefined network throttling profile

imports:
  - video-qoe-metrics
  - playwright

completeness:
  test_coverage: 90%
  e2e_tests: 8
  unit_tests: 10
