name: vibee-player
# spec.vibee for VIBEE Video Editor Player
# Single source of truth for editor features and behaviors

plugin:
  name: vibee-player
  version: 1.0.0
  category: ui
  description: React/Vite video editor with Jotai state management

# Stack
stack:
  framework: React 19
  state: Jotai 2.16
  routing: React Router 7
  styling: Tailwind 4 + Tamagui
  testing: Vitest + Playwright
  video: Remotion 4.0.394
  bundler: Vite 7

# Pages
pages:
  - name: Editor
    path: /editor
    components:
      - Header
      - InteractiveCanvas
      - Timeline
      - AssetsPanel
      - TemplatesPanel
      - PropertiesPanel
    layout:
      structure: grid
      areas: [header, sidebar-left, canvas-area, sidebar-right, timeline-area]

  - name: Home
    path: /
    description: Landing page

  - name: Feed
    path: /feed
    description: Video feed browser

  - name: Search
    path: /search
    description: Search videos and templates

  - name: Generate
    path: /generate/:tab
    description: AI generation tools

  - name: Token
    path: /token
    description: Web3 token page

# Editor Behaviors (Given-When-Then format)
behaviors:
  - name: editor_loads_correctly
    description: Editor page loads with all components visible
    given: User navigates to /editor
    when: Page loads completely
    then:
      - Header is visible
      - Canvas area is visible
      - Timeline area is visible
    test: e2e/editor.spec.ts:11

  - name: timeline_displays
    description: Timeline component renders correctly
    given: Editor is loaded
    when: User views timeline area
    then:
      - Timeline wrapper (.timeline-area) is visible
      - Timeline content (.timeline) is visible
    test: e2e/editor.spec.ts:21

  - name: canvas_responds_to_viewport
    description: Canvas adjusts to window resize
    given: Editor is loaded
    when: Window is resized to 1920x1080
    then: Canvas area width exceeds 500px
    test: e2e/editor.spec.ts:44

  - name: header_visible
    description: Header component shows navigation
    given: Editor is loaded
    when: User views header area
    then: Header element with .header class is visible
    test: e2e/editor.spec.ts:37

  - name: sidebar_shows_assets
    description: Left sidebar shows asset panels
    given: Editor is loaded with showAssets=true
    when: Layout preset includes assets
    then:
      - Sidebar left is visible
      - Tabs for templates/lipsync/video/image/voice/music exist

# State Management (Jotai Atoms)
atoms:
  - name: tracksAtom
    type: Track[]
    description: Timeline tracks with items
    persistent: true

  - name: selectedItemIdsAtom
    type: string[]
    description: Currently selected item IDs

  - name: currentFrameAtom
    type: number
    description: Current playback frame

  - name: throttledFrameAtom
    type: number
    description: Throttled frame for non-critical UI (10fps)

  - name: isPlayingAtom
    type: boolean
    description: Playback state

  - name: sidebarTabAtom
    type: SidebarTab
    description: Active sidebar tab
    values: [templates, lipsync, video, image, voice, music]

  - name: layoutPresetAtom
    type: string
    description: Current layout preset

# Components
components:
  - name: InteractiveCanvas
    path: src/components/Canvas/InteractiveCanvas.tsx
    props:
      - None (uses atoms directly)
    atoms_used:
      - tracksAtom
      - selectedItemIdsAtom
      - currentFrameAtom

  - name: Timeline
    path: src/components/Timeline/Timeline.tsx
    class: .timeline
    atoms_used:
      - tracksAtom
      - currentFrameAtom
      - isPlayingAtom

  - name: Header
    path: src/components/Header/Header.tsx
    class: header.header
    props:
      - wsStatus: connected | disconnected
      - wsClientId: string

  - name: AssetsPanel
    path: src/components/Panels/AssetsPanel.tsx
    props:
      - filterType: lipsync | video | image | voice | music

  - name: PropertiesPanel
    path: src/components/Panels/PropertiesPanel.tsx
    visibility: selectedItemIds.length > 0

# CSS Architecture
css:
  layout:
    variables:
      - --assets-width
      - --timeline-height
    classes:
      - .editor
      - .editor-main
      - .sidebar-left
      - .sidebar-right
      - .canvas-area
      - .timeline-area

# Testing
testing:
  e2e:
    framework: Playwright
    config: playwright.config.ts
    tests:
      - path: e2e/editor.spec.ts
        count: 6
        pass_rate: 100%

# Completeness criteria
completeness:
  test_coverage: 100%
  e2e_tests_passing: 6/6
  all_behaviors_implemented: true
  layout_issues_fixed: 7/7
