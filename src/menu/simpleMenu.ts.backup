// 🤖 Массив сотрудников HaimGroupMedia_bot (ограниченный доступ к парсингу)
const HAIM_GROUP_STAFF_IDS = [
  '144022504', // @neuro_coder - Главный админ и владелец проекта ID 37
  '289259562', // @Vyacheslav_Neklyudov - Админ
