cmd_shell() {
  # КТО МОЖЕТ ДОЙТИ ДО ОБОЛОЧКИ И С ЧЕМ.
  #
  # Важен ПРИМИТИВ, а не файл: `exec`/`execSync` отдают строку оболочке, и
  # каждая подстановка в шаблоне интерпретируется. `execFile`/`spawn` берут
  # массив аргументов и оболочки не поднимают.
  #
  # Классификация идёт по ИМПОРТУ, а не по имени вызова, и это не педантизм:
  # contentFactory/stages.ts импортирует безопасный `execFile` и зовёт его
  # локально `exec`, а четыре файла оборачивают опасный `exec` в `promisify` и
  # зовут результат `execAsync` -- по именам вызовов первый попадёт в опасные,
  # а остальные четыре не найдутся вовсе.
  #
  # Перечисление этой популяции дало два настоящих дефекта: непроверенный
  # job_id, доезжающий до `rm -rf` через ssh2 (#1772), и шаблон команды,
  # выпавший из собственного соглашения о кавычках (#1773).
  ( cd "$ROOT" && node scripts/probe-shell-callers.cjs )
}

cmd_secrets_audit() {
