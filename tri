  done
  # An unmatched glob stays literal, so keep only the files that exist:
  # with no done-* yet, files[0] was the pattern and cut-* recordings
  # were reported as none at all.
  local files=() f
  for f in "$dir"/done-*.wav "$dir"/cut-*.wav; do [ -e "$f" ] && files+=("$f"); done
  [ ${#files[@]} -gt 0 ] || { warn 'no recordings yet'; return 1; }
  printf '\n'
