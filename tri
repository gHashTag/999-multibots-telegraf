cmd_in_gate() {
  # СОБИРАЕТ ЛИ ГЕЙТ ЭТОТ ТЕСТ ВООБЩЕ.
  #
  # Написал тест, гейт зелёный — и это ничего не значит, если файл не попал в
  # прогон: СЬЮТА, КОТОРАЯ НЕ ЗАПУСКАЛАСЬ, НЕ МОЖЕТ ДАТЬ РЕГРЕССИЮ. Ровно так
  # прошёл виток it.72: в worktree не слинковались node_modules под-приложений,
  # весь набор apps/vibee-editor/render молча не собрался, гейт напечатал
  # чистую дельту, а новый тест не выполнился НИ РАЗУ. Заметил только по
  # абсолютному счёту (4061 против 4295 — 234 теста исчезли), и с тех пор
  # каждый раз считал членство руками: 4300 = +5, 4305 = +5, 4309 = +4.
  #
  # Здесь та же проверка за пару секунд и без полного прогона: `vitest list`
  # применяет КОРНЕВОЙ конфиг (тот самый, которым ходит гейт) и печатает по
  # строке на тест. Ноль строк = файла в популяции гейта нет. Две причины, и
  # они лечатся по-разному, поэтому обе названы в выводе.
  local target="${1:-}"
  if [ -z "$target" ]; then
    bad 'нужен путь к тесту: tri in-gate <файл.test.ts>'
    return 2
  fi
  if [ ! -f "$ROOT/$target" ] && [ ! -f "$target" ]; then
    bad "нет такого файла: $target"
    return 2
  fi
  local base out n
  base="$(basename "$target")"
  out="$(cd "$ROOT" && npx vitest list "$target" 2>&1)"
  n="$(printf '%s\n' "$out" | grep -c "$base >" || true)"
  if [ "$n" -gt 0 ]; then
    good "$base: гейт видит $n тест(ов)"
    return 0
  fi
  bad "$base: гейт НЕ СОБИРАЕТ этот файл — ноль тестов в популяции"
  echo
  echo '  Две причины, лечатся по-разному:'
  echo '   1) файл исключён в корневом vitest.config (например apps/**/player/**,'
  echo '      *.spec.ts, e2e) — тогда гейт и не должен его видеть;'
  echo '   2) ОШИБКА СБОРА: импорт не резолвится. В worktree это почти всегда'
  echo '      несвязанные node_modules под-приложений — лечится `tri worktree`,'
  echo '      который линкует root И каждый apps/*/node_modules.'
  echo
  echo '  Что сказал сам vitest:'
  printf '%s\n' "$out" | grep -iE "error|cannot find|failed to load|ERR_" | head -5 | sed 's/^/    /'
  return 1
}

cmd_why_red() {
  # ПОЧЕМУ ГЕЙТ КРАСНЫЙ НА ЭТОМ ФАЙЛЕ: тест сломался или его ПЕРЕИМЕНОВАЛИ?
  #
  # Гейт сравнивает МНОЖЕСТВА имён и не умеет их различать: имя, которого
  # больше нет, выглядит ровно как упавший тест — и хуже, оно неизлечимо.
  # Перепроверка гейта снимает подозрение, только УВИДЕВ проход, а
  # несуществующее имя пройти не может никогда. Гейт краснеет ПО КОНСТРУКЦИИ
  # на чистом дереве, и его перестают читать.
  #
  # Так и случилось: снимок записан, через четыре дня чужой PR переписал
  # voiceValidation.test.ts, снимок не обновили — и я двадцать витков подряд
  # называл эти 14 имён «известным флейком», читая мимо красного гейта.
  #
  # ПОДПИСЬ, которую эта команда показывает за секунды: в снимке 14 имён, файл
  # выдаёт 13. Флейк НЕ МЕНЯЕТ ЧИСЛО тестов — а переименование меняет.
  local target="${1:-}"
  local baseline="${2:-$ROOT/.test-baseline.txt}"
  if [ -z "$target" ]; then
    bad 'нужен путь к тесту: tri why-red <файл.test.ts> [снимок]'
    return 2
  fi
  if [ ! -f "$baseline" ]; then
    bad "нет снимка: $baseline"
    return 2
  fi
  # Имена из снимка для этого файла.
  local base_names now_names
  base_names="$(grep -F "$target :: " "$baseline" | sed "s|^.* :: ||" || true)"
  # Имена, которые файл ВЫДАЁТ сейчас. Пофайлово намеренно: полный
  # `vitest list` обрывается на первой ошибке сборки в любом чужом файле.
  now_names="$(cd "$ROOT" && npx vitest list "$target" 2>/dev/null \
    | sed "s|^.*$(basename "$target") > ||" | sed "s| > | |g" || true)"
  local nb nn
  nb="$(printf '%s\n' "$base_names" | grep -c . || true)"
  nn="$(printf '%s\n' "$now_names" | grep -c . || true)"
  echo "  снимок: $nb   файл сейчас: $nn"
  if [ "$nb" -eq 0 ]; then
    skip "в снимке нет записей об этом файле — сравнивать нечего"
    return 0
  fi
  if [ "$nn" -eq 0 ]; then
    bad 'файл не выдал НИ ОДНОГО теста — он не собирается (см. tri in-gate)'
    return 1
  fi
  # ПРОПАВШИЕ имена: есть в снимке, файл их больше не производит.
  local gone
  gone="$(comm -23 <(printf '%s\n' "$base_names" | sort -u) \
                   <(printf '%s\n' "$now_names" | sort -u))"
  local ng
  ng="$(printf '%s\n' "$gone" | grep -c . || true)"
  if [ "$ng" -eq 0 ]; then
    good 'все имена снимка файл по-прежнему производит'
    echo '  Значит краснота — про ПОВЕДЕНИЕ: тест существует и падает.'
    return 0
  fi
  # ОТКЛЮЧЁННЫЙ ТЕСТ ВЫГЛЯДИТ КАК УДАЛЁННЫЙ, но лечится наоборот.
  #
  # `vitest list` НЕ печатает пропущенные тесты (проверено: файл с шестью
  # тестами после одного it.skip выдаёт пять, exit 0). Значит по одному списку
  # «отключён» и «переименован» неразличимы — и первая версия этой команды
  # уверенно называла отключение переименованием и советовала обновить снимок.
  # Совет разрушительный: он впечатывает выключенный тест в базу как норму и
  # стирает единственный след того, что охрана снята.
  #
  # Различает их ИСХОДНИК: у отключённого теста заголовок никуда не делся, он
  # лежит рядом с маркером skip. У переименованного заголовка в файле нет.
  local disabled renamed nd nr skip_titles
  disabled=""; renamed=""
  # Заголовки тестов, помеченных skip В ЭТОМ ФАЙЛЕ.
  skip_titles="$(grep -oE "(describe|it|test)\\.skip\\(('[^']*'|\"[^\"]*\")" "$ROOT/$target" 2>/dev/null \
    | sed -E "s/^(describe|it|test)\\.skip\\(['\"]//; s/['\"]$//" || true)"
  while IFS= read -r nm; do
    [ -n "$nm" ] || continue
    # Сверяем не с ЦЕЛЫМ файлом, а с ЗАГОЛОВКАМИ пропущенных тестов.
    # Имя в снимке — склейка describe+it через пробел, и в исходнике такой
    # строки нет НИКОГДА: там лежит только листовой заголовок. Поэтому вопрос
    # другой: кончается ли пропавшее имя на заголовок какого-нибудь skip-теста.
    #
    # БЕЗ КОНВЕЙЕРА. Первая версия спрашивала это через `... | grep -q hit`, и
    # под `set -o pipefail` (строка 27) ответ переворачивался: grep выходит по
    # первому совпадению, SIGPIPE убивает while, статус конвейера берётся от
    # него — «нашёл» читалось как «не нашёл». Тот же капкан, что уже стоил
    # самопроверки в tri unguarded.
    local hit=0 st
    while IFS= read -r st; do
      [ -n "$st" ] || continue
      case "$nm" in *"$st") hit=1 ;; esac
    done <<< "$skip_titles"
    if [ "$hit" -eq 1 ]; then
      disabled="$disabled$nm
"
    else
      renamed="$renamed$nm
"
    fi
  done <<< "$gone"
  nd="$(printf '%s\n' "$disabled" | grep -c . || true)"
  nr="$(printf '%s\n' "$renamed" | grep -c . || true)"

  if [ "$nd" -gt 0 ]; then
    bad "$nd имён ОТКЛЮЧЕНЫ (skip), а не удалены — заголовок всё ещё в файле"
    printf '%s' "$disabled" | head -6 | sed 's/^/    - /'
    echo
    echo '  Это СНЯТАЯ ОХРАНА, и снимок обновлять НЕЛЬЗЯ: обновление впечатает'
    echo '  выключенный тест в базу как норму и сотрёт след. Решать так:'
    echo '   1) выясни, почему выключен, и запиши причину рядом со skip;'
    echo '   2) если причина устранима — включи обратно, это дешевле долга;'
    echo '   3) если нет — назови в отчёте, что охрана снята и чего она стоила.'
    [ "$nr" -eq 0 ] && return 1
    echo
  fi

  [ "$nr" -eq 0 ] && return 1
  bad "$nr имён из снимка файл больше НЕ ПРОИЗВОДИТ — снимок устарел"
  printf '%s' "$renamed" | head -6 | sed 's/^/    - /'
  [ "$nr" -gt 6 ] && echo "    ... ещё $((nr - 6))"
  echo
  echo '  Это ПЕРЕИМЕНОВАНИЕ, а не регрессия: такие имена не пройдут никогда,'
  echo '  и перепроверка гейта их не снимет. Лечение по протоколу снимка:'
  echo '   1) сверь, что замена покрывает то же или лучше (сравни имена);'
  echo '   2) node scripts/test-gate.cjs --save;'
  echo '   3) сверь diff снимка — удалиться должны ТОЛЬКО ожидаемые имена;'
  echo '   4) скажи об этом в отчёте. Молча обновлять снимок нельзя.'
  return 1
}

cmd_why_red_selfcheck() {
  # ЛИНЕЙКУ ПРОВЕРЯЕМ НА РЕАЛЬНОМ СЛУЧАЕ, а не на выдуманном.
  #
  # ad207845b — снимок ДО того, как PR #1496 переписал voiceValidation, и он
  # обязан дать 14 пропавших имён. Текущий снимок обязан дать ноль. Проверка,
  # отвечающая одинаково на оба, ничего не проверяет.
  local f='src/__tests__/helpers/voiceValidation.test.ts'
  local old_snap="/tmp/tri-why-red-old-baseline.txt"
  if ! git -C "$ROOT" show ad207845b:.test-baseline.txt > "$old_snap" 2>/dev/null; then
    warn 'самопроверка пропущена: исторический снимок ad207845b недоступен'
    return 0
  fi
  local rc=0
  if cmd_why_red "$f" "$old_snap" >/dev/null 2>&1; then
    bad 'СЛОМАНА: на старом снимке пропавших имён не найдено'
    rc=1
  else
    good 'на снимке до PR #1496 пропавшие имена найдены'
  fi
  if cmd_why_red "$f" >/dev/null 2>&1; then
    good 'на текущем снимке пропавших имён нет'
  else
    bad 'СЛОМАНА (или снимок снова устарел): на текущем снимке есть пропавшие'
    rc=1
  fi
  # НОВАЯ ПОЛОВИНА: отличает ли команда ОТКЛЮЧЁННЫЙ тест от переименованного.
  #
  # Проверяется БЕЗ правки файлов: синтетический снимок утверждает, что тест,
  # который сейчас помечен skip, когда-то был зелёным. Тогда имя «пропадает»,
  # и команда обязана назвать это снятой охраной, а не устаревшим снимком.
  # Обратный случай — имя, которого в файле нет вовсе, — обязан остаться
  # переименованием.
  local sk_file='src/__tests__/utils/buttonMapping.test.ts'
  local sk_title syn
  sk_title="$(grep -oE "(describe|it|test)\\.skip\\('[^']*'" "$ROOT/$sk_file" 2>/dev/null \
    | head -1 | sed -E "s/^(describe|it|test)\\.skip\\('//; s/'$//")"
  if [ -z "$sk_title" ]; then
    warn 'самопроверка отключения пропущена: не нашёл skip-теста для образца'
  else
    syn=/tmp/tri-whyred-synthetic.txt
    printf '%s :: SYNTHETIC %s\n' "$sk_file" "$sk_title" > "$syn"
    # Вывод СНАЧАЛА в переменную: cmd_why_red возвращает 1, когда находит
    # пропажу, и под pipefail конвейер отдал бы её статус, а не grep-а.
    local out_disabled out_renamed
    out_disabled="$(cmd_why_red "$sk_file" "$syn" 2>&1 || true)"
    if printf '%s' "$out_disabled" | grep -q 'ОТКЛЮЧЕНЫ'; then
      good 'отключённый тест назван снятой охраной, а не устаревшим снимком'
    else
      bad 'СЛОМАНА: отключённый тест по-прежнему выдаётся за переименование'
      rc=1
    fi
    printf '%s :: SYNTHETIC no-such-title-exists-anywhere\n' "$sk_file" > "$syn"
    out_renamed="$(cmd_why_red "$sk_file" "$syn" 2>&1 || true)"
    if printf '%s' "$out_renamed" | grep -q 'ПЕРЕИМЕНОВАНИЕ'; then
      good 'по-настоящему исчезнувшее имя всё ещё зовётся переименованием'
    else
      bad 'СЛОМАНА: исчезнувшее имя перестало опознаваться как переименование'
      rc=1
    fi
    rm -f "$syn"
  fi

  rm -f "$old_snap"
  return "$rc"
}

cmd_wt() {
  # ИНВЕНТАРЬ РАБОЧИХ ДЕРЕВЬЕВ. Только отчёт: репозиторий общий с форком и
  # другими агентами, поэтому чужое дерево не удаляем -- печатаем.
  #
  # Зачем: устаревшее дерево однажды стало отдавать ЛОЖНУЮ красноту гейта --
  # 18 файлов перестали читаться, и прогон отчитался о регрессии, которой не
  # было. Час ушёл на доказательство.
  #
  # Столбца "влито" здесь НЕТ, и это решение, а не упущение. Все PR влиты
  # СКВОШЕМ, поэтому ни ancestry, ни трёхточечный diff на вопрос не отвечают,
  # а сравнение содержимого путает "влито и дополнено" с "не влито": ветка,
  # дописавшая строку в файл, который с тех пор вырос, выглядит неслитой.
  # Печатать неверный ответ хуже, чем не печатать никакого.
  local main_wt
  main_wt=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
  printf '%-42s %-28s %s\n' "tree" "branch" "state"
  git worktree list --porcelain | awk '
    /^worktree /{wt=$2}
    /^branch /{br=$2; sub("refs/heads/","",br); print wt"\t"br}
  ' | while IFS=$'\t' read -r wt br; do
    [ "$wt" = "$main_wt" ] && continue
    local state
    if [ ! -d "$wt" ]; then
      state="КАТАЛОГА НЕТ -- git worktree prune"
    elif [ -n "$(cd "$wt" && git status --porcelain 2>/dev/null | grep -v '^??')" ]; then
      state="есть правки"
    else
      state="чисто"
    fi
    printf '%-42s %-28s %s\n' "$(basename "$wt")" "$br" "$state"
  done
  echo
  echo "  Чистое дерево держать незачем: вердикт гейта берите со СВЕЖЕГО."
  echo "  Убирать своё: git worktree remove <путь>"
}

cmd_trust_all() {
  # ТО ЖЕ, НО ПО ВСЕМ РАБОЧИМ ДЕРЕВЬЯМ СРАЗУ.
  #
  # Написано потому, что деградацию не удаётся вызвать по заказу, а значит
  # единственный способ её застать -- смотреть на все деревья, когда она
  # случается. Первый же прогон дал ОТРИЦАТЕЛЬНЫЙ результат, и он ценен:
  # 25 деревьев из 25 здоровы, включая самые старые. Значит порча НЕ
  # накапливается со временем и НЕ остаётся навсегда -- она проходит сама.
  # Это уточняет вывод it.128 («дерево портится не при создании»).
  local smoke='src/__tests__/inngest/stuckTrainingAgeUnknown.test.ts'
  local bad=0 total=0
  while IFS= read -r w; do
    [ -d "$w" ] || continue
    total=$((total + 1))
    if [ ! -e "$w/node_modules" ]; then
      printf '  %-46s %s\n' "$(basename "$w")" "нет node_modules"
      bad=$((bad + 1)); continue
    fi
    local out
    out=$(cd "$w" && npx vitest list "$smoke" 2>&1)
    if printf '%s' "$out" | grep -qiE 'cannot find|error|failed'; then
      printf '  %-46s %s\n' "$(basename "$w")" "ДЕГРАДИРОВАНО"
      printf '%s\n' "$out" | head -3 | sed 's/^/        /'
      bad=$((bad + 1))
    else
      printf '  %-46s %s\n' "$(basename "$w")" "ok"
    fi
  done < <(cd "$ROOT" && git worktree list | awk '{print $1}')
  echo
  echo "деревьев: $total, деградировавших: $bad"
  [ "$bad" -eq 0 ] || return 1
}

cmd_trust() {
  # ГОДНО ЛИ ЭТО ДЕРЕВО, ЧТОБЫ ВЕРИТЬ ЕГО ГЕЙТУ.
  #
  # Рабочее дерево иногда перестаёт резолвить встроенные модули через
  # vite-node: файлы не перечисляются, и гейт докладывает регрессию, которой
  # нет. Причина за четыре итерации не найдена; опровергнуты содержимое, общий
  # кэш `.vite`, порядок прогонов, версии, набор файлов на диске и путь.
  #
  # Но главное выяснилось иначе: дерево портится НЕ при создании. Оно проходит
  # пробу в `tri worktree` и деградирует позже -- значит одноразовой проверки
  # мало, и нужна та, которую можно позвать в любой момент, ПЕРЕД тем как
  # поверить вердикту.
  #
  # НЕСКОЛЬКО проб, а не одна. Померено it.138: порча детерминирована для
  # ПАРЫ (дерево, файл) -- в одном и том же дереве один файл не перечисляется
  # трижды из трёх, а другой проходит трижды из трёх. Пока проба была одна,
  # эта команда отвечала «годно» про дерево, где другие файлы стабильно
  # падали: вопрос был уже названия, а популяция -- один файл.
  # Четвёртая проба ОБЯЗАНА импортировать модуль приложения, а не читать
  # исходник текстом. Три первых читают текст и импортируют только fs/path --
  # то есть ровно ту половину, которая не ломалась НИКОГДА. Из-за этого trust
  # печатал «дереву можно верить» на деревьях, где сбор падал (it.155:
  # голый 'stream' вместо 'node:stream' разрешался относительно корня дерева).
  # staffListResolution тянет @/navigation, чья бочка доходит до сервисов.
  local smokes=(
    'src/__tests__/inngest/stuckTrainingAgeUnknown.test.ts'
    'src/__tests__/security/webhookSecretToken.test.ts'
    'src/__tests__/money/paidServicesTableUnread.test.ts'
    'src/__tests__/navigation/staffListResolution.test.ts'
  )
  local present=()
  local f
  for f in "${smokes[@]}"; do
    [ -f "$ROOT/$f" ] && present+=("$f")
  done
  if [ "${#present[@]}" -eq 0 ]; then
    bad "ни один пробный файл не найден"
    echo "   Обновите список smokes в cmd_trust."
    return 2
  fi
  # Capture FIRST, test after. `npx vitest | grep -q` inside this script is a
  # trap: tri runs under pipefail, vitest exits non-zero when the probe file
  # collects nothing, and pipefail hands that failure to the `if` even though
  # grep matched -- so the check reported a degraded tree as healthy. The first
  # version of this command did exactly that, and it was caught by comparing it
  # against the same command typed by hand.
  local out failed=()
  for f in "${present[@]}"; do
    out=$(cd "$ROOT" && npx vitest list "$f" 2>&1)
    printf '%s' "$out" | grep -q 'Cannot find module' && failed+=("$f")
  done
  if [ "${#failed[@]}" -gt 0 ]; then
    bad "дереву верить НЕЛЬЗЯ: vite-node не резолвит встроенный модуль"
    for f in "${failed[@]}"; do echo "   не перечисляется: $f"; done
    echo "   Вердикт гейта здесь будет про окружение, а не про код."
    echo "   Возьмите вердикт из основного чекаута или сделайте новое дерево."
    return 1
  fi
  good "дерево годно: ${#present[@]} пробных файла перечисляются, гейту можно верить"
}

cmd_timers() {
  # ТАЙМЕРЫ С ASYNC-КОЛБЭКОМ И ДВЕ РАЗНЫЕ ОПАСНОСТИ.
  #
  # ПЕРЕКРЫТИЕ -- только у `setInterval`: он не ждёт, и медленный тик
  # запускается рядом с самим собой. Для кода, который читает пачку, действует
  # и помечает потом, второй проход переделывает работу первого -- так очередь
  # уведомлений слала сообщение дважды (#1803).
  #
  # ТИХАЯ ПОТЕРЯ -- у любого async-таймера: процесс переживёт reject (сеть
  # натянута), а работа пропадёт без следа.
  #
  # Обработка -- это НЕ только `try`: цепочка, кончающаяся `.catch(...)`,
  # защищена не хуже. Первая версия считала только `try` и обвинила четыре
  # поздравительных сообщения, каждое из которых кончается `.catch(() => {})`.
  # И охрана перекрытия пишется по-разному: `checkInFlight` мимо шаблона
  # `inFlight` -- матчер знал одно написание и докладывал написание, а не суть.
  ( cd "$ROOT" && node scripts/probe-timers.cjs )
}

cmd_optional() {
  # ОТКАЗ, СТОЯЩИЙ ЗА НЕОБЯЗАТЕЛЬНЫМ ПАРАМЕТРОМ, -- ЭТО ОТКАЗ ПО ЖЕЛАНИЮ.
  #
  # Форму назвал `assertPublicRedirect`: сторож редиректов бросал только
