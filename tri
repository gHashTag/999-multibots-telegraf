MOUTH_SVC=2455209b-6611-4814-bb55-7d3b5d994656
cmd_ears() {
  local p=564d9ebd-7aa8-44fe-93ec-e0b03c87158d e=e4d200ad-b8a9-4edf-9b25-190a32613b32
  local action=status langs='ru en mouth' a
