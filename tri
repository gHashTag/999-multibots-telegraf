          f'[{min(times)}..{max(times)}]{split} -- '
          f'{"SLOW (the person waits this after speaking)" if slow else "ok"}')
    mark(2 if slow else 0)
    if END_MS:
        hidden = min(med, END_MS - EAGER_MS) if EAGER_MS else 0
        print(f'    felt after the last word: pause {END_MS} + words {med - hidden}'
              f' = {END_MS + med - hidden} ms'
