        # going bad, not one unlucky sample.
        many = len(missed) * 3 >= len(missed) + len(times)
        print(f'  round trip {lang}: {len(missed)} of {len(missed) + len(times)} clips misheard, '
              f'e.g. "{missed[0][:50]}" -- {"CHECK the voice and the ears" if many else "one noisy sample, not a fault"}')
