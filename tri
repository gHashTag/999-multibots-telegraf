held = caught = finished = unfinished = 0
for path in sys.argv[1:]:
    name = os.path.basename(path)
    # Trim the file's own trailing quiet (-50 dB), then add exactly ours.
    wav = subprocess.run(['ffmpeg', '-nostdin', '-v', 'error', '-i', path, '-af',
        f'areverse,silenceremove=start_periods=1:start_threshold=-50dB,areverse,apad=pad_dur={pause / 1000}',
