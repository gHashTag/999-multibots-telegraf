  # IDEMPOTENT / SETTLEMENT. A credit with NONE is a mint suspect. The TON CAS
  # (#1555) was found via a sibling tri flag; this generalises it to every credit.
  # INVENTORY, never a gate (exit 0): a "review" hint is heuristic -- the guard
  # may live in the caller/router (a signed mount, a caller allowlist). Read each.
  ( cd "$ROOT" && node "$TOOLS/mint-audit.mjs" "$@" )
}

cmd_stepjump() {
  # Inventory of ctx.wizard.selectStep sites and the selectStep(N)+next()
  # off-by-one that SKIPS Step N (next() = selectStep(cursor+1)). Broke the
  # resume-after-voice flow in veed-fabric (#1565, fixed) and ai-reels-wizard
  # (owner task_2602e027, its Step 2 charges). Correct pattern: selectStep(N)
  # then direct-invoke steps[cursor](ctx). INVENTORY, never a gate (exit 0).
