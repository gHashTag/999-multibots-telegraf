#!/usr/bin/env bash
#
# tri — один вход ко всей оснастке цикла.
#
# ЗАЧЕМ ЭТО ЕСТЬ. В .claude/loop-opus/ лежит одиннадцать скриптов, и каждый
# виток я звал их полными путями с приставкой PATH=…/node. Дело не только в
# скорости: длинную команду не запоминают, а незапомненную проверку не делают.
#
# ЧЕМ ЭТО ОТЛИЧАЕТСЯ ОТ ОБЁРТКИ. Половина команд здесь — не переименованные
# старые скрипты, а УРОКИ, ставшие исполнимыми. Каждый записан в скилле словами
# и каждый стоил цикла:
#
#   tri кто     ← «признак живого маршрута — его собственное сообщение,
#                  а не статус 401». Стоило четырёх циклов.
#   tri в-tsc   ← «ноль ошибок означал „не проверено“, а не „верно“».
#   tri жив     ← «три правки легли туда, что никто не рендерит».
#   tri мутация ← «зелёная мутация — это отчёт о дыре в покрытии».
#   tri выложен ← «мерж не равен выкладке», и сравнивать надо ПОСЛЕ fetch,
#                  иначе ворота дают ложную тревогу.
#
# Записанное словами надо вспомнить. Команду — набрать. Разница решает.
#
# ИМЕНА. Подкоманды по-русски: их читает человек. Переменные и функции —
# латиницей, потому что кириллица в имени переменной bash даёт
# «command not found» без объяснения причины. Оплачено дважды.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS="$ROOT/.claude/loop-opus"

# node 20 из nvm: системный 18 ломает Vite и половину прогонов.
#
# ПУТЬ БЫЛ МЁРТВ. Стояло /Users/playom/… — опечатка в имени пользователя
# (playra). Каталога нет, PATH молча игнорировал запись, и tri всё это время
# работал на том node, который подвернётся (v22 из Homebrew) — то есть
# «закрепление версии» ничего не закрепляло. Тот же класс опечатки уже ловили
# в verify-landed.mjs, но здесь он остался.
#
# Теперь: ищем нужную версию у ТЕКУЩЕГО пользователя и добавляем её, только
# если каталог существует. Несуществующий путь в PATH — это не подстраховка,
# а тишина вместо ошибки.
_nvm20="$HOME/.nvm/versions/node/v20.19.0/bin"
[ -d "$_nvm20" ] && export PATH="$_nvm20:$PATH"
export PATH="/opt/homebrew/bin:$PATH"

RENDER="${TRI_RENDER_URL:-https://vibee-render-production.up.railway.app}"

paint() { printf '\033[%sm%s\033[0m\n' "$1" "$2"; }
good() { paint '32' "  OK   $1"; }
bad()  { paint '31' "  ✗    $1"; }
warn() { paint '33' "  ⚠    $1"; }

# THE THIRD OUTCOME NEEDS ITS OWN COLOUR, or it gets spent as one of the two.
#
# «Не измерено» was printed with warn() — yellow, and yellow next to green reads
# as «green with a remark». Cyan «?» is not a shade of either, so a reader
# cannot round it off. The counting is what actually decides the verdict (see
# cmd_gate), but a state nobody can see is a state nobody acts on.
skip() { paint '36' "  ?    $1"; }

# IS THE FACTORY ALIVE -- answered by AGE, not by the presence of a field.
#
# On 2026-08-29 the pipeline stood still for 51 hours while the regression check
# kept printing a clean run: it tested `lastPostAt` for existence (a boolean
# stays true forever) and threw away the token balance that had actually stopped
# it. This is a separate command so the answer is one line, available BEFORE the
# work rather than after.
factory_fact() {
  # THE FEED IS THE TRUTH, THE LOCAL FILE IS A HINT.
  #
  # This read loop/state.json only -- and that file is written by whichever
  # LOOP_DIR the last run used. Test runs use a temp dir, and the production
  # daemon writes inside its own container, so the repo copy goes stale and this
  # command reported a 52.9-hour stall on a day with three published reels. It
  # was making exactly the mistake it was built to catch: trusting a local
  # artefact instead of the record of what actually happened.
  local newest
  newest=$(curl -s -m 20 "$RENDER/api/feed?page=0&limit=1&sort=recent" \
    | python3 -c "
import sys, json
from datetime import datetime, timezone
try:
    t = json.load(sys.stdin).get('templates', [])
except Exception:
    print(''); raise SystemExit
if not t:
    print(''); raise SystemExit
raw = str(t[0].get('createdAt', ''))
# '2026-08-29 04:28:41.2+00' -> ISO: space to T, offset needs its colon.
iso = raw.replace(' ', 'T')
if len(iso) > 3 and (iso[-3] == '+' or iso[-3] == '-'):
    iso += ':00'
try:
    age = (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds() / 3600
except Exception:
    print(''); raise SystemExit
print(f\"{age:.1f}|{str(t[0].get('name',''))[:44]}\")
" 2>/dev/null)

  if [ -z "$newest" ]; then
    warn 'лента не ответила — судить о фабрике нечем (это НЕ «всё хорошо»)'
    return 1
  fi
  local age name
  age=${newest%%|*}
  name=${newest#*|}
  # Compare without bc: strip the fraction.
  local whole=${age%%.*}
  if [ "${whole:-99}" -le 8 ]; then
    good "last post ${age}h ago — «${name}»"
    return 0
  fi
  bad "FACTORY STALLED: ${age}h with no post — «${name}»"
  paint '31' '       check: autopilot daemon (AUTOPILOT_LOOP), tokens, topic queue'
  return 1
}

usage() {
  cat <<'СПРАВКА'
tri — loop tooling. Lessons that became commands.

Command names are ENGLISH. The former Russian names still work as aliases, so
scripts, skills and journal entries written earlier keep running: renaming
without an alias would break work that already exists.

CHECKS THAT EACH COST A CYCLE
  tri who <path> [method] [body]
        Hit a route and say WHO answered: the global guard or the route itself.
        A 401 means nothing on its own -- only the vocabulary in the body does.
        Example: tri who /api/auth/pair/claim POST '{"code":"123456"}'

  tri in-tsc <file> [tsconfig]
        Is the file part of the tsc program. Zero errors in a file that is not
        in the program means "not checked", not "correct".

  tri alive <string> <build dir>
        Is the string in the BUILT chunks. Searches all of them, not just the
        index: a component usually lands in a lazy chunk, so searching index
        lies.

  tri mutate <file> <from> <to> <test>
        Break it, run the test, expect red, revert, expect green. A test that
        does not go red when you break the code checks nothing.

  tri deployed
        Does the version in production match origin/main.

  tri diverged
        How far the current branch has diverged from origin/main. Work is based
        on origin/main, not on the local HEAD.

  tri worktree <branch>
        Make a PRIVATE checkout off origin/main and symlink every node_modules
        (root AND the per-app ones: render/player/vibee-atoms) from the main
        tree, so `bun run verify` runs green immediately instead of false-failing
        on env-gaps. Prints the path on the last line:
          wt="$(tri worktree fix/my-thing | tail -1)"; cd "$wt"

  tri price <ModeName>
        Print the STATIC base cost of a mode from BASE_COSTS before you treat an
        "unbilled paid path" as a defect. A mode absent from BASE_COSTS (AiChat)
        or set to 0 (ChatWithAvatar) is free-by-design -- charging it is not a
        fix, it writes 0-value payment rows. Dynamic costs (steps, answerAi
        response.cost) are NOT shown -- read those paths directly.

  tri money-base <usdCost> [markup]
        Evaluate BOTH star-cost helpers for a USD cost so you never hand-guess a
        money base. calculateFinalImageCostInStars = ceil(usd*interestRate/starCost);
        calculateFinalPriceInStars = floor(usd/starCost*markup). Constants read from
        src/price/constants. A refund and its charge can use DIFFERENT helpers whose
        bases diverge by rounding -- match the CHARGE's helper (learned via #1263).
        NOTE: serviceBase is the THEORETICAL calculateFinalImageCostInStars(usd);
        a service may hardcode a different costPerImage (nano_banana=5) -- a false
        DIVERGE. Verify the real source costPerImage, not the formula (#1271).

  tri batch-refunds
        Audit which aiPhotoshop ALL_MODELS batch services forward the exact charge
        (chargedCostOverride) so a failure refunds what was charged. MISSING means
        the service refunds its own base -- a loss when that base diverges from the
        batch-charge base (check with tri money-base). Regression guard for #1267.

  tri idempotency-keys
        Advisory: list inv_id / idempotencyKey sites and flag non-deterministic
        keys (Date.now/random/uuid) that defeat a UNIQUE backstop -- a duplicate
        or retry can never be rejected (#1298 promo star-mint). A flag is OK only
        if the intent is unique-per-payment, not dedup (reward/bonus/refund).

  tri sweep <symbol>
        Class-sweep helper: list every `await <symbol>(` call-site by layer
        and flag the ones that DISCARD the result. Use when a point-fix lands
        to find its siblings. A flagged site is a hypothesis -- read it.

  tri ratchets | tri линейки
        Run every gated safety-class ratchet in one shot, by exit code
        (double-charge / scene-id / unbilled-paid / OOM / cross-bot). Names
        each class + its file. The loop's fast pre/post-work safety check.

  tri guards | tri стражи
        Run the loop-fable invariant ratchets (guards.mjs) as one exit-code
        run -- the per-iteration regression check after syncing main. Each
        loop-fable fix pins its bug here (33 and counting). --list shows files.

  tri ratchet-audit | tri аудит-линеек
        Meta-check the guards: does each STRUCTURAL ratchet have a self-check
        (detector can fire) and a floor (fails loud if the target is gutted)?
        A ratchet that can only pass is a false ruler. Behavioral tests exempt.

  tri fn-liveness | tri живость-функций
        The complement of ratchet-audit for BEHAVIORAL ratchets: is the fn each
        one imports+calls still LIVE (referenced by >=1 production file outside
        its def)? A 0 is a "ratchet on a dead twin" (the #1572 class) -- a
        vacuous green. Verify, then delete fn+ratchet or move the invariant.
        --self-check proves the predicate against known truth first.

  tri timeouts | tri таймауты
        List axios calls with no timeout (default is infinite), split
        likely-LIVE vs likely-DEAD. Triage, not fix-all: bound only the ones on
        a live CHARGED path whose refund fires solely on a throw (a silent hang
        there is charged-not-delivered). Most others are non-charged/dead.

  tri inflight | tri блокировка
        List scene .action handlers that reach a charge primitive but set no
        *InProgress guard -- a double-tap can re-enter and double-charge (the
        iter204 aiPhotoshop-upscale class). Triage: a hit may sit behind a
        shared guarded choke fn or not be double-tappable. Read each.

  tri leaks | tri утечки
        List files that saveFileLocally() but never unlink -- a per-call
        temp-file leak (the iter206 fluxKontextPro class). Triage: a hit may
        deliver via the file (clean up after) or via a remote url (pure waste).

  tri replay | tri повтор
        Inventory of paid .action BUTTON handlers + the guard each has against a
        stale-persistent-button replay (upscale_image #1551, ai_photoshop_-
        upscale_last #1553, upscale_neurophoto_image (iter213)). Shows CONSUME- /
        LEAVE- / INFLIGHT-ONLY / UNGUARDED. Triage, not a gate: in-flight alone
        does NOT stop a LATER re-tap; a handler is safe if its target changes
        each tap. Read each flagged handler.

  tri mint | tri минт
        Inventory of every credit call (MONEY_INCOME balance mutation) + the
        protection its enclosing fn carries: REFUND / TRANSFER / SIGNED / CAS /
        ADMIN / IDEMPOTENT / SETTLEMENT. A credit with NONE is a mint suspect.
        Triage, not a gate: the guard may live in the caller/router. Read each.

  tri stepjump | tri шаг
        Inventory of ctx.wizard.selectStep sites + the selectStep(N)+next()
        off-by-one that SKIPS Step N (next = selectStep(cursor+1)). Broke the
        veed-fabric resume (#1565); ai-reels twin is owner (charge step). Fix:
        selectStep(N) + direct-invoke steps[cursor](ctx). Triage, not a gate.

  tri charge | tri заряд
        Completeness check for the double-charge class (#1358): lists every
        scene that CHARGES money and whether it is guarded / safe / a tracked
        gap (#1372) / UNCLASSIFIED. Non-zero exit on any unclassified scene.
        Reads the classification from the vitest ratchet so it never drifts.

  tri wired <SymbolName>
        Is a handler wired or dead? Lists every src reference and flags the ones
        on commented-out lines (the shape of dead wiring, e.g. a handler whose
        only bot.on() registration is commented). Reports facts to READ, not a
        verdict: it sees `//` comments only, NOT block comments, if(false),
        feature flags, or examples-only modules.

  tri real <name>
        Does the feature work on the WEB before carrying it into the app.
        Looks at: does the server route exist, does the button have its own
        handler, is the counter a literal. Porting something broken reproduces
        the decoration and records parity with it.

  tri gate
        Run what CI should have run: types, tests, the iOS build, Cyrillic.
        Not an equal substitute -- one machine, one Node, one Xcode -- but
        better than nothing while Actions are unpaid.

        THREE outcomes, and the EXIT CODE carries them:
          0  every section ran, nothing failed
          1  a section FAILED -- do not merge
          2  nothing failed, but a section COULD NOT MEASURE (marked «?»)
        2 is not a pass. A missing tool, a missing node_modules, an unreadable
        diff: each of those used to print a yellow warning and let the run end
        on the green line with exit 0, which is how the iOS build stayed
        unbuilt for a hundred iterations while the gate said all clear. So
        `tri gate && …` now stops on 2 too -- deliberately.

        Section 3 needs xcodegen (brew install xcodegen). Without it the iOS
        build is reported as not measured, never as passing.

  tri ci
        Is CI running at all. A run that fails in seconds with zero steps is an
        infrastructure refusal, not a signal about the code: everything merged
        was merged blind.

  tri colors [dir]
        Literal colours and font sizes in Swift that bypass Theme.swift.
        Catches the LITERAL, not the mention: .system(size: 14) yes,
        .system(size: Theme.Size.xs) no -- that is a token in use.
        A design system leaks one literal per edit, not all at once.

  tri colors check
        Run the pattern against a built-in sample: it must find 10 literals and
        skip 9 tokens. Silence over the tree does NOT prove health -- a dead
        pattern is silent too, which has already happened here.

LOOP TOOLING
  tri lock | tri unlock   take or release the iteration lock
  tri in-gate <file>      Does the GATE actually collect this test? A suite that
                          never ran cannot regress, so a green gate proves
                          nothing about a file it never loaded -- that is how a
                          new test once passed without executing once. Zero
                          collected tests means either the config excludes it or
                          an import failed to resolve (in a worktree: unlinked
                          sub-app node_modules); the two are reported apart
                          because they are fixed differently.
  tri in-gate-check       Can `tri in-gate` still fail? Runs it against a file
                          the gate must see AND one it must not.
  tri disk [reap]         DATA-volume usage + self-heal. Reports stale worktrees
                          and DEAD-session scratch (0 open handles AND mtime>1d;
                          liveness is judged by OPEN HANDLE, not mtime -- a
                          week-idle 31G scratch was a LIVE vvp sim). `tri disk
                          reap` frees the dead ones. Big OWNER eaters (Docker,
                          Caches, Simulators, DerivedData) are named, never
                          touched -- deleting their data is the owner's call.
  tri scan                anomalies, and what is waiting on the owner
  tri scan-check          Can `tri scan` still fail? Stands up a local server,
                          feeds the checker deliberately broken payloads and
                          asserts every alarm fires. "0 anomalies" on prod does
                          NOT prove health: a detector that stopped detecting
                          prints exactly the same line. Both defects found in
                          anomalies.mjs on 2026-08-29 had looked green.
  tri panel               rebuild the dashboard
  tri tests               the full run
  tri routes              client and server addresses, compared
  tri health              the render service /health in one line
  tri factory             Is the content factory alive, answered by the AGE of
                          the last post rather than the presence of a field.
                          On 2026-08-29 the regression check reported clean while
                          the pipeline had been stopped for 51 hours, because it
                          tested lastPostAt for existence, not for staleness.

OTHER
  tri lesson <title>      append a lesson to the skill (body read from stdin)
  tri help
СПРАВКА
}

# ─────────────────────────────────────────────────────────────────────────
# КТО ОТВЕТИЛ. Самая дорогая ошибка этого репозитория — теперь одна команда.
#
# Гвард и маршрут отвечают ОДНИМ И ТЕМ ЖЕ статусом 401. Отличить их можно
# только по словарю в теле. Четырежды я принимал отказ гварда за ответ своего
# маршрута — и однажды выложил в прод два маршрута, которые нельзя вызвать.
# ─────────────────────────────────────────────────────────────────────────
cmd_who() {
  local route="${1:?нужен путь, например /api/auth/pair/claim}"
  local verb="${2:-POST}"
  local payload="${3:-{\}}"

  local raw status body
  raw=$(curl -s -m 25 -X "$verb" "$RENDER$route" \
          -H 'Content-Type: application/json' \
          ${payload:+-d "$payload"} -w '\n%{http_code}' 2>/dev/null)
  status=$(printf '%s' "$raw" | tail -1)
  body=$(printf '%s' "$raw" | sed '$d')

  printf '  %s %s → %s\n' "$verb" "$route" "$status"
  printf '  %s\n' "$(printf '%s' "$body" | head -c 300)"

  # Словарь гварда: эти фразы печатает ТОЛЬКО общая проверка на входе.
  if printf '%s' "$body" | grep -qE 'no X-Api-Key|no Telegram initData|"unauthorized"'; then
    bad 'ответил ГВАРД — до маршрута не дошло'
    # КОНТРОЛЬНАЯ ПРОБА. Отказ гварда НЕ ГОВОРИТ, существует ли маршрут.
    #
    # Найдено разведкой: без ключа сервер отвечает одинаковым 401 и на живой
    # маршрут, и на заведомо выдуманный. То есть прежняя формулировка «его нет
    # в PUBLIC_EXACT» была догадкой, выданной за вывод: путь мог просто не
    # существовать, и совет искать его в списке публичных увёл бы не туда.
    #
    # Поэтому дёргаем заведомо несуществующий путь. Если он отвечает тем же —
    # проба про существование не говорит ничего, и это надо сказать вслух.
    local control
    control=$(curl -s -m 15 -X "$verb" "$RENDER/api/tri-control-$$-does-not-exist" \
                -H 'Content-Type: application/json' -d '{}' 2>/dev/null)
    if printf '%s' "$control" | grep -qE 'no X-Api-Key|"unauthorized"'; then
      paint '31' '       ВНИМАНИЕ: выдуманный путь отвечает тем же отказом.'
      paint '31' '       Значит проба НЕ РАЗЛИЧАЕТ «маршрут закрыт» и «маршрута нет».'
      paint '31' '       Повторите с ключом: curl -H "X-Api-Key: ..." — тогда'
      paint '31' '       несуществующий путь даст 404, а закрытый останется 401.'
    else
      paint '31' '       выдуманный путь отвечает иначе — значит этот маршрут ЕСТЬ,'
      paint '31' '       и его нет в PUBLIC_EXACT (auth.ts).'
    fi
    return 1
  fi
  if [ -z "$body" ]; then
    warn 'пустое тело — сказать нечего, проверьте адрес и метод'
    return 2
  fi
  good 'ответил САМ МАРШРУТ — он жив'
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
# ВХОДИТ ЛИ ФАЙЛ В ПРОГРАММУ TSC.
# Однажды я влил файл, который не импортировал никто: tsc его не видел, и ноль
# ошибок означал «не проверялось». Внутри было обращение к несуществующему полю.
# ─────────────────────────────────────────────────────────────────────────
cmd_in_tsc() {
  local target="${1:?нужен путь к файлу}"

  # ТРЕТИЙ ИСХОД. Раньше несуществующему файлу эта команда отвечала «НЕ в
  # программе» — то есть выдавала отсутствие данных за отрицательный ответ.
  # Тот же изъян, что у ворот, принявших пропавший node_modules за красные
  # тесты, и у проверки живости, совпавшей на подстроке.
  if [ ! -f "$target" ]; then
    warn "файла $target нет — померить нечего"
    paint '33' '       Это НЕ «не в программе»: данных просто не получено.'
    return 3
  fi
  local conf="${2:-}"
  local base; base="$(basename "$target")"
  local here; here="$(cd "$(dirname "$target")" && pwd)"

  if [ -z "$conf" ]; then
    local walk="$here"
    while [ "$walk" != "/" ]; do
      if [ -f "$walk/tsconfig.json" ]; then conf="$walk/tsconfig.json"; break; fi
      walk="$(dirname "$walk")"
    done
  fi
  require_fresh || return 3
  [ -f "$conf" ] || { bad 'tsconfig не найден'; return 1; }

  printf '  конфиг: %s\n' "$conf"
  local hits
  # Считаем ВЕСЬ вывод, а не только совпадения: пустой список файлов означает,
  # что tsc не отработал вовсе, и тогда ноль совпадений ничего не доказывает.
  local listing
  listing=$(cd "$(dirname "$conf")" \
    && npx tsc -p "$conf" --noEmit --pretty false --listFiles 2>/dev/null)
  if [ -z "$listing" ]; then
    warn 'tsc не выдал списка файлов — померить не удалось'
    paint '33' '       Проверьте, что зависимости на месте и конфиг читается.'
    return 3
  fi
  hits=$(printf '%s' "$listing" | grep -c "/$base$")

  if [ "${hits:-0}" -gt 0 ]; then
    good "$base В программе — ноль ошибок здесь что-то значит"
  else
    bad "$base НЕ в программе — ноль ошибок не значит ничего"
    paint '31' '       include его не тянет, и никто его не импортирует'
    return 1
  fi
}

# ─────────────────────────────────────────────────────────────────────────
# ОТКАЗ МЕРИТЬ ПО УСТАРЕВШЕЙ КОПИИ.
#
# Найдена первопричина семи подряд «померил не тот артефакт»: рабочая копия в
# корне репозитория отставала от origin/main на 144 коммита, и файла, который
# искали, в ней не было ВООБЩЕ. grep уверенно отвечал «не найдено» — и был
# формально прав насчёт этой копии, и полностью неверен насчёт мира.
#
# Молчаливый неверный ответ дороже отказа отвечать. Поэтому команды, которые
# меряют локальные файлы, сначала спрашивают, насколько копия свежая.
# ─────────────────────────────────────────────────────────────────────────
require_fresh() {
  local behind
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null || true
  behind=$(git -C "$ROOT" rev-list --count HEAD..origin/main 2>/dev/null)
  [ -z "${behind:-}" ] && return 0          # не git-дерево — мерить нечему мешать

  if [ "$behind" -gt 5 ]; then
    bad "копия отстаёт от origin/main на $behind коммитов"
    paint '31' '       Замер по ней НИЧЕГО не значит: искомого файла может не быть'
    paint '31' '       в этой копии вовсе, и «не найдено» будет ложью.'
    paint '31' "       Мерьте выложенный артефакт или свежее дерево от origin/main."
    # Возврат 3, а не 1: вызывающий отличит «устарело» от «не нашлось».
    return 3
  fi
  [ "$behind" -gt 0 ] && warn "копия отстаёт на $behind коммитов — держите в уме"
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
# ЖИВ ЛИ КОМПОНЕНТ В СБОРКЕ.
# В этом репозитории трижды правили файлы, которые ничто не рендерит:
# AssetBrowser, VerticalTabs, BottomNavigation. И семь раз мерили индексный
# бандл вместо ленивого чанка, где код на самом деле лежит.
# ─────────────────────────────────────────────────────────────────────────
cmd_alive() {
  local needle="${1:?нужна отличительная строка из компонента}"
  local built="${2:?нужен каталог сборки, например apps/vibee-editor/player/dist}"

  require_fresh || return 3
  # Каталог сборки может существовать и быть пустым — тогда «строки нет»
  # означает «нечего искать», а не «код мёртв».
  if [ ! -d "$built" ]; then
    warn "нет каталога $built — померить нечего, соберите сначала"
    return 3
  fi
  if [ -z "$(ls -A "$built" 2>/dev/null)" ]; then
    warn "каталог $built пуст — сборки нет, вывод ничего не докажет"
    return 3
  fi

  local hits
  hits=$(grep -rl -- "$needle" "$built" 2>/dev/null)
  if [ -z "$hits" ]; then
    bad 'строки нет ни в одном чанке — код мёртв или не собран'
    return 1
  fi
  good 'найдено в собранных чанках:'
  printf '       %s\n' $hits
}

# ─────────────────────────────────────────────────────────────────────────
# МУТАЦИЯ. Тест, который не краснеет от поломки, не проверяет ничего.
# Однажды мутация прошла зелёной — и это была не удача, а дыра в покрытии.
# ─────────────────────────────────────────────────────────────────────────
MUT_KEEP=""
MUT_FILE=""
restore_mutation() {
  # Идемпотентно: зовётся и явно после прогона, и ловушкой на выходе.
  if [ -n "${MUT_KEEP:-}" ] && [ -f "${MUT_KEEP:-}" ] && [ -n "${MUT_FILE:-}" ]; then
    cp "$MUT_KEEP" "$MUT_FILE"
    rm -f "$MUT_KEEP"
    MUT_KEEP=""
  fi
}

cmd_mutate() {
  local target="${1:?нужен файл}"
  local from="${2:?что заменить}"
  local to="${3:?на что}"
  local spec="${4:?нужен путь к тесту}"
  [ -f "$target" ] || { bad "нет файла $target"; return 1; }

  # ВНЕ функции, а не local: ловушка срабатывает при выходе из СКРИПТА, когда
  # локальных переменных уже нет. Первая версия падала там с «unbound variable»
  # — восстановление при этом уже произошло, но сообщение выглядело как сбой.
  MUT_KEEP="$(mktemp)"
  MUT_FILE="$target"
  cp "$target" "$MUT_KEEP"
  trap 'restore_mutation' EXIT INT TERM

  if ! grep -qF -- "$from" "$target"; then
    bad "строка «$from» в файле не найдена — мутировать нечего"
    return 1
  fi

  python3 - "$target" "$from" "$to" <<'PY'
import io, sys
path, a, b = sys.argv[1], sys.argv[2], sys.argv[3]
src = io.open(path, encoding='utf-8').read()
io.open(path, 'w', encoding='utf-8').write(src.replace(a, b, 1))
PY

  printf '  сломано, гоняю тест…\n'
  # ТРЕТИЙ ИСХОД, и здесь он опаснее всех.
  #
  # `npx vitest` возвращает ненулевой код и когда тест упал, и когда он НЕ
  # ЗАПУСТИЛСЯ — нет node_modules, не читается конфиг, нет самого файла.
  # Без разбора вывода команда объявила бы «покраснел, как должен» и выдала
  # непроведённую проверку за пройденную. Это ложь в сторону уверенности,
  # то есть худшая из возможных здесь.
  local runout
  runout=$(cd "$ROOT" && npx vitest run "$spec" 2>&1)
  if printf '%s' "$runout" | grep -qE 'MODULE_NOT_FOUND|Cannot find module|No test files found'; then
    bad 'тест НЕ ЗАПУСТИЛСЯ — мутация ничего не проверила'
    paint '31' '       Это окружение, а не код. Поставьте зависимости и повторите.'
    return 3
  fi
  # MATCH FAILURE ONLY.
  #
  # This read `[0-9]+ (passed|failed)`, which vitest prints in BOTH outcomes:
  # "Tests  4 passed" when green and "Tests  1 failed | 3 passed" when red. The
  # negation was therefore true only when there was no summary line at all --
  # a case the previous branch already handles -- so the "mutant survived"
  # verdict was dead code and this command reported success unconditionally.
  # The one command whose entire purpose is catching a surviving mutant could
  # not catch one. Proven 2026-08-29 by mutating a file the chosen test never
  # imports: it still said the test went red.
  if ! printf '%s' "$runout" | grep -qE '[0-9]+ failed'; then
    bad 'тест ПРОШЁЛ на сломанном коде — он проверяет не то, что вы думали'
    paint '31' '       это находка, а не облегчение: покрытия здесь нет'
    return 1
  fi
  good 'тест покраснел, как и должен'

  restore_mutation
  printf '  откатил, гоняю снова…\n'
  if (cd "$ROOT" && npx vitest run "$spec" >/dev/null 2>&1); then
    good 'на целом коде зелено — проверка доказала себя в обе стороны'
    return 0
  fi
  bad 'после отката всё ещё красно — сломано что-то ещё'
  return 1
}

cmd_deployed() {
  # fetch ПЕРЕД сравнением. Без него сравниваем с тем, каким origin/main был на
  # прошлой синхронизации, и получаем ложную тревогу. Уже случалось.
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null \
    || warn 'origin/main не обновлён, сравнение может отставать'

  local live head expected
  live=$(curl -s -m 20 "$RENDER/health" \
    | python3 -c 'import sys,json;print(json.load(sys.stdin).get("version","?"))' 2>/dev/null)
  head=$(git -C "$ROOT" rev-parse --short origin/main 2>/dev/null)

  # COMPARE AGAINST WHAT THIS SERVICE ACTUALLY BUILDS, not the head of main.
  #
  # Railway rebuilds the render service only when a push touched its paths, so a
  # docs commit on top rebuilds nothing -- correctly. Comparing with the head
  # therefore reported "выкладка отстаёт" after every report commit, while the
  # service carried every line that affects it. The identical defect was found
  # and fixed in .claude/loop-opus/anomalies.mjs on 2026-08-29; it lived on here
  # because the two checks were never read side by side.
  expected=$(git -C "$ROOT" log -1 --format=%h origin/main \
    -- apps/vibee-editor/render 2>/dev/null)
  [ -z "$expected" ] && expected="$head"

  printf '  прод: %s | собирается из: %s | origin/main: %s\n' \
    "${live:-нет ответа}" "$expected" "$head"
  if [ -z "$live" ] || [ "$live" = "?" ]; then
    # NOT MEASURED, and the exit code has to say so.
    #
    # This used to warn and fall off the end of the function, which returns 0 --
    # so `tri deployed` reported success having compared NOTHING, the same
    # false green the gate was just cleared of. Found 2026-08-29 by a verifier
    # reading this file while checking a different fix.
    skip 'прод не назвал версию — сверить нечем (НЕ ИЗМЕРЕНО)'
    return 2
  elif [ "${expected#"$live"}" != "$expected" ]; then
    # PREFIX match, not equality: /health reports 7 characters and
    # `git rev-parse --short` gives 8 on this repository, so `=` was false for
    # an up-to-date deploy and this command declared a lag on its very first
    # honest run. anomalies.mjs already compares by prefix for the same reason.
    if [ "$expected" = "$head" ]; then
      good 'выложено то же, что в main'
    else
      good "выложена последняя правка рендера ($expected); main ушёл дальше мимо него"
    fi
    return 0
  elif git -C "$ROOT" merge-base --is-ancestor "$live" origin/main 2>/dev/null; then
    bad "выкладка отстаёт: на проде $live, а рендер собирается из $expected"
    return 1
  else
    bad "на проде $live — этого коммита в main нет"
    return 1
  fi
}

cmd_diverged() {
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null
  local counts behind ahead
  counts=$(git -C "$ROOT" rev-list --left-right --count origin/main...HEAD 2>/dev/null)
  behind=$(printf '%s' "$counts" | cut -f1)
  ahead=$(printf '%s' "$counts" | cut -f2)
  printf '  позади origin/main: %s | впереди: %s\n' "${behind:-?}" "${ahead:-?}"
  if [ "${behind:-0}" -gt 20 ]; then
    bad 'ветка сильно устарела — правку ведите ОТ origin/main'
    return 1
  elif [ "${ahead:-0}" -gt 0 ]; then
    warn "$ahead своих коммитов не выложено"
  else
    good 'в ногу с origin/main'
  fi
}

# ─────────────────────────────────────────────────────────────────────────
# ЛИТЕРАЛЬНЫЕ ЦВЕТА И РАЗМЕРЫ В SWIFT.
#
# Дизайн расползается не разом, а по одному литералу за правку: где-то
# .green вместо акцента, где-то Color.black вместо фона. Каждый по
# отдельности безобиден, вместе — экран, не похожий на веб.
#
# Веб держит значения в :root и потому не расползается. У Swift такого
# места не было; после приведения оно есть — Theme.swift. Эта команда
# показывает, что мимо него всё ещё пишут.
#
# ПОЧЕМУ ШАБЛОН ПЕРЕПИСАН. Первая версия была сломана в ОБЕ стороны, и обе
# поломки измерены, а не предположены.
#
#   Ложь первая — лишнее. Она ловила «.system(size:» целиком и показывала
#   нарушением строку
#       .font(.system(size: Тема.Кегль.xs, weight: .semibold))
#   то есть ровно ИСПОЛЬЗОВАНИЕ токена, ради которого всё затевалось.
#
#   Ложь вторая, хуже — недостающее. В ветку про имена цветов затесался
#   байт 0x08 (настоящий backspace вместо двух знаков «\» и «b»), и вся
#   ветка не совпадала НИ С ЧЕМ. Файл с «Color.black» и «.green» команда
#   объявляла чистым. Проверка «на дереве ноль» этого не видит: молчать
#   умеет и мёртвый шаблон — потому ниже появилась самопроверка.
#
# Теперь ловится ЛИТЕРАЛ, а не упоминание:
#     .system(size: 14)             да — сразу после «size:» стоит цифра
#     .system(size: Тема.Кегль.xs)  нет — там имя токена
#     .green / Color.black          да — системный цвет по имени
#     Тема.Цвет.акцент              нет
#
# «\b» на хвосте имени обязателен: без него «.red» ловит «.reduce(». «\b»
# в голове «Color\(» отсекает «CGColor(red: 0, green: 0, …)» из конвейера
# экспорта — CGColor и UIColor намеренно вне охвата, Тема держит SwiftUI-Color,
# и кадру видео её значение не присвоить. Вернуть охват — убрать «\b» в
# COLORS_INIT, но вместе с ним вернётся и шум.
# ─────────────────────────────────────────────────────────────────────────

# Шаблоны вынесены в переменные, потому что «tri цвета проверка» гоняет
# ИМЕННО ИХ на встроенном образце. Копия разошлась бы с оригиналом на первой
# же правке, и самопроверка стала бы проверять не то, что работает.
COLORS_SIZE='\.system\(size:[[:space:]]*(CGFloat\()?[0-9]'
COLORS_NAME='\.(green|blue|red|orange|yellow|purple|pink|gray|black|white)\b'
COLORS_INIT='\bColor\([^)]*(red|white|hue):[[:space:]]*[0-9]'
COLORS_HEX='\bColor\([^)]*[Hh]ex:[[:space:]]*("#|0x)'

colors_scan() {
  # Theme.swift исключён: он и есть то место, где литералам положено быть.
  # Второй фильтр выбрасывает строки-комментарии. Прежний «grep -v '^\s*//'»
  # не выбрасывал ничего никогда: в выводе grep -n строка начинается с
  # «путь:номер:», и «^» до «//» попросту не доходит.
  grep -rn --include='*.swift' \
      -E "$COLORS_SIZE|$COLORS_NAME|$COLORS_INIT|$COLORS_HEX" "$1" 2>/dev/null \
    | grep -v '/Theme.swift:' \
    | grep -v -E ':[0-9]+:[[:space:]]*(//|\*|/\*)' \
    || true
}

# САМОПРОВЕРКА. Детектор обязан доказывать себя в обе стороны: находить
# литерал и молчать на токене. Прогон «на живом дереве ноль» доказывает
# только вторую половину — и именно поэтому мёртвая ветка с байтом 0x08
# прожила незамеченной.
colors_selftest() {
  local sandbox; sandbox=$(mktemp -d)
  cat > "$sandbox/Cases.swift" <<'ОБРАЗЕЦ'
let a = Text("x").font(.system(size: 14))                       // EXPECT-HIT
let b = Text("x").font(.system(size: 12, weight: .semibold))    // EXPECT-HIT
let c = Text("x").font(.system(size:9))                         // EXPECT-HIT
let d = Text("x").foregroundColor(.green)                       // EXPECT-HIT
let e = Rectangle().fill(Color.black)                           // EXPECT-HIT
let f = Rectangle().fill(.white.opacity(0.08))                  // EXPECT-HIT
let g = Color(red: 0.29, green: 0.87, blue: 0.50)               // EXPECT-HIT
let h = Color(вебHex: 0x00FF88)                                 // EXPECT-HIT
let i = Color(white: 0.2)                                       // EXPECT-HIT
let j = Font.system(size: CGFloat(18))                          // EXPECT-HIT
let k = Text("x").font(.system(size: Тема.Кегль.xs))            // EXPECT-MISS
let l = Text("x").font(.system(size: Тема.БезИсточника.кегль))  // EXPECT-MISS
let m = Rectangle().fill(Тема.Цвет.акцент)                      // EXPECT-MISS
let n = Тема.Цвет.границаВидимая                                // EXPECT-MISS
let o = items.reduce(0, +)                                      // EXPECT-MISS
let p = слой.backgroundColor = CGColor(red: 0, green: 0, blue: 0, alpha: 1) // EXPECT-MISS
let q = Color(Тема.Цвет.фон)                                    // EXPECT-MISS
let r = вид.grayscale(1.0)                                      // EXPECT-MISS
let s = Text("x").redacted(reason: .placeholder)                // EXPECT-MISS
ОБРАЗЕЦ

  local want found leaked out
  want=$(grep -c 'EXPECT-HIT' "$sandbox/Cases.swift" | tr -d ' ')
  out=$(colors_scan "$sandbox")
  found=$(printf '%s\n' "$out" | grep -c 'EXPECT-HIT')
  leaked=$(printf '%s\n' "$out" | grep -c 'EXPECT-MISS')
  rm -rf "$sandbox"

  printf '  литералов в образце: %s | поймано: %s | ложных срабатываний: %s\n' \
    "$want" "$found" "$leaked"
  if [ "$found" = "$want" ] && [ "$leaked" = "0" ]; then
    good 'шаблон доказан в обе стороны: ловит литералы, молчит на токенах'
    return 0
  fi
  bad 'шаблон НЕ доказан — сломан сам детектор, его выводу верить нельзя'
  return 1
}

cmd_colors() {
  if [ "${1:-}" = "проверка" ]; then colors_selftest; return $?; fi

  local dir="${1:-$ROOT/apps/vibee-ios/Vibee}"
  [ -d "$dir" ] || { bad "нет каталога $dir"; return 1; }

  local hits; hits=$(colors_scan "$dir")

  if [ -z "$hits" ]; then
    good 'литеральных цветов и размеров вне Theme.swift не найдено'
    return 0
  fi

  local n; n=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  warn "мимо Theme.swift написано $n мест:"
  printf '%s\n' "$hits" | head -25 | sed 's/^/       /'
  [ "$n" -gt 25 ] && printf '       … и ещё %s\n' "$((n - 25))"
  return 1
}

# ─────────────────────────────────────────────────────────────────────────
# ЖИВ ЛИ CI ВООБЩЕ.
#
# Найдено на 91-м витке: все проверки GitHub Actions падали за 3-4 секунды
# С НУЛЁМ ВЫПОЛНЕННЫХ ШАГОВ — отказ по оплате, а не сигнал о коде. Значит
# десятки правок влиты НЕПРОВЕРЕННЫМИ, и я всё это время писал «влито и
# проверено», имея в виду свои прогоны, а не CI.
#
# Красный CI, который всегда красный, перестают читать — ровно как врущий
# детектор. Но здесь хуже: он выглядит как работающая защита.
# ─────────────────────────────────────────────────────────────────────────
cmd_ci() {
  local runs
  runs=$(gh run list --limit 6 --json conclusion,name,startedAt,updatedAt 2>/dev/null) || {
    bad 'gh не ответил — проверить CI нечем'; return 1; }

  local total failed
  total=$(printf '%s' "$runs" | python3 -c 'import sys,json;print(len(json.load(sys.stdin)))' 2>/dev/null)
  failed=$(printf '%s' "$runs" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print(sum(1 for r in d if r.get("conclusion")=="failure"))' 2>/dev/null)

  # Секунды между стартом и концом. Прогон, падающий за считанные секунды,
  # не успел ничего выполнить — это отказ инфраструктуры, а не теста.
  local quick
  quick=$(printf '%s' "$runs" | python3 -c '
import sys,json,datetime
def t(x): return datetime.datetime.fromisoformat(x.replace("Z","+00:00"))
d=json.load(sys.stdin)
n=0
for r in d:
    try:
        s=(t(r["updatedAt"])-t(r["startedAt"])).total_seconds()
        if r.get("conclusion")=="failure" and s < 15: n+=1
    except Exception: pass
print(n)' 2>/dev/null)

  printf '  последних прогонов: %s | провалов: %s | из них короче 15 с: %s\n'     "${total:-?}" "${failed:-?}" "${quick:-?}"

  if [ "${quick:-0}" -ge 3 ]; then
    bad 'CI НЕ ВЫПОЛНЯЕТСЯ: падает за секунды, шагов не делает'
    paint '31' '       Это отказ инфраструктуры (чаще всего оплата Actions),'
    paint '31' '       а не сигнал о коде. Всё, что влито сейчас, влито ВСЛЕПУЮ.'
    return 1
  fi
  if [ "${failed:-0}" -ge 5 ]; then
    warn 'CI красный подряд — но прогоны идут долго, значит что-то реально падает'
    return 2
  fi
  good 'CI выполняется'
}

# ─────────────────────────────────────────────────────────────────────────
# РАБОТАЕТ ЛИ ФУНКЦИЯ В ВЕБЕ ВООБЩЕ.
#
# На 93-м витке список недостающего соврал дважды в одной проверке:
# комментарии числились непереносёнными, а их нет НИГДЕ (кнопка зовёт общий
# обработчик карточки, счётчик литерал 0, маршрута на сервере ноль); лайк
# числился непереносённым, а был уже подключён.
#
# Перенести неработающее — значит воспроизвести декорацию и записать себе
# паритет. Поэтому перед переносом спрашиваем не «есть ли в вебе кнопка», а
# «делает ли она что-нибудь».
# ─────────────────────────────────────────────────────────────────────────
cmd_real() {
  local name="${1:?нужно имя функции, например like или comment}"
  local web="$ROOT/apps/vibee-editor/player/src"
  local server="$ROOT/apps/vibee-editor/render/render-server.ts"
  local ios="$ROOT/apps/vibee-ios/Vibee"

  printf '  функция: %s\n' "$name"

  # 1. Есть ли на сервере маршрут, который вообще про это.
  local route
  # Тот же капкан, что с literal: -c по нескольким файлам даёт число на файл.
  route=$(grep -oiE "['\"/]${name}['\"]|/${name}\\b" "$server" 2>/dev/null | wc -l | tr -d ' ')

  # 2. Зовёт ли веб отдельный обработчик, или общий onClick карточки.
  local handler
  handler=$(grep -rhoE "on[A-Z][a-zA-Z]*=\{[a-zA-Z]*${name}[a-zA-Z]*\}" "$web" 2>/dev/null | head -1)

  # 3. Захардкожен ли счётчик рядом. Литерал в разметке — верный признак
  #    заглушки: настоящее число приходит из данных.
  local literal
  # `grep -c` печатает число НА КАЖДЫЙ файл, и при нескольких файлах
  # получается "0\n0\n1" — сравнение с числом падает с "integer expression
  # expected". Считаем совпадения, а не доверяем -c.
  literal=$(grep -rniE -A3 "\{/\* *${name}" "$web" 2>/dev/null \
    | grep -oE '<span>[0-9]+</span>' | wc -l | tr -d ' ')

  # 4. Знает ли о ней приложение.
  local native
  native=$(grep -rilE "${name}" "$ios" 2>/dev/null | wc -l | tr -d ' ')

  printf '  сервер: %s упоминаний | свой обработчик: %s | литерал-счётчик: %s | в iOS: %s файлов\n' \
    "$route" "${handler:-НЕТ}" "$literal" "$native"

  if [ "${route:-0}" -eq 0 ]; then
    bad 'на сервере НЕТ ничего про эту функцию — переносить нечего'
    paint '31' '       кнопка в вебе, если она есть, ничего не делает'
    return 1
  fi
  if [ -z "$handler" ] && [ "${literal:-0}" -gt 0 ]; then
    warn 'общий обработчик и литеральный счётчик — похоже на заглушку в вебе'
    return 2
  fi
  if [ "${native:-0}" -gt 0 ]; then
    good "функция живая, и приложение уже про неё знает ($native файлов)"
    return 0
  fi
  good 'функция живая в вебе, в приложении её нет — вот это настоящий пробел'
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
# ТО, ЧТО ДОЛЖЕН БЫЛ ПРОВЕРИТЬ CI.
#
# GitHub Actions не выполняется: задания падают за секунды с нулём шагов
# (отказ по оплате). За сотню витков так влито 157 правок — ни одна не
# прошла проверку. Оплату я решить не могу, а заменить её локально могу.
#
# Это НЕ равноценная замена, и притворяться иначе нельзя: здесь одна машина,
# один Node, один Xcode. Но «ничего» хуже, чем «кое-что, названное своим
# именем».
# ─────────────────────────────────────────────────────────────────────────
cmd_gate() {
  local fails=0
  # A SECTION THAT DID NOT MEASURE IS NOT A SECTION THAT PASSED.
  #
  # Three of the four checks below could already say «я это не мерил», and all
  # three said it with warn(): a yellow line that touches no counter and that
  # nothing downstream reads. Measured 2026-08-29 on this machine — xcodegen was
  # absent, section 3 measured NOTHING, and the run still ended on the green
  # «можно вливать» with exit 0. A warning that costs nothing gets spent as a
  # pass, which is how the iOS build went unbuilt for a hundred iterations while
  # the gate reported all clear.
  #
  # So the third outcome is now COUNTED, not merely coloured. Every branch that
  # cannot measure increments this, and the green line is unreachable while it
  # is above zero. Passes are not tallied on purpose: the only two numbers that
  # can change the verdict are failures and non-measurements.
  local unmeasured=0
  local SECTIONS=4
  # Known type-error debt of the render server. Lower it when the debt drops;
  # never raise it to make a red gate green.
  local GATE_TS_BASELINE=8

  printf '\n  1. Типы рендер-сервера\n'
  local tsout tsrc
  tsout=$(cd "$ROOT/apps/vibee-editor/render" \
    && npx tsc -p tsconfig.json --noEmit --pretty false 2>&1)
  tsrc=$?
  local n miss setup
  # COUNT ONLY ERRORS THAT CAME FROM CODE.
  #
  # A tsc SETUP failure also prints a line containing «error TS», so the old
  # `grep -c 'error TS'` counted it as ordinary debt: one such line is «1 error»,
  # which is under the baseline of 8, and the gate answered «не больше базы» and
  # then «можно вливать» — having type-checked NOTHING. Measured 2026-08-29 by
  # moving the render tsconfig.json aside for ten seconds: tsc printed
  # «error TS5058: The specified path does not exist», exited 1, and the gate
  # went green.
  #
  # The discriminator is the prefix, verified the same day against both cases:
  # a code error is «file(line,col): error TSxxxx», a setup error is «error
  # TSxxxx» at the start of the line with no file at all. So they are counted
  # separately and a single setup error makes the section unmeasured, whatever
  # the other number says.
  n=$(printf '%s' "$tsout" | grep -cE '\([0-9]+,[0-9]+\): error TS')
  setup=$(printf '%s' "$tsout" | grep -cE '^error TS')
  miss=$(printf '%s' "$tsout" | grep -c 'TS2307')

  if [ "${setup:-0}" -gt 0 ]; then
    skip 'tsc failed to start (config/path) — types NOT MEASURED'
    printf '%s\n' "$tsout" | grep -E '^error TS' | head -3 | while IFS= read -r l; do
      paint '36' "       $l"
    done
    unmeasured=$((unmeasured + 1))
  elif [ "${n:-0}" -eq 0 ] && [ "${tsrc:-0}" -ne 0 ]; then
    # TSC NEVER RAN — and this was the one FALSE GREEN in the whole gate.
    #
    # The count came from `grep -c 'error TS'` over the output. When npx cannot
    # find typescript at all there are no «error TS» lines either, so the count
    # is zero and the old code answered «без ошибок»: the check shouted all
    # clear precisely when it had done the least. tsc exits 0 clean and 1/2 with
    # errors, so «zero matches AND non-zero exit» is exactly «did not run».
    skip 'tsc did not run (typescript missing?) — types NOT MEASURED'
    printf '%s\n' "$tsout" | tail -3 | while IFS= read -r l; do
      paint '36' "       $l"
    done
    unmeasured=$((unmeasured + 1))
  elif [ "${n:-0}" -eq 0 ]; then
    good 'без ошибок'
  elif [ "${miss:-0}" -gt 0 ]; then
    # ТРЕТИЙ ИСХОД, и он здесь стоил отдельного разбора.
    #
    # Один пропущенный `npm install` в соседнем пакете дал 390 ошибок: без
    # `jotai` каждый атом терял типы, и все его параметры становились неявным
    # any. Числа выглядели как обвал кода, а имена файлов указывали не туда.
    # Настоящих ошибок было 7 — ровно столько же, сколько до правок.
    #
    # Признак: хотя бы один TS2307 «Cannot find module». Тогда цифра
    # рядом ничего не говорит о коде.
    skip "$n errors, $miss of them «cannot find module» — types NOT MEASURED"
    paint '36' '       Это НЕ про код: где-то не поставлены зависимости.'
    paint '36' '       Проверьте npm install в apps/vibee-editor/packages/*.'
    unmeasured=$((unmeasured + 1))
  elif [ "${n:-0}" -gt "$GATE_TS_BASELINE" ]; then
    # RATCHET, not a hard zero. The render server carries a known debt; the
    # question that matters is whether THIS change added to it.
    #
    # Both branches above only warned, and `fails` was never touched here -- so
    # eight type errors contributed nothing to the verdict and the advice
    # "compare with origin/main" was addressed to a human, while the thing
    # running this is an agent. Measured 2026-08-29: the gate printed 8 errors
    # and still ended with a tally that ignored them.
    bad "$n ошибок типов — БОЛЬШЕ базы ($GATE_TS_BASELINE). Это добавили здесь."
    fails=$((fails + 1))
  else
    good "$n ошибок — не больше базы ($GATE_TS_BASELINE)"
  fi

  printf '\n  2. Тесты рендер-сервера\n'
  # НЕ ЗАПУСТИЛИСЬ и УПАЛИ — разные вещи, и путать их нельзя.
  #
  # На первом же прогоне эти ворота напечатали «КРАСНО», хотя тесты не падали:
  # в рабочем дереве не было node_modules, и vitest не смог загрузить конфиг.
  # Ворота, принимающие поломку окружения за поломку кода, — это шум, а шум
  # перестают читать. Уже записано дважды про другие детекторы.
  local out vrc
  # THE EXIT CODE IS THE VERDICT, not the wording of the output.
  #
  # This line used to be `out=$(...)` alone, which throws the status away, and
  # the pass branch below was a grep for «N passed» with no «N failed». That is
  # the practice this repository has already been burned by twice — «grep -c
  # "error TS"» returned 0 while tsc had errors, because of colour codes.
  #
  # Measured 2026-08-29: a test file that PASSES but leaves an unhandled
  # rejection makes vitest print «Tests 187 passed» and «Errors 1 error» and
  # exit 1. The gate read the first line, called it green, and ended «можно
  # вливать» on a suite its own command had just failed.
  out=$(cd "$ROOT" && npx vitest run apps/vibee-editor/render 2>&1)
  vrc=$?
  if printf '%s' "$out" | grep -qE 'MODULE_NOT_FOUND|Cannot find module|command not found'; then
    skip 'did not start: environment (no node_modules?) — tests NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif printf '%s' "$out" | grep -qE 'No test files found'; then
    # NO FILES IS NEITHER PASS NOR FAIL. vitest exits non-zero here, so this
    # landed on «КРАСНО» — a red that says nothing about the code and everything
    # about the path argument. A renamed directory would have read as a
    # regression, which is the fastest way to teach someone to ignore the gate.
    skip 'no test files matched the path — tests NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif [ "${vrc:-1}" -eq 0 ]; then
    good "$(printf '%s' "$out" | grep -oE 'Tests  [0-9]+ passed' | head -1)"
  else
    # «КРАСНО» ALONE IS NOT ACTIONABLE. The whole vitest output was captured and
    # then thrown away, so the only way to learn WHICH test broke was to re-run
    # the suite by hand — paid on 2026-08-29, when this went red for exactly one
    # run and the gate could not name a single file. Same defect as the iOS log
    # going to /dev/null, in a section that had already been fixed once.
    bad "КРАСНО (vitest exit $vrc)"
    # «Errors» is listed alongside FAIL because an unhandled rejection shows up
    # only there: the run that exposed this defect had zero failing assertions.
    printf '%s\n' "$out" | grep -E 'FAIL|✕|×|Errors  ' | head -5 | while IFS= read -r l; do
      paint '31' "       $l"
    done
    fails=$((fails + 1))
  fi

  printf '\n  3. Сборка iOS\n'
  # A MISSING TOOL IS NOT A BROKEN BUILD -- the same third-outcome rule this
  # file already applies to types and tests.
  #
  # xcodegen is not installed on this machine, so the `&&` chain could never
  # succeed and this step reported a failure on EVERY run. The verdict was
  # therefore a constant "do not merge", which is read exactly as often as a
  # constant "all clear" -- and it made fixing the other checks pointless.
  #
  # THE TOOL IS HERE NOW. `brew install xcodegen` put 2.46.0 on this machine on
  # 2026-08-29 (2 MB bottle, no password), and the build that had never once run
  # went straight through: ** BUILD SUCCEEDED ** in ~15 s. So this section
  # measures for real, and the branches below finally mean what they say.
  #
  # THE TWO STEPS ARE SPLIT because they fail for opposite reasons. A broken
  # project.yml is about the code; an absent xcodegen is about the laptop. The
  # old `&&` chain fused them into one «СБОРКА ПАДАЕТ».
  #
  # THE FLAGS ARE COPIED FROM run.sh on purpose. Without `-arch arm64` xcodebuild
  # builds every applicable architecture — measured here: 171 MB of output and a
  # warning about ONLY_ACTIVE_ARCH — and without SYMROOT it writes somewhere
  # other than where run.sh looks, so the daily loop and the gate would each pay
  # for a full build. Both build/ and build2/ are in apps/vibee-ios/.gitignore.
  local ioslog="${TMPDIR:-/tmp}/tri-gate-ios.log"
  if ! command -v xcodegen >/dev/null 2>&1; then
    skip 'xcodegen is not installed — iOS build NOT MEASURED (brew install xcodegen)'
    unmeasured=$((unmeasured + 1))
  elif ! command -v xcodebuild >/dev/null 2>&1; then
    skip 'xcodebuild not found (no Xcode?) — iOS build NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif ! (cd "$ROOT/apps/vibee-ios" && xcodegen generate --quiet) >"$ioslog" 2>&1; then
    bad 'xcodegen generate падает — сломан project.yml'
    tail -3 "$ioslog" | while IFS= read -r l; do paint '31' "       $l"; done
    fails=$((fails + 1))
  elif (cd "$ROOT/apps/vibee-ios" \
      && xcodebuild -project Vibee.xcodeproj -target Vibee \
         -sdk iphonesimulator -configuration Debug -arch arm64 \
         SYMROOT="$ROOT/apps/vibee-ios/build2" build) >"$ioslog" 2>&1; then
    good 'BUILD SUCCEEDED'
  else
    # The log went to /dev/null, so «СБОРКА ПАДАЕТ» arrived with nothing to act
    # on and the next step was always to re-run the build by hand. Compiler
    # lines first; the tail only when there are none, because a failure in the
    # link or copy phase has no `error:` in it.
    bad 'СБОРКА ПАДАЕТ'
    local shown
    shown=$(grep -E 'error:' "$ioslog" | head -5)
    [ -n "$shown" ] || shown=$(tail -5 "$ioslog")
    printf '%s\n' "$shown" | while IFS= read -r l; do paint '31' "       $l"; done
    paint '31' "       полный лог: $ioslog"
    fails=$((fails + 1))
  fi

  printf '\n  4. Кириллица в добавленных строках\n'
  # RANGE, not the index -- and a real failure.
  #
  # This ran the guard in `staged` mode, which reads `git diff --cached`. Outside
  # a commit that index is EMPTY, so the check passed by construction: measured
  # 2026-08-29, zero staged files and a green line while the branch carried
  # Russian comments. And even a genuine hit only warned, never touching
  # `fails`. Both halves made it unable to fail.
  #
  # THE GUARD ALREADY DISTINGUISHES THREE OUTCOMES; this call threw two of them
  # away. `>/dev/null 2>&1` inside an `if` keeps only "zero or not", so:
  #   exit 1  a real hit                      -> red, correct
  #   exit 2  «failed to read the diff»       -> was ALSO red: broken plumbing
  #           (no-cyrillic-guard.cjs:153)        reported as dirty code
  #   exit 0  «merge in progress, skipping»   -> was GREEN having checked
  #           (checkStaged, early return)        nothing at all
  # The last one is the dangerous half: a clean line for an unread diff, during
  # exactly the operation that brings other people's lines in. It has no exit
  # code of its own, so it is caught by the sentence the guard prints.
  local cyrout cyrrc
  cyrout=$(cd "$ROOT" && node scripts/no-cyrillic-guard.cjs range 2>&1)
  cyrrc=$?
  if [ "${cyrrc:-0}" -eq 0 ] && printf '%s' "$cyrout" | grep -q 'merge in progress'; then
    skip 'merge in progress, the guard checked nothing — Cyrillic NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif [ "${cyrrc:-0}" -eq 0 ]; then
    good 'чисто в диапазоне ветки'
  elif [ "${cyrrc:-0}" -eq 1 ]; then
    bad 'кириллица в добавленных строках ветки'
    printf '%s\n' "$cyrout" | grep ':  ' | head -5 | while IFS= read -r l; do
      paint '31' "     $l"
    done
    fails=$((fails + 1))
  else
    skip "the guard could not read the range (exit $cyrrc) — Cyrillic NOT MEASURED"
    unmeasured=$((unmeasured + 1))
  fi

  printf '\n'
  if [ "$fails" -gt 0 ]; then
    bad "НЕ ВЛИВАТЬ: провалов $fails"
    if [ "$unmeasured" -gt 0 ]; then
      # Both numbers, always. «One failure» out of four sections means something
      # different when two of the other three never ran, and the reader cannot
      # recover that from a single count.
      skip "and NOT MEASURED: $unmeasured of $SECTIONS"
    fi
    paint '31' '       CI сейчас не выполняется, и поймать это больше некому.'
    return 1
  fi
  if [ "$unmeasured" -gt 0 ]; then
    # NOTHING FAILED IS NOT THE SAME AS EVERYTHING PASSED. Saying «можно
    # вливать» here would be a claim about sections that produced no evidence —
    # the precise mistake this whole change exists to remove.
    #
    # Its own exit code, because a caller has to be able to tell «checked and
    # clean» from «could not check»: `tri gate && …` now stops on 2 as well.
    skip "NOT MEASURED: $unmeasured of $SECTIONS — this is NOT «можно вливать»"
    paint '36' '       Reasons above, each marked «?». Fix the environment and re-run.'
    return 2
  fi
  good 'можно вливать — насколько это может подтвердить одна машина'
}

cmd_lesson() {
  local title="${1:?нужен заголовок урока}"
  local skill="$ROOT/.claude/skills/vibee-stack-hard-won/SKILL.md"
  [ -f "$skill" ] || { bad 'скилл не найден'; return 1; }
  { printf '\n## %s\n\n' "$title"; cat; } >> "$skill"
  good 'урок дописан в SKILL.md'
}

cmd_worktree() {
  # Why a worktree at all: the loop shares the main tree with sibling sessions,
  # and a plain `git checkout -b` there lets another session take the branch out
  # from under the work. A worktree is a private checkout. Base is origin/main,
  # never local HEAD -- work stands on what is merged.
  local branch="${1:-}"
  if [ -z "$branch" ]; then
    bad 'нужно имя ветки: tri worktree <branch>'
    return 1
  fi
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null
  local base wt
  base="$(git -C "$ROOT" rev-parse origin/main)"
  wt="${TRI_WORKTREE_DIR:-${TMPDIR:-/tmp}}/tri-wt-${branch//\//-}"
  if [ -e "$wt" ]; then
    bad "уже существует: $wt"
    return 1
  fi
  if ! git -C "$ROOT" worktree add "$wt" -b "$branch" "$base" >/dev/null 2>&1; then
    bad "git worktree add не удался (ветка $branch занята?)"
    return 1
  fi
  # A fresh worktree has NO node_modules, and the root alone is NOT enough. The
  # vibee-editor monorepo keeps per-app node_modules (render/player/vibee-atoms);
  # without them `bun run verify` dies on ENOENT (render/.bin/tsx) and
  # ERR_MODULE_NOT_FOUND (jotai) -- an env-gap that reads exactly like a
  # regression but is one the worktree invented. Symlink the root and every app
  # node_modules from the main tree so the gate measures the code, not the gap.
  ln -s "$ROOT/node_modules" "$wt/node_modules"
  local rel
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    mkdir -p "$wt/$(dirname "$rel")"
    ln -s "$ROOT/$rel" "$wt/$rel"
  done < <(cd "$ROOT" && find apps \( -type d -o -type l \) -name node_modules -prune 2>/dev/null | grep -v '/node_modules/')
  good "worktree готов, node_modules слинкованы (root + apps)"
  # Print ONLY the path on the last line so a caller can:  cd "$(tri worktree x | tail -1)"
  printf '%s\n' "$wt"
}

cmd_price() {
  # Before treating an "unbilled paid path" as a defect, check whether the mode
  # even HAS a price. Direct text chat here is free-by-design: ModeEnum.AiChat is
  # absent from BASE_COSTS (calculateModeCost returns 0), ChatWithAvatar is 0.
  # Charging a cost-0 mode is not a fix -- it writes 0-value payment rows and the
  # balance gate (balance < 0) always passes. This prints the STATIC base cost
  # from BASE_COSTS; dynamic costs (steps-based avatars, answerAi response.cost)
  # are NOT reflected -- read those paths directly.
  local mode="${1:-}"
  if [ -z "$mode" ]; then
    bad 'нужно имя режима: tri price <ModeName>   (напр. tri price Voice)'
    return 1
  fi
  local file="$ROOT/src/price/helpers/modelsCost.ts"
  if [ ! -f "$file" ]; then
    bad "нет файла $file"
    return 1
  fi
  # Only look inside the BASE_COSTS object literal.
  local block line
  block="$(awk '/export const BASE_COSTS/{f=1} f{print} f&&/^\}/{exit}' "$file")"
  line="$(printf '%s\n' "$block" | grep -E "\[ModeEnum\.${mode}\]:" | head -1)"
  if [ -z "$line" ]; then
    warn "ModeEnum.${mode} НЕ в BASE_COSTS → calculateModeCost вернёт 0 (free-by-design / цена не задана)"
    printf '  charge за 0 ВРЕДЕН: 0-value payment-row, gate (balance < 0) всегда проходит\n'
    return 0
  fi
  local val
  val="$(printf '%s\n' "$line" | sed -E 's/.*\]:[[:space:]]*//; s/,.*$//; s/[[:space:]]*$//')"
  if [ "$val" = "0" ]; then
    warn "ModeEnum.${mode} base cost = 0 (free-by-design) — статическая цена нулевая"
    printf '  (динамическая цена, если есть — через steps/answerAi response.cost — здесь НЕ видна)\n'
  else
    good "ModeEnum.${mode} base cost = ${val}\$ (статическая; steps/answerAi не учтены)"
  fi
}

cmd_money_base() {
  # Two star-cost helpers in this repo can DISAGREE by rounding:
  #   calculateFinalImageCostInStars(usd)   = ceil(usd*interestRate/starCost)  [IMAGES_MODELS.ts]
  #   calculateFinalPriceInStars(usd,,mk)   = floor(usd/starCost*mk)           [paidServices.ts]
  # A refund MUST use the same helper the charge used. Hand-guessing the markup or
  # trusting a code comment nearly shipped a refund-mint (#1263). Evaluate BOTH with
  # the REAL constants so a money base is never hand-computed again.
  local usd="${1:-}" markup="${2:-}"
  if [ -z "$usd" ]; then
    bad 'нужна цена USD: tri money-base <usdCost> [markup]   (напр. tri money-base 0.025 2.4)'
    return 1
  fi
  local cfile="$ROOT/src/price/constants/index.ts"
  local star ir
  star="$(grep -E 'STAR_COST_USD[[:space:]]*=' "$cfile" 2>/dev/null | head -1 | grep -oE '[0-9.]+' | head -1)"
  ir="$(grep -E 'MARKUP_MULTIPLIER[[:space:]]*=' "$cfile" 2>/dev/null | head -1 | grep -oE '[0-9.]+' | head -1)"
  star="${star:-0.016}"; ir="${ir:-1.5}"; markup="${markup:-$ir}"
  node -e "const usd=$usd,star=$star,ir=$ir,mk=$markup;const img=Math.ceil(usd*ir/star),price=Math.floor(usd/star*mk);console.log('  constants (from source): starCost='+star+'  interestRate='+ir+'  markup(arg)='+mk);console.log('  calculateFinalImageCostInStars = ceil('+usd+'*'+ir+'/'+star+') = '+img+' stars');console.log('  calculateFinalPriceInStars     = floor('+usd+'/'+star+'*'+mk+') = '+price+' stars');console.log(img===price?'  AGREE: базы совпадают — refund любой из них ок':'  DIVERGE: refund ОБЯЗАН брать базу того же helper, что и charge!');console.log('  ВНИМАНИЕ: serviceBase = calculateFinalImageCostInStars(usd) ТЕОРЕТИЧЕСКИ; сервис может ХАРДКОДИТЬ costPerImage (nano_banana=5) -- сверь реальный источник, не формулу')"
}

cmd_batch_refunds() {
  # Wiring audit: which services in the aiPhotoshop ALL_MODELS batch forward the
  # EXACT per-image charge (chargedCostOverride) so a failure refunds what was
  # charged. A service that does NOT forward refunds its own base -- which
  # UNDER-refunds whenever the batch-charge helper (calculateFinalPriceInStars)
  # and the service-refund helper (calculateFinalImageCostInStars) diverge.
  # #1267 fixed flux_kontext_max; pro/seededit/nano_banana queued. Compose with
  # tri money-base <usd> 2.4 to see whether a MISSING actually loses money.
  local f="$ROOT/src/scenes/aiPhotoshopScene/index.ts"
  [ -f "$f" ] || { bad "нет файла $f"; return 1; }
  node -e '
    const s=require("fs").readFileSync(process.argv[1],"utf8");
    const re=/modelKey === .([a-z_0-9]+)./g; let m; const idx=[];
    while((m=re.exec(s))) idx.push([m.index,m[1]]);
    let any=false;
    console.log("  batch services (skipBalanceCheck) forward exact charge (chargedCostOverride)?");
    for(let i=0;i<idx.length;i++){
      const start=idx[i][0], name=idx[i][1], end=i+1<idx.length?idx[i+1][0]:start+2500;
      const b=s.slice(start,end);
      if(/skipBalanceCheck:\s*true/.test(b)){any=true;const ok=/chargedCostOverride/.test(b);console.log("    "+(ok?"forwards OK   ":"MISSING  !!  ")+name);}
    }
    if(!any) console.log("    (no batch skipBalanceCheck call sites)");
    console.log("  MISSING loses money only when bases diverge -- verify: tri money-base <usd> 2.4");
  ' "$f"
}

cmd_idempotency_keys() {
  # Advisory audit (NOT a pass/fail gate): list every inv_id / idempotencyKey
  # assignment and flag the ones whose value is NON-deterministic (Date.now,
  # Math.random, uuid). A non-deterministic idempotency key defeats a UNIQUE
  # backstop -- a duplicate/retry can never be rejected (#1298 promo star-mint).
  # A flagged site is only OK if the intent is unique-PER-PAYMENT (a real
  # invoice), NOT idempotency/dedup (reward, bonus, refund) -- YOU judge.
  node -e '
    const fs=require("fs"), path=require("path");
    function walk(d,acc){ for(const e of fs.readdirSync(d,{withFileTypes:true})){ if(e.name==="node_modules"||e.name===".git")continue; const p=path.join(d,e.name); if(e.isDirectory())walk(p,acc); else if(e.name.endsWith(".ts")&&!e.name.endsWith(".test.ts"))acc.push(p);} return acc; }
    const files=walk(path.join(process.argv[1],"src"),[]);
    const NONDET=/Date\.now\(|Math\.random\(|randomUUID|uuidv4\(/;
    const risky=[]; let total=0;
    for(const f of files){ const lines=fs.readFileSync(f,"utf8").split("\n");
      for(let i=0;i<lines.length;i++){ const l=lines[i];
        if(/\binv_id\s*:/.test(l) || /idempotencyKey\s*[:=]/.test(l)){ total++;
          const val=l.split(/inv_id\s*:|idempotencyKey\s*[:=]/)[1]||l;
          if(NONDET.test(val)) risky.push(f.replace(process.argv[1]+"/","")+":"+(i+1)+"  "+l.trim().slice(0,88));
        } } }
    console.log("NON-DETERMINISTIC idempotency keys (OK only if intent is unique-per-payment, not dedup):");
    if(!risky.length) console.log("  (none)"); else risky.forEach(r=>console.log("  ! "+r));
    console.log("");
    console.log("total inv_id/idempotencyKey sites: "+total+" | flagged: "+risky.length);
  ' "$ROOT"
}

cmd_wired() {
  # Reachability aid: before fixing a call-site, confirm something reaches it.
  # This does NOT decide reachable-vs-dead — grep cannot (registration hides in
  # Stage arrays, scene lists, dynamic registries; wiring is disabled by /* */,
  # if(false), feature flags, examples-only modules — none visible to grep). It
  # does ONE reliable thing: list every reference and FLAG the ones on
  # commented-out lines, because a handler whose bot.on() registration is
  # commented (handleTextMessage) is the classic dead-code trap. READ the flagged
  # lines and find the actual registration yourself — the tool only points.
  local sym="${1:-}"
  if [ -z "$sym" ]; then
    bad 'нужен символ: tri wired <SymbolName>   (напр. tri wired handleTextMessage)'
    return 1
  fi
  local hits commented
  hits="$(cd "$ROOT" && grep -rnE "\\b${sym}\\b" src --include='*.ts' 2>/dev/null | grep -v '__tests__')"
  if [ -z "$hits" ]; then
    warn "нет ссылок на ${sym} в src (кроме тестов) — символ не используется?"
    return 0
  fi
  commented="$(printf '%s\n' "$hits" | grep -E ':[0-9]+:[[:space:]]*//')"
  local nt nc
  nt="$(printf '%s' "$hits" | grep -c .)"
  nc="$(printf '%s' "$commented" | grep -c .)"
  printf '  ссылок всего: %s | из них закомментированных: %s\n' "$nt" "$nc"
  if [ "$nc" -gt 0 ]; then
    warn 'ЗАКОММЕНТИРОВАННЫЕ ссылки (частый признак мёртвой проводки — ЧИТАЙ):'
    printf '%s\n' "$commented" | sed 's/^/    /'
  fi
  printf '  НЕ вывод, а указатель: сам найди РЕГИСТРАЦИЮ (bot.on/.hears/.use/.action/.command/\n'
  printf '  Stage/scene-массив) среди живых ссылок. Если она только в закомментированных — мёртвый код.\n'
  printf '  grep не видит /* */, if(false), feature-flag, examples-only, динамические реестры.\n'
}

