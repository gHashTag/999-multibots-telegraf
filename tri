cmd_comment_math() {
  # ИСПОЛНЯЕТ АРИФМЕТИКУ, КОТОРУЮ КОММЕНТАРИЙ ДЕЛАЕТ САМ НАД СОБОЙ.
  #
  # Часть комментариев -- не проза, а вычисления: «$0,40 / $0,016 = 40⭐».
  # Такой комментарий приводит ВСЕ нужные цифры и называет ответ, поэтому
  # проверка не требует ни знания предметной области, ни базы, ни запуска --
  # только посчитать. В итерации, с которой это началось, десять таких
  # утверждений оказались неверными, и одно из десяти было числом, из которого
  # считается живое списание.
  #
  # Что считается утверждением -- нарочно узко: числа, четыре действия, знак
  # равенства, число. Одно короткое слово-единица между операндом и знаком
  # допускается («60 credits * $0,005»), несколько слов -- уже проза, и такая
  # цепочка помечается НЕРАЗОБРАННОЙ, а не угадывается.
  #
  # Округление не расхождение: сравнение идёт с той точностью, с какой ЗАПИСАН
  # ответ, плюс усечение и потолок. Иначе каждое честное «2,8» при 2,8125
  # превращается в дефект.
  ( cd "$ROOT" && node scripts/comment-math.cjs "$@" )
}

cmd_gate_liveness() {
  # ПЕРЕЖИВЁТ ЛИ ГЕЙТ СМЕРТЬ СВОЕГО МАТЧЕРА.
  #
  # Счётный гейт сканирует репозиторий и упирается в число: потолок долга или
  # список-разрешение. У всех у них одна общая беда: если матчер перестал
  # совпадать, скан вернёт пусто, долг станет нулём, и ЛЮБАЯ граница
  # удовлетворится. Гейт зеленеет ровно в тот момент, когда ослеп.
  #
  # Потолок удовлетворяется нулём. Сравнение со списком удовлетворяется пустой
  # разницей. Замечает только ПОЛ на популяции: утверждение, что обход
  # что-то нашёл, проверенное ДО границы.
  #
  # Инструмент сужает чтение, а не доказывает. «Пол стоит на СКАНЕ, а не на
  # константе выше по файлу» — вопрос смысла, а матчер видит только форму,
  # поэтому его вердикты сверяются с ручным чтением через `--calibrate`, и
  # печатаются ОБЕ стороны ошибки.
  ( cd "$ROOT" && node scripts/gate-liveness.cjs "$@" )
}

cmd_neg_controls() {
