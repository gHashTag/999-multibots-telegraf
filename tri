cmd_charge_timing() {
  # ПОЧЕМУ ПРОВАЛ НЕ СТОИТ ЧЕЛОВЕКУ ДЕНЕГ ТАМ, ГДЕ ВОЗВРАТА НЕТ.
  #
  # Десять файлов списывают и никогда не возвращают. Шесть объяснены тем, что
  # уже держит тест. Четыре безопасны по причине, которая жила ТОЛЬКО в
  # комментарии: списание стоит после успеха. Правда сегодня, не проверена
  # ничем -- перенеси вызов на двадцать строк выше, и комментарий читается
  # так же, а люди начинают платить за неудачи.
  #
  # Механизма ДВА, и одно общее правило их бы склеило:
  #   доставка-первой -- списание НИЖЕ вызова, отдающего результат человеку;
  #   по-результату   -- списание внутри условия на результат провайдера.
  #
  # Проверка цены -- НЕ проверка успеха: `if (cost > 0)` ничего не говорит о
  # том, получилось ли. Именно поэтому textToSpeechWizard числится
  # «доставка-первой», а не «по-результату».
  ( cd "$ROOT" && node -e '
    const fs = require("fs")
    const t = require("./scripts/lib/charge-timing.cjs")
    t.selfCheck()
    console.log("самопроверка: " + t.SAMPLES.length + " образцов сошлись, обе стороны\n")
    const FILES = [
      "src/handlers/handleTextToVideoDirect.ts",
      "src/scenes/textToSpeechWizard/index.ts",
      "src/scenes/voiceAvatarWizard/index.ts",
      "src/scenes/instagramParserScene/index.ts",
    ]
    for (const f of FILES) {
      const r = t.timingFor(fs.readFileSync(f, "utf8"))
      const m = r.deliveryFirst ? "доставка-первой" : r.successGated ? "по-результату  " : "НИ ОДНОГО"
      console.log("  " + m + "  " + f.replace(/^src\//, ""))
    }
  ' )
}

