cmd_guards() {
  # The loop-fable invariant ratchets (guards.mjs) as ONE exit-code run -- the
  # fast per-iteration regression check after syncing main. Distinct from
  # `tri ratchets` (the older safety-class list in ratchets.mjs): this is the
  # growing list each loop-fable fix pins its bug against (33 and counting).
  # I typed `node .claude/loop-opus/guards.mjs` by hand every iteration; an
  # unmemorised path is a check skipped. `tri guards --list` prints the files.
  ( cd "$ROOT" && node "$TOOLS/guards.mjs" "$@" )
}

cmd_ratchet_audit() {
  # META-check the QUALITY of the tri guards themselves: does each STRUCTURAL
  # ratchet (an AST/text source scan, which can silently break) have a SELF-CHECK
  # (feeds the detector a synthetic bad input and asserts it fires) and a FLOOR
  # (asserts the guarded target is still present, so a rename/gut fails loud)?
  # A ratchet that can only pass, never fail, is a false ruler -- the loop's
  # recurring bug (it.198/199/200/204). Behavioral tests (import + call the real
  # fn) are inherently self-validating and exempt. TRIAGE, not a gate.
  ( cd "$ROOT" && node "$TOOLS/ratchet-audit.mjs" "$@" )
}

cmd_fn_liveness() {
  # Catch a BEHAVIORAL ratchet whose fn-under-test has gone DEAD. A behavioral
  # test imports a fn from @/ and calls it, so it self-validates -- UNLESS that
  # fn loses all production importers (deleted/orphaned/replaced by a twin). Then
  # the ratchet still passes but pins an invariant on code nothing runs: a
  # vacuous green (the #1572 processBalanceVideoOperation class). ratchet-audit
  # checks self-check+floor PRESENCE; it does NOT check the guarded fn is LIVE.
  # Liveness = >=1 production file references the fn outside its own def file
  # (an import counts -- that is the exact "never imported" signal that let #1572
  # be deleted). A 0 is a CANDIDATE: verify by hand, then delete fn+ratchet
  # (autonomous, typecheck-safe) or move the invariant to the live twin. TRIAGE.
  # --self-check proves the predicate against known truth before trusting a run.
  ( cd "$ROOT" && node "$TOOLS/fn-liveness-audit.mjs" "$@" )
}

cmd_timeouts() {
  # List axios calls with NO timeout, split into likely-LIVE vs likely-DEAD by
  # whether the module is referenced elsewhere. axios default timeout is 0
  # (infinite): a call on a CHARGED path that hangs leaves the user charged with
  # no delivery and no refund (refund fires only on a throw). The report is a
  # triage list, NOT a fix-all -- most no-timeout calls are non-charged
  # (getAccountBalance), dead (0 importers), or owner-render (#1333). Bound the
  # ones that (1) sit on a live charged path and (2) refund only on throw.
  ( cd "$ROOT" && node "$TOOLS/axios-timeout-audit.mjs" "$@" )
}

cmd_inflight() {
  # List scene .action handlers that reach a CHARGE primitive
  # (processBalanceOperation / updateUserBalance / directPaymentProcessor /
  # upscaleImage) but set NO *InProgress guard flag -- a double-tap can re-enter
  # before the first non-atomic charge settles and double-charge. iter204 shipped
  # exactly this (aiPhotoshop 'upscale' button bypassed the scene choke point).
  # TRIAGE, not a gate: a flagged handler is a HYPOTHESIS -- the charge may sit
  # behind a shared guarded choke fn (grep the callee) or the action may not be
