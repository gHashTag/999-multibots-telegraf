# tri turn --record: the kit for the recordings --audio needs (cycle 15).
#
# Smart Turn stays in shadow until a PERSON's voice says it holds finished
# turns rarely and catches unfinished ones (synthesized speech is not a
# person). This walks the owner through ten phrases -- five said to the end,
# five broken off mid-thought -- records each from the Mac's microphone and
# judges them with --audio. Recordings live in ~/.cache/tri/turn-voice/<lang>
# and are kept: a second run records only what is missing, and re-judges all.
# Delete a file to record it again. macOS asks once for microphone access.
_turn_record() {
  local lang="$1" pause="$2" dir n=0 kind phrase file pid ans
  command -v ffmpeg >/dev/null || { bad 'ffmpeg is needed to record'; return 2; }
  [ -t 0 ] || { bad 'tri turn --record is interactive: run it in a terminal'; return 2; }
  dir="$HOME/.cache/tri/turn-voice/$lang"
  mkdir -p "$dir" || return 2
  local -a items
  if [ "$lang" = ru ]; then
    items=(  # cyrillic-ok: phrases the owner reads aloud
      'done|Покажи мои рилсы за эту неделю.'  # cyrillic-ok
      'done|Сколько у меня токенов?'  # cyrillic-ok
      'done|Открой календарь на завтра.'  # cyrillic-ok
      'done|Сделай липсинк из последнего видео.'  # cyrillic-ok
      'done|Спасибо, это всё.'  # cyrillic-ok
      'cut|Покажи мне рилсы и'  # cyrillic-ok
      'cut|Я хочу сделать видео про'  # cyrillic-ok
      'cut|Открой календарь, а потом'  # cyrillic-ok
      'cut|Сколько стоит, ну, это'  # cyrillic-ok
      'cut|Напиши клиенту, что'  # cyrillic-ok
    )
  else
    items=(
      'done|Show me my reels from this week.'
      'done|How many tokens do I have?'
      'done|Open my calendar for tomorrow.'
      'done|Make a lipsync from the last video.'
      'done|Thanks, that is all.'
      'cut|Show me my reels and'
      'cut|I want to make a video about'
      'cut|Open the calendar, and then'
      'cut|How much does it, um, the'
      'cut|Tell the client that'
    )
  fi
  printf "  recordings: %s\n" "$dir"
  printf '  %s\n' 'say each phrase as you would to the agent. "cut" phrases: stop where the text stops, as if thinking, then press Enter'
  # Seen 2026-10-02: from a process macOS has not yet asked about, ffmpeg
  # sits on the microphone without a word (not even `timeout` ended it).
  printf '  %s\n' 'the first recording may wait for the macOS "allow microphone" prompt -- answer it, then speak'
  for phrase in "${items[@]}"; do
    kind="${phrase%%|*}"; phrase="${phrase#*|}"; n=$((n + 1))
    file="$dir/$kind-$(printf %02d "$n").wav"
    [ -s "$file" ] && { printf '  %s  already recorded\n' "$(basename "$file")"; continue; }
    printf '\n  [%s %d/%d]  %s\n' "$kind" "$n" "${#items[@]}" "$phrase"
