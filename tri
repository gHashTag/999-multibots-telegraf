  # популяцию списком из ЧЕТЫРЁХ имён функций, а пишущих файлов -- десять, и
  # четыре из них не упоминают ни одного имени из словаря: у них своя
  # .from('payments_v2').insert(...).
  #
  # Два написания одной вещи -- главный повторяющийся дефект: четыре раза
  # ратчет докладывал чистоту о той половине, которой не видел. Здесь тот же
  # вопрос задан НАРОЧНО и в одном месте.
  #
  # Считается по замаскированному коду: закомментированная запись -- не
  # денежный путь. Замерено, что без маски одна строка комментария в
  # постороннем файле записывала его в пишущие.
  ( cd "$ROOT" && node -e '
    const m = require("./scripts/lib/money-writers.cjs")
    const fs = require("fs")
    m.selfCheck()
    const w = m.writerFiles(".")
    const re = new RegExp("(?<![A-Za-z0-9_])(" + m.PRIMITIVE_NAMES.join("|") + ")(?![A-Za-z0-9_])")
    console.log("самопроверка: " + m.SAMPLES.length + " образцов сошлись, обе стороны")
