cmd_blind_probes() {
  # ИНСТРУМЕНТ, КОТОРЫЙ ОТВЕЧАЕТ УВЕРЕННО ПРИ СЛОМАННОМ ЧТЕНИИ, НЕОПРОВЕРЖИМ.
  #
  # it.178: `tri dupes` глотал каждый отказ чтения, и «дублей нет» печаталось
  # теми же словами, что «не прочитано ничего». Сломать под ним чтение было
  # нельзя -- вывод не менялся, поэтому дефект и жил так долго.
  #
  # it.179: замер по каталогу инструментов. Из одиннадцати проб шесть отвечали
  # уверенно, читая НОЛЬ файлов. Худшей была probe-tool-blindness -- та самая,
  # что ищет молчаливую слепоту: она печатала «инструментов проверено: 540, с
  # признаками слепоты: 0», не открыв ни одного. Число описывало СПИСОК,
  # который дало перечисление (оно идёт через git и продолжало работать), а не
  # выполненную работу.
  #
  # Популяция берётся с диска, а не списком здесь: новая проба обязана попасть
  # под этот вопрос сама.
  local pre="$ROOT/scripts/lib/crash-preload.cjs"
  [ -f "$pre" ] || { bad "нет $pre"; return 2; }
  local f name rc_ok rc_broken bad_n=0 skip_n=0 total=0
  for f in "$ROOT"/scripts/probe-*.cjs; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .cjs)
    total=$((total + 1))
    # Обе стороны через ОДИН конвейер: иначе пустой вывод одной из них даёт
    # разные хеши на одинаковом содержимом (it.177).
    local out_ok out_broken tmp_ok tmp_br
    tmp_ok=$(mktemp); tmp_br=$(mktemp)
    ( cd "$ROOT" && node "$f" ) >"$tmp_ok" 2>/dev/null; rc_ok=$?
    ( cd "$ROOT" && NODE_OPTIONS="--require $pre" node "$f" ) >"$tmp_br" 2>/dev/null; rc_broken=$?
    out_ok=$(md5 <"$tmp_ok"); out_broken=$(md5 <"$tmp_br")
    rm -f "$tmp_ok" "$tmp_br"
    # ТРИ СОСТОЯНИЯ. Судить можно только пробу, которая в норме отрабатывает
    # чисто: у той, что и без поломки выходит ненулём (нужен доступ к базе,
    # аргумент, окружение), одинаковый код возврата не значит НИЧЕГО. Первая
    # версия приравняла "rc не изменился" к слепоте и насчитала 28 из 54.
    # Вывод НЕ ИЗМЕНИЛСЯ -- значит поломка до этой пробы не дошла (она читает
    # не исходники, а вывод git, либо её предмет лежит в каталоге, который
    # проба щадит). Обвинять её не в чем, но и судить нельзя.
    if [ "$rc_ok" -eq 0 ] && [ "$out_ok" = "$out_broken" ]; then
      printf "  проба не дошла   %-28s (читает не тем способом)\\n" "$name"
      skip_n=$((skip_n + 1))
    elif [ "$rc_ok" -ne 0 ]; then
      printf "  не запускается   %-28s rc %s (судить нельзя)\n" "$name" "$rc_ok"
      skip_n=$((skip_n + 1))
    elif [ "$rc_broken" -ne "$rc_ok" ]; then
      printf "  отказывается     %-28s rc %s -> %s\n" "$name" "$rc_ok" "$rc_broken"
    else
      printf "  ОТВЕЧАЕТ ВСЛЕПУЮ  %-28s rc %s -> %s\n" "$name" "$rc_ok" "$rc_broken"
      bad_n=$((bad_n + 1))
    fi
  done
  echo ""
  echo "проб: $total   судимых: $((total - skip_n))   отвечают вслепую: $bad_n   не запускаются: $skip_n"
  [ "$bad_n" -eq 0 ] || return 1
}

cmd_checks_of_checks() {
  # КАЖДАЯ САМОПРОВЕРКА ОБЯЗАНА ПОКРАСНЕТЬ, КОГДА ЕЁ ИНСТРУМЕНТ СЛОМАН.
  #
  # it.177: `tri dupes` падал на каждом файле с кавычкой, а его самопроверка
  # была ЗЕЛЁНОЙ -- два из трёх её утверждений отрицательные («это НЕ дубль»),
  # а пустой вывод отрицательное утверждение удовлетворяет. Мёртвый инструмент
  # и здоровый давали одни и те же слова.
  #
  # Читать восемь самопроверок глазами в поисках следующей такой -- медленно и
  # ненадёжно. Вопрос задаётся снаружи и всем сразу: ломаем чтение данных под
  # инструментом и смотрим, кто всё ещё говорит OK.
  #
  # ТРИ ИСХОДА, А НЕ ДВА. Узкая версия этой пробы ломала только чтение
  # исходников и не доходила до трёх инструментов из восьми -- их самопроверки
  # были обвинены в том, что проходят на сломанном, хотя сломан никто не был.
  # «Мутация не дошла» -- отдельный ответ, а не разновидность провала.
  #
  # ПОПУЛЯЦИЯ БЕРЁТСЯ ИЗ ДИСПЕТЧЕРА, а не списком здесь: список в коде тихо
  # отстаёт от репозитория, и новая самопроверка ускользнула бы от проверки.
  # ДВЕ ПРОБЫ, А НЕ ОДНА. Тупая ломает КАЖДОЕ чтение данных, поэтому любая
  # самопроверка хотя бы с одним положительным утверждением краснеет от неё --
  # то есть ловит только собранные целиком из отрицательных. Настоящий дефект
  # it.177 был уже: падение ЩАДИЛО положительный образец (в нём не было
  # кавычек) и было невидимо двум отрицательным.
  local pre="$ROOT/scripts/lib/crash-preload.cjs"
  local pre_sel="$ROOT/scripts/lib/crash-preload-selective.cjs"
  [ -f "$pre" ] || { bad "нет $pre"; return 2; }
  [ -f "$pre_sel" ] || { bad "нет $pre_sel"; return 2; }
  local checks
  checks=$(grep -oE "^  [a-z-]+-check\|" "$ROOT/tri" | sed "s/|//;s/^ *//")
  [ -n "$checks" ] || { bad "популяция пуста -- матчер диспетчера сломан"; return 2; }
  local c rc_ok rc_broken err vacuous=0 unreached=0 total=0
  local errfile; errfile=$(mktemp)
  for c in $checks; do
    total=$((total + 1))
    ( cd "$ROOT" && ./tri "$c" ) >/dev/null 2>&1; rc_ok=$?
    ( cd "$ROOT" && NODE_OPTIONS="--require $pre" ./tri "$c" ) >/dev/null 2>"$errfile"; rc_broken=$?
    err=$(wc -c <"$errfile" | tr -d " ")
    local rc_sel
    ( cd "$ROOT" && NODE_OPTIONS="--require $pre_sel" ./tri "$c" ) >/dev/null 2>&1; rc_sel=$?
    if [ "$rc_broken" -ne 0 ] && [ "$rc_sel" -ne 0 ]; then
      printf "  краснеет на обеих    %-18s\n" "$c"
    elif [ "$rc_broken" -ne 0 ]; then
      printf "  ПРОШЛА НА ИЗБИРАТ.   %-18s <-- падение, щадящее образец, невидимо\n" "$c"
      vacuous=$((vacuous + 1))
    elif [ "$rc_ok" -eq "$rc_broken" ] && [ "$err" -lt 50 ]; then
      # инструмент не читает данных этим способом -- проба его не тронула
      printf "  мутация не дошла     %-18s (прочитай сам)\n" "$c"
      unreached=$((unreached + 1))
    else
      printf "  ПРОШЛА НА СЛОМАННОМ  %-18s <-- утверждения выполняются пустым выводом\n" "$c"
      vacuous=$((vacuous + 1))
    fi
  done
  rm -f "$errfile"
  echo ""
  echo "самопроверок: $total   проходят на сломанном: $vacuous   не тронуты пробой: $unreached"
  [ "$vacuous" -eq 0 ] || return 1
}

cmd_mask_diff() {
  # СПРАШИВАЕТ У ВСЕХ ПЕРЕПИСЕЙ СРАЗУ: ЗАВИСИТ ЛИ ОТВЕТ ОТ ТОГО, ЧТО КОММЕНТАРИЙ
  # ВЫГЛЯДИТ КОДОМ.
  #
  # it.176: измеритель классифицировал охраны по найденному тексту, а не по
  # тому, чем они читают список, и опубликовал 5 там, где было 4. Читать
  # двадцать инструментов глазами в поисках седьмого такого -- долго и
  # ненадёжно. Этот прогон задаёт вопрос снаружи: каждый глагол выполняется
  # дважды, второй раз с подменой чтения исходников на ЗАМАСКИРОВАННЫЕ.
  #
  # СДВИНУЛСЯ -- НЕ ПРИГОВОР. Перепись, чей предмет и есть содержимое строк
  # (имя таблицы в .from(...), ключ inv_id, шаблоны exclude в конфиге), обязана
  # сдвинуться: маска стирает её предмет. Сдвиг -- повод прочитать, а не вывод.
  #
  # Найдено этим прогоном: scopes считал walk() из комментариев (66 против 64,
  # и «19 неразобранных корней» оказалось 17), mock-imports считал vi.mock(
  # из комментариев (699 против 693).
  #
  # Обе стороны обязаны собираться ОДИНАКОВО: первая версия сравнивала md5 от
  # `print -r -- "$out"` с md5 от вывода по конвейеру. print добавляет перевод
  # строки, конвейер нет -- и любой глагол с пустым выводом объявлялся
  # сдвинувшимся. Так `dupes` был обвинён зря (а оказался мёртв по другой
  # причине).
  local pre="$ROOT/scripts/lib/mask-preload.cjs"
  [ -f "$pre" ] || { bad "нет $pre"; return 2; }
  local verbs=(money-writers idempotency-keys unguarded dupes mock-imports \
               credit-sites scopes charge-timing credit-guards untracked)
  local v a b moved=0
  for v in "${verbs[@]}"; do
    a="$( ( cd "$ROOT" && ./tri "$v" ) 2>/dev/null | md5 )"
    b="$( ( cd "$ROOT" && NODE_OPTIONS="--require $pre" ./tri "$v" ) 2>/dev/null | md5 )"
    if [ "$a" = "$b" ]; then
      printf '  устойчив   %s\n' "$v"
    else
      printf '  СДВИНУЛСЯ  %s  -- прочитай diff, это вопрос, а не вердикт\n' "$v"
      moved=$((moved + 1))
    fi
  done
  echo ""
  echo "сдвинулось: $moved из ${#verbs[@]}"
  echo "diff одного глагола:  diff <(./tri V) <(NODE_OPTIONS=\"--require $pre\" ./tri V)"
}

cmd_mock_imports() {
  # ГОЛЫЙ ВСТРОЕННЫЙ МОДУЛЬ ВНУТРИ ФАБРИКИ МОКА -- ВЕРДИКТ, ЗАВИСЯЩИЙ ОТ ДЕРЕВА.
  #
  # Итерации 155-173: один и тот же коммит, побайтово одинаковые файлы, чистый
  # git status -- и противоположные стабильные вердикты в двух worktree. Причина
  # была одной строкой в фабрике `vi.mock('fs')` самого теста: `import('stream')`
  # без префикса. Внутри фабрики имя разрешает vitest, а не Node, и результат
  # зависел от дерева. `node:stream` разрешается одинаково везде.
  #
  # ПОПУЛЯЦИЯ УЗКАЯ НАМЕРЕННО. Статические голые импорты наверху теста сюда НЕ
  # входят: их сотни, и набор зелёный. Ломает только позиция внутри фабрики.
  #
  # ЧИТАЕТСЯ AST, А НЕ РЕГЭКСП: первая перепись этого класса регэкспом
  # засчитала `typeof import('fs')` -- ТИПОВУЮ позицию, которая стирается
  # компилятором и не может повлиять ни на что. Регэксп знает написание;
  # значение это или тип, знает только разбор.
  ( cd "$ROOT" && node -e '
    const fs = require("fs"), { execFileSync } = require("child_process")
    const m = require("./scripts/lib/mock-factory-imports.cjs")
    m.selfCheck()
    console.log("самопроверка: 5 образцов сошлись (опасная форма против четырёх похожих)\n")
    const files = execFileSync("git", ["ls-files"], { encoding: "utf8" }).split("\n")
      .filter(f => /\.(ts|mts|cts|js|mjs|cjs)$/.test(f) && /__tests__|\.test\./.test(f))
    let factories = 0, hits = 0
    for (const f of files) {
      if (!fs.existsSync(f)) continue
      const raw = fs.readFileSync(f, "utf8")
      // Counted on CODE: a commented-out or quoted vi.mock( is not a factory.
      // The raw count said 699 where 693 exist.
      factories += m.countFactories(raw)
      for (const h of m.bareBuiltinsInMockFactories(raw, f)) {
        hits++
        console.log("  ГОЛЫЙ  " + f + ":" + h.line + "  " + h.module + "  ->  node:" + h.module)
      }
    }
    console.log("фабрик просмотрено: " + factories)
    console.log("голых встроенных внутри них: " + hits + (hits ? "" : "  (класс пуст)"))
  ' )
}

cmd_credit_sites() {
  # ГДЕ РЕПОЗИТОРИЙ НАЧИСЛЯЕТ ДЕНЬГИ. КАЖДЫЙ САЙТ -- ПОВЕРХНОСТЬ ЧЕКАНКИ.
  #
  # Повтор начисления удваивает деньги, поддельная нагрузка чеканит, сумма из
  # недоверенного входа чеканит сколько попросят. Перепись держит ИЗВЕСТНУЮ
  # популяцию; новый сайт обязан пройти через человека.
  #
  # Единица счёта -- ВЫЗОВ, а не окно строк. Прошлый матчер искал MONEY_INCOME
  # в восьми строках после вызова и ошибался ЧЕТЫРЬМЯ способами сразу:
  # комментарий в двенадцать строк прятал два обучающих сайта (один ЖИВОЙ),
  # окно в сорок выдумывало три несуществующих, сырой текст засчитывал
  # комментарии, а начисление с типом REFUND было невидимо целиком -- включая
  # живую сцену aiCoverWizard.
  #
  # Читается замаскированный код, берётся сбалансированный список аргументов,
  # прослеживается ОДИН хоп через локальную переменную (так делает
  # refundAndTell). Настраивать нечего: числа-окна больше нет.
  ( cd "$ROOT" && node -e '
    const c = require("./scripts/lib/credit-sites.cjs")
    c.selfCheck()
    const r = c.creditCallsByFile("src")
    const files = Object.keys(r).sort()
    const calls = Object.values(r).reduce((a, b) => a + b, 0)
    console.log("самопроверка: " + c.SAMPLES.length + " образцов сошлись, обе стороны")
    console.log("написания начисления: " + c.CREDIT_TYPES.join(" | "))
    console.log("кредитных сайтов: " + files.length + " файлов, " + calls + " вызовов\n")
    for (const f of files) console.log("  " + r[f] + "  " + f)
  ' )
}

