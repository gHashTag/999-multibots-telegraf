    for i in range(RUNS):
        code, body, ms = call(f'/api/voice/transcribe?lang={lang}', clips[i % len(clips)], 'audio/mpeg')
        text = json.loads(body).get('text', '') if code == 200 else body[:100].decode(errors='replace')
        if not (code == 200 and probe in text.lower()):
            missed.append(text)
            if code != 200:
