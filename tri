                          deduplicate. Reads rows, not code; --gate fails only on a
                          violation inside the window (LEDGER_SINCE, default this year)
  tri витрина <f.html>    re-measure what the owner dashboard CLAIMS against the ledger;
                          the claimed values are read from the artifact, never hardcoded
  tri сверка              who actually paid, among the invoices we still call PENDING
                          (independent channel: Robokassa OpStateExt, read-only,
                          credits nobody -- needs ROBOKASSA_PASSWORD_2)
  tri воронка             is anybody using this? generations and charges by month
  tri платежи [--gate|--detail]    top-ups pressed and never credited; --gate reds on fresh ones
  tri события             the dark segment: arrival to payment, step by step
  tri ключи [--gate]      ask each provider whether the key still works, not whether it is set
                          (needs a railway-linked checkout, not a worktree)
  tri help
СПРАВКА
}

# ─────────────────────────────────────────────────────────────────────────
# КТО ОТВЕТИЛ. Самая дорогая ошибка этого репозитория — теперь одна команда.
#
# Гвард и маршрут отвечают ОДНИМ И ТЕМ ЖЕ статусом 401. Отличить их можно
# только по словарю в теле. Четырежды я принимал отказ гварда за ответ своего
# маршрута — и однажды выложил в прод два маршрута, которые нельзя вызвать.
# ─────────────────────────────────────────────────────────────────────────
cmd_who() {
  local route="${1:?нужен путь, например /api/auth/pair/claim}"
  local verb="${2:-POST}"
  local payload="${3:-{\}}"

  local raw status body
  raw=$(curl -s -m 25 -X "$verb" "$RENDER$route" \
          -H 'Content-Type: application/json' \
          ${payload:+-d "$payload"} -w '\n%{http_code}' 2>/dev/null)
  status=$(printf '%s' "$raw" | tail -1)
  body=$(printf '%s' "$raw" | sed '$d')

  printf '  %s %s → %s\n' "$verb" "$route" "$status"
  printf '  %s\n' "$(printf '%s' "$body" | head -c 300)"

  # Словарь гварда: эти фразы печатает ТОЛЬКО общая проверка на входе.
  if printf '%s' "$body" | grep -qE 'no X-Api-Key|no Telegram initData|"unauthorized"'; then
    bad 'ответил ГВАРД — до маршрута не дошло'
    # КОНТРОЛЬНАЯ ПРОБА. Отказ гварда НЕ ГОВОРИТ, существует ли маршрут.
    #
    # Найдено разведкой: без ключа сервер отвечает одинаковым 401 и на живой
    # маршрут, и на заведомо выдуманный. То есть прежняя формулировка «его нет
    # в PUBLIC_EXACT» была догадкой, выданной за вывод: путь мог просто не
    # существовать, и совет искать его в списке публичных увёл бы не туда.
    #
    # Поэтому дёргаем заведомо несуществующий путь. Если он отвечает тем же —
    # проба про существование не говорит ничего, и это надо сказать вслух.
    local control
    control=$(curl -s -m 15 -X "$verb" "$RENDER/api/tri-control-$$-does-not-exist" \
                -H 'Content-Type: application/json' -d '{}' 2>/dev/null)
    if printf '%s' "$control" | grep -qE 'no X-Api-Key|"unauthorized"'; then
      paint '31' '       ВНИМАНИЕ: выдуманный путь отвечает тем же отказом.'
      paint '31' '       Значит проба НЕ РАЗЛИЧАЕТ «маршрут закрыт» и «маршрута нет».'
      paint '31' '       Повторите с ключом: curl -H "X-Api-Key: ..." — тогда'
      paint '31' '       несуществующий путь даст 404, а закрытый останется 401.'
    else
      paint '31' '       выдуманный путь отвечает иначе — значит этот маршрут ЕСТЬ,'
      paint '31' '       и его нет в PUBLIC_EXACT (auth.ts).'
    fi
    return 1
  fi
  if [ -z "$body" ]; then
    warn 'пустое тело — сказать нечего, проверьте адрес и метод'
    return 2
  fi
  good 'ответил САМ МАРШРУТ — он жив'
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
# ВХОДИТ ЛИ ФАЙЛ В ПРОГРАММУ TSC.
# Однажды я влил файл, который не импортировал никто: tsc его не видел, и ноль
# ошибок означал «не проверялось». Внутри было обращение к несуществующему полю.
# ─────────────────────────────────────────────────────────────────────────
cmd_in_tsc() {
  local target="${1:?нужен путь к файлу}"

  # ТРЕТИЙ ИСХОД. Раньше несуществующему файлу эта команда отвечала «НЕ в
  # программе» — то есть выдавала отсутствие данных за отрицательный ответ.
  # Тот же изъян, что у ворот, принявших пропавший node_modules за красные
  # тесты, и у проверки живости, совпавшей на подстроке.
  if [ ! -f "$target" ]; then
    warn "файла $target нет — померить нечего"
    paint '33' '       Это НЕ «не в программе»: данных просто не получено.'
    return 3
  fi
  local conf="${2:-}"
  local base; base="$(basename "$target")"
  local here; here="$(cd "$(dirname "$target")" && pwd)"

  if [ -z "$conf" ]; then
    local walk="$here"
    while [ "$walk" != "/" ]; do
      if [ -f "$walk/tsconfig.json" ]; then conf="$walk/tsconfig.json"; break; fi
      walk="$(dirname "$walk")"
    done
  fi
  require_fresh || return 3
  [ -f "$conf" ] || { bad 'tsconfig не найден'; return 1; }

  printf '  конфиг: %s\n' "$conf"
  local hits
  # Считаем ВЕСЬ вывод, а не только совпадения: пустой список файлов означает,
  # что tsc не отработал вовсе, и тогда ноль совпадений ничего не доказывает.
  local listing
  listing=$(cd "$(dirname "$conf")" \
    && npx tsc -p "$conf" --noEmit --pretty false --listFiles 2>/dev/null)
  if [ -z "$listing" ]; then
    warn 'tsc не выдал списка файлов — померить не удалось'
    paint '33' '       Проверьте, что зависимости на месте и конфиг читается.'
    return 3
  fi
  hits=$(printf '%s' "$listing" | grep -c "/$base$")

  if [ "${hits:-0}" -gt 0 ]; then
    good "$base В программе — ноль ошибок здесь что-то значит"
  else
    bad "$base НЕ в программе — ноль ошибок не значит ничего"
    paint '31' '       include его не тянет, и никто его не импортирует'
    return 1
  fi
}

# ─────────────────────────────────────────────────────────────────────────
# ОТКАЗ МЕРИТЬ ПО УСТАРЕВШЕЙ КОПИИ.
#
# Найдена первопричина семи подряд «померил не тот артефакт»: рабочая копия в
# корне репозитория отставала от origin/main на 144 коммита, и файла, который
# искали, в ней не было ВООБЩЕ. grep уверенно отвечал «не найдено» — и был
# формально прав насчёт этой копии, и полностью неверен насчёт мира.
#
# Молчаливый неверный ответ дороже отказа отвечать. Поэтому команды, которые
# меряют локальные файлы, сначала спрашивают, насколько копия свежая.
# ─────────────────────────────────────────────────────────────────────────
require_fresh() {
  local behind
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null || true
  behind=$(git -C "$ROOT" rev-list --count HEAD..origin/main 2>/dev/null)
  [ -z "${behind:-}" ] && return 0          # не git-дерево — мерить нечему мешать

  if [ "$behind" -gt 5 ]; then
    bad "копия отстаёт от origin/main на $behind коммитов"
    paint '31' '       Замер по ней НИЧЕГО не значит: искомого файла может не быть'
    paint '31' '       в этой копии вовсе, и «не найдено» будет ложью.'
    paint '31' "       Мерьте выложенный артефакт или свежее дерево от origin/main."
    # Возврат 3, а не 1: вызывающий отличит «устарело» от «не нашлось».
    return 3
  fi
  [ "$behind" -gt 0 ] && warn "копия отстаёт на $behind коммитов — держите в уме"
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
# ЖИВ ЛИ КОМПОНЕНТ В СБОРКЕ.
# В этом репозитории трижды правили файлы, которые ничто не рендерит:
# AssetBrowser, VerticalTabs, BottomNavigation. И семь раз мерили индексный
# бандл вместо ленивого чанка, где код на самом деле лежит.
# ─────────────────────────────────────────────────────────────────────────
cmd_alive() {
  local needle="${1:?нужна отличительная строка из компонента}"
  local built="${2:?нужен каталог сборки, например apps/vibee-editor/player/dist}"

  require_fresh || return 3
  # Каталог сборки может существовать и быть пустым — тогда «строки нет»
  # означает «нечего искать», а не «код мёртв».
  if [ ! -d "$built" ]; then
    warn "нет каталога $built — померить нечего, соберите сначала"
    return 3
  fi
  if [ -z "$(ls -A "$built" 2>/dev/null)" ]; then
    warn "каталог $built пуст — сборки нет, вывод ничего не докажет"
    return 3
  fi

  local hits
  hits=$(grep -rl -- "$needle" "$built" 2>/dev/null)
  if [ -z "$hits" ]; then
    bad 'строки нет ни в одном чанке — код мёртв или не собран'
    return 1
  fi
  good 'найдено в собранных чанках:'
  printf '       %s\n' $hits
}

# ─────────────────────────────────────────────────────────────────────────
# МУТАЦИЯ. Тест, который не краснеет от поломки, не проверяет ничего.
# Однажды мутация прошла зелёной — и это была не удача, а дыра в покрытии.
# ─────────────────────────────────────────────────────────────────────────
MUT_KEEP=""
MUT_FILE=""
restore_mutation() {
  # Идемпотентно: зовётся и явно после прогона, и ловушкой на выходе.
  if [ -n "${MUT_KEEP:-}" ] && [ -f "${MUT_KEEP:-}" ] && [ -n "${MUT_FILE:-}" ]; then
    cp "$MUT_KEEP" "$MUT_FILE"
    rm -f "$MUT_KEEP"
    MUT_KEEP=""
  fi
}

cmd_mutate() {
  # Break the code, run the test, expect red, revert, expect green. A test that
  # does not go red when you break the code checks nothing -- and this is the
  # ritual I kept performing by hand (copy, patch, run, restore) for several
  # cycles before `tri map` showed me the command was already here.
  #   tri mutate <file> <from> <to> <test>
  local target="${1:?нужен файл}"
  local from="${2:?что заменить}"
  local to="${3:?на что}"
  local spec="${4:?нужен путь к тесту}"
  [ -f "$target" ] || { bad "нет файла $target"; return 1; }

  # ВНЕ функции, а не local: ловушка срабатывает при выходе из СКРИПТА, когда
  # локальных переменных уже нет. Первая версия падала там с «unbound variable»
  # — восстановление при этом уже произошло, но сообщение выглядело как сбой.
  MUT_KEEP="$(mktemp)"
  MUT_FILE="$target"
  cp "$target" "$MUT_KEEP"
  trap 'restore_mutation' EXIT INT TERM

  if ! grep -qF -- "$from" "$target"; then
    bad "строка «$from» в файле не найдена — мутировать нечего"
    return 1
  fi

  python3 - "$target" "$from" "$to" <<'PY'
import io, sys
path, a, b = sys.argv[1], sys.argv[2], sys.argv[3]
src = io.open(path, encoding='utf-8').read()
io.open(path, 'w', encoding='utf-8').write(src.replace(a, b, 1))
PY

  printf '  сломано, гоняю тест…\n'
  # ТРЕТИЙ ИСХОД, и здесь он опаснее всех.
  #
  # `npx vitest` возвращает ненулевой код и когда тест упал, и когда он НЕ
  # ЗАПУСТИЛСЯ — нет node_modules, не читается конфиг, нет самого файла.
  # Без разбора вывода команда объявила бы «покраснел, как должен» и выдала
  # непроведённую проверку за пройденную. Это ложь в сторону уверенности,
  # то есть худшая из возможных здесь.
  local runout
  runout=$(cd "$ROOT" && npx vitest run "$spec" 2>&1)
  if printf '%s' "$runout" | grep -qE 'MODULE_NOT_FOUND|Cannot find module|No test files found'; then
    bad 'тест НЕ ЗАПУСТИЛСЯ — мутация ничего не проверила'
    paint '31' '       Это окружение, а не код. Поставьте зависимости и повторите.'
    return 3
  fi
  # MATCH FAILURE ONLY.
  #
  # This read `[0-9]+ (passed|failed)`, which vitest prints in BOTH outcomes:
  # "Tests  4 passed" when green and "Tests  1 failed | 3 passed" when red. The
  # negation was therefore true only when there was no summary line at all --
  # a case the previous branch already handles -- so the "mutant survived"
  # verdict was dead code and this command reported success unconditionally.
  # The one command whose entire purpose is catching a surviving mutant could
  # not catch one. Proven 2026-08-29 by mutating a file the chosen test never
  # imports: it still said the test went red.
  if ! printf '%s' "$runout" | grep -qE '[0-9]+ failed'; then
    bad 'тест ПРОШЁЛ на сломанном коде — он проверяет не то, что вы думали'
    paint '31' '       это находка, а не облегчение: покрытия здесь нет'
    return 1
  fi
  good 'тест покраснел, как и должен'

  restore_mutation
  printf '  откатил, гоняю снова…\n'
  if (cd "$ROOT" && npx vitest run "$spec" >/dev/null 2>&1); then
    good 'на целом коде зелено — проверка доказала себя в обе стороны'
    return 0
  fi
  bad 'после отката всё ещё красно — сломано что-то ещё'
  return 1
}

cmd_deployed() {
  # fetch ПЕРЕД сравнением. Без него сравниваем с тем, каким origin/main был на
  # прошлой синхронизации, и получаем ложную тревогу. Уже случалось.
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null \
    || warn 'origin/main не обновлён, сравнение может отставать'

  local live head expected
  live=$(curl -s -m 20 "$RENDER/health" \
    | python3 -c 'import sys,json;print(json.load(sys.stdin).get("version","?"))' 2>/dev/null)
  head=$(git -C "$ROOT" rev-parse --short origin/main 2>/dev/null)

  # COMPARE AGAINST WHAT THIS SERVICE ACTUALLY BUILDS, not the head of main.
  #
  # Railway rebuilds the render service only when a push touched its paths, so a
  # docs commit on top rebuilds nothing -- correctly. Comparing with the head
  # therefore reported "выкладка отстаёт" after every report commit, while the
  # service carried every line that affects it. The identical defect was found
  # and fixed in .claude/loop-opus/anomalies.mjs on 2026-08-29; it lived on here
  # because the two checks were never read side by side.
  expected=$(git -C "$ROOT" log -1 --format=%h origin/main \
    -- apps/vibee-editor/render 2>/dev/null)
  [ -z "$expected" ] && expected="$head"

  printf '  прод: %s | собирается из: %s | origin/main: %s\n' \
    "${live:-нет ответа}" "$expected" "$head"
  if [ -z "$live" ] || [ "$live" = "?" ]; then
    # NOT MEASURED, and the exit code has to say so.
    #
    # This used to warn and fall off the end of the function, which returns 0 --
    # so `tri deployed` reported success having compared NOTHING, the same
    # false green the gate was just cleared of. Found 2026-08-29 by a verifier
    # reading this file while checking a different fix.
    skip 'прод не назвал версию — сверить нечем (НЕ ИЗМЕРЕНО)'
    return 2
  elif [ "${expected#"$live"}" != "$expected" ]; then
    # PREFIX match, not equality: /health reports 7 characters and
    # `git rev-parse --short` gives 8 on this repository, so `=` was false for
    # an up-to-date deploy and this command declared a lag on its very first
    # honest run. anomalies.mjs already compares by prefix for the same reason.
    if [ "$expected" = "$head" ]; then
      good 'выложено то же, что в main'
    else
      good "выложена последняя правка рендера ($expected); main ушёл дальше мимо него"
    fi
    return 0
  elif git -C "$ROOT" merge-base --is-ancestor "$live" origin/main 2>/dev/null; then
    bad "выкладка отстаёт: на проде $live, а рендер собирается из $expected"
    return 1
  else
    bad "на проде $live — этого коммита в main нет"
    return 1
  fi
}

cmd_diverged() {
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null
  local counts behind ahead
  counts=$(git -C "$ROOT" rev-list --left-right --count origin/main...HEAD 2>/dev/null)
  behind=$(printf '%s' "$counts" | cut -f1)
  ahead=$(printf '%s' "$counts" | cut -f2)
  printf '  позади origin/main: %s | впереди: %s\n' "${behind:-?}" "${ahead:-?}"
  if [ "${behind:-0}" -gt 20 ]; then
    bad 'ветка сильно устарела — правку ведите ОТ origin/main'
    return 1
  elif [ "${ahead:-0}" -gt 0 ]; then
    warn "$ahead своих коммитов не выложено"
  else
    good 'в ногу с origin/main'
  fi
}

# ─────────────────────────────────────────────────────────────────────────
# ЛИТЕРАЛЬНЫЕ ЦВЕТА И РАЗМЕРЫ В SWIFT.
#
# Дизайн расползается не разом, а по одному литералу за правку: где-то
# .green вместо акцента, где-то Color.black вместо фона. Каждый по
# отдельности безобиден, вместе — экран, не похожий на веб.
#
# Веб держит значения в :root и потому не расползается. У Swift такого
# места не было; после приведения оно есть — Theme.swift. Эта команда
# показывает, что мимо него всё ещё пишут.
#
# ПОЧЕМУ ШАБЛОН ПЕРЕПИСАН. Первая версия была сломана в ОБЕ стороны, и обе
# поломки измерены, а не предположены.
#
#   Ложь первая — лишнее. Она ловила «.system(size:» целиком и показывала
#   нарушением строку
#       .font(.system(size: Тема.Кегль.xs, weight: .semibold))
#   то есть ровно ИСПОЛЬЗОВАНИЕ токена, ради которого всё затевалось.
#
#   Ложь вторая, хуже — недостающее. В ветку про имена цветов затесался
#   байт 0x08 (настоящий backspace вместо двух знаков «\» и «b»), и вся
#   ветка не совпадала НИ С ЧЕМ. Файл с «Color.black» и «.green» команда
#   объявляла чистым. Проверка «на дереве ноль» этого не видит: молчать
#   умеет и мёртвый шаблон — потому ниже появилась самопроверка.
#
# Теперь ловится ЛИТЕРАЛ, а не упоминание:
#     .system(size: 14)             да — сразу после «size:» стоит цифра
#     .system(size: Тема.Кегль.xs)  нет — там имя токена
#     .green / Color.black          да — системный цвет по имени
#     Тема.Цвет.акцент              нет
#
# «\b» на хвосте имени обязателен: без него «.red» ловит «.reduce(». «\b»
# в голове «Color\(» отсекает «CGColor(red: 0, green: 0, …)» из конвейера
# экспорта — CGColor и UIColor намеренно вне охвата, Тема держит SwiftUI-Color,
# и кадру видео её значение не присвоить. Вернуть охват — убрать «\b» в
# COLORS_INIT, но вместе с ним вернётся и шум.
# ─────────────────────────────────────────────────────────────────────────

# Шаблоны вынесены в переменные, потому что «tri цвета проверка» гоняет
# ИМЕННО ИХ на встроенном образце. Копия разошлась бы с оригиналом на первой
# же правке, и самопроверка стала бы проверять не то, что работает.
COLORS_SIZE='\.system\(size:[[:space:]]*(CGFloat\()?[0-9]'
COLORS_NAME='\.(green|blue|red|orange|yellow|purple|pink|gray|black|white)\b'
COLORS_INIT='\bColor\([^)]*(red|white|hue):[[:space:]]*[0-9]'
COLORS_HEX='\bColor\([^)]*[Hh]ex:[[:space:]]*("#|0x)'

colors_scan() {
  # Theme.swift исключён: он и есть то место, где литералам положено быть.
  # Второй фильтр выбрасывает строки-комментарии. Прежний «grep -v '^\s*//'»
  # не выбрасывал ничего никогда: в выводе grep -n строка начинается с
  # «путь:номер:», и «^» до «//» попросту не доходит.
  grep -rn --include='*.swift' \
      -E "$COLORS_SIZE|$COLORS_NAME|$COLORS_INIT|$COLORS_HEX" "$1" 2>/dev/null \
    | grep -v '/Theme.swift:' \
    | grep -v -E ':[0-9]+:[[:space:]]*(//|\*|/\*)' \
    || true
}

# САМОПРОВЕРКА. Детектор обязан доказывать себя в обе стороны: находить
# литерал и молчать на токене. Прогон «на живом дереве ноль» доказывает
# только вторую половину — и именно поэтому мёртвая ветка с байтом 0x08
# прожила незамеченной.
colors_selftest() {
  local sandbox; sandbox=$(mktemp -d)
  cat > "$sandbox/Cases.swift" <<'ОБРАЗЕЦ'
let a = Text("x").font(.system(size: 14))                       // EXPECT-HIT
let b = Text("x").font(.system(size: 12, weight: .semibold))    // EXPECT-HIT
let c = Text("x").font(.system(size:9))                         // EXPECT-HIT
let d = Text("x").foregroundColor(.green)                       // EXPECT-HIT
let e = Rectangle().fill(Color.black)                           // EXPECT-HIT
let f = Rectangle().fill(.white.opacity(0.08))                  // EXPECT-HIT
let g = Color(red: 0.29, green: 0.87, blue: 0.50)               // EXPECT-HIT
let h = Color(вебHex: 0x00FF88)                                 // EXPECT-HIT
let i = Color(white: 0.2)                                       // EXPECT-HIT
let j = Font.system(size: CGFloat(18))                          // EXPECT-HIT
let k = Text("x").font(.system(size: Тема.Кегль.xs))            // EXPECT-MISS
let l = Text("x").font(.system(size: Тема.БезИсточника.кегль))  // EXPECT-MISS
let m = Rectangle().fill(Тема.Цвет.акцент)                      // EXPECT-MISS
let n = Тема.Цвет.границаВидимая                                // EXPECT-MISS
let o = items.reduce(0, +)                                      // EXPECT-MISS
let p = слой.backgroundColor = CGColor(red: 0, green: 0, blue: 0, alpha: 1) // EXPECT-MISS
let q = Color(Тема.Цвет.фон)                                    // EXPECT-MISS
let r = вид.grayscale(1.0)                                      // EXPECT-MISS
let s = Text("x").redacted(reason: .placeholder)                // EXPECT-MISS
ОБРАЗЕЦ

  local want found leaked out
  want=$(grep -c 'EXPECT-HIT' "$sandbox/Cases.swift" | tr -d ' ')
  out=$(colors_scan "$sandbox")
  found=$(printf '%s\n' "$out" | grep -c 'EXPECT-HIT')
  leaked=$(printf '%s\n' "$out" | grep -c 'EXPECT-MISS')
  rm -rf "$sandbox"

  printf '  литералов в образце: %s | поймано: %s | ложных срабатываний: %s\n' \
    "$want" "$found" "$leaked"
  if [ "$found" = "$want" ] && [ "$leaked" = "0" ]; then
    good 'шаблон доказан в обе стороны: ловит литералы, молчит на токенах'
    return 0
  fi
  bad 'шаблон НЕ доказан — сломан сам детектор, его выводу верить нельзя'
  return 1
}

cmd_colors() {
  if [ "${1:-}" = "проверка" ]; then colors_selftest; return $?; fi

  local dir="${1:-$ROOT/apps/vibee-ios/Vibee}"
  [ -d "$dir" ] || { bad "нет каталога $dir"; return 1; }

  local hits; hits=$(colors_scan "$dir")

  if [ -z "$hits" ]; then
    good 'литеральных цветов и размеров вне Theme.swift не найдено'
    return 0
  fi

  local n; n=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  warn "мимо Theme.swift написано $n мест:"
  printf '%s\n' "$hits" | head -25 | sed 's/^/       /'
  [ "$n" -gt 25 ] && printf '       … и ещё %s\n' "$((n - 25))"
  return 1
}

# ─────────────────────────────────────────────────────────────────────────
# ЖИВ ЛИ CI ВООБЩЕ.
#
# Найдено на 91-м витке: все проверки GitHub Actions падали за 3-4 секунды
# С НУЛЁМ ВЫПОЛНЕННЫХ ШАГОВ — отказ по оплате, а не сигнал о коде. Значит
# десятки правок влиты НЕПРОВЕРЕННЫМИ, и я всё это время писал «влито и
# проверено», имея в виду свои прогоны, а не CI.
#
# Красный CI, который всегда красный, перестают читать — ровно как врущий
# детектор. Но здесь хуже: он выглядит как работающая защита.
# ─────────────────────────────────────────────────────────────────────────
cmd_ci() {
  local runs
  runs=$(gh run list --limit 6 --json conclusion,name,startedAt,updatedAt 2>/dev/null) || {
    bad 'gh не ответил — проверить CI нечем'; return 1; }

  local total failed
  total=$(printf '%s' "$runs" | python3 -c 'import sys,json;print(len(json.load(sys.stdin)))' 2>/dev/null)
  failed=$(printf '%s' "$runs" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print(sum(1 for r in d if r.get("conclusion")=="failure"))' 2>/dev/null)

  # Секунды между стартом и концом. Прогон, падающий за считанные секунды,
  # не успел ничего выполнить — это отказ инфраструктуры, а не теста.
  local quick
  quick=$(printf '%s' "$runs" | python3 -c '
import sys,json,datetime
def t(x): return datetime.datetime.fromisoformat(x.replace("Z","+00:00"))
d=json.load(sys.stdin)
n=0
for r in d:
    try:
        s=(t(r["updatedAt"])-t(r["startedAt"])).total_seconds()
        if r.get("conclusion")=="failure" and s < 15: n+=1
    except Exception: pass
print(n)' 2>/dev/null)

  printf '  последних прогонов: %s | провалов: %s | из них короче 15 с: %s\n'     "${total:-?}" "${failed:-?}" "${quick:-?}"

  if [ "${quick:-0}" -ge 3 ]; then
    bad 'CI НЕ ВЫПОЛНЯЕТСЯ: падает за секунды, шагов не делает'
    paint '31' '       Это отказ инфраструктуры (чаще всего оплата Actions),'
    paint '31' '       а не сигнал о коде. Всё, что влито сейчас, влито ВСЛЕПУЮ.'
    return 1
  fi
  if [ "${failed:-0}" -ge 5 ]; then
    warn 'CI красный подряд — но прогоны идут долго, значит что-то реально падает'
    return 2
  fi
  good 'CI выполняется'
}

# ─────────────────────────────────────────────────────────────────────────
# РАБОТАЕТ ЛИ ФУНКЦИЯ В ВЕБЕ ВООБЩЕ.
#
# На 93-м витке список недостающего соврал дважды в одной проверке:
# комментарии числились непереносёнными, а их нет НИГДЕ (кнопка зовёт общий
# обработчик карточки, счётчик литерал 0, маршрута на сервере ноль); лайк
# числился непереносённым, а был уже подключён.
#
# Перенести неработающее — значит воспроизвести декорацию и записать себе
# паритет. Поэтому перед переносом спрашиваем не «есть ли в вебе кнопка», а
# «делает ли она что-нибудь».
# ─────────────────────────────────────────────────────────────────────────
# tri iphone [check|build|install] — the Vibee app on the REAL phone, one command.
#
# Every step had its own way to fail without saying why:
#   * a locked or unplugged phone makes xcodebuild print "Unable to find a
#     destination matching the provided destination specifier" -- nothing
#     about the phone. devicectl knows (`tunnelState`), so ask it FIRST;
#   * the phone has TWO ids: xcodebuild wants the hardware udid
#     (00008110-...), devicectl wants the CoreDevice identifier (BF368496-...).
#     Passing one where the other belongs fails as "device not found";
#   * Xcode on this machine has no Apple ID: signing goes through the App
#     Store Connect API key, and without -authenticationKey* the build stops
#     at provisioning (memory: ios-device-build-via-asc-key);
#   * `launch` without --terminate-existing raises the OLD process, and the
#     screen shows yesterday's build.
#
#   tri iphone          build, install, launch
#   tri iphone check    is the phone reachable right now (exit 0 = yes)
#   tri iphone build    compile for the phone only (no install)
#   tri iphone sim      build, install, launch on the SIMULATOR (VIBEE_SIM=udid,
#                       default: the booted one, else boots the first iPhone
#                       simulator). `simctl install` once hung for
#                       11 min and `launch` for 2: the simulator (~10 GB) had
#                       pushed swap to 5 of 6 GB. Both now have deadlines; an
#                       install that misses it gets one simulator reboot.
#   tri iphone off      shut every running simulator down (gives ~10 GB back)
#   tri iphone test [Class]  unit tests with a 25-min deadline and a one-line
#                       verdict (Class = one test class, e.g. ConnectivityTests)
#   tri iphone typecheck  type-check the app AND the tests with swiftc, no
#                       simulator (~80 s). Proves it compiles, not that the
#                       tests pass -- when swap rules out `tri iphone test`.
#   tri iphone ru [File]  native strings still Russian-only (count / lines)
#   tri iphone ru-diff [ref]  lines a counter change hides vs ref (origin/main)
#   tri iphone ru-web [file]  ROUGH count of Russian-only literals in the web
#                       player (the parity reference is not clean either)
#   VIBEE_DEVICE=name   another paired phone (default: t27_dev)
# The simulator holds ~10 GB of this 16 GB machine; the pre-push gates and the
# next build need it back. One word instead of remembering the udid.
iphone_sim_off() {
  local booted
  booted=$(xcrun simctl list devices booted | sed -nE 's/.*\(([0-9A-F-]{36})\) \(Booted\).*/\1/p')
  [ -n "$booted" ] || { good "no simulator is running"; return 0; }
  local u
  for u in $booted; do xcrun simctl shutdown "$u" && good "shut down $u"; done
  echo "  …    swap now: $(sysctl -n vm.swapusage | sed -E 's/.*(used = [^ ]+ +free = [^ ]+).*/\1/')"
}

# Native strings that only exist in Russian. The tab bar follows the phone's
# language through say(en, ru); a screen that still hard-codes Russian shows
# an English phone a mixed app. This counts what is left, so a loop can watch
# the number go down instead of re-grepping -- a plain grep both missed and
# double-counted: it saw say( calls that span lines as Russian-only.
# Not counted: say(...) and l(...) spans, comments, NSLog/print,
# accessibilityIdentifier, `== "x"` comparisons, generated files (named on
# stderr with the test that guards them), and lines marked
# ru-only-ok (data that IS Russian: a server status key, a demo project).
#   tri iphone ru          count per file and the total
#   tri iphone ru File     the lines in one file
iphone_ru() {
  local ios="$1" only="${2:-}"
  python3 - "$ios/Vibee" "$only" <<'PY'
import os, re, sys
root, only = sys.argv[1], sys.argv[2]
CYR = re.compile('[Ѐ-ӿ]')
LIT = re.compile(r'"(?:[^"\\]|\\.)*"')
# "\(лайков)" is a variable inside an interpolation, not Russian text
INTERP = re.compile(r'\\\([^)]*\)')

def blank_calls(src, names):
    # Replace name( ... ) with spaces, matching parens outside strings, so
    # line numbers survive and a call spread over lines counts as one.
    out = list(src)
    for m in re.finditer(r'\b(?:' + '|'.join(names) + r')\(', src):
        i, depth, instr = m.end(), 1, False
        while i < len(src) and depth:
            c = src[i]
            if instr:
                if c == '\\': i += 1
                elif c == '"': instr = False
            elif c == '"': instr = True
            elif c == '(': depth += 1
            elif c == ')': depth -= 1
            i += 1
        for k in range(m.start(), i):
            if out[k] != '\n': out[k] = ' '
    return ''.join(out)

# Not UI text, each found as a false hit in AgentChatView (iteration 6):
# o["тип"] is a server JSON key, `case "ход":` matches a server value, and
# ("from the bot", "из бота") on one line is already a bilingual pair.
KEY = re.compile(r'\[\s*"(?:[^"\\]|\\.)*"\s*\]')
CASE = re.compile(r'\bcase\s+"(?:[^"\\]|\\.)*"(?:\s*,\s*"(?:[^"\\]|\\.)*")*\s*:')
PAIR = re.compile(r'("(?:[^"\\]|\\.)*")(\s*,\s*)("(?:[^"\\]|\\.)*")')
# GenerateScreen (iteration 7): `kind == "видео"` compares a server value --
# only that literal goes, the UI text on the same line still counts.
CMP = re.compile(r'[=!]=\s*"(?:[^"\\]|\\.)*"')
# Iteration 15: КаталогСценария keys its English labels by the Russian value
# (`"Бизнес": "Business",`) -- the key is data, the value is the UI text.
# Line start only: a ternary's `? "a" : "b"` never starts a line with a literal.
DICTKEY = re.compile(r'^(\s*)("(?:[^"\\]|\\.)*")(\s*:)(?!:)')
# Iteration 15: Animation.swift's 22 hits were precondition messages -- they
# reach a developer's crash log, never a screen.
DEV_ONLY = ['precondition', 'preconditionFailure', 'assert', 'assertionFailure', 'fatalError']

def protocol_out(line):
    line = KEY.sub(lambda m: ' ' * len(m.group()), line)
    line = CASE.sub(lambda m: ' ' * len(m.group()), line)
    line = CMP.sub(lambda m: ' ' * len(m.group()), line)
    line = DICTKEY.sub(lambda m: m.group(1) + ' ' * len(m.group(2)) + m.group(3), line)
    return PAIR.sub(lambda m: ' ' * len(m.group())
                    if not CYR.search(m.group(1)) and CYR.search(m.group(3))
                    else m.group(), line)

def comments_out(src):
    src = re.sub(r'/\*.*?\*/', lambda m: re.sub(r'[^\n]', ' ', m.group()), src, flags=re.S)
    lines = []
    for line in src.split('\n'):
        # a // outside a string literal starts a comment
        bare = LIT.sub(lambda m: 'x' * len(m.group()), line)
        k = bare.find('//')
        lines.append(line if k < 0 else line[:k])
    return lines

# Iteration 8: KieModels.swift is written by gen-kie-swift.ts and cannot carry
# hand marks. The screen shows it through KieModelLabels, and a test fails on
# any catalogue entry whose English label keeps Cyrillic -- that test, not
# this counter, is the guard for generated words. `l(en, ru)` is the local
# pair helper of testable pure functions; a call spread over lines is a pair.
GENERATED = {'KieModels.swift': 'KieModelLabelTests'}

total, per = 0, []
for f in sorted(os.listdir(root)):
    if not f.endswith('.swift') or (only and f != only and f != only + '.swift'):
        continue
    raw = open(os.path.join(root, f), encoding='utf-8').read()
    marks = raw.split('\n')
    if f in GENERATED:
        print(f'  skipped {f}: generated, its words are checked by {GENERATED[f]}', file=sys.stderr)
        continue
    lines = [protocol_out(l) for l in comments_out(blank_calls(raw, ['say', 'l', 'NSLog', 'print', 'accessibilityIdentifier'] + DEV_ONLY))]
    hits = [(n + 1, marks[n].strip()) for n, l in enumerate(lines)
            if 'ru-only-ok' not in marks[n]
            and any(CYR.search(INTERP.sub('', x)) for x in LIT.findall(l))]
    if hits:
        total += len(hits); per.append((len(hits), f, hits))
for n, f, hits in sorted(per, reverse=True):
    if only:
        for ln, text in hits: print(f'  {f}:{ln}  {text[:120]}')
    else:
        print(f'  {n:4d}  {f}')
print(f'  total {total} Russian-only line(s)')
PY
}

# What a change to the counter itself hides or adds, on the SAME Swift files.
# Iterations 6 and 7 did this by hand: a filter that drops 36 lines must have
# every dropped line read. The old copy has to sit in $ROOT -- `tri` finds the
# app next to itself, and run from /tmp it counted another tree and printed an
# empty diff that looked like "no change".
# The web is the wording reference, and iteration 9 found it printing "· 6/с"
# and a Russian shortfall sentence in English mode. Before copying web wording,
# look here. ROUGH on purpose: en/ru pairs split over lines still count, so it
# ranks files to read, it is not a score to drive to zero.
iphone_ru_web() {
  local only="${1:-}"
  python3 - "$ROOT/apps/vibee-editor/player/src" "$only" <<'PY'
import os, re, sys
root, only = sys.argv[1], sys.argv[2]
CYR = re.compile('[Ѐ-ӿ]')
LIT = re.compile(r"'(?:[^'\\\n]|\\.)*'|\"(?:[^\"\\\n]|\\.)*\"|`(?:[^`\\]|\\.)*?`")
# a line that already chooses by language, logs, or is marked by the guard
SKIP = re.compile(r"lang\s*===?\s*'(?:ru|en)'|isRu|\bru\s*[?:]|Ru\s*:|\bt\(|"
                  r"console\.|logger\.|cyrillic-ok|ru-only-ok")
SKIP_FILES = ('language.ts',)
KEY = re.compile(r"\[\s*'[^'\n]*'\s*\]")
counts, lines = {}, []
for d, _, fs in os.walk(root):
    if 'node_modules' in d or '__tests__' in d or '/harness' in d or '/i18n' in d:
        continue
    for f in fs:
        if not f.endswith(('.ts', '.tsx')) or '.test.' in f or f in SKIP_FILES:
            continue
        if only and f != only:
            continue
        p = os.path.join(d, f)
        for n, line in enumerate(open(p, encoding='utf-8'), 1):
            code = line.split('//')[0] if '://' not in line else line
            if code.lstrip().startswith(('*', '/*')) or SKIP.search(code):
                continue
            # vd['баланс'] is a server JSON key, not text (same filter as `ru`)  # cyrillic-ok: quotes a key
            code = KEY.sub('', code)
            if any(CYR.search(m) for m in LIT.findall(code)):
                rel = os.path.relpath(p, root)
                counts[rel] = counts.get(rel, 0) + 1
                lines.append(f"  {rel}:{n}  {line.strip()[:110]}")
if only:
    print('\n'.join(lines))
else:
    for rel, c in sorted(counts.items(), key=lambda kv: -kv[1])[:25]:
        print(f"  {c:4d}  {rel}")
print(f"  total {sum(counts.values())} line(s) with a Russian literal outside a language branch (rough)")
PY
}

iphone_ru_diff() {
  local ios="$1" ref="${2:-origin/main}" old="$ROOT/.tri-ru-diff-old" f b
  git -C "$ROOT" show "$ref:tri" > "$old" 2>/dev/null || { bad "no tri at $ref"; rm -f "$old"; return 2; }
  local hidden=0 shown=0 a z
  a=$(mktemp) z=$(mktemp)
  for f in "$ios"/Vibee/*.swift; do
    b=$(basename "$f")
    bash "$old" iphone ru "$b" 2>/dev/null | grep -v ' total ' > "$a"
    iphone_ru "$ios" "$b" 2>/dev/null | grep -v ' total ' > "$z"
    while IFS= read -r l; do echo "  - hidden  ${l#  }"; hidden=$((hidden + 1)); done < <(comm -23 <(sort "$a") <(sort "$z"))
    while IFS= read -r l; do echo "  + counted ${l#  }"; shown=$((shown + 1)); done < <(comm -13 <(sort "$a") <(sort "$z"))
  done
  rm -f "$old" "$a" "$z"
  good "counter vs $ref: $hidden line(s) newly hidden, $shown newly counted -- read every hidden one"
}

# The unit tests, with the deadline and the summary every loop iteration
# typed by hand: under load they take 10+ minutes, and the verdict is one line
# in a 3000-line log. `tri iphone test FeedHandleTests` runs one class.
iphone_test() {
  local ios="$1" only="${2:-}" sim="${VIBEE_SIM:-}"
  # Same build cache as `tri iphone sim`: a cache of its own made the first
  # run a cold build, which missed the deadline under load.
  local dd="${TMPDIR:-/tmp}/tri-iphone-dd-sim" log="${TMPDIR:-/tmp}/tri-iphone-test-${2:-all}.log"
  local deadline
  deadline=$(command -v timeout || command -v gtimeout) \
    || { bad "no timeout(1) -- brew install coreutils"; return 2; }
  [ -n "$sim" ] || sim=$(xcrun simctl list devices booted | sed -nE 's/.*\(([0-9A-F-]{36})\) \(Booted\).*/\1/p' | head -1)
  [ -n "$sim" ] || sim=$(xcrun simctl list devices available | sed -nE 's/^ +iPhone.*\(([0-9A-F-]{36})\) \(Shutdown\).*/\1/p' | head -1)
  [ -n "$sim" ] || { bad "no iPhone simulator at all -- create one in Xcode, or set VIBEE_SIM=udid"; return 1; }
  local free_mb
  free_mb=$(df -m "${TMPDIR:-/tmp}" | awk 'NR==2 {print $4}')
  [ "${free_mb:-0}" -lt 2048 ] && { bad "only ${free_mb} MB free, need 2048 -- see tri disk, or rm -rf $dd"; return 1; }
  local target="VibeeTests${only:+/$only}"
  echo "  …    $target on $sim, deadline 25 min (log: $log)"
  ( cd "$ios" && xcodegen generate --quiet && "$deadline" 1500 xcodebuild test -scheme Vibee \
      -destination "id=$sim" -derivedDataPath "$dd" -only-testing:"$target" ) >"$log" 2>&1
  local rc=$?
  local verdict
  verdict=$(grep -E "Executed [0-9]+ tests?" "$log" | tail -1 | sed -E 's/^[[:space:]]+//')
  # A misspelt class runs nothing and xcodebuild still says success.
  if [ "$rc" -eq 0 ] && grep -qE "Executed 0 tests" <<<"$verdict"; then
    bad "ran 0 tests -- is there a class named '$only' in VibeeTests?"; return 1
  fi
  if [ "$rc" -eq 0 ]; then
    good "${verdict:-tests passed}"
  elif [ "$rc" -eq 124 ]; then
    # Say where it stopped, not why: the first such message named a cause
    # (a starved machine) nobody had measured. Swap is a lead, not a verdict.
    bad "no verdict in 25 min; swap: $(sysctl -n vm.swapusage | sed -E 's/.*(free = [^ ]+).*/\1/'); the log ends with:"
    tail -4 "$log" | cut -c1-140 | sed 's/^/       /'
  else
    bad "${verdict:-did not build}"
    grep -E "error: |: error:|failed \(" "$log" | sort -u | head -10 | sed 's/^/       /'
  fi
  return "$rc"
}

# Iteration 15: swap at 9 of 11 GB kept the simulator (and so `iphone test`)
# out for hours, and Swift edits waited unverified. swiftc can type-check the
# app and the tests against the simulator SDK with no device at all: emit the
# app as a testable module, then check the tests against it. XCTest lives
# outside the SDK proper, hence the platform -I/-F paths.
iphone_typecheck() {
  local ios="$1" target="arm64-apple-ios17.0-simulator" t plat rc log
  plat="$(xcrun --sdk iphonesimulator --show-sdk-platform-path)/Developer" || { bad "no iphonesimulator SDK"; return 2; }
  t=$(mktemp -d) log="$t/log"
  echo "  …    app: emit module + type-check ($target)"
  ( cd "$ios" && xcrun --sdk iphonesimulator swiftc -emit-module -enable-testing \
      -module-name Vibee -target "$target" -emit-module-path "$t/Vibee.swiftmodule" \
      Vibee/*.swift ) >"$log" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    bad "the app does not type-check"
    grep -E ": error:" "$log" | sort -u | head -15 | sed 's/^/       /'
    rm -rf "$t"; return "$rc"
  fi
  good "app type-checks ($(grep -c ': warning:' "$log") warning(s))"
  echo "  …    tests: type-check against the app module"
  ( cd "$ios" && xcrun --sdk iphonesimulator swiftc -typecheck -target "$target" \
      -I "$t" -I "$plat/usr/lib" -F "$plat/Library/Frameworks" VibeeTests/*.swift ) >"$log" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    bad "the tests do not type-check"
    grep -E ": error:" "$log" | sort -u | head -15 | sed 's/^/       /'
  else
    good "tests type-check -- compiled, NOT run: \`tri iphone test\` still owes the verdict"
  fi
  rm -rf "$t"; return "$rc"
}

iphone_sim() {
  local ios="$1" sim="${VIBEE_SIM:-}"
  local dd="${TMPDIR:-/tmp}/tri-iphone-dd-sim" log="${TMPDIR:-/tmp}/tri-iphone-sim.log"
  local deadline
  deadline=$(command -v timeout || command -v gtimeout) \
    || { bad "no timeout(1) -- brew install coreutils"; return 2; }
  [ -n "$sim" ] || sim=$(xcrun simctl list devices booted | sed -nE 's/.*\(([0-9A-F-]{36})\) \(Booted\).*/\1/p' | head -1)
  # `xcodebuild test` shuts its simulator down when it finishes, so "nothing
  # booted" is the normal state right after the tests -- boot one instead of
  # failing. Same deadline idea as install: a starved machine boots for minutes.
  [ -n "$sim" ] || sim=$(xcrun simctl list devices available | sed -nE 's/^ +iPhone.*\(([0-9A-F-]{36})\) \(Shutdown\).*/\1/p' | head -1)
  [ -n "$sim" ] || { bad "no iPhone simulator at all -- create one in Xcode, or set VIBEE_SIM=udid"; return 1; }
  if ! xcrun simctl list devices booted | grep -q "$sim"; then
    echo "  …    booting simulator $sim"
    xcrun simctl boot "$sim" 2>/dev/null
    "$deadline" 300 xcrun simctl bootstatus "$sim" -b >/dev/null 2>&1 \
      || { bad "simulator $sim did not finish booting in 300 s"; return 1; }
  fi
  local free_mb
  free_mb=$(df -m "${TMPDIR:-/tmp}" | awk 'NR==2 {print $4}')
  if [ "${free_mb:-0}" -lt 2048 ]; then
    bad "only ${free_mb} MB free, need 2048 -- see tri disk, or rm -rf $dd"; return 1
  fi
  # A booted iPhone simulator is ~140 processes and ~10 GB resident; on this
  # 16 GB machine that pushed swap to 5 of 6 GB and install/launch hung with
  # no error (2026-10-02). `memory_pressure` still said 38% free, so ask swap.
  local swap_free
  swap_free=$(sysctl -n vm.swapusage | sed -E 's/.*free = ([0-9]+)\..*/\1/')
  [ "${swap_free:-9999}" -lt 1024 ] && warn "swap has ${swap_free} MB left -- the simulator will crawl; close what you can"
  # Only the simctl process itself: wrappers (xcrun, a tool's launcher) carry
  # the same command line and would count one stream twice. The simulator
  # panel keeps a narrow orientation stream of its own; that one is cheap.
  local stray
  stray=$(pgrep -fl "bin/simctl spawn $sim log (stream|show)" | grep -v "interface orientation")
  [ -n "$stray" ] && warn "log stream/show on $sim (each loads the simulator; kill yours):" \
    && sed -E 's/.*(log (stream|show))/       \1/' <<<"$stray" | cut -c1-120
  echo "  …    building for simulator $sim (log: $log)"
  if ! ( cd "$ios" && xcodegen generate --quiet && xcodebuild -scheme Vibee \
      -destination "id=$sim" -derivedDataPath "$dd" build -quiet ) >"$log" 2>&1; then
    bad "build failed:"; grep -E "error:" "$log" | head -8 | sed 's/^/       /'
    return 1
  fi
  good "built"
  local app="$dd/Build/Products/Debug-iphonesimulator/Vibee.app"
  if ! "$deadline" 240 xcrun simctl install "$sim" "$app" >>"$log" 2>&1; then
    warn "install did not finish in 240 s -- rebooting the simulator once"
    "$deadline" 90 xcrun simctl shutdown "$sim" >>"$log" 2>&1
    "$deadline" 120 xcrun simctl boot "$sim" >>"$log" 2>&1
    "$deadline" 120 xcrun simctl bootstatus "$sim" -b >>"$log" 2>&1
    "$deadline" 240 xcrun simctl install "$sim" "$app" >>"$log" 2>&1 \
      || { bad "install failed after a reboot too: tail $log"; return 1; }
  fi
  good "installed"
  local rc
  "$deadline" 120 xcrun simctl launch --terminate-running-process "$sim" ai.t27.vibee >>"$log" 2>&1
  rc=$?
  if [ "$rc" = 124 ]; then
    bad "launch did not answer in 120 s -- the simulator is starved (swap? tri iphone sim warns), not the app"
    return 1
  elif [ "$rc" != 0 ]; then
    bad "launch failed: tail $log"; return 1
  fi
  good "launched the fresh build on simulator $sim"
}

cmd_iphone() {
  local mode="${1:-all}" name="${VIBEE_DEVICE:-t27_dev}"
  local json="${TMPDIR:-/tmp}/tri-iphone-devices.json"
  local dd="${TMPDIR:-/tmp}/tri-iphone-dd"
  local ios="$ROOT/apps/vibee-ios"
  local key="$HOME/.appstoreconnect/private_keys/AuthKey_R3JF4GL93F.p8"
  local keyjson="$HOME/.appstoreconnect/fastlane-key.json"

  [ "$mode" = "sim" ] && { iphone_sim "$ios"; return; }
  [ "$mode" = "off" ] && { iphone_sim_off; return; }
  [ "$mode" = "test" ] && { iphone_test "$ios" "${2:-}"; return; }
  [ "$mode" = "typecheck" ] && { iphone_typecheck "$ios"; return; }
  [ "$mode" = "ru" ] && { iphone_ru "$ios" "${2:-}"; return; }
  [ "$mode" = "ru-diff" ] && { iphone_ru_diff "$ios" "${2:-}"; return; }
  [ "$mode" = "ru-web" ] && { iphone_ru_web "${2:-}"; return; }

  if ! xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1; then
    bad "devicectl did not answer (Xcode command line tools?)"; return 2
  fi
  local row
  row=$(python3 - "$json" "$name" <<'PY'
import json, sys
devs = json.load(open(sys.argv[1]))["result"]["devices"]
for d in devs:
    if d["deviceProperties"].get("name") == sys.argv[2]:
        c = d.get("connectionProperties", {})
        print(d["identifier"], d["hardwareProperties"].get("udid", ""),
              c.get("tunnelState", "?"), c.get("pairingState", "?"))
        break
PY
)
  if [ -z "$row" ]; then
    bad "no paired device named '$name' -- set VIBEE_DEVICE, known:"
    python3 -c "import json,sys;[print('       '+d['deviceProperties'].get('name','?')) for d in json.load(open(sys.argv[1]))['result']['devices']]" "$json"
    return 2
  fi
  local core udid tunnel pairing
  read -r core udid tunnel pairing <<<"$row"
  # An idle tunnel closes within seconds, so "disconnected" on a paired
  # phone usually means asleep, not gone: one request to the device opens
  # it again (measured 2026-10-02 on t27_dev over Wi-Fi).
  if [ "$mode" != "build" ] && [ "$tunnel" = "disconnected" ] && [ "$pairing" = "paired" ]; then
    timeout 60 xcrun devicectl device info details --device "$core" >/dev/null 2>&1 && tunnel=connected
  fi
  if [ "$mode" = "build" ]; then
    : # compiling for the phone does not need the phone
  elif [ "$tunnel" != "connected" ]; then
    bad "$name is $tunnel (paired: $pairing) -- unlock it and keep it on the cable or the same Wi-Fi"
    return 1
  else
    good "$name reachable (udid $udid, core $core)"
  fi
  [ "$mode" = "check" ] && return 0

  # The iOS build is the largest single eater of disk here (run.sh paid for
  # this: a full disk left the loop unable even to write). Refuse up front;
  # the derived-data dir is ONE fixed path, so builds reuse it, not stack.
  local free_mb
  free_mb=$(df -m "${TMPDIR:-/tmp}" | awk 'NR==2 {print $4}')
  if [ "${free_mb:-0}" -lt 2048 ]; then
    bad "only ${free_mb} MB free, need 2048 -- see tri disk, or rm -rf $dd"; return 1
  fi
  [ -f "$key" ] && [ -f "$keyjson" ] || { bad "App Store Connect key missing: $key / $keyjson"; return 2; }
  local issuer
  issuer=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['issuer_id'])" "$keyjson") || return 2
  local dest="id=$udid"
  [ "$mode" = "build" ] && dest="generic/platform=iOS"
  local log="${TMPDIR:-/tmp}/tri-iphone-build.log"
  echo "  …    building for $dest (log: $log)"
  if ! ( cd "$ios" && xcodegen generate --quiet && xcodebuild -scheme Vibee -destination "$dest" \
      -derivedDataPath "$dd" -allowProvisioningUpdates -allowProvisioningDeviceRegistration \
      -authenticationKeyPath "$key" -authenticationKeyID R3JF4GL93F \
      -authenticationKeyIssuerID "$issuer" build -quiet ) >"$log" 2>&1; then
    bad "build failed:"; grep -E "error:" "$log" | head -8 | sed 's/^/       /'
    return 1
  fi
  good "built"
  [ "$mode" = "build" ] && return 0

  local app="$dd/Build/Products/Debug-iphoneos/Vibee.app"
  xcrun devicectl device install app --device "$core" "$app" >"$log" 2>&1 \
    || { bad "install failed:"; tail -5 "$log" | sed 's/^/       /'; return 1; }
  good "installed"
  xcrun devicectl device process launch --device "$core" --terminate-existing ai.t27.vibee >"$log" 2>&1 \
    || { bad "launch failed (phone locked?):"; tail -5 "$log" | sed 's/^/       /'; return 1; }
  good "launched the fresh build on $name"
}

cmd_real() {
  local name="${1:?нужно имя функции, например like или comment}"
  local web="$ROOT/apps/vibee-editor/player/src"
  local server="$ROOT/apps/vibee-editor/render/render-server.ts"
  local ios="$ROOT/apps/vibee-ios/Vibee"

  printf '  функция: %s\n' "$name"

  # 1. Есть ли на сервере маршрут, который вообще про это.
  local route
  # Тот же капкан, что с literal: -c по нескольким файлам даёт число на файл.
  route=$(grep -oiE "['\"/]${name}['\"]|/${name}\\b" "$server" 2>/dev/null | wc -l | tr -d ' ')

  # 2. Зовёт ли веб отдельный обработчик, или общий onClick карточки.
  local handler
  handler=$(grep -rhoE "on[A-Z][a-zA-Z]*=\{[a-zA-Z]*${name}[a-zA-Z]*\}" "$web" 2>/dev/null | head -1)

  # 3. Захардкожен ли счётчик рядом. Литерал в разметке — верный признак
  #    заглушки: настоящее число приходит из данных.
  local literal
  # `grep -c` печатает число НА КАЖДЫЙ файл, и при нескольких файлах
  # получается "0\n0\n1" — сравнение с числом падает с "integer expression
  # expected". Считаем совпадения, а не доверяем -c.
  literal=$(grep -rniE -A3 "\{/\* *${name}" "$web" 2>/dev/null \
    | grep -oE '<span>[0-9]+</span>' | wc -l | tr -d ' ')

  # 4. Знает ли о ней приложение.
  local native
  native=$(grep -rilE "${name}" "$ios" 2>/dev/null | wc -l | tr -d ' ')

  printf '  сервер: %s упоминаний | свой обработчик: %s | литерал-счётчик: %s | в iOS: %s файлов\n' \
    "$route" "${handler:-НЕТ}" "$literal" "$native"

  if [ "${route:-0}" -eq 0 ]; then
    bad 'на сервере НЕТ ничего про эту функцию — переносить нечего'
    paint '31' '       кнопка в вебе, если она есть, ничего не делает'
    return 1
  fi
  if [ -z "$handler" ] && [ "${literal:-0}" -gt 0 ]; then
    warn 'общий обработчик и литеральный счётчик — похоже на заглушку в вебе'
    return 2
  fi
  if [ "${native:-0}" -gt 0 ]; then
    good "функция живая, и приложение уже про неё знает ($native файлов)"
    return 0
  fi
  good 'функция живая в вебе, в приложении её нет — вот это настоящий пробел'
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
# ТО, ЧТО ДОЛЖЕН БЫЛ ПРОВЕРИТЬ CI.
#
# GitHub Actions не выполняется: задания падают за секунды с нулём шагов
# (отказ по оплате). За сотню витков так влито 157 правок — ни одна не
# прошла проверку. Оплату я решить не могу, а заменить её локально могу.
#
# Это НЕ равноценная замена, и притворяться иначе нельзя: здесь одна машина,
# один Node, один Xcode. Но «ничего» хуже, чем «кое-что, названное своим
# именем».
# ─────────────────────────────────────────────────────────────────────────
cmd_gate() {
  local fails=0
  # A SECTION THAT DID NOT MEASURE IS NOT A SECTION THAT PASSED.
  #
  # Three of the four checks below could already say «я это не мерил», and all
  # three said it with warn(): a yellow line that touches no counter and that
  # nothing downstream reads. Measured 2026-08-29 on this machine — xcodegen was
  # absent, section 3 measured NOTHING, and the run still ended on the green
  # «можно вливать» with exit 0. A warning that costs nothing gets spent as a
  # pass, which is how the iOS build went unbuilt for a hundred iterations while
  # the gate reported all clear.
  #
  # So the third outcome is now COUNTED, not merely coloured. Every branch that
  # cannot measure increments this, and the green line is unreachable while it
  # is above zero. Passes are not tallied on purpose: the only two numbers that
  # can change the verdict are failures and non-measurements.
  local unmeasured=0
  local SECTIONS=4
  # Known type-error debt of the render server. Lower it when the debt drops;
  # never raise it to make a red gate green.
  local GATE_TS_BASELINE=8

  printf '\n  1. Типы рендер-сервера\n'
  local tsout tsrc
  tsout=$(cd "$ROOT/apps/vibee-editor/render" \
    && npx tsc -p tsconfig.json --noEmit --pretty false 2>&1)
  tsrc=$?
  local n miss setup
  # COUNT ONLY ERRORS THAT CAME FROM CODE.
  #
  # A tsc SETUP failure also prints a line containing «error TS», so the old
  # `grep -c 'error TS'` counted it as ordinary debt: one such line is «1 error»,
  # which is under the baseline of 8, and the gate answered «не больше базы» and
  # then «можно вливать» — having type-checked NOTHING. Measured 2026-08-29 by
  # moving the render tsconfig.json aside for ten seconds: tsc printed
  # «error TS5058: The specified path does not exist», exited 1, and the gate
  # went green.
  #
  # The discriminator is the prefix, verified the same day against both cases:
  # a code error is «file(line,col): error TSxxxx», a setup error is «error
  # TSxxxx» at the start of the line with no file at all. So they are counted
  # separately and a single setup error makes the section unmeasured, whatever
  # the other number says.
  n=$(printf '%s' "$tsout" | grep -cE '\([0-9]+,[0-9]+\): error TS')
  setup=$(printf '%s' "$tsout" | grep -cE '^error TS')
  miss=$(printf '%s' "$tsout" | grep -c 'TS2307')

  if [ "${setup:-0}" -gt 0 ]; then
    skip 'tsc failed to start (config/path) — types NOT MEASURED'
    printf '%s\n' "$tsout" | grep -E '^error TS' | head -3 | while IFS= read -r l; do
      paint '36' "       $l"
    done
    unmeasured=$((unmeasured + 1))
  elif [ "${n:-0}" -eq 0 ] && [ "${tsrc:-0}" -ne 0 ]; then
    # TSC NEVER RAN — and this was the one FALSE GREEN in the whole gate.
    #
    # The count came from `grep -c 'error TS'` over the output. When npx cannot
    # find typescript at all there are no «error TS» lines either, so the count
    # is zero and the old code answered «без ошибок»: the check shouted all
    # clear precisely when it had done the least. tsc exits 0 clean and 1/2 with
    # errors, so «zero matches AND non-zero exit» is exactly «did not run».
    skip 'tsc did not run (typescript missing?) — types NOT MEASURED'
    printf '%s\n' "$tsout" | tail -3 | while IFS= read -r l; do
      paint '36' "       $l"
    done
    unmeasured=$((unmeasured + 1))
  elif [ "${n:-0}" -eq 0 ]; then
    good 'без ошибок'
  elif [ "${miss:-0}" -gt 0 ]; then
    # ТРЕТИЙ ИСХОД, и он здесь стоил отдельного разбора.
    #
    # Один пропущенный `npm install` в соседнем пакете дал 390 ошибок: без
    # `jotai` каждый атом терял типы, и все его параметры становились неявным
    # any. Числа выглядели как обвал кода, а имена файлов указывали не туда.
    # Настоящих ошибок было 7 — ровно столько же, сколько до правок.
    #
    # Признак: хотя бы один TS2307 «Cannot find module». Тогда цифра
    # рядом ничего не говорит о коде.
    skip "$n errors, $miss of them «cannot find module» — types NOT MEASURED"
    paint '36' '       Это НЕ про код: где-то не поставлены зависимости.'
    paint '36' '       Проверьте npm install в apps/vibee-editor/packages/*.'
    unmeasured=$((unmeasured + 1))
  elif [ "${n:-0}" -gt "$GATE_TS_BASELINE" ]; then
    # RATCHET, not a hard zero. The render server carries a known debt; the
    # question that matters is whether THIS change added to it.
    #
    # Both branches above only warned, and `fails` was never touched here -- so
    # eight type errors contributed nothing to the verdict and the advice
    # "compare with origin/main" was addressed to a human, while the thing
    # running this is an agent. Measured 2026-08-29: the gate printed 8 errors
    # and still ended with a tally that ignored them.
    bad "$n ошибок типов — БОЛЬШЕ базы ($GATE_TS_BASELINE). Это добавили здесь."
    fails=$((fails + 1))
  else
    good "$n ошибок — не больше базы ($GATE_TS_BASELINE)"
  fi

  printf '\n  2. Тесты рендер-сервера\n'
  # НЕ ЗАПУСТИЛИСЬ и УПАЛИ — разные вещи, и путать их нельзя.
  #
  # На первом же прогоне эти ворота напечатали «КРАСНО», хотя тесты не падали:
  # в рабочем дереве не было node_modules, и vitest не смог загрузить конфиг.
  # Ворота, принимающие поломку окружения за поломку кода, — это шум, а шум
  # перестают читать. Уже записано дважды про другие детекторы.
  local out vrc
  # THE EXIT CODE IS THE VERDICT, not the wording of the output.
  #
  # This line used to be `out=$(...)` alone, which throws the status away, and
  # the pass branch below was a grep for «N passed» with no «N failed». That is
  # the practice this repository has already been burned by twice — «grep -c
  # "error TS"» returned 0 while tsc had errors, because of colour codes.
  #
  # Measured 2026-08-29: a test file that PASSES but leaves an unhandled
  # rejection makes vitest print «Tests 187 passed» and «Errors 1 error» and
  # exit 1. The gate read the first line, called it green, and ended «можно
  # вливать» on a suite its own command had just failed.
  out=$(cd "$ROOT" && npx vitest run apps/vibee-editor/render 2>&1)
  vrc=$?
  if printf '%s' "$out" | grep -qE 'MODULE_NOT_FOUND|Cannot find module|command not found'; then
    skip 'did not start: environment (no node_modules?) — tests NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif printf '%s' "$out" | grep -qE 'No test files found'; then
    # NO FILES IS NEITHER PASS NOR FAIL. vitest exits non-zero here, so this
    # landed on «КРАСНО» — a red that says nothing about the code and everything
    # about the path argument. A renamed directory would have read as a
    # regression, which is the fastest way to teach someone to ignore the gate.
    skip 'no test files matched the path — tests NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif [ "${vrc:-1}" -eq 0 ]; then
    good "$(printf '%s' "$out" | grep -oE 'Tests  [0-9]+ passed' | head -1)"
  else
    # «КРАСНО» ALONE IS NOT ACTIONABLE. The whole vitest output was captured and
    # then thrown away, so the only way to learn WHICH test broke was to re-run
    # the suite by hand — paid on 2026-08-29, when this went red for exactly one
    # run and the gate could not name a single file. Same defect as the iOS log
    # going to /dev/null, in a section that had already been fixed once.
    bad "КРАСНО (vitest exit $vrc)"
    # «Errors» is listed alongside FAIL because an unhandled rejection shows up
    # only there: the run that exposed this defect had zero failing assertions.
    printf '%s\n' "$out" | grep -E 'FAIL|✕|×|Errors  ' | head -5 | while IFS= read -r l; do
      paint '31' "       $l"
    done
    fails=$((fails + 1))
  fi

  printf '\n  3. Сборка iOS\n'
  # A MISSING TOOL IS NOT A BROKEN BUILD -- the same third-outcome rule this
  # file already applies to types and tests.
  #
  # xcodegen is not installed on this machine, so the `&&` chain could never
  # succeed and this step reported a failure on EVERY run. The verdict was
  # therefore a constant "do not merge", which is read exactly as often as a
  # constant "all clear" -- and it made fixing the other checks pointless.
  #
  # THE TOOL IS HERE NOW. `brew install xcodegen` put 2.46.0 on this machine on
  # 2026-08-29 (2 MB bottle, no password), and the build that had never once run
  # went straight through: ** BUILD SUCCEEDED ** in ~15 s. So this section
  # measures for real, and the branches below finally mean what they say.
  #
  # THE TWO STEPS ARE SPLIT because they fail for opposite reasons. A broken
  # project.yml is about the code; an absent xcodegen is about the laptop. The
  # old `&&` chain fused them into one «СБОРКА ПАДАЕТ».
  #
  # THE FLAGS ARE COPIED FROM run.sh on purpose. Without `-arch arm64` xcodebuild
  # builds every applicable architecture — measured here: 171 MB of output and a
  # warning about ONLY_ACTIVE_ARCH — and without SYMROOT it writes somewhere
  # other than where run.sh looks, so the daily loop and the gate would each pay
  # for a full build. Both build/ and build2/ are in apps/vibee-ios/.gitignore.
  local ioslog="${TMPDIR:-/tmp}/tri-gate-ios.log"
  if ! command -v xcodegen >/dev/null 2>&1; then
    skip 'xcodegen is not installed — iOS build NOT MEASURED (brew install xcodegen)'
    unmeasured=$((unmeasured + 1))
  elif ! command -v xcodebuild >/dev/null 2>&1; then
    skip 'xcodebuild not found (no Xcode?) — iOS build NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif ! (cd "$ROOT/apps/vibee-ios" && xcodegen generate --quiet) >"$ioslog" 2>&1; then
    bad 'xcodegen generate падает — сломан project.yml'
    tail -3 "$ioslog" | while IFS= read -r l; do paint '31' "       $l"; done
    fails=$((fails + 1))
  elif (cd "$ROOT/apps/vibee-ios" \
      && xcodebuild -project Vibee.xcodeproj -target Vibee \
         -sdk iphonesimulator -configuration Debug -arch arm64 \
         SYMROOT="$ROOT/apps/vibee-ios/build2" build) >"$ioslog" 2>&1; then
    good 'BUILD SUCCEEDED'
  else
    # The log went to /dev/null, so «СБОРКА ПАДАЕТ» arrived with nothing to act
    # on and the next step was always to re-run the build by hand. Compiler
    # lines first; the tail only when there are none, because a failure in the
    # link or copy phase has no `error:` in it.
    bad 'СБОРКА ПАДАЕТ'
    local shown
    shown=$(grep -E 'error:' "$ioslog" | head -5)
    [ -n "$shown" ] || shown=$(tail -5 "$ioslog")
    printf '%s\n' "$shown" | while IFS= read -r l; do paint '31' "       $l"; done
    paint '31' "       полный лог: $ioslog"
    fails=$((fails + 1))
  fi

  printf '\n  4. Кириллица в добавленных строках\n'
  # RANGE, not the index -- and a real failure.
  #
  # This ran the guard in `staged` mode, which reads `git diff --cached`. Outside
  # a commit that index is EMPTY, so the check passed by construction: measured
  # 2026-08-29, zero staged files and a green line while the branch carried
  # Russian comments. And even a genuine hit only warned, never touching
  # `fails`. Both halves made it unable to fail.
  #
  # THE GUARD ALREADY DISTINGUISHES THREE OUTCOMES; this call threw two of them
  # away. `>/dev/null 2>&1` inside an `if` keeps only "zero or not", so:
  #   exit 1  a real hit                      -> red, correct
  #   exit 2  «failed to read the diff»       -> was ALSO red: broken plumbing
  #           (no-cyrillic-guard.cjs:153)        reported as dirty code
  #   exit 0  «merge in progress, skipping»   -> was GREEN having checked
  #           (checkStaged, early return)        nothing at all
  # The last one is the dangerous half: a clean line for an unread diff, during
  # exactly the operation that brings other people's lines in. It has no exit
  # code of its own, so it is caught by the sentence the guard prints.
  local cyrout cyrrc
  cyrout=$(cd "$ROOT" && node scripts/no-cyrillic-guard.cjs range 2>&1)
  cyrrc=$?
  if [ "${cyrrc:-0}" -eq 0 ] && printf '%s' "$cyrout" | grep -q 'merge in progress'; then
    skip 'merge in progress, the guard checked nothing — Cyrillic NOT MEASURED'
    unmeasured=$((unmeasured + 1))
  elif [ "${cyrrc:-0}" -eq 0 ]; then
    good 'чисто в диапазоне ветки'
  elif [ "${cyrrc:-0}" -eq 1 ]; then
    bad 'кириллица в добавленных строках ветки'
    printf '%s\n' "$cyrout" | grep ':  ' | head -5 | while IFS= read -r l; do
      paint '31' "     $l"
    done
    fails=$((fails + 1))
  else
    skip "the guard could not read the range (exit $cyrrc) — Cyrillic NOT MEASURED"
    unmeasured=$((unmeasured + 1))
  fi

  printf '\n'
  if [ "$fails" -gt 0 ]; then
    bad "НЕ ВЛИВАТЬ: провалов $fails"
    if [ "$unmeasured" -gt 0 ]; then
      # Both numbers, always. «One failure» out of four sections means something
      # different when two of the other three never ran, and the reader cannot
      # recover that from a single count.
      skip "and NOT MEASURED: $unmeasured of $SECTIONS"
    fi
    paint '31' '       CI сейчас не выполняется, и поймать это больше некому.'
    return 1
  fi
  if [ "$unmeasured" -gt 0 ]; then
    # NOTHING FAILED IS NOT THE SAME AS EVERYTHING PASSED. Saying «можно
    # вливать» here would be a claim about sections that produced no evidence —
    # the precise mistake this whole change exists to remove.
    #
    # Its own exit code, because a caller has to be able to tell «checked and
    # clean» from «could not check»: `tri gate && …` now stops on 2 as well.
    skip "NOT MEASURED: $unmeasured of $SECTIONS — this is NOT «можно вливать»"
    paint '36' '       Reasons above, each marked «?». Fix the environment and re-run.'
    return 2
  fi
  good 'можно вливать — насколько это может подтвердить одна машина'
}

# ─────────────────────────────────────────────────────────────────────────
# ONE MCP TOOL, WITHOUT HAND-BUILDING JSON-RPC.
#
# Every cycle that needed the render's agent tools re-wrote the same curl by
# hand, and on 2026-09-27 the hand-written wrapper cost two rounds: a shell
# default of `${2:-{\}}` reached the server as a broken envelope and it
# answered -32600 Invalid JSON-RPC request -- which reads like a dead route,
# not like a quoting bug. The envelope is machinery; machinery is generated.
#
# Two things this deliberately does NOT do:
#   * it never prints the key, not even on error. A key echoed into a terminal
#     is a key in the scrollback, and this repo's rule for a leaked value is
#     REVOKE, not delete.
#   * `eval` reads the script from a FILE and encodes it with json.dumps. The
#     code argument is a string containing quotes, newlines and braces; every
#     attempt to pass it through the shell has mangled it.
#
# And the lesson the render taught on the same day, recorded where it is used:
# browser_evaluate rejects a top-level `await` ("page threw: Uncaught") but it
# DOES resolve a returned promise. So wrap the body in an IIFE and return the
# chain -- see `tri mcp eval --example`.
# ─────────────────────────────────────────────────────────────────────────
_mcp_key() {
  # Order matters: an explicit env var beats a scratch file, and the vault is
  # the fallback rather than the default because it costs a network round trip.
  if [ -n "${AGENT_KEY:-}" ]; then printf '%s' "$AGENT_KEY"; return 0; fi
  local f="${TRI_AGENT_KEY_FILE:-/tmp/.ak.tmp}"
  if [ -s "$f" ]; then tr -d '\r\n' < "$f"; return 0; fi
  local v
  # Logged out, infisical does not fail -- it starts an interactive login and
  # waits for a person forever, and every command needing the key hung with it
  # (seen 2026-10-01 under an unattended loop). It gets 20 s and no terminal.
  command -v infisical > /dev/null 2>&1 || return 1
  v=$(perl -e 'alarm shift; exec @ARGV' "${TRI_VAULT_TIMEOUT_S:-20}" \
        infisical secrets get AGENT_KEY --plain < /dev/null 2>/dev/null | tr -d '\r\n')
  # Logged out, it may also PRINT a notice on stdout (311 characters of prose
  # on 2026-10-01), which used to go out as the X-Agent-Key header. A key is
  # one token, so anything else is no key at all.
  [[ "$v" =~ ^[A-Za-z0-9_.:-]{16,256}$ ]] && { printf '%s' "$v"; return 0; }
  return 1
}

cmd_mcp() {
  local tool="${1:-}"
  if [ -z "$tool" ]; then
    bad 'needs a tool: tri mcp <tool> [json] | tri mcp eval <file.js> | tri mcp list'
    return 1
  fi

  if [ "$tool" = 'eval' ] && [ "${2:-}" = '--example' ]; then
    cat <<'EX'
(function(){                      /* no top-level await: the page throws */
  return fetch('/some/endpoint', {credentials:'include'})
    .then(r => r.json())
    .then(j => JSON.stringify(j).slice(0, 400))
})()
EX
    return 0
  fi

  local key
  if ! key=$(_mcp_key); then
    bad 'no agent key: set AGENT_KEY, or TRI_AGENT_KEY_FILE, or store it in Infisical as AGENT_KEY'
    return 1
  fi

  local args_json='{}'
  case "$tool" in
    list)
      args_json='__LIST__'
      ;;
    eval)
      local js="${2:-}"
      [ -f "$js" ] || { bad "no script file: ${js:-<empty>}"; return 1; }
      args_json=$(python3 -c 'import json,sys; print(json.dumps({"code": open(sys.argv[1]).read()}))' "$js") \
        || { bad 'could not pack the script'; return 1; }
      tool='browser_evaluate'
      ;;
    *)
      if [ -n "${2:-}" ]; then
        # Validated HERE rather than at the server, because the server's answer
        # to a malformed envelope looks nothing like "your JSON is wrong".
        args_json=$(python3 -c 'import json,sys; print(json.dumps(json.loads(sys.argv[1])))' "$2" 2>/dev/null) \
          || { bad "arguments are not JSON: $2"; return 1; }
      fi
      ;;
  esac

  MCP_KEY="$key" MCP_TOOL="$tool" MCP_ARGS="$args_json" MCP_URL="$RENDER/mcp" \
    python3 - <<'PY'
import json, os, sys, urllib.error, urllib.request

tool, raw = os.environ['MCP_TOOL'], os.environ['MCP_ARGS']
if raw == '__LIST__':
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/list"}
else:
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
            "params": {"name": tool, "arguments": json.loads(raw)}}

req = urllib.request.Request(
    os.environ['MCP_URL'], data=json.dumps(body).encode(),
    headers={"Content-Type": "application/json",
             "X-Agent-Key": os.environ['MCP_KEY']})
try:
    with urllib.request.urlopen(req, timeout=240) as r:
        answer = json.loads(r.read())
except urllib.error.HTTPError as e:
    # 502 here is almost always the deploy swap, not a broken call. Saying so
    # saves the next cycle from debugging a healthy route.
    hint = ' (looks like the deploy swap: retry in a minute)' if e.code == 502 else ''
    print(f'HTTP {e.code} {e.reason}{hint}', file=sys.stderr)
    sys.exit(1)

if 'error' in answer:
    print(json.dumps(answer['error'], ensure_ascii=False, indent=1), file=sys.stderr)
    sys.exit(1)

result = answer.get('result', answer)
if raw == '__LIST__':
    for t in result.get('tools', []):
        print(t['name'])
    sys.exit(0)

printed = False
for chunk in (result.get('content') or []):
    if chunk.get('type') == 'text':
        print(chunk['text'])
        printed = True
if not printed:
    print(json.dumps(result, ensure_ascii=False, indent=1))
PY
}

# ─────────────────────────────────────────────────────────────────────────
# IS THE REMOTE BROWSER ALIVE, OR ONLY ANSWERING.
#
# On 2026-09-27 the pod looked healthy and could not act. `/json/list` is
# served by the browser PROCESS, so it keeps answering while every renderer
# is wedged, and the tabs route reported that reply as health. #3152 split
# the claim in two -- `reachable` about the process, `answers` about a real
# page -- and this command is the only reader that tells them apart out loud.
#
# `answers: null` is a THIRD outcome: nobody asked. Printing it as dead would
# invent an outage on a deploy that predates the probe; printing it as alive
# would hide the exact outage the probe exists to catch. So it gets its own
# line and its own exit code.
# ─────────────────────────────────────────────────────────────────────────
cmd_browser() {
  local key
  key=$(_mcp_key) || {
    bad 'no agent key: set $AGENT_KEY, or /tmp/.ak.tmp, or log into Infisical'
    return 1
  }

  BR_KEY="$key" BR_URL="$RENDER/api/browser/tabs" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.request

req = urllib.request.Request(
    os.environ['BR_URL'], headers={"X-Agent-Key": os.environ['BR_KEY']})
try:
    with urllib.request.urlopen(req, timeout=90) as r:
        answer = json.loads(r.read())
except urllib.error.HTTPError as e:
    # Same reading as in `tri mcp`: 502 is the deploy swap, not a dead route.
    hint = ' (looks like the deploy swap: retry in a minute)' if e.code == 502 else ''
    print(f'  HTTP {e.code} {e.reason}{hint}')
    sys.exit(3)
except Exception as e:                        # DNS, TLS, timeout
    print(f'  the render did not answer at all: {e}')
    sys.exit(3)

pods = answer.get('pods') or []
if not pods:
    # Not an outage. Railway cannot run pods, and the route says so by
    # returning nothing rather than by failing.
    print('  no pods -- this deployment does not run one')
    sys.exit(2)

worst = 0
for p in pods:
    who = p.get('who') or '(unclaimed pod)'
    pages, cap = p.get('pages'), p.get('cap')
    reachable, answers = p.get('reachable'), p.get('answers')
    room = f'{pages}/{cap} tabs'

    if not reachable:
        print(f'  {who}: DEAD -- the target list did not answer ({room})')
        worst = max(worst, 1)
    elif answers is False:
        print(f'  {who}: WEDGED -- the process answers, no page does ({room})')
        print('        this is the 2026-09-27 shape: healthy-looking, cannot act')
        worst = max(worst, 1)
    elif answers is None:
        print(f'  {who}: reachable, NOT ASKED -- no probe in this deploy ({room})')
        worst = max(worst, 2)
    else:
        print(f'  {who}: alive -- a real page evaluated 1 + 1 ({room})')
        # At the cap the tab evicted to make room can be the page being signed
        # in on, so a full pod is worth saying before it costs a sign-in.
        if isinstance(pages, int) and isinstance(cap, int) and pages >= cap:
            print('        at the cap: the next open evicts a tab')
            worst = max(worst, 2)

sys.exit(worst)
PY
  local rc=$?
  case "$rc" in
    0) good 'the remote browser can act' ;;
    1) bad 'the remote browser cannot act -- run `tri heal` before trusting a round' ;;
    2) warn 'reachable, but the answer is not proof of a working page' ;;
    *) bad 'could not tell -- the render itself did not answer' ;;
  esac
  return "$rc"
}

# ─────────────────────────────────────────────────────────────────────────
# tri card -- a kanban card's conversation without opening the app.
#
# One thread, many pilots: the sheet on /game/kanban?card=N, this command and
# an outside agent over A2A (metadata.task) all read and write the rows of
# `task:gHashTag/<repo>#<n>`. The server resolves a bare number against the
# board it reads, so this command never guesses a repository.
# ─────────────────────────────────────────────────────────────────────────
cmd_card() {
  local task="${1:-}"
  if [ -z "$task" ]; then
    bad 'needs a card: tri card <n|repo#n|gHashTag/repo#n> [text]'
    return 1
  fi
  shift
  local key
  key=$(_mcp_key) || {
    bad 'no agent key: set $AGENT_KEY, or /tmp/.ak.tmp, or log into Infisical'
    return 1
  }
  CARD_KEY="$key" CARD_URL="$RENDER" CARD_TASK="$task" CARD_TEXT="$*" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.parse, urllib.request

base, task, text = os.environ['CARD_URL'], os.environ['CARD_TASK'], os.environ['CARD_TEXT'].strip()
head = {"X-Agent-Key": os.environ['CARD_KEY'], "Content-Type": "application/json"}

def call(path, body=None, timeout=60):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(base + path, data=data, headers=head,
                                 method='GET' if body is None else 'POST')
    return urllib.request.urlopen(req, timeout=timeout)

def fail(e):
    if isinstance(e, urllib.error.HTTPError):
        try:
            why = json.loads(e.read()).get('error', '')
        except Exception:
            why = ''
        hint = ' (looks like the deploy swap: retry in a minute)' if e.code == 502 else ''
        print(f'  HTTP {e.code} {why or e.reason}{hint}')
        sys.exit(1 if 400 <= e.code < 500 else 3)
    print(f'  the render did not answer at all: {e}')
    sys.exit(3)

q = urllib.parse.urlencode({'task': task, 'limit': 100})
try:
    with call(f'/api/agent/history?{q}') as r:
        hist = json.loads(r.read())
except Exception as e:
    fail(e)

thread = hist.get('thread') or ''
if not thread.startswith('task:'):
    # A render that predates task threads ignores ?task= and answers with the
    # person's OWN thread. Saying anything now would land in the wrong
    # conversation, so nothing is sent.
    print(f'  this render answered thread {thread or "(none)"!r}, not a task thread:')
    print('  task threads are not deployed there yet -- nothing was sent')
    sys.exit(2)
card = hist.get('card') or {}
turns = hist.get('messages') or []
title = card.get('title') or '(untitled on the board)'
print(f"  {thread.removeprefix('task:')}  [{card.get('column') or '?'}]  {title}")

if not text:
    if not turns:
        print('  no conversation yet -- `tri card <n> "<text>"` starts one')
    for t in turns[-12:]:
        who = 'you  ' if t.get('role') == 'user' else 'agent'
        line = ' '.join(str(t.get('content') or '').split())
        print(f'  {who} {line[:300]}')
    sys.exit(0)

history = [{'role': t.get('role'), 'content': t.get('content')}
           for t in turns[-20:] if t.get('role') in ('user', 'assistant')]
history.append({'role': 'user', 'content': text})
try:
    with call('/api/agent/chat', {'messages': history, 'task': task,
                                  'surface': 'agent'}, timeout=600) as r:
        print('  agent ', end='', flush=True)
        for raw in r:
            try:
                ev = json.loads(raw)
            except Exception:
                continue
            kind = ev.get('\u0442\u0438\u043f')        # the stream's own key
            words = str(ev.get('\u0442\u0435\u043a\u0441\u0442') or '')
            if kind == '\u0442\u0435\u043a\u0441\u0442':
                print(words, end='', flush=True)
            elif kind == '\u043e\u0448\u0438\u0431\u043a\u0430':
                print(f'\n  error: {words}')
                sys.exit(1)
        print()
except Exception as e:
    fail(e)
PY
}

# tri card-check -- is the kanban card chat live, end to end, after the
# owner merges and render deploys? Read-only: every request is a GET.
cmd_card_check() {
  local task="${1:-5382}"
  local key
  key=$(_mcp_key) || {
    bad 'no agent key: set $AGENT_KEY, or /tmp/.ak.tmp, or log into Infisical'
    return 1
  }
  local merged
  merged=$(for pr in gHashTag/999-multibots-telegraf#3208 gHashTag/t27#5389; do
    gh pr view "${pr#*#}" -R "${pr%#*}" --json state -q .state 2>/dev/null \
      | sed "s|^|$pr |"
  done)
  # 5. The Queen's move door (BrowserOS#519) against the spec's flag: the
  # sheet's move row may light only once the door is merged (spec v5 S16).
  local door_pr door_flag
  door_pr=$(gh pr view 519 -R gHashTag/BrowserOS --json state -q .state 2>/dev/null)
  door_flag=$(grep -o 'MOVE_DOOR_EXISTS = [a-z]*' \
    "$ROOT/apps/vibee-editor/render/src/spec/kanban-card-chat.gen.ts" | awk '{print $3}')
  # 4. The server's GraphQL query against LIVE GitHub, with the local `gh`
  # token (read-only use, never printed), compared with the client's read.
  # Holds before any merge: a GitHub schema change breaks it here first.
  local pr_n="${task##*#}" pr_repo="${task%#*}" parity=''
  [ "$pr_repo" = "$task" ] && pr_repo='gHashTag/t27'
  case "$pr_repo" in */*) ;; *) pr_repo="gHashTag/$pr_repo" ;; esac
  if command -v gh >/dev/null && gh auth token >/dev/null 2>&1; then
    parity=$(cd "$ROOT/apps/vibee-editor/render" \
      && GH_READ=$(gh auth token) ./node_modules/.bin/tsx \
        scripts/card-status-parity.ts "$pr_repo" "$pr_n" 2>/dev/null | tail -1)
  fi
  CARD_KEY="$key" CARD_URL="$RENDER" CARD_TASK="$task" CARD_MERGED="$merged" \
    CARD_PARITY="$parity" CARD_DOOR_PR="$door_pr" CARD_DOOR_FLAG="$door_flag" \
    python3 - <<'PY'
import json, os, sys, urllib.error, urllib.parse, urllib.request

base, task = os.environ['CARD_URL'], os.environ['CARD_TASK']
head = {"X-Agent-Key": os.environ['CARD_KEY']}
verdicts = []

def say(kind, what):
    verdicts.append(kind)
    print(f'  {kind:<5} {what}')

def get(path):
    req = urllib.request.Request(base + path, headers=head)
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.status, json.loads(r.read() or b'null')
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b'null')
        except Exception:
            return e.code, None
    except Exception as e:
        return 0, str(e)

# 1. The card's thread: a render with task threads answers `task:`.
code, h = get('/api/agent/history?' + urllib.parse.urlencode({'task': task, 'limit': 1}))
thread = (h or {}).get('thread', '') if isinstance(h, dict) else ''
if code == 200 and thread.startswith('task:'):
    say('ok', f'thread {thread}')
elif code == 200:
    say('wait', f'render answers thread {thread!r}: task threads not deployed')
else:
    say('fail' if code and code < 500 else 'wait', f'history HTTP {code}')

# 2. The server's status door.
ref = thread.removeprefix('task:') if thread.startswith('task:') else ''
repo, _, n = ref.rpartition('#')
if not ref:
    repo, n = 'gHashTag/t27', task.rpartition('#')[2]
code, s = get('/api/card-status?' + urllib.parse.urlencode({'repo': repo, 'n': n}))
if code == 404:
    say('wait', '/api/card-status not deployed (the client reads GitHub itself)')
elif code == 503:
    say('wait', 'card-status deployed, no GITHUB_READ_TOKEN: the owner\'s call; the client reads')
elif code == 200 and isinstance(s, dict) and s.get('measured'):
    st = s.get('status') or {}
    prs = ', '.join(f"{p['repo'].split('/')[1]}#{p['number']} {p['state']}"
                    + (f" checks={p['checks']}" if p.get('checks') else '')
                    for p in st.get('prs', []))
    say('ok', f"server read: {st.get('kind')} {prs}".rstrip())
elif code == 200:
    say('fail', 'card-status configured but GitHub did not answer (token scope or limit?)')
else:
    say('fail' if code and code < 500 else 'wait', f'card-status HTTP {code}')

# 3. The pull requests that carry it.
for line in filter(None, os.environ.get('CARD_MERGED', '').splitlines()):
    pr, state = line.rsplit(' ', 1)
    say('ok' if state == 'MERGED' else 'wait', f'{pr} {state.lower()}')

# 4. The server's query against live GitHub, the same card both ways.
raw = os.environ.get('CARD_PARITY', '')
try:
    par = json.loads(raw) if raw else None
except ValueError:
    par = None
if par is None:
    say('wait', 'query vs live GitHub: not run (no `gh` login or no answer)')
elif par.get('error'):
    say('fail' if 'broke' in par['error'] else 'wait', f"query vs live GitHub: {par['error']}")
elif par.get('client') == 'unmeasured':
    say('wait', 'query answered; the client read was refused (limit)')
elif par.get('same'):
    srv = par.get('server') or {}
    say('ok', f"query vs live GitHub: server == client ({len(srv.get('prs', []))} shown, +{srv.get('more', 0)})")
else:
    say('fail', f"server != client: {json.dumps(par.get('server'))} vs {json.dumps(par.get('client'))}")

# 5. The move door against the flag: a lit row on a missing door is a lie.
door, flag = os.environ.get('CARD_DOOR_PR', ''), os.environ.get('CARD_DOOR_FLAG', '')
if flag == 'true' and door != 'MERGED':
    say('fail', f'MOVE_DOOR_EXISTS is true but BrowserOS#519 is {door.lower() or "unread"}')
elif flag == 'true':
    say('ok', 'move door merged and the spec says so')
elif door == 'MERGED':
    say('wait', 'BrowserOS#519 merged: once deployed, spec v7 flips MOVE_DOOR_EXISTS')
else:
    say('wait', f'move row dark: BrowserOS#519 {door.lower() or "unread"}')

sys.exit(1 if 'fail' in verdicts else 2 if 'wait' in verdicts else 0)
PY
}

# tri card-drift -- the nightly drift watch (spec kanban-card-chat.t27 v5,
# DRIFT_ONE_ISSUE). The verb comes from render's driftAction (bound by the
# spec test); this function only carries it out with `gh`.
cmd_card_drift() {
  local dry=0 task='5382' a
  for a in "$@"; do
    case "$a" in --dry) dry=1 ;; *) task="$a" ;; esac
  done
  local n="${task##*#}" repo="${task%#*}"
  [ "$repo" = "$task" ] && repo='gHashTag/t27'
  case "$repo" in */*) ;; *) repo="gHashTag/$repo" ;; esac
  local render="$ROOT/apps/vibee-editor/render"
  if ! gh auth token >/dev/null 2>&1; then
    warn 'no `gh` login: nothing measured, nothing written'
    return 2
  fi
  local parity
  parity=$(cd "$render" && GH_READ=$(gh auth token) ./node_modules/.bin/tsx \
    scripts/card-status-parity.ts "$repo" "$n" 2>/dev/null | tail -1)
  # The pipeline's status is tail's; ask the JSON instead.
  local drifted
  drifted=$(printf '%s' "$parity" | python3 -c '
import json, sys
try:
    p = json.loads(sys.stdin.read() or "null")
except ValueError:
    p = None
if not isinstance(p, dict) or p.get("client") == "unmeasured":
    print("x")
elif "same" in p:
    print("0" if p["same"] else "1")
elif "broke" in (p.get("error") or "") or "gone" in (p.get("error") or ""):
    print("1")
else:
    print("x")')
  if [ "$drifted" = x ]; then
    warn "not measured tonight: ${parity:-no answer} -- the issue is left as it is"
    return 2
  fi
  local body
  body=$(printf '%s\n\n```json\n%s\n```\n\nCard: %s#%s.' \
    "$([ "$drifted" = 1 ] && echo 'The server read and the client read of the same card differ (or the query broke).' || echo 'The two reads agree again.')" \
    "$parity" "$repo" "$n")
  _one_issue 'card-check drift' \
    'card-check drift: the server card-status read disagrees with GitHub' \
    "$drifted" "$body" "$dry"
}

# One issue per watch (spec kanban-card-chat.t27 v5, DRIFT_ONE_ISSUE): opened
# on the first bad night, commented on while it stays bad, closed on the first
# good night; a night that measured nothing (bad=x) touches nothing. The verb
# is render's driftAction; the issue is found by its title's KEY prefix, not
# by GitHub's fuzzy search alone. Exit 1 bad, 2 unmeasured, 0 good.
_one_issue() {
  local key="$1" title="$2" bad="$3" text="$4" dry="$5"
  local render="$ROOT/apps/vibee-editor/render"
  if [ "$bad" = x ]; then
    warn "$key: not measured tonight -- the issue is left as it is"
    return 2
  fi
  local open_n verb
  open_n=$(gh issue list -R gHashTag/t27 --state open --limit 10 \
    --search "in:title \"$key\"" --json number,title \
    -q "[.[] | select(.title | startswith(\"$key\"))][0].number // empty" 2>/dev/null)
  verb=$(cd "$render" && ./node_modules/.bin/tsx scripts/card-drift.ts \
    "$bad" "$([ -n "$open_n" ] && echo 1 || echo 0)")
  local body
  body=$(printf '%s\n\nMeasured %s by `tri hive-nightly` (spec kanban-card-chat.t27, DRIFT_ONE_ISSUE). Part of #5388.' \
    "$text" "$(date -u +%Y-%m-%dT%H:%MZ)")
  echo "  $key: bad=$bad issue=${open_n:-none} -> $verb"
  if [ "$dry" != 1 ]; then
    case "$verb" in
      open) gh issue create -R gHashTag/t27 --title "$title" --body "$body" ;;
      comment) gh issue comment "$open_n" -R gHashTag/t27 --body "$body" ;;
      close) gh issue close "$open_n" -R gHashTag/t27 --comment "$body" ;;
    esac
  fi
  [ "$bad" = 1 ] && return 1 || return 0
}

# tri hive-nightly -- every watch of the card sheet in one night, each keeping
# its own ONE issue: the drift (server read vs client read), the live
# card-check against render, and on Sundays (or --shots) every phone stand.
# A watch that could not measure (no key, no login, nothing deployed yet)
# says so and touches nothing. Exit: 1 if any watch is bad, else 2 if any
# measured nothing, else 0.
cmd_hive_nightly() {
  local dry=0 shots=0 a
  for a in "$@"; do
    case "$a" in --dry) dry=1 ;; --shots) shots=1 ;; esac
  done
  [ "$(date +%u)" = 7 ] && shots=1
  if ! gh auth token >/dev/null 2>&1; then
    warn 'no `gh` login: nothing measured, nothing written'
    return 2
  fi
  local worst=0 rc out bad
  _worse() { [ "$1" = 1 ] && worst=1; [ "$1" = 2 ] && [ "$worst" = 0 ] && worst=2; }

  echo '== drift'
  cmd_card_drift $([ "$dry" = 1 ] && echo --dry)
  _worse $?

  echo '== card-check (live)'
  if _mcp_key >/dev/null 2>&1; then
    out=$(cmd_card_check 2>&1); rc=$?
    printf '%s\n' "$out"
    # Waiting on a merge or a deploy is the normal state, not a regression.
    case "$rc" in 0) bad=0 ;; 1) bad=1 ;; *) bad=x ;; esac
    # Our own key refused is not the sheet answering wrong: unmeasured.
    case "$out" in *'HTTP 401'*) bad=x ;; esac
  else
    out='no agent key'; bad=x
    echo '  no agent key: set $AGENT_KEY or log into Infisical'
  fi
  _one_issue 'card-check live' \
    'card-check live: the deployed card sheet answers wrong' \
    "$bad" "$(printf 'tri card-check:\n\n```\n%s\n```' "$out")" "$dry"
  _worse $?

  if [ "$shots" = 1 ]; then
    echo '== tri shot all'
    out=$(TRI_BRIDGE=1 "$ROOT/bin/tri" shot all 2>&1); rc=$?
    # The reason travels with the verdict: a red line without its cut and
    # small rows cannot be read the morning after.
    printf '%s\n' "$out" | grep -vE '^ok ' | tail -60
    if [ "$rc" = 1 ]; then
      # A stand red once and green on a second shot is a flake, not a
      # regression: say it, but only a stand that stays red opens the issue.
      local line stand w lang again still=0
      while IFS= read -r line; do
        stand=$(printf '%s' "$line" | sed -E 's/.*RED -- ([^ ]+) at ([0-9]+)px \(([a-z]+)\).*/\1/')
        w=$(printf '%s' "$line" | sed -E 's/.*RED -- ([^ ]+) at ([0-9]+)px \(([a-z]+)\).*/\2/')
        lang=$(printf '%s' "$line" | sed -E 's/.*RED -- ([^ ]+) at ([0-9]+)px \(([a-z]+)\).*/\3/')
        again=$(TRI_BRIDGE=1 "$ROOT/bin/tri" shot "$stand" "$w" "$lang" 2>&1)
        if printf '%s' "$again" | grep -q 'shot green'; then
          echo "  flake: $stand $w $lang red once, green on a second shot"
          out=$(printf '%s\n\nflake (green on a second shot): %s %s %s' "$out" "$stand" "$w" "$lang")
        else
          still=1
        fi
      done < <(printf '%s\n' "$out" | grep -E '== shot RED -- ')
      [ "$still" = 0 ] && rc=0
    fi
    case "$rc" in 0) bad=0 ;; 1) bad=1 ;; *) bad=x ;; esac
    _one_issue 'phone-shot regression' \
      'phone-shot regression: a stand is red at phone width' \
      "$bad" "$(printf 'tri shot all:\n\n```\n%s\n```' "$(printf '%s\n' "$out" | grep -vE '^ok ' | tail -40)")" "$dry"
    _worse $?
  fi
  return "$worst"
}

cmd_heal() {
  local key
  key=$(_mcp_key) || {
    bad 'no agent key: set $AGENT_KEY, or /tmp/.ak.tmp, or log into Infisical'
    return 1
  }

  # HEAL THE REMOTE BROWSER -- the action `tri browser` kept pointing at.
  #
  # `tri browser` ends a wedged verdict with "run `tri heal`", and for four
  # ticks the only heal was a raw `curl -X POST /api/browser/heal` copied from
  # a docstring -- observability with no wired way to act. This is that verb.
  #
  # Safe to run at ANY time, and that safety is the server's promise, not this
  # script's: /api/browser/heal PROBES FIRST and REFUSES to restart a browser
  # that answers (routes.ts, "a restart would take a working browser away from
  # the person") -- built to stop the exact 2026-09-27 mistake of restarting a
  # healthy pod on a misread `running: false`. So this reader does not gate
  # behind a --force or a second probe of its own: the one authority on "is it
  # well" is the endpoint, and asking twice is just a chance to disagree with it.
  #
  # Exit codes match the family: 0 nothing to do or healed, 1 restarted and
  # STILL dead (Chromium must come up inside the pod -- a different remedy),
  # 2 no browser of this person configured, 3 the render did not answer.
  BR_KEY="$key" BR_URL="$RENDER/api/browser/heal" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.request

req = urllib.request.Request(
    os.environ['BR_URL'],
    data=b'{}',
    method='POST',
    headers={"X-Agent-Key": os.environ['BR_KEY'],
             "Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=120) as r:
        answer = json.loads(r.read())
except urllib.error.HTTPError as e:
    # 409 is the route saying no browser of this person is configured to heal
    # -- not an outage. Everything else that carries an HTTP code we surface.
    body = ''
    try:
        body = e.read().decode('utf-8', 'replace')
    except Exception:
        pass
    if e.code == 409:
        print('  no browser of this person is configured -- none to heal')
        sys.exit(2)
    hint = ' (looks like the deploy swap: retry in a minute)' if e.code == 502 else ''
    print(f'  HTTP {e.code} {e.reason}{hint}')
    if body:
        print(f'  {body[:300]}')
    sys.exit(3)
except Exception as e:                        # DNS, TLS, timeout
    print(f'  the render did not answer at all: {e}')
    sys.exit(3)

why = answer.get('why') or ''
healed = answer.get('healed')
rebooted = answer.get('rebooted')
if why:
    print(f'  {why}')

# healed is False in TWO worlds: the browser was well and a restart was refused
# (good -- nothing to do), or a restart was tried and it still does not answer
# (bad -- a deeper remedy). `why` tells them apart in prose; `rebooted` tells
# them apart in a field, so gate on the field, not the sentence.
if healed:
    sys.exit(0)                                # was down, answers again
if rebooted is False and 'answers' in why.lower():
    sys.exit(0)                                # refused: the browser was well
if rebooted:
    print('  the pod rebooted but the page is still silent')
    sys.exit(1)                                # restarted, still dead
if healed is False and 'still does not answer' in why.lower():
    sys.exit(1)                                # restart did not take
sys.exit(0)
PY
  local rc=$?
  case "$rc" in
    0) good 'the remote browser is well -- healed, or never needed it' ;;
    1) bad 'restarted and it STILL does not answer -- Chromium must be restarted inside the pod' ;;
    2) warn 'nothing to heal -- no browser of this person is configured' ;;
    *) bad 'could not tell -- the render itself did not answer' ;;
  esac
  return "$rc"
}

# ─────────────────────────────────────────────────────────────────────────
# WHAT THE AGENT SAW WHEN IT ERRED.
#
# On 2026-09-22 the agent said the screen showed "the Queen's board" while it
# showed a Google sign-in; finding that out took an evening of re-running its
# calls by hand. The journal has held the answer ever since, but reading it
# meant scrolling fifty steps and guessing which look came before which error.
# This asks the journal the focused question (saw.ts, errors=1): for each
# failed step, the last thing the agent actually looked at, and how long
# before. Exit 0 when nothing erred, 1 when something did, 3 when the render
# did not answer -- so a script can gate on "did the last turn err".
# ─────────────────────────────────────────────────────────────────────────
cmd_saw() {
  local key
  key=$(_mcp_key) || {
    bad 'no agent key: set $AGENT_KEY, or /tmp/.ak.tmp, or log into Infisical'
    return 1
  }

  SAW_KEY="$key" SAW_URL="$RENDER/api/browser/journal?errors=1&limit=${1:-50}" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.request

req = urllib.request.Request(
    os.environ['SAW_URL'], headers={"X-Agent-Key": os.environ['SAW_KEY']})
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        answer = json.loads(r.read())
except urllib.error.HTTPError as e:
    hint = ' (looks like the deploy swap: retry in a minute)' if e.code == 502 else ''
    print(f'  HTTP {e.code} {e.reason}{hint}')
    sys.exit(3)
except Exception as e:                        # DNS, TLS, timeout
    print(f'  the render did not answer at all: {e}')
    sys.exit(3)

errors = answer.get('errors') or []
if not errors:
    print('  no errors in the last steps -- the agent did not stumble')
    sys.exit(0)

def ago(ms):
    s = ms / 1000.0
    return f'{s:.0f}s' if s < 60 else f'{s/60:.0f}m'

for e in errors:
    tool = e.get('tool', '?')
    at = (e.get('at') or '')[11:19]              # HH:MM:SS, the date rarely matters here
    msg = e.get('error') or '(no message kept)'
    print(f'  {at}  {tool} FAILED: {msg}')
    saw = e.get('saw')
    if not saw:
        # The third outcome, kept out loud: nothing looked at is not
        # looked-and-saw-nothing.
        print('        saw: nothing looked at before this')
        continue
    what = saw.get('seen') or saw.get('title') or saw.get('url') or '(a page)'
    where = f" <{saw['url']}>" if saw.get('url') and saw.get('seen') is None and saw.get('title') is None else ''
    print(f"        saw {ago(saw.get('agoMs', 0))} before ({saw.get('tool','?')}): {what}{where}")

sys.exit(1)
PY
  local rc=$?
  case "$rc" in
    0) good 'the last turn did not err' ;;
    1) warn 'the last turn erred -- above is what the agent saw each time' ;;
    *) bad 'could not tell -- the render itself did not answer' ;;
  esac
  return "$rc"
}

# The full journal (journal.ts): every step the agent took, newest first, tool
# + ok + ms + one line of what it touched. cmd_saw is this narrowed to error
# moments; this is the whole timeline its timings were meant to be read from.
# `--probes` folds in the on-a-clock watch checks (the doc's "tri eyes"), which
# are trimmed apart from real work and hidden otherwise. Exit 0 steps shown,
# 2 none recorded yet (the third outcome: nobody acted, not an outage), 3 the
# render did not answer -- so a script can tell "empty" from "unreachable".
# ─────────────────────────────────────────────────────────────────────────
cmd_journal() {
  local key limit=50 probes=
  for a in "$@"; do
    case "$a" in
      --probes|--eyes) probes=1 ;;
      *[!0-9]*|'') : ;;                 # ignore non-numeric args
      *) limit="$a" ;;
    esac
  done
  key=$(_mcp_key) || {
    bad 'no agent key: set $AGENT_KEY, or /tmp/.ak.tmp, or log into Infisical'
    return 1
  }

  local url="$RENDER/api/browser/journal?limit=$limit"
  [ -n "$probes" ] && url="$url&probes=1"

  JRN_KEY="$key" JRN_URL="$url" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.request

req = urllib.request.Request(
    os.environ['JRN_URL'], headers={"X-Agent-Key": os.environ['JRN_KEY']})
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        answer = json.loads(r.read())
except urllib.error.HTTPError as e:
    hint = ' (looks like the deploy swap: retry in a minute)' if e.code == 502 else ''
    print(f'  HTTP {e.code} {e.reason}{hint}')
    sys.exit(3)
except Exception as e:                        # DNS, TLS, timeout
    print(f'  the render did not answer at all: {e}')
    sys.exit(3)

steps = answer.get('steps') or []
if not steps:
    # The third outcome, kept out loud: an empty journal is nobody-acted,
    # not a broken render. A script gates on this being distinct from exit 3.
    print('  nothing recorded yet -- the agent has taken no steps')
    sys.exit(2)

def clip(v, n):
    s = str(v)
    return s if len(s) <= n else s[:n - 1] + '…'

for s in steps:
    at = (s.get('at') or '')[11:19]                # HH:MM:SS
    tool = s.get('tool', '?')
    mark = ' ok ' if s.get('ok') else 'FAIL'
    ms = s.get('ms', 0)
    d = s.get('detail') or {}
    what = d.get('seen') or d.get('title') or d.get('what') or d.get('url') or ''
    if not what and d.get('x') is not None:
        what = f"({d['x']},{d['y']})"
    tag = ' ·probe' if d.get('probe') else ''
    line = f"  {at}  {mark}  {tool} {ms}ms{tag}"
    if what:
        line += f"  {clip(what, 90)}"
    print(line)
    if not s.get('ok') and d.get('error'):
        print(f"        error: {clip(d['error'], 120)}")

sys.exit(0)
PY
  local rc=$?
  case "$rc" in
    0) good 'the browser has a timeline -- above is the record, newest first' ;;
    2) warn 'nothing recorded yet -- nobody has driven the browser' ;;
    *) bad 'could not read the journal -- the render itself did not answer' ;;
  esac
  return "$rc"
}

