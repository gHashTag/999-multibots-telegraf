    good 'без контроля отчёт отказывается считать'
  fi
  rm -f /tmp/tri-net-check.log /tmp/tri-net-check.log.mark \
        /tmp/tri-net-check2.log /tmp/tri-net-check2.log.mark
  return "$rc"
}

cmd_skipped() {
  # ПЕРЕПИСЬ ВЫКЛЮЧЕННЫХ ТЕСТОВ.
  #
  # Гейт видит только ЗЕЛЁНЫЕ имена. Тест, помеченный skip, зелёным не
  # становится и в снимок не попадает — а если он лежит в файле, где ОСТАЛЬНЫЕ
  # тесты зелёные, то файл в снимке есть, гейт доволен, и выключенные тесты
  # внутри не видит НИКТО. На 04.09.2026 таких было 36 в 10 зелёных файлах.
  #
  # Отдельно считаем НЕЗАДОКУМЕНТИРОВАННЫЕ: skip без объяснения рядом. Skip с
  # записанной причиной и условием снятия — это честный долг; skip молча
  # неотличим от «замял красноту». Команда падает только на них, поэтому на
  # чистом дереве она зелёная и её не приучаются игнорировать.
  local files
  if [ "$#" -gt 0 ]; then
    files="$(printf '%s\n' "$@")"
  else
    files="$(git -C "$ROOT" ls-files '*.test.ts' '*.test.tsx')"
  fi
  printf '%s' "$files" | node -e '
    const fs = require("fs");
    const snapPath = process.argv[1];
    let snap = "";
    try { snap = fs.readFileSync(snapPath, "utf8"); } catch {}
    let input = "";
    process.stdin.on("data", d => input += d);
    process.stdin.on("end", () => {
      const files = input.split("\n").filter(Boolean);
      // ТОЛЬКО ВЫЗОВ, И НЕ В КОММЕНТАРИИ.
      //
      // Первая версия искала `\b(describe|it|test)\.skip\b` по сырому тексту и
      // посчитала выключенным тест в trainingDedupColumn, где эта пара слов
      // стоит В КОММЕНТАРИИ: «соседняя рантайм-сьюта — describe.skip». Итог
      // 46 вместо 45, и это число я успел опубликовать. Теперь требуется
      // скобка вызова, а комментарии вырезаются до поиска.
      const SKIP = /\b(describe|it|test)\.skip\s*\(/;
      // Вырезаем и комментарии, И строковые литералы. Комментарии — с #1712,
      // где упоминание `describe.skip` в шапке посчиталось выключенным тестом.
      // Строки — потому что ровно на них обжёгся tri dupes (#1724): восемь из
      // десяти его находок оказались образцами кода внутри шаблонных строк.
      // Здесь сегодня совпадений нет (42 и в сыром тексте, и в коде), то есть
      // перепись верна ПО УДАЧЕ: ни одна фикстура пока не содержит `.skip(`.
      // Свойство, которое держится удачей, ничем не удерживается — чиним до
      // того, как первая такая фикстура появится.
      // Кавычки задаются кодами намеренно: литеральный апостроф внутри
      // node -e рвёт саму bash-строку, в которой этот скрипт живёт. Поймано
      // дважды подряд — сперва в коде, потом в ЭТОМ комментарии.
      const QUOTES = String.fromCharCode(96, 34, 39);
      const stripComments = t => {
        let o = "", i = 0;
        const keep = x => x.replace(/[^\n]/g, " ");
        while (i < t.length) {
          const c = t[i];
          if (c === "/" && t[i + 1] === "*") {
            const j = t.indexOf("*/", i + 2); const e = j === -1 ? t.length : j + 2;
            o += keep(t.slice(i, e)); i = e; continue;
          }
          if (c === "/" && t[i + 1] === "/") {
            const j = t.indexOf("\n", i); const e = j === -1 ? t.length : j;
            o += keep(t.slice(i, e)); i = e; continue;
          }
          if (QUOTES.includes(c)) {
            let j = i + 1;
            while (j < t.length) {
              if (t[j] === "\\") { j += 2; continue; }
              if (t[j] === c) break;
              if (c !== "`" && t[j] === "\n") break;
              j++;
            }
            const e = Math.min(j + 1, t.length);
            o += c + keep(t.slice(i + 1, e)); i = e; continue;
          }
          o += c; i++;
        }
        return o;
      };
      let sites = 0, hidden = 0, undoc = 0;
      const undocList = [], hiddenFiles = new Map();
      for (const f of files) {
        let src;
        // ДВА ТЕКСТА, А НЕ ОДИН. Поиск идёт по тексту БЕЗ комментариев (иначе
        // упоминание в комментарии считается выключенным тестом), а окно
        // «есть ли записанная причина» смотрит в ИСХОДНЫЙ текст — причина и
        // есть комментарий, и вырезав их, я бы объявил недокументированными
        // все до одного. Самопроверка это и поймала.
        let raw;
        try { raw = fs.readFileSync(f, "utf8"); } catch { continue; }
        src = stripComments(raw).split("\n");
        const rawLines = raw.split("\n");
        const green = snap.includes(f + " :: ");
        for (let i = 0; i < src.length; i++) {
          if (!SKIP.test(src[i])) continue;
          sites++;
          if (green) { hidden++; hiddenFiles.set(f, (hiddenFiles.get(f)||0)+1); }
          const win = rawLines.slice(Math.max(0, i-12), i).join("\n");
          if (!/(\/\/|\*)\s*\S/.test(win)) { undoc++; undocList.push(f + ":" + (i+1)); }
        }
      }
      for (const [f, n] of [...hiddenFiles].sort((a,b) => b[1]-a[1]))
        console.log("  " + String(n).padStart(2) + "  " + f);
      console.log("");
      console.log("выключенных тестов: " + sites);
      console.log("из них СПРЯТАНЫ в зелёных файлах (гейт их не видит): " + hidden);
      console.log("без записанной причины: " + undoc);
      for (const u of undocList) console.log("    - " + u);
      process.exit(undoc === 0 ? 0 : 1);
    });
  ' "$ROOT/.test-baseline.txt"
}

cmd_skipped_selfcheck() {
  # ЛИНЕЙКА В ОБЕ СТОРОНЫ, на временных файлах: репозиторий не трогаем.
  local d=/tmp/tri-skipped-probe
  rm -rf "$d"; mkdir -p "$d"
  printf "describe('x', () => {\n  it.skip('bare', () => {})\n})\n" > "$d/bare.test.ts"
  printf "describe('x', () => {\n  // reason: waiting on a stand\n  it.skip('documented', () => {})\n})\n" > "$d/doc.test.ts"
  local rc=0 out
  out="$(cmd_skipped "$d/bare.test.ts" 2>&1 || true)"
  if printf '%s' "$out" | grep -q 'без записанной причины: 1'; then
    good 'skip без объяснения опознан'
  else
    bad 'СЛОМАНА: skip без объяснения не опознан'
    rc=1
  fi
  printf "// the sibling suite is describe.skip and that is fine\ndescribe('x', () => {\n  it('live', () => {})\n})\n" > "$d/mention.test.ts"
  # Образец кода ВНУТРИ шаблонной строки — то, на чём обжёгся tri dupes.
  printf "const sample = \`describe.skip('inside', () => {})\`\ndescribe('x', () => {\n  it('live', () => {})\n})\n" > "$d/fixture.test.ts"
  out="$(cmd_skipped "$d/mention.test.ts" 2>&1 || true)"
  if printf '%s' "$out" | grep -q 'выключенных тестов: 0'; then
    good 'упоминание skip в комментарии не считается выключенным тестом'
  else
    bad 'СЛОМАНА: комментарий со словом skip посчитан выключенным тестом'
    rc=1
  fi

  out="$(cmd_skipped "$d/fixture.test.ts" 2>&1 || true)"
  if printf '%s' "$out" | grep -q 'выключенных тестов: 0'; then
    good 'skip внутри шаблонной строки не считается выключенным тестом'
  else
    bad 'СЛОМАНА: образец кода в строке посчитан выключенным тестом'
    rc=1
  fi

  out="$(cmd_skipped "$d/doc.test.ts" 2>&1 || true)"
  if printf '%s' "$out" | grep -q 'без записанной причины: 0'; then
    good 'skip с записанной причиной не считается нарушением'
  else
    bad 'СЛОМАНА: документированный skip засчитан как нарушение'
    rc=1
  fi
  rm -rf "$d"
  return "$rc"
}

cmd_unguarded() {
  # СЛЕПОЕ ПЯТНО ВОРОТ. Ворота сравнивают МНОЖЕСТВА имён: они кричат, когда имя
  # ПРОПАЛО из снимка. Про тест, которого в снимке НИКОГДА НЕ БЫЛО, сказать
  # нечего — пропасть он не может. Такой тест зелёный, полезный и никем не
  # охраняемый: сломай его завтра, и ворота промолчат.
  #
  # Так вышло с PR #1696: пять тестов влились и остались вне снимка на целую
  # итерацию. Нашлось по расхождению «+11, а добавлено 6».
  #
  # ПОЧЕМУ ЗДЕСЬ ДВА ЧИСЛА, А НЕ ОДНО. Первая версия печатала одно: «80 из 531
  # не под охраной». Число оказалось завышено вдвое, и я успел опубликовать его
  # в дашборде и в сообщении коммита. Из тех 80 тридцать девять исключены из
  # прогона САМИМ vitest.config.ts, и там у каждого исключения записана
  # причина: у player свой раннер (bun run test:player), файлы с bun:test
  # гоняет npm run test:bun, ещё три умирают на загрузке модуля. Это не дыра в
  # охране, это другой сторож. Оставшиеся — в области корневого прогона и
  # действительно вне снимка; вот их и надо читать.
  #
  # Прогона нет, только текст. Точное пофайловое сравнение имён — tri в-гейте.
  local snap="${1:-$ROOT/.test-baseline.txt}"
  [ -f "$snap" ] || { bad "снимок не найден: $snap"; return 2; }

  git -C "$ROOT" ls-files '*.test.ts' '*.test.tsx' | sort > /tmp/tri-unguarded-all.txt
  node -e '
    const fs = require("fs");
    const root = process.argv[1], snapPath = process.argv[2];
    const snap = fs.readFileSync(snapPath, "utf8");
    const files = fs.readFileSync("/tmp/tri-unguarded-all.txt", "utf8").split("\n").filter(Boolean);
    const cfg = fs.readFileSync(root + "/vitest.config.ts", "utf8");
    const m = cfg.match(/exclude:\s*\[([\s\S]*?)\n    \],/);
    const pats = m ? [...m[1].matchAll(/'"'"'([^'"'"']+)'"'"'/g)].map(x => x[1]) : [];
    // ОДИН проход, а не цепочка замен: последовательные replace портят
    // собственный вывод — "**" превращается в ".*", после чего замена "*" на
    // "[^/]*" делает из него ".[^/]*", и шаблон перестаёт ходить вглубь.
    // Именно так 25 файлов player'"'"'а вывалились из "исключённых" и завысили
    // остаток с 41 до 67.
    const rx = p => {
      const esc = s2 => s2.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, "[^/]*");
      const joined = p.split("**").map(esc).join("\u0000");
      return new RegExp("^" + joined
        .replace(/\u0000\//g, "(?:.*/)?")
        .replace(/\u0000/g, ".*") + "$");
    };
    const excluded = [], residue = [];
    for (const f of files) {
      if (snap.includes(f + " :: ")) continue;
      (pats.some(p => rx(p).test(f)) ? excluded : residue).push(f);
    }
    for (const f of residue) console.log("  " + f);
    console.log("");
    console.log("файлов с тестами: " + files.length);
    console.log("исключены из прогона конфигом (свой раннер / мёртвые на импорте): " + excluded.length);
    console.log("В ОБЛАСТИ ПРОГОНА, но вне снимка: " + residue.length);
    process.exit(residue.length === 0 ? 0 : 1);
  ' "$ROOT" "$snap"
}

cmd_unguarded_selfcheck() {
  # ЛИНЕЙКА ОБЯЗАНА ОТВЕЧАТЬ ПО-РАЗНОМУ НА ДВУХ РЕАЛЬНЫХ СНИМКАХ.
  #
  # a937b089c — снимок сразу после мержа #1696: файл stars-secret-not-logged
  # уже в репозитории, но в снимке его НЕТ. Команда обязана его назвать.
  # Текущий снимок его содержит (обновлён в #1697) — назвать не должна.
  local f='apps/vibee-editor/render/stars-secret-not-logged.test.ts'
  local old_snap="/tmp/tri-unguarded-old-baseline.txt"
  if ! git -C "$ROOT" show a937b089c:.test-baseline.txt > "$old_snap" 2>/dev/null; then
    warn 'самопроверка пропущена: исторический снимок a937b089c недоступен'
    return 0
  fi
  local rc=0
  # ВЫВОД СНАЧАЛА В ПЕРЕМЕННУЮ, а не в конвейер. cmd_unguarded возвращает 1,
  # КОГДА НАХОДИТ, — это удобно для ворот, но при set -o pipefail (строка 27)
  # статус конвейера берётся от неё, а не от grep. Пайп «нашёл» читался как
  # «не нашёл», и обе половины линейки врали: вторая печатала OK всегда,
  # потому что незащищённые файлы есть ВСЕГДА. Проверка, которая не умеет
  # провалиться, ничего не проверяет.
  local out_old out_now
  out_old="$(cmd_unguarded "$old_snap" 2>/dev/null || true)"
  out_now="$(cmd_unguarded 2>/dev/null || true)"
  if printf '%s' "$out_old" | grep -qF "$f"; then
    good 'на снимке после #1696 незащищённый файл найден'
  else
    bad 'СЛОМАНА: на снимке после #1696 незащищённый файл не найден'
    rc=1
  fi
  if printf '%s' "$out_now" | grep -qF "$f"; then
    bad 'СЛОМАНА (или снимок снова отстал): файл всё ещё вне текущего снимка'
    rc=1
  else
    good 'в текущем снимке этот файл под охраной'
  fi
  # ТРЕТЬЯ ПРОВЕРКА ПИННИНГУЕТ РАЗДЕЛЕНИЕ, а не только сам список.
  # Первая версия печатала одно число (80) и была завышена вдвое: перевод
  # glob в регексп ломался на 'apps/vibee-editor/player/**', и 25 файлов
  # с собственным раннером считались незащищёнными. Регресс в переводе снова
  # раздует остаток молча, поэтому здесь: файл player'а обязан быть В
  # ИСКЛЮЧЁННЫХ (то есть НЕ в выводе), а обе доли — ненулевыми.
  local player_file
  player_file="$(git -C "$ROOT" ls-files 'apps/vibee-editor/player/**/*.test.ts*' | head -1)"
  if [ -z "$player_file" ]; then
    warn 'самопроверка раздела пропущена: у player не нашлось тестов'
  elif printf '%s' "$out_now" | grep -qF "$player_file"; then
    bad 'СЛОМАНА: файл player-раннера попал в остаток — перевод glob сломан'
    rc=1
  else
    good 'файлы своего раннера учтены как исключённые, а не как дыра'
  fi

  rm -f "$old_snap"
  return "$rc"
}

cmd_in_gate_selfcheck() {
  # ЛИНЕЙКУ ПРОВЕРЯЕМ В ОБЕ СТОРОНЫ, иначе она умеет только говорить «да».
  # Нужен файл, который гейт ОБЯЗАН видеть, и файл, который он обязан НЕ
  # видеть; проверка, отвечающая одинаково на оба, бесполезна.
  local yes no rc=0
  yes="$(cd "$ROOT" && ls src/__tests__/money/*.test.ts 2>/dev/null | head -1)"
  no="$(cd "$ROOT" && ls apps/vibee-editor/player/src/**/*.test.ts 2>/dev/null | head -1)"
  if [ -z "$yes" ] || [ -z "$no" ]; then
    warn 'самопроверка пропущена: не нашёл пару образцов (да/нет)'
    return 0
  fi
  if cmd_in_gate "$yes" >/dev/null 2>&1; then
    good "положительный образец виден гейту: $(basename "$yes")"
  else
    bad "СЛОМАНА: гейт не видит заведомо собираемый $(basename "$yes")"
    rc=1
  fi
  if cmd_in_gate "$no" >/dev/null 2>&1; then
    bad "СЛОМАНА: отвечает «да» на исключённый $(basename "$no")"
    rc=1
  else
    good "исключённый образец не виден гейту: $(basename "$no")"
  fi
  return "$rc"
}

cmd_disk() {
  # САМОВОССТАНОВЛЕНИЕ ДИСКА. Цикл делит DATA-том с чужими сессиями; когда том
  # заполняется под нуль, Bash падает с ENOSPC ещё ДО запуска команды — харнесс
  # не может создать файл вывода, и весь виток встаёт (случилось it.69). Команда
  # мерит ВЕРНЫЙ том, чистит МОИ следы и называет чужих пожирателей.
  #
  # ЛИНЕЙКА «занято» — ОТКРЫТЫЙ ДЕСКРИПТОР, а не mtime. Пойман vvp-симулятор
  # Verilog, державший 31G scratch с mtime недельной давности: жив, хотя выглядел
  # мёртвым. Поэтому reap удаляет сессию только когда lsof=0 хендлов И mtime
  # старше суток (двойная страховка; текущую сессию бережёт свежий mtime).
  local mode="${1:-}"

  # (1) ВЕРНЫЙ том. `df /` показывает запечатанный системный снапшот (почти
  # всегда «полон» и неинформативен); реальное место живёт на DATA-томе.
  paint '1;36' 'DATA-том'
  df -h /System/Volumes/Data | sed -n '1,2p'

  # (2) Мои worktree'ы. prune снимает записи, чей каталог уже исчез (безопасно).
  echo; paint '1;36' 'worktree цикла'
  git -C "$ROOT" worktree prune 2>/dev/null
  git -C "$ROOT" worktree list 2>/dev/null

  # (3) Scratch сессий. Один прогон lsof, дальше сверяем по пути открытых файлов.
  echo; paint '1;36' 'scratch сессий  (к возврату = 0 хендлов И mtime>суток)'
  local tmproot="/private/tmp/claude-$(id -u)"
  local held; held="$(lsof -Fn 2>/dev/null | grep "^n$tmproot" || true)"
  local d base sz
  for d in "$tmproot"/*/*; do
    [ -d "$d" ] || continue
    base="$(basename "$d")"
    case "$base" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*) ;;
      *) continue ;;
    esac
    sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
    if printf '%s\n' "$held" | grep -q -- "$base"; then
      skip "жива (открыт дескриптор), пропуск: $sz  $base"
    elif [ -n "$(find "$d" -maxdepth 0 -mtime +1 2>/dev/null)" ]; then
      if [ "$mode" = "reap" ] || [ "$mode" = "чисти" ]; then
        rm -rf "$d" 2>/dev/null && good "освобождено $sz  $base"
      else
        warn "мёртвая, к возврату: $sz  $base   (запусти: tri диск чисти)"
      fi
    else
      skip "свежая (<суток), пропуск: $sz  $base"
    fi
  done

  # (4) Крупные ЧУЖИЕ пожиратели — НАЗВАТЬ, но не трогать: это данные владельца,
  # а удаление данных — его решение (деструктив последним, [[debugging_doctrine]]).
  echo; paint '1;36' 'крупные пожиратели  (владельцу — сам не трогаю)'
  local p
  for p in \
    "$HOME/Library/Containers/com.docker.docker" \
    "$HOME/Library/Caches" \
    "$HOME/Library/Developer/CoreSimulator" \
    "$HOME/Library/Developer/Xcode/DerivedData"; do
    [ -e "$p" ] && du -sh "$p" 2>/dev/null
  done
}

