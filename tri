        h, r = int(statistics.median(hears)), int(statistics.median(reads))
        # Which ears heard it: "gigaam"/"parakeet", "whisper", or both when
        # the fast ears fell back on some runs -- that mix is itself the finding.
        ears = '/'.join(sorted(engines)) or 'whisper'
        road = max(0, med - h - r)
        split = f' = upload {r} + {ears} {h} + road {road} (warm round trip {ping})'
    else:
