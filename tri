cmd_money_writers() {
  # КТО ВООБЩЕ МОЖЕТ ДВИНУТЬ ДЕНЬГИ. СПРОСИ ДО ТОГО, КАК ПИСАТЬ ДЕНЕЖНЫЙ ТЕСТ.
  #
  # Баланс -- не колонка: get_user_balance складывает строки таблицы платежей.
