cmd_untracked() {
  # ФАЙЛ, КОТОРОГО ЕЩЁ НЕТ В ИНДЕКСЕ, НЕВИДИМ ДЛЯ ОХРАН -- И ГЕЙТ ЗЕЛЕНЕЕТ.
  #
  # it.174: я написал файл, прогнал гейт (зелено, регрессий нет), и ТОЛЬКО
  # ПОТОМ сделал git add. На следующей итерации main оказался красным из-за
  # этого файла. Популяция охран приходит из `git ls-files`, а он не
  # перечисляет неотслеживаемое: единственная охрана, которая обязана была
  # его судить, физически не могла его увидеть.
  #
  # Порядок «написал -> гейт -> add» выглядит осторожным и является обычным.
  # Значит дефект не в дисциплине, а в том, что зелёный гейт на таком дереве
  # НЕОТЛИЧИМ от зелёного гейта на полном.
  #
  # Команда печатает: какие исходники сейчас невидимы и какие охраны их
  # пропустят. Пустой список -- значит гейту можно верить.
  ( cd "$ROOT" && node -e '
    const { execFileSync } = require("child_process")
    const run = a => execFileSync("git", a, { encoding: "utf8" }).split("\n").filter(Boolean)
    const SRC = /\.(ts|mts|cts|js|mjs|cjs)$/
    const hidden = run(["ls-files", "--others", "--exclude-standard"]).filter(f => SRC.test(f))
    const guards = execFileSync("bash", ["-c",
      "grep -rl \"ls-files\" src/__tests__ 2>/dev/null || true"],
      { encoding: "utf8" }).split("\n").filter(Boolean)
    // ПОПУЛЯЦИЯ -- ЭТО ТО, ЧЕМ ОНА ЧИТАЕТСЯ, А НЕ ТО, ЧТО УПОМЯНУТО В ТЕКСТЕ.
    // Первая версия этой команды считала слепой любую охрану, где встречается
    // ls-files без --others, и насчитала 5. Одна из пяти сканирует ОБХОДОМ
    // ФАЙЛОВОЙ СИСТЕМЫ (walk/readdirSync) и неотслеживаемое видит прекрасно;
    // её вызовы ls-files -- предмет её собственной проверки. Настоящих слепых
    // было 4. Матчер знал написание, а не вещь.
    const fs2 = require("fs")
    const rows = guards.map(g => {
      const t = fs2.readFileSync(g, "utf8")
      // Обход ФС проверяется ПЕРВЫМ: он полон по построению, независимо от
      // того, что ещё упомянуто в файле.
      if (/walk\(|readdirSync\(/.test(t)) return [g, "полная (обход ФС)"]
      if (/repoFiles\(/.test(t)) return [g, "полная (repoFiles)"]
      if (/--others/.test(t)) return [g, "полная (--others)"]
      return [g, "СЛЕПА (только индекс)"]
    })
    const blind = rows.filter(r => r[1].startsWith("СЛЕПА"))
    console.log("охран, упоминающих git ls-files: " + guards.length)
    rows.forEach(r => console.log("     " + r[1].padEnd(24) + r[0]))
    console.log("  слепых на неотслеживаемое: " + blind.length)
    console.log("\nнеотслеживаемых исходников: " + hidden.length)
    hidden.forEach(f => console.log("     " + f))
    if (hidden.length && blind.length) {
      console.log("\n!! " + blind.length + " ОХРАН НЕ СУДЯТ ЭТИ ФАЙЛЫ.")
      console.log("   git add их до прогона -- иначе зелёный ничего не значит.")
    } else if (hidden.length) {
      // После #1883 популяция охран включает неотслеживаемое, поэтому список
      // выше -- уже НЕ список невидимого. Называть его так значило бы
      // пугать несуществующим: сами файлы никуда не делись, а слепота ушла.
      console.log("\nслепых охран нет -- эти файлы уже входят в популяцию.")
    } else {
      console.log("\nнеотслеживаемых исходников нет.")
    }
  ' )
}

cmd_money_ratchets() {
