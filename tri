# ─────────────────────────────────────────────────────────────────────────
# tri board: is the board on app.t27.ai the board trinity's main says it is?
#
# The player builds the board from gHashTag/trinity at a pinned QUEEN_REF
# (apps/vibee-editor/Dockerfile, stage `queen`). A merge in trinity ships
# nothing until that line moves; trinity's board-release.yml opens a
# release(board) PR here for each push to its main, and the older ones go
# stale. Before this the state took four commands and a mental diff.
#
# One screen: the pinned SHA on origin/main, trinity main's HEAD, the commits
# between them, and every open release(board) PR -- stale when its SHA is
# already inside the pin, current when it is trinity main.
# A release PR is merged by a reviewer agent, not by the session that
# authored the trinity change (owner, 2026-10-02; skill
# continuous-improvement-loop, "The loop ships its green PRs -- through a
# reviewer, not by its own hand").
#
#   tri board    rc 0 the board is trinity main, 1 behind, 2 unknown
# ─────────────────────────────────────────────────────────────────────────
cmd_board() {
  if [ $# -gt 0 ]; then bad "tri board takes no arguments, not '$1'"; return 2; fi
  timeout 60 git -C "$ROOT" fetch -q origin main 2>/dev/null \
    || warn 'git fetch origin main failed -- reading a possibly stale origin/main'
  local pin head
  pin=$(git -C "$ROOT" show origin/main:apps/vibee-editor/Dockerfile 2>/dev/null \
    | sed -n 's/^ARG QUEEN_REF=\([0-9a-f]\{40\}\)$/\1/p' | head -1)
  if [ -z "$pin" ]; then
    skip 'no 40-hex ARG QUEEN_REF in origin/main:apps/vibee-editor/Dockerfile'
    return 2
  fi
  # gh api prints the error body to stdout on a failed call, so an answer is
  # only kept when gh exited 0 -- a 404 page is not a SHA.
  head=$(timeout 30 gh api repos/gHashTag/trinity/commits/main --jq .sha 2>/dev/null) || head=
  if [ -z "$head" ]; then
    skip "pinned ${pin:0:7}; trinity main did not answer -- cannot compare"
    return 2
  fi
  good "pinned  ${pin:0:7}  (origin/main QUEEN_REF)"
  good "trinity ${head:0:7}  (gHashTag/trinity main)"
  local rc=0
  if [ "$pin" = "$head" ]; then
    good 'the pin is trinity main -- nothing to ship'
  else
    local ahead
    ahead=$(timeout 30 gh api "repos/gHashTag/trinity/compare/$pin...$head" \
      --jq '.ahead_by' 2>/dev/null) || ahead=
    warn "the board is ${ahead:-?} commit(s) behind trinity main:"
    timeout 30 gh api "repos/gHashTag/trinity/compare/$pin...$head" \
      --jq '.commits[] | "      " + .sha[0:7] + " " + (.commit.message | split("\n")[0])' \
      2>/dev/null | tail -20
    rc=1
  fi
  local prs
  # By branch, not by title search: GitHub search drops the parentheses in
  # "release(board)" and matched nothing while #3304 was open.
  prs=$(timeout 30 gh pr list --repo gHashTag/999-multibots-telegraf --state open \
    --limit 200 --json number,title,headRefName \
    --jq '.[] | select(.headRefName | startswith("release/board-")) | "\(.number) \(.title)"' \
    2>/dev/null)
  if [ -z "$prs" ]; then
    [ "$rc" = 1 ] && warn 'no open release(board) PR -- trinity board-release.yml did not open one'
    return "$rc"
  fi
  local n title sha status
  while read -r n title; do
    sha=$(printf '%s' "$title" | sed -n 's/.*ship trinity \([0-9a-f]\{7,40\}\).*/\1/p')
    if [ -z "$sha" ]; then
      warn "#$n $title -- no SHA in the title"; continue
    fi
    # The pin first: when the pin is already trinity main, a PR for that same
    # SHA is stale, not "to merge".
    if [ "${pin#"$sha"}" != "$pin" ]; then
      warn "#$n ships $sha, already the pin -- stale, close it"
      continue
    fi
    if [ "${head#"$sha"}" != "$head" ]; then
      good "#$n ships trinity main ($sha) -- for a reviewer agent to review and merge"
      continue
    fi
    status=$(timeout 30 gh api "repos/gHashTag/trinity/compare/$sha...$pin" \
      --jq .status 2>/dev/null) || status=
    case "$status" in
      ahead|identical) warn "#$n ships $sha, already inside the pin -- stale, close it" ;;
      # An empty status is a 404 (the SHA is gone from trinity) or a timeout:
      # nothing was compared, so do not tell a reviewer the PR is superseded.
      '') warn "#$n ships $sha -- trinity did not answer for it, cannot compare; check by hand" ;;
      *) warn "#$n ships $sha, older than trinity main ($status) -- superseded by a newer release PR" ;;
    esac
  done <<<"$prs"
  return "$rc"
}

# ─────────────────────────────────────────────────────────────────────────
# tri deploys: is the player on app.t27.ai the code main says it is?
#
# 999's GitHub Actions are dead (billing), so the player's tests run in ONE
# place: the vibee-editor Docker build (tsc + scripts/test-gate.mjs). One
# failing test there refuses EVERY later deploy, and nothing tells anyone --
# #3199, #3234 and #3238 all merged "green" and none of them went live.
# Worse, a test-only commit is SKIPPED by the service's watchPatterns, so the
# commit that broke a test is never the one whose deploy fails: blame lands
# on the next innocent source change.
#
# This answers it from Railway and git, in one screen:
#   - the commit actually serving (newest SUCCESS deploy);
#   - every commit on origin/main since then that touches what the image is
#     built from (the watchPatterns of apps/vibee-editor/railway.toml), with
#     its deploy status;
#   - for the newest FAILED deploy: the failing test files and the vitest
#     "x" lines, the tsc errors, the gate's REFUSED line, and the commit that
#     last touched each failing test file.
#
#   tri deploys          rc 0 live, 1 failed or behind, 2 unknown, 5 building
#   tri deploys --logs   also print the raw tail of the failed build log
# ─────────────────────────────────────────────────────────────────────────
cmd_deploys() {
  local p=564d9ebd-7aa8-44fe-93ec-e0b03c87158d e=e4d200ad-b8a9-4edf-9b25-190a32613b32
  local s=7aad4834-8ac0-4d6b-a031-44ec694ad8de raw=0 a
  for a in "$@"; do
    case "$a" in
      --logs) raw=1 ;;
      *) bad "tri deploys [--logs], not '$a'"; return 2 ;;
    esac
  done
  local list
  list=$(timeout 40 railway deployment list -p "$p" -e "$e" -s "$s" --limit 60 --json 2>/dev/null)
  if [ -z "$list" ] || ! printf '%s' "$list" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then
    skip 'player: railway did not answer -- deploy state unknown'
    return 2
  fi
  timeout 60 git -C "$ROOT" fetch -q origin main 2>/dev/null \
    || warn 'git fetch origin main failed -- comparing with a possibly stale origin/main'

  # The newest SUCCESS is what serves; REMOVED ones are older replaced images.
  local live
  live=$(printf '%s' "$list" | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    if d["status"] == "SUCCESS":
        print((d.get("meta") or {}).get("commitHash") or ""); break')
  if [ -z "$live" ] || ! git -C "$ROOT" cat-file -e "$live^{commit}" 2>/dev/null; then
    skip "player: no SUCCESS deploy with a known commit among the last 60 (${live:-none})"
    return 2
  fi
  good "player serves $(git -C "$ROOT" log -1 --format='%h %s' "$live" | cut -c1-90)"
  if ! git -C "$ROOT" merge-base --is-ancestor "$live" origin/main; then
    warn "the serving commit is not on origin/main (a manual 'railway up'?)"
  fi

  # Same set as watchPatterns in apps/vibee-editor/railway.toml: what the
  # image is built from. Test files are excluded there, so here too.
  local behind
  behind=$(git -C "$ROOT" log --format='%H %s' "$live..origin/main" -- \
    apps/vibee-editor/player apps/vibee-editor/packages apps/vibee-editor/nginx \
    apps/vibee-editor/Dockerfile apps/vibee-editor/docker-entrypoint.sh \
    apps/vibee-editor/railway.toml \
    ':(glob,exclude)apps/vibee-editor/player/**/*.test.ts' \
    ':(glob,exclude)apps/vibee-editor/player/**/*.test.tsx')
  local verdict failed_id
  verdict=$(printf '%s' "$list" | BEHIND="$behind" python3 -c '
import json, os, sys
deps = json.load(sys.stdin)
by = {}
for d in deps:  # newest first: keep the newest deploy of each commit
    h = (d.get("meta") or {}).get("commitHash") or ""
    by.setdefault(h, d)
rows = [l.split(" ", 1) for l in os.environ["BEHIND"].splitlines() if l.strip()]
building = ("BUILDING", "DEPLOYING", "INITIALIZING", "QUEUED", "WAITING")
state, failed = "live", ""
for h, subject in rows:
    d = by.get(h)
    st = d["status"] if d else "NO DEPLOY"
    print("ROW %-9s %s %s" % (st, h[:9], subject[:70]))
    if st in ("FAILED", "CRASHED") and not failed:
        failed = d["id"]
    if st in building and state == "live":
        state = "building"
if rows and state == "live":
    state = "behind"
if failed:
    state = "failed"
print("STATE %s %s %d" % (state, failed or "-", len(rows)))')
  printf '%s\n' "$verdict" | sed -n 's/^ROW /    /p'
  local state n
  read -r _ state failed_id n <<<"$(printf '%s\n' "$verdict" | grep '^STATE ')"
  case "$state" in
    live) good 'player: nothing on main since the serving commit touches the image'; return 0 ;;
    building) warn "player: $n commit(s) not live yet, a deploy is on its way -- check again"; return 5 ;;
    behind) bad "player: $n commit(s) on main touch the image but are not live (no FAILED deploy found among the last 60)"; return 1 ;;
  esac

  bad "player: $n commit(s) on main are NOT live -- the deploy $failed_id FAILED"
  local log
  log=$(timeout 90 railway logs "$failed_id" -b -n 3000 2>/dev/null)
  if [ -z "$log" ]; then
    skip 'the build log did not come back -- read it: railway logs '"$failed_id"' -b'
    return 1
  fi
  printf '%s\n' "$log" | python3 -c '
import re, sys
text = re.sub(r"\x1b\[[0-9;]*m", "", sys.stdin.read())
seen, files = set(), []
for line in text.splitlines():
    s = line.strip()
    m = re.match(r"(?:❯|FAIL)\s+(\S+\.test\.tsx?)\b.*?(\d+ failed|\))", s)
    if m and "failed" in s and m.group(1) not in files:
        files.append(m.group(1))
    keep = (
        s.startswith("×")
        or "error TS" in s
        or s.startswith("test gate:")
        or (m and "failed" in s)
    )
    if keep and s not in seen:
        seen.add(s)
        print("    " + s[:160])
for f in files:
    print("FILE " + f)' > /tmp/tri-deploys-why.$$
  grep -v '^FILE ' /tmp/tri-deploys-why.$$
  local f last
  while read -r _ f; do
    last=$(git -C "$ROOT" log -1 --format='%h %s' origin/main -- "apps/vibee-editor/player/$f" | cut -c1-80)
    [ -n "$last" ] && printf '    last touched %s by %s\n' "$f" "$last"
  done < <(grep '^FILE ' /tmp/tri-deploys-why.$$)
  if ! grep -q . /tmp/tri-deploys-why.$$; then
    warn 'no failing test or tsc line found in the build log -- the failure is elsewhere (use --logs)'
  fi
  rm -f /tmp/tri-deploys-why.$$
  [ "$raw" = 1 ] && printf '%s\n' "$log" | tail -40
  return 1
}

# ─────────────────────────────────────────────────────────────────────────
# tri loop: where the last cycle stopped, before this one starts.
#
# A cron loop fires every 15 minutes whether the previous cycle finished or
# not. The way a new cycle breaks the old one is not a bad edit, it is a
# blind start: a second branch over a dirty tree, a second push while a hook
# run still holds the first, a merge while the deploy of the last one is red.
# This prints all of it in one screen, and the exit code says whether it is
# safe to begin something new (0) or there is work in flight to continue (1).
# ─────────────────────────────────────────────────────────────────────────
cmd_loop() {
  local busy=0 branch dirty ahead
  branch=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null)
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null
  dirty=$(git -C "$ROOT" status --porcelain | grep -v '\.claude/launch\.json$' | wc -l | tr -d ' ')
  ahead=$(git -C "$ROOT" rev-list --count origin/main..HEAD 2>/dev/null || echo '?')
  printf '  branch %s: %s uncommitted, %s commits not in main\n' "$branch" "$dirty" "$ahead"
  [ "$dirty" != 0 ] && { warn 'uncommitted work: finish and commit it before anything new'; busy=1; }

  # Only processes working IN THIS TREE. Every session on this machine pushes
  # and runs gates; the first version of this check counted another session's
  # `git push` as ours and would have parked this loop behind it for ever.
  local pid running=''
  for pid in $(pgrep -f 'lefthook run|test-gate\.mjs|vitest run|git push' 2>/dev/null); do
    case "$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" in
      "$ROOT"|"$ROOT"/*) running+="$(ps -o pid=,command= -p "$pid" | cut -c1-130)"$'\n' ;;
    esac
  done
  if [ -n "$running" ]; then
    warn 'a gate or push is still running in this tree -- wait, do not start a second:'
    printf '%s' "$running" | sed 's/^/        /'
    busy=1
  fi

  if command -v gh >/dev/null; then
    local mine
    mine=$(gh pr list --head "$branch" --state all --json number,state,title \
      --jq '.[0] | select(.) | "#\(.number) \(.state) -- \(.title)"' 2>/dev/null)
    printf '  this branch PR: %s\n' "${mine:-none yet}"
    # An OPEN PR here is work in flight: merge it (or close it) before a new
    # cycle branches -- cycle 7 found this path saying "nothing in flight".
    case "$mine" in
      *' OPEN -- '*) warn 'this branch PR is still OPEN -- merge or close it first'; busy=1 ;;
    esac
  fi

  # Each service's newest deploy. A FAILED one on main blocks every later
  # merge of that service: fix it first, or nothing you merge goes live.
  local svc name
  for svc in 7aad4834-8ac0-4d6b-a031-44ec694ad8de:player 6339df9c-15b8-4f51-ba26-4af0b55c596a:render; do
    name=${svc#*:}
    timeout 30 railway deployment list -p 564d9ebd-7aa8-44fe-93ec-e0b03c87158d \
      -e e4d200ad-b8a9-4edf-9b25-190a32613b32 -s "${svc%%:*}" --limit 1 --json 2>/dev/null \
      | python3 -c '
import json, sys
name = sys.argv[1]
try:
    d = json.load(sys.stdin)[0]
except Exception:
    print("  " + name + ": deploy state unknown (railway did not answer)")
    sys.exit(2)
m = d.get("meta") or {}
msg = (m.get("commitMessage") or "").splitlines()[0][:60]
print("  %s: %s %s %s" % (name, d["status"], (m.get("commitHash") or "")[:9], msg))
# 4, not 1: a crash of this very script also exits 1, and must not read as
# "the deploy failed" -- the first run of this check said exactly that.
# 5: still on its way. Cycle 4 read "nothing in flight" with the player
# BUILDING -- a merge whose deploy is unverified IS work in flight.
if d["status"] in ("FAILED", "CRASHED"):
    sys.exit(4)
sys.exit(5 if d["status"] in ("BUILDING", "DEPLOYING", "INITIALIZING", "QUEUED", "WAITING") else 0)
' "$name"
    case "${PIPESTATUS[1]}" in
      4) bad "$name: the last deploy failed -- fix it before merging more (for the player, tri deploys says why)"; busy=1 ;;
      5) warn "$name: still deploying -- wait for SUCCESS before the next item"; busy=1 ;;
    esac
  done

  # The player's lint ratchet runs on pre-push only, and a push that had to
  # skip hooks (ssh drops after a long pre-push, so --no-verify) skips it.
  # Cycle 7 put 4 rules-of-hooks errors on main that way (a plain function
  # named useRoad) and the NEXT push, cycle 8's, was the one refused. ~25 s.
  if [ -z "${TRI_LOOP_FAST:-}" ]; then
    if node "$ROOT/scripts/player-lint-ratchet.cjs" >/tmp/tri-loop-lint.$$ 2>&1; then
      printf '  player lint: within the ratchet\n'
    else
      bad 'player lint is over its ratchet -- a push skipped hooks; fix it first:'
      sed 's/^/        /' /tmp/tri-loop-lint.$$ | head -5
      busy=1
    fi
    rm -f /tmp/tri-loop-lint.$$
  fi

  if [ "$busy" = 0 ]; then good 'nothing in flight: safe to start the next item'; fi
  return "$busy"
}

