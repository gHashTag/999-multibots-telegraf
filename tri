cmd_readers() {
  # Tests that read source as TEXT -- invisible to `vitest related`, which
  # follows the import graph. Moving code breaks them and the pre-push gate
  # does not notice: a money guard sat broken for two days that way.
  #   tri readers            the inventory, and any path that no longer exists
  #   tri readers --gate     exit 1 when a target is missing
  #   tri readers --run FILE...  run the tests that read FILE as text, NOW,
  #                          not five minutes into pre-push. 2026-10-02 the
  #                          same money guard broke the same way a second time
  #                          (top-up sentences moved out of useTokenTopUp.ts).
  if [ "${1:-}" = "--run" ]; then
    shift
    [ $# -gt 0 ] || { echo "usage: tri readers --run FILE..." >&2; return 2; }
    # By the quoted file NAME, not `--for`: `--for` also lists every scanner
    # that walks a whole directory (106 tests for one hook) -- too many to run
    # before a push. A guard on one file names it, as creditedIsNotOk does.
    # Untracked files count too: the guard being added in this very change is
    # usually the one that names the file.
    local tests="" f
    for f in "$@"; do
      tests="$tests $(cd "$ROOT" && { git ls-files '*.test.ts' '*.test.tsx'
        git ls-files --others --exclude-standard '*.test.ts' '*.test.tsx'; } \
        | xargs /usr/bin/grep -l -F "'$(basename "$f")'" 2>/dev/null)"
    done
    tests=$(echo $tests | tr ' ' '\n' | sort -u)
    if [ -z "$tests" ]; then echo "  --   no test names these files"; return 0; fi
    echo "$tests" | sed 's/^/  reads it: /'
    # Each test runs under the vitest config of ITS OWN package. The root
    # config excludes player/, and a file it excludes, passed by name, is
    # dropped SILENTLY: "75 passed" for 76 named, 2026-10-02.
    local groups t d mine rc=0
    groups=$(echo "$tests" | while read -r t; do
      d=$(dirname "$t")
      while [ "$d" != "." ] && ! ls "$ROOT/$d"/vitest.config.* >/dev/null 2>&1; do
        d=$(dirname "$d")
      done
      echo "$d $t"
    done)
    for d in $(echo "$groups" | cut -d' ' -f1 | sort -u); do
      mine=$(echo "$groups" | awk -v d="$d" '$1 == d { print $2 }')
      [ "$d" = "." ] || mine=$(echo "$mine" | sed "s#^$d/##")
      echo "  --   $(echo "$mine" | wc -l | tr -d ' ') under $d/vitest.config"
      # shellcheck disable=SC2086
      ( cd "$ROOT/$d" && timeout 600 npx vitest run $mine ) || rc=1
    done
    return $rc
  fi
  ( cd "$ROOT" && node "$ROOT/scripts/text-readers.cjs" "$@" )
}

# The live check for generation refusal codes (render/generation-refusal.ts):
# every generation route, asked without credentials, must refuse with a
# `code` the clients translate. Safe by construction -- each route charges
# before it calls a provider, and an unsigned call is refused at the charge,
# so nothing is spent. Run it after a render deploy; a route that answers
# without a code means the stamp is gone or the deploy has not landed.
cmd_gen_refusal() {
  local base="${1:-$RENDER}" kind body status code fails=0
  # The names come from the server's own list, not a copy of it.
  local known
  known=" $(sed -n '/^export const GENERATION_REFUSAL_CODES/,/] as const/p' \
    "$ROOT/apps/vibee-editor/render/generation-refusal.ts" | grep -oE "'[a-z_]+'" | tr -d "'" | tr '\n' ' ')"
  [ "$known" = " " ] && { bad "no codes read from render/generation-refusal.ts"; return 1; }
  for kind in image video audio lipsync; do
    body="$(curl -sS -m 30 -o /tmp/tri-gen-refusal.$$ -w '%{http_code}' \
      -X POST -H 'Content-Type: application/json' \
      --data '{"model":"probe","prompt":"probe","text":"probe"}' \
      "$base/api/generate/$kind" 2>/dev/null)" || body="000"
    status="$body"
    code="$(node -e 'try{const o=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(typeof o.code==="string"?o.code:"")}catch{}' /tmp/tri-gen-refusal.$$ 2>/dev/null)"
    if [ "$status" -ge 200 ] 2>/dev/null && [ "$status" -lt 300 ]; then
      bad "$kind: answered $status to an unsigned call -- that is not a refusal"
      fails=$((fails + 1))
    elif [ -n "$code" ] && [[ "$known" == *" $code "* ]]; then
      good "$kind: $status $code"
    elif [ -n "$code" ]; then
      warn "$kind: $status $code -- a code the clients do not know"
      fails=$((fails + 1))
    else
      bad "$kind: $status without a code ($(head -c 120 /tmp/tri-gen-refusal.$$ 2>/dev/null))"
      fails=$((fails + 1))
    fi
  done
  rm -f /tmp/tri-gen-refusal.$$
  [ "$fails" -eq 0 ]
}

cmd_pr_billing() {
  # Is every failing check on a PR the Actions billing stop, and nothing else?
  #   tri pr-billing N    rc 0 only if EVERY failing check run says so
  #
  # GitHub Actions has not run a job here since 2026-06-02 (billing), so every
  # PR shows ~17 red checks and the merge rule is "each one must be billing".
  # That was checked by hand in a shell loop every time, and on 2026-10-02 a
  # dropped connection returned an EMPTY annotation list: the loop printed
  # "NOT BILLING" for a job that had never started. An empty answer is
  # re-asked (3 tries) and, if still empty, counted as UNKNOWN -- never as
  # billing, never as a real failure.
  # TRI_GH: tri puts /opt/homebrew/bin first on PATH, so a stub gh on PATH
  # is silently bypassed -- the negative control needs a named seam.
  local gh="${TRI_GH:-gh}"
  local pr="${1:-}" repo="${TRI_GH_REPO:-gHashTag/999-multibots-telegraf}"
  [ -n "$pr" ] || { echo "usage: tri pr-billing PR_NUMBER" >&2; return 2; }
  local sha ids id name msg try billing=0 other=0 unknown=0
  sha=$("$gh" pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid) \
    || { bad "PR $pr not found in $repo"; return 2; }
  ids=$("$gh" api "repos/$repo/commits/$sha/check-runs?per_page=100" \
    --jq '.check_runs[]|select(.conclusion=="failure")|"\(.id)\t\(.name)"') \
    || { bad "could not list check runs for $sha"; return 2; }
  if [ -z "$ids" ]; then good "PR $pr: no failing checks"; return 0; fi
  while IFS=$'\t' read -r id name; do
    msg=""
    for try in 1 2 3; do
      msg=$("$gh" api "repos/$repo/check-runs/$id/annotations" --jq '.[].message' 2>/dev/null) && [ -n "$msg" ] && break
      sleep 2
    done
    if printf '%s' "$msg" | /usr/bin/grep -q "recent account payments have failed"; then
      billing=$((billing + 1))
    elif [ -z "$msg" ]; then
      unknown=$((unknown + 1)); skip "$name ($id): no annotation after 3 tries"
    else
      other=$((other + 1)); bad "$name ($id): $(printf '%s' "$msg" | head -1)"
    fi
  done <<< "$ids"
  echo "  --   PR $pr @ ${sha:0:9}: $billing billing, $other other, $unknown unknown"
  if [ $other -eq 0 ] && [ $unknown -eq 0 ]; then
    good "every failing check is the billing stop -- merge is allowed"
    return 0
  fi
  bad "not every failure is billing -- read the ones above before merging"
  return 1
}

cmd_premerge() {
  # Would PR N pass the player's deploy gate once it lands on today's main?
  #   tri premerge N           rc 0 pass, 1 refused/conflict, 2 usage/setup
  #   tri premerge N --keep    leave the throwaway worktree behind
  #
  # Actions are dead (billing), so the only test gate is the Docker `test`
  # stage, and it runs AFTER the merge, on main. A PR that is green on its own
  # branch can still break it: 2026-10-02, two PRs each passed alone and the
  # deploy of their sum failed. This runs the gate on (origin/main + PR head)
  # BEFORE the merge, so the red lands on the PR, not on app.t27.ai.
  #
  # node_modules are not installed (no downloads): each entry is symlinked
  # from a checkout that has them, except @vibee/*, which must resolve to THIS
  # worktree's packages -- a symlink into another tree tests the wrong atoms.
  local gh="${TRI_GH:-gh}" repo="${TRI_GH_REPO:-gHashTag/999-multibots-telegraf}"
  local pr="" keep=0 a
  for a in "$@"; do
    case "$a" in
      --keep) keep=1 ;;
      *) pr="$a" ;;
    esac
  done
  [[ "$pr" =~ ^[0-9]+$ ]] || { echo "usage: tri premerge PR_NUMBER [--keep]" >&2; return 2; }

  local src="${TRI_PLAYER_NM:-}" cand
  if [ -z "$src" ]; then
    for cand in "$ROOT" $(git -C "$ROOT" worktree list --porcelain | awk '/^worktree /{print $2}'); do
      if [ -d "$cand/apps/vibee-editor/player/node_modules" ] && [ ! -L "$cand/apps/vibee-editor/player/node_modules" ]; then
        src="$cand/apps/vibee-editor"; break
      fi
    done
  fi
  [ -n "$src" ] || { bad "no checkout with a real player/node_modules (set TRI_PLAYER_NM=<dir with player/ and packages/>)"; return 2; }

  local head
  head=$("$gh" pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid) \
    || { bad "PR $pr not found in $repo"; return 2; }
  git -C "$ROOT" fetch -q origin main "pull/$pr/head" \
    || { bad "git fetch of main and pull/$pr/head failed"; return 2; }
  local main_sha
  main_sha=$(git -C "$ROOT" rev-parse origin/main)

  local dir
  dir=$(mktemp -d "/tmp/tri-premerge-$pr.XXXX") || return 2
  rmdir "$dir"
  git -C "$ROOT" worktree add -q --detach "$dir" "$main_sha" || { bad "worktree add failed"; return 2; }
  local rc=0
  (
    cd "$dir" || exit 2
    git -c user.name=tri -c user.email=tri@localhost merge -q --no-edit "$head" >/dev/null 2>&1 || {
      bad "PR $pr (${head:0:9}) does not merge cleanly into main ${main_sha:0:9}:"
      git diff --name-only --diff-filter=U | sed 's/^/        /'
      exit 1
    }
    if git diff --name-only "$main_sha" HEAD -- 'apps/vibee-editor/player/package*.json' 'apps/vibee-editor/packages/*/package*.json' | grep -q .; then
      warn "PR $pr changes a package.json -- node_modules here are the local ones, a pass is not proof"
    fi
    local ed="$dir/apps/vibee-editor" e
    mkdir -p "$ed/player/node_modules/@vibee"
    for e in "$src/player/node_modules/"* "$src/player/node_modules/".bin "$src/player/node_modules/".vite; do
      [ -e "$e" ] || continue
      [ "$(basename "$e")" = "@vibee" ] && continue
      ln -s "$e" "$ed/player/node_modules/$(basename "$e")"
    done
    for e in "$ed"/packages/*/; do
      e="${e%/}"
      ln -s "../../../packages/$(basename "$e")" "$ed/player/node_modules/@vibee/$(basename "$e")"
      [ -d "$src/packages/$(basename "$e")/node_modules" ] && ln -s "$src/packages/$(basename "$e")/node_modules" "$e/node_modules"
    done
    # @vibee/atoms is the name the player imports; the directory is vibee-atoms.
    [ -e "$ed/packages/vibee-atoms" ] && ln -sfn ../../../packages/vibee-atoms "$ed/player/node_modules/@vibee/atoms"

    # The gate runs on the image's Node, not on whatever is first on PATH.
    # 2026-10-02, first run: Node 26 (tri puts Homebrew first) has its own
    # global Storage, a spy on Storage.prototype missed jsdom's, and a test
    # that passes in the image failed here. Nearest installed major wins.
    local want bin best="" bestd=99 m d
    want=$(sed -n 's/^FROM node:\([0-9][0-9]*\).* AS build$/\1/p' "$ed/Dockerfile" | head -1)
    for bin in /opt/homebrew/opt/node@*/bin "$HOME"/.nvm/versions/node/v*/bin; do
      [ -x "$bin/node" ] || continue
      m=$("$bin/node" -p 'process.versions.node.split(".")[0]' 2>/dev/null) || continue
      d=$(( m > ${want:-0} ? m - ${want:-0} : ${want:-0} - m ))
      [ $d -lt $bestd ] && { best="$bin"; bestd=$d; }
    done
    [ -n "$best" ] && PATH="$best:$PATH"
    [ "$(node -p 'process.versions.node.split(".")[0]')" = "$want" ] \
      || warn "the image builds on Node ${want:-?}, this runs on $(node -v) -- the nearest installed"

    echo "  --   PR $pr ${head:0:9} on main ${main_sha:0:9}, $(node -v): tsc --noEmit, then test-gate (several minutes)"
    cd "$ed/player" || exit 2
    npx tsc --noEmit -p . > "$dir/.premerge-tsc.log" 2>&1 || {
      bad "tsc refused:"; grep 'error TS' "$dir/.premerge-tsc.log" | head -20 | sed 's/^/        /'; exit 1
    }
    node scripts/test-gate.mjs > "$dir/.premerge-gate.log" 2>&1 || {
      bad "test gate refused:"
      sed 's/\x1b\[[0-9;]*m//g' "$dir/.premerge-gate.log" | grep -E '^ *(❯|×|FAIL)|test gate:' | head -30 | sed 's/^/        /'
      exit 1
    }
    good "PR $pr passes the deploy gate on main ${main_sha:0:9}: $(sed 's/\x1b\[[0-9;]*m//g' "$dir/.premerge-gate.log" | grep -E '^ *Tests ' | tail -1 | sed 's/^ *//')"
  ) || rc=$?
  if [ $keep -eq 1 ]; then
    echo "  --   kept: $dir (logs: .premerge-tsc.log, .premerge-gate.log)"
  else
    git -C "$ROOT" worktree remove --force "$dir" 2>/dev/null || { rm -rf "$dir"; git -C "$ROOT" worktree prune; }
  fi
  return $rc
}

