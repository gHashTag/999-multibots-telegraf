# A verdict nobody tested is a claim, not a check. The live pod is alive today,
# so the interesting three answers -- dead, wedged, never asked -- cannot be
# seen against it. They are served here from a local socket instead: the same
# code path, real HTTP, crafted bodies. A `tri browser` that called the wedged
# body healthy is exactly the failure #3152 exists to prevent, so it is the
# first case.
cmd_browser_selfcheck() {
  command -v python3 >/dev/null 2>&1 || {
    warn 'self-check skipped: no python3'; return 0; }

  local dir port_file rc=0
  dir=$(mktemp -d)
  port_file="$dir/port"

  BR_DIR="$dir" python3 - <<'PY' &
import http.server, json, os, threading

BODY = os.path.join(os.environ['BR_DIR'], 'body.json')

class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        with open(BODY, 'rb') as f:
            raw = f.read()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)
    def log_message(self, *a):
        pass

srv = http.server.HTTPServer(('127.0.0.1', 0), H)
with open(os.path.join(os.environ['BR_DIR'], 'port'), 'w') as f:
    f.write(str(srv.server_address[1]))
srv.serve_forever()
PY
  local srv_pid=$!

  local waited=0
  while [ ! -s "$port_file" ] && [ "$waited" -lt 50 ]; do
    sleep 0.1; waited=$((waited + 1))
  done
  if [ ! -s "$port_file" ]; then
    kill "$srv_pid" 2>/dev/null
    rm -rf "$dir"
    warn 'self-check skipped: the local socket never came up'
    return 0
  fi

  # Shadows the global for every cmd_browser call below -- bash scoping is
  # dynamic, so the command under test needs no test-only parameter.
  local RENDER="http://127.0.0.1:$(cat "$port_file")"
  local AGENT_KEY='selfcheck-not-a-real-key'

  # case | body | expected exit | word the answer must contain
  local case_name body want word out got
  while IFS='|' read -r case_name body want word; do
    [ -n "$case_name" ] || continue
    printf '%s' "$body" > "$dir/body.json"
    out=$(cmd_browser 2>&1); got=$?
    if [ "$got" -ne "$want" ]; then
      bad "BROKEN on $case_name: exit $got, expected $want"
      rc=1
    elif ! printf '%s' "$out" | grep -q "$word"; then
      bad "BROKEN on $case_name: the answer never says \"$word\""
      rc=1
    else
      good "$case_name reads as $word (exit $got)"
    fi
  done <<CASES
wedged Chromium|{"ok":true,"pods":[{"who":"p","pages":3,"cap":12,"reachable":true,"answers":false}]}|1|WEDGED
dead process|{"ok":true,"pods":[{"who":"p","pages":0,"cap":12,"reachable":false,"answers":null}]}|1|DEAD
nobody asked|{"ok":true,"pods":[{"who":"p","pages":3,"cap":12,"reachable":true,"answers":null}]}|2|NOT ASKED
a live page|{"ok":true,"pods":[{"who":"p","pages":3,"cap":12,"reachable":true,"answers":true}]}|0|alive
sitting at the cap|{"ok":true,"pods":[{"who":"p","pages":12,"cap":12,"reachable":true,"answers":true}]}|2|at the cap
no pod at all|{"ok":true,"pods":[]}|2|does not run one
CASES

  kill "$srv_pid" 2>/dev/null
  wait "$srv_pid" 2>/dev/null
  rm -rf "$dir"
  return "$rc"
}

