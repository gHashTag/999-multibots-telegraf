# Link every node_modules the main tree has and the worktree lacks: the root
# and each app's own (render, player, vibee-atoms...). An existing directory or
# link is left alone. Prints one line per link made; returns the count.
link_deps() {
  local src="$1" wt="$2" rel n=0
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    [ -e "$wt/$rel" ] || [ -L "$wt/$rel" ] && continue
    [ -d "$wt/$(dirname "$rel")" ] || continue
    ln -s "$src/$rel" "$wt/$rel" && echo "$rel" && n=$((n + 1))
  done < <(cd "$src" && { echo node_modules; find apps \( -type d -o -type l \) -name node_modules -prune 2>/dev/null | grep -v '/node_modules/'; })
  return 0
}

# What a node_modules path holds, in one word, so the "emptied" trap is named
# in every shape it takes: npm's emptying can leave only dotfiles behind
# (.package-lock.json, .bin), a removed target leaves a dangling link, and a
# half-finished install leaves nothing at all.
nm_state() {
  local d="$1"
  if [ -L "$d" ] && [ ! -e "$d" ]; then echo dangling; return; fi
  if [ ! -e "$d" ]; then echo absent; return; fi
  if [ -z "$(ls -A "$d" 2>/dev/null)" ]; then echo empty; return; fi
  if [ -z "$(ls "$d" 2>/dev/null)" ]; then echo dotfiles-only; return; fi
  echo ok
}

cmd_deps() {
  # Worktrees made by `tri worktree` get their node_modules linked; the ones a
  # bee, the Claude app or a plain `git worktree add` makes do not. Then the
  # gates fail in ways that read as code faults (2026-10-02, PR #3346):
  # render-types "tsc not found" summarised as a 240 s red, and bundle-boots
  # "spawnSync node_modules/.bin/esbuild ENOENT". This links what is missing
  # from the main checkout and names the binaries the gates call.
  #
  # The opposite trap (2026-10-02 23:14): an agent ran a root `npm ci` in a
  # worktree whose node_modules was such a link. npm empties node_modules
  # THROUGH the link before replacing it, so the main checkout -- and every
  # tree linked to it -- lost all its packages at once. When the main root is
  # empty this says so, and `--heal` reinstalls it there (never here).
  #
  # `--own` is the way out for a tree that really must install: it turns each
  # link (root AND per-app -- render/player links are just as shared) into the
  # tree's own copy, cloned copy-on-write where the disk can, so an install
  # there empties only the copy.
  local heal=0 own=0 arg path=""
  for arg in "$@"; do
    case "$arg" in
      --heal) heal=1 ;;
      --own) own=1 ;;
      -*) bad "unknown flag: $arg (tri deps [--heal] [--own] [path])"; return 1 ;;
      *) path="$arg" ;;
    esac
  done
  local wt main made
  wt="$(git -C "${path:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" \
    || { bad "not inside a git tree: ${path:-$PWD}"; return 1; }
  main="$(dirname "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)")"
  if [ "$wt" = "$main" ]; then
    good "$wt is the main checkout -- nothing to link"
    [ "$own" = 1 ] && echo "  note --own does nothing here: the main checkout's node_modules are its own"
  else
    made="$(link_deps "$main" "$wt")"
    if [ -n "$made" ]; then
      good "linked from $main:"; sed 's/^/       /' <<<"$made"
    else
      good "every node_modules the main tree has is already here"
    fi
    [ "$own" = 1 ] && { own_deps "$main" "$wt" || return 1; }
  fi
  local bin rc=0
  for bin in node_modules/.bin/esbuild node_modules/.bin/vitest \
      apps/vibee-editor/render/node_modules/.bin/tsc \
      apps/vibee-editor/player/node_modules/.bin/vitest; do
    if [ -x "$wt/$bin" ]; then
      echo "  ok   $bin"
    else
      bad "missing $bin -- the gate that calls it will fail on ENOENT, not on code"; rc=1
    fi
  done
  # A link carries the MAIN checkout's install, and that follows the main
  # checkout's branch, not this tree's (2026-10-03: main sat on an old branch,
  # its install had no `redis`, and every tree on origin/main failed root
  # typecheck on "Cannot find module 'redis'" -- read as a code fault).
  local rel missing
  while IFS= read -r rel; do
    [ -f "$wt/$rel/package.json" ] && [ -d "$wt/$rel/node_modules" ] || continue
    missing="$(node -e '
      const fs = require("fs"), p = require("path"), d = process.argv[1]
      const pkg = JSON.parse(fs.readFileSync(p.join(d, "package.json"), "utf8"))
      const names = Object.keys({ ...pkg.dependencies, ...pkg.devDependencies })
      const gone = names.filter(n => !fs.existsSync(p.join(d, "node_modules", n, "package.json")))
      process.stdout.write(gone.join(" "))
    ' "$wt/$rel" 2>/dev/null)"
    [ -z "$missing" ] && continue
    rc=1
    bad "$([ "$rel" = . ] && echo root || echo "$rel") declares packages its node_modules lacks: $missing"
    if [ -L "$wt/$rel/node_modules" ]; then
      echo "       the link carries $main's install, made for ITS branch; fix: tri deps --own, then install in this tree"
    else
      echo "       install here, in $wt/$rel"
    fi
  done < <(cd "$wt" && { echo .; find apps \( -type d -o -type l \) -name node_modules -prune 2>/dev/null | grep -v '/node_modules/' | sed 's|/node_modules$||'; })
  [ "$wt" != "$main" ] && [ -L "$wt/node_modules" ] && \
    echo "  note no root npm ci / bun install in this tree: node_modules is the main checkout's, and an install empties it (tri deps --own first)"
  local state
  state="$(nm_state "$main/node_modules")"
  if [ "$state" != ok ]; then
    rc=1
    bad "the main checkout's node_modules is $(tr "[:lower:]" "[:upper:]" <<<"$state") -- a root install through a linked tree does this (npm empties the link's target first)"
    if [ "$heal" = 1 ]; then
      # bun.lock drifts on install. Put it back only when nobody was editing
      # the dependencies: a dirty bun.lock or package.json is someone's work.
      local dirty
      dirty="$(git -C "$main" status --porcelain -- bun.lock package.json)"
      echo "  ...  bun install in $main"
      if (cd "$main" && bun install --no-summary >/dev/null 2>&1); then
        if [ -z "$dirty" ]; then
          git -C "$main" checkout -q -- bun.lock 2>/dev/null
        else
          echo "  note bun.lock left as the install wrote it: bun.lock/package.json were already edited"
        fi
        good "main checkout reinstalled -- run tri deps again"
      else
        bad "bun install failed in $main"
      fi
    else
      echo "       restore: tri deps --heal   (runs bun install in $main, never in a worktree)"
    fi
  fi
  return $rc
}

# Replace every node_modules LINK in the worktree with a real copy of what it
# points at. Only links into the main checkout are touched; a real directory
# is already the tree's own. `cp -c` clones on APFS (near-free), `--reflink`
# does the same on Linux filesystems that can, else it is a plain copy.
own_deps() {
  local main="$1" wt="$2" rel target link n=0
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    target="$(readlink "$wt/$rel")"
    case "$target" in
      "$main"/*) ;;
      *) echo "  skip $rel -> $target (not the main checkout's)"; continue ;;
    esac
    [ -d "$target" ] || { bad "$rel links to a missing $target -- nothing to copy"; return 1; }
    # A target that is itself a link would be copied AS a link (cp -R does not
    # follow it), and the tree would still share an install. Copy what it means.
    link="$target"
    target="$(cd -P "$target" && pwd)" || return 1
    rm -- "$wt/$rel" || return 1
    # A copy that dies half-way leaves a half tree, and the next cp would nest
    # into it (cp -R SRC EXISTING_DIR copies INTO the dir). Clear between tries.
    if cp -Rc "$target" "$wt/$rel" 2>/dev/null \
        || { rm -rf -- "${wt:?}/${rel:?}"; cp -R --reflink=auto "$target" "$wt/$rel" 2>/dev/null; } \
        || { rm -rf -- "${wt:?}/${rel:?}"; cp -R "$target" "$wt/$rel"; }; then
      echo "  own  $rel"; n=$((n + 1))
    else
      bad "copy of $rel failed -- relink with: ln -s $link $wt/$rel"; return 1
    fi
  done < <(cd "$wt" && { [ -L node_modules ] && echo node_modules; find apps -type l -name node_modules 2>/dev/null | grep -v '/node_modules/'; })
  if [ "$n" = 0 ]; then
    good "no linked node_modules here -- the tree's are already its own"
  else
    good "$n node_modules now belong to this tree -- an install here empties only them"
  fi
}

cmd_worktree() {
  # Why a worktree at all: the loop shares the main tree with sibling sessions,
  # and a plain `git checkout -b` there lets another session take the branch out
  # from under the work. A worktree is a private checkout. Base is origin/main,
  # never local HEAD -- work stands on what is merged.
  local branch="${1:-}"
  if [ -z "$branch" ]; then
    bad 'нужно имя ветки: tri worktree <branch>'
    return 1
  fi
  git -C "$ROOT" fetch origin main --quiet 2>/dev/null
  local base wt
  base="$(git -C "$ROOT" rev-parse origin/main)"
  wt="${TRI_WORKTREE_DIR:-${TMPDIR:-/tmp}}/tri-wt-${branch//\//-}"
  if [ -e "$wt" ]; then
    bad "уже существует: $wt"
    return 1
  fi
  if ! git -C "$ROOT" worktree add "$wt" -b "$branch" "$base" >/dev/null 2>&1; then
    bad "git worktree add не удался (ветка $branch занята?)"
    return 1
  fi
  # A fresh worktree has NO node_modules, and the root alone is NOT enough. The
  # vibee-editor monorepo keeps per-app node_modules (render/player/vibee-atoms);
  # without them `bun run verify` dies on ENOENT (render/.bin/tsx) and
  # ERR_MODULE_NOT_FOUND (jotai) -- an env-gap that reads exactly like a
  # regression but is one the worktree invented. Symlink the root and every app
  # node_modules from the main tree so the gate measures the code, not the gap.
  link_deps "$ROOT" "$wt" >/dev/null
  # Smoke the tree before handing it over.
  #
  # Some worktrees deterministically break vite-node module resolution: a bare
  # `stream` import resolves as <root>/stream and the file collects no tests.
  # Reproducible 5 out of 5 in an affected tree, while the same commit in a
  # neighbouring tree is clean.
  #
  # THE CAUSE IS NOT KNOWN, and every hypothesis tried has been refuted rather
  # than left open: not the file contents (reverting every change did not clear
  # it), not the shared vite cache (clearing it changes nothing and run order
  # does not matter), not node or vitest versions, not the set of files present
  # on disk, and not the path -- a name that fails under one spelling passes
  # under another of the same length.
  #
  # So this guard is justified by what it COSTS, not by a diagnosis: three
  # seconds against the hour it took to prove the code innocent the first time,
  # when the gate reported a regression that no change had caused. A cheap
  # detector for an undiagnosed fault is still worth having; calling it a fix
  # would not be.
  local smoke='src/__tests__/inngest/stuckTrainingAgeUnknown.test.ts'
  if [ -f "$wt/$smoke" ]; then
    if (cd "$wt" && npx vitest run "$smoke" 2>&1 | grep -q 'Cannot find module'); then
      bad "дерево непригодно: vite-node не резолвит встроенный модуль по этому пути"
      echo "   Это свойство ПУТИ, а не содержимого: тот же коммит рядом собирается."
      echo "   Дерево удалено. Повторите с другим именем ветки, путь изменится."
      git -C "$ROOT" worktree remove --force "$wt" >/dev/null 2>&1
      git -C "$ROOT" branch -D "$branch" >/dev/null 2>&1
      return 1
    fi
  fi
  good "worktree готов, node_modules слинкованы (root + apps), проба прошла"
  # Print ONLY the path on the last line so a caller can:  cd "$(tri worktree x | tail -1)"
  printf '%s\n' "$wt"
}

cmd_price() {
  # Before treating an "unbilled paid path" as a defect, check whether the mode
  # even HAS a price. Direct text chat here is free-by-design: ModeEnum.AiChat is
  # absent from BASE_COSTS (calculateModeCost returns 0), ChatWithAvatar is 0.
  # Charging a cost-0 mode is not a fix -- it writes 0-value payment rows and the
  # balance gate (balance < 0) always passes. This prints the STATIC base cost
  # from BASE_COSTS; dynamic costs (steps-based avatars, answerAi response.cost)
  # are NOT reflected -- read those paths directly.
  local mode="${1:-}"
  if [ -z "$mode" ]; then
    bad 'нужно имя режима: tri price <ModeName>   (напр. tri price Voice)'
    return 1
  fi
  local file="$ROOT/src/price/helpers/modelsCost.ts"
  if [ ! -f "$file" ]; then
    bad "нет файла $file"
    return 1
  fi
  # Only look inside the BASE_COSTS object literal.
  local block line
  block="$(awk '/export const BASE_COSTS/{f=1} f{print} f&&/^\}/{exit}' "$file")"
  line="$(printf '%s\n' "$block" | grep -E "\[ModeEnum\.${mode}\]:" | head -1)"
  if [ -z "$line" ]; then
    warn "ModeEnum.${mode} НЕ в BASE_COSTS → calculateModeCost вернёт 0 (free-by-design / цена не задана)"
    printf '  charge за 0 ВРЕДЕН: 0-value payment-row, gate (balance < 0) всегда проходит\n'
    return 0
  fi
  local val
  val="$(printf '%s\n' "$line" | sed -E 's/.*\]:[[:space:]]*//; s/,.*$//; s/[[:space:]]*$//')"
  if [ "$val" = "0" ]; then
    warn "ModeEnum.${mode} base cost = 0 (free-by-design) — статическая цена нулевая"
    printf '  (динамическая цена, если есть — через steps/answerAi response.cost — здесь НЕ видна)\n'
  else
    good "ModeEnum.${mode} base cost = ${val}\$ (статическая; steps/answerAi не учтены)"
  fi
}

cmd_money_base() {
  # Two star-cost helpers in this repo can DISAGREE by rounding:
  #   calculateFinalImageCostInStars(usd)   = ceil(usd*interestRate/starCost)  [IMAGES_MODELS.ts]
  #   calculateFinalPriceInStars(usd,,mk)   = floor(usd/starCost*mk)           [paidServices.ts]
  # A refund MUST use the same helper the charge used. Hand-guessing the markup or
  # trusting a code comment nearly shipped a refund-mint (#1263). Evaluate BOTH with
  # the REAL constants so a money base is never hand-computed again.
  local usd="${1:-}" markup="${2:-}"
  if [ -z "$usd" ]; then
    bad 'нужна цена USD: tri money-base <usdCost> [markup]   (напр. tri money-base 0.025 2.4)'
    return 1
  fi
  local cfile="$ROOT/src/price/constants/index.ts"
  local star ir
  star="$(grep -E 'STAR_COST_USD[[:space:]]*=' "$cfile" 2>/dev/null | head -1 | grep -oE '[0-9.]+' | head -1)"
  ir="$(grep -E 'MARKUP_MULTIPLIER[[:space:]]*=' "$cfile" 2>/dev/null | head -1 | grep -oE '[0-9.]+' | head -1)"
  star="${star:-0.016}"; ir="${ir:-1.5}"; markup="${markup:-$ir}"
  node -e "const usd=$usd,star=$star,ir=$ir,mk=$markup;const img=Math.ceil(usd*ir/star),price=Math.floor(usd/star*mk);console.log('  constants (from source): starCost='+star+'  interestRate='+ir+'  markup(arg)='+mk);console.log('  calculateFinalImageCostInStars = ceil('+usd+'*'+ir+'/'+star+') = '+img+' stars');console.log('  calculateFinalPriceInStars     = floor('+usd+'/'+star+'*'+mk+') = '+price+' stars');console.log(img===price?'  AGREE: базы совпадают — refund любой из них ок':'  DIVERGE: refund ОБЯЗАН брать базу того же helper, что и charge!');console.log('  ВНИМАНИЕ: serviceBase = calculateFinalImageCostInStars(usd) ТЕОРЕТИЧЕСКИ; сервис может ХАРДКОДИТЬ costPerImage (nano_banana=5) -- сверь реальный источник, не формулу')"
}

cmd_batch_refunds() {
  # Wiring audit: which services in the aiPhotoshop ALL_MODELS batch forward the
  # EXACT per-image charge (chargedCostOverride) so a failure refunds what was
  # charged. A service that does NOT forward refunds its own base -- which
  # UNDER-refunds whenever the batch-charge helper (calculateFinalPriceInStars)
  # and the service-refund helper (calculateFinalImageCostInStars) diverge.
  # #1267 fixed flux_kontext_max; pro/seededit/nano_banana queued. Compose with
  # tri money-base <usd> 2.4 to see whether a MISSING actually loses money.
  local f="$ROOT/src/scenes/aiPhotoshopScene/index.ts"
  [ -f "$f" ] || { bad "нет файла $f"; return 1; }
  node -e '
    const s=require("fs").readFileSync(process.argv[1],"utf8");
    const re=/modelKey === .([a-z_0-9]+)./g; let m; const idx=[];
    while((m=re.exec(s))) idx.push([m.index,m[1]]);
    let any=false;
    console.log("  batch services (skipBalanceCheck) forward exact charge (chargedCostOverride)?");
    for(let i=0;i<idx.length;i++){
      const start=idx[i][0], name=idx[i][1], end=i+1<idx.length?idx[i+1][0]:start+2500;
      const b=s.slice(start,end);
      if(/skipBalanceCheck:\s*true/.test(b)){any=true;const ok=/chargedCostOverride/.test(b);console.log("    "+(ok?"forwards OK   ":"MISSING  !!  ")+name);}
    }
    if(!any) console.log("    (no batch skipBalanceCheck call sites)");
    console.log("  MISSING loses money only when bases diverge -- verify: tri money-base <usd> 2.4");
  ' "$f"
}

cmd_idempotency_keys() {
  # Advisory audit (NOT a pass/fail gate): list every inv_id / idempotencyKey
  # assignment and flag the ones whose value is NON-deterministic (Date.now,
  # Math.random, uuid). A non-deterministic idempotency key defeats a UNIQUE
  # backstop -- a duplicate/retry can never be rejected (#1298 promo star-mint).
  # A flagged site is only OK if the intent is unique-PER-PAYMENT (a real
  # invoice), NOT idempotency/dedup (reward, bonus, refund) -- YOU judge.
  node -e '
    const fs=require("fs"), path=require("path");
    function walk(d,acc){ for(const e of fs.readdirSync(d,{withFileTypes:true})){ if(e.name==="node_modules"||e.name===".git")continue; const p=path.join(d,e.name); if(e.isDirectory())walk(p,acc); else if(e.name.endsWith(".ts")&&!e.name.endsWith(".test.ts"))acc.push(p);} return acc; }
    const files=walk(path.join(process.argv[1],"src"),[]);
    const NONDET=/Date\.now\(|Math\.random\(|randomUUID|uuidv4\(/;
    const risky=[]; let total=0;
    for(const f of files){ const lines=fs.readFileSync(f,"utf8").split("\n");
      for(let i=0;i<lines.length;i++){ const l=lines[i];
        if(/\binv_id\s*:/.test(l) || /idempotencyKey\s*[:=]/.test(l)){ total++;
          const val=l.split(/inv_id\s*:|idempotencyKey\s*[:=]/)[1]||l;
          if(NONDET.test(val)) risky.push(f.replace(process.argv[1]+"/","")+":"+(i+1)+"  "+l.trim().slice(0,88));
        } } }
    console.log("NON-DETERMINISTIC idempotency keys (OK only if intent is unique-per-payment, not dedup):");
    if(!risky.length) console.log("  (none)"); else risky.forEach(r=>console.log("  ! "+r));
    console.log("");
    console.log("total inv_id/idempotencyKey sites: "+total+" | flagged: "+risky.length);
  ' "$ROOT"
}

cmd_wired() {
  # Reachability aid: before fixing a call-site, confirm something reaches it.
  # This does NOT decide reachable-vs-dead — grep cannot (registration hides in
  # Stage arrays, scene lists, dynamic registries; wiring is disabled by /* */,
  # if(false), feature flags, examples-only modules — none visible to grep). It
  # does ONE reliable thing: list every reference and FLAG the ones on
  # commented-out lines, because a handler whose bot.on() registration is
  # commented (handleTextMessage) is the classic dead-code trap. READ the flagged
  # lines and find the actual registration yourself — the tool only points.
  local sym="${1:-}"
  if [ -z "$sym" ]; then
    bad 'нужен символ: tri wired <SymbolName>   (напр. tri wired handleTextMessage)'
    return 1
  fi
  local hits commented
  hits="$(cd "$ROOT" && grep -rnE "\\b${sym}\\b" src --include='*.ts' 2>/dev/null | grep -v '__tests__')"
  if [ -z "$hits" ]; then
    warn "нет ссылок на ${sym} в src (кроме тестов) — символ не используется?"
    return 0
  fi
  commented="$(printf '%s\n' "$hits" | grep -E ':[0-9]+:[[:space:]]*//')"
  local nt nc
  nt="$(printf '%s' "$hits" | grep -c .)"
  nc="$(printf '%s' "$commented" | grep -c .)"
  printf '  ссылок всего: %s | из них закомментированных: %s\n' "$nt" "$nc"
  if [ "$nc" -gt 0 ]; then
    warn 'ЗАКОММЕНТИРОВАННЫЕ ссылки (частый признак мёртвой проводки — ЧИТАЙ):'
    printf '%s\n' "$commented" | sed 's/^/    /'
  fi
  printf '  НЕ вывод, а указатель: сам найди РЕГИСТРАЦИЮ (bot.on/.hears/.use/.action/.command/\n'
  printf '  Stage/scene-массив) среди живых ссылок. Если она только в закомментированных — мёртвый код.\n'
  printf '  grep не видит /* */, if(false), feature-flag, examples-only, динамические реестры.\n'
}

