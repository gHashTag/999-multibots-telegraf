cmd_in_gate() {
  # СОБИРАЕТ ЛИ ГЕЙТ ЭТОТ ТЕСТ ВООБЩЕ.
  #
  # Написал тест, гейт зелёный — и это ничего не значит, если файл не попал в
  # прогон: СЬЮТА, КОТОРАЯ НЕ ЗАПУСКАЛАСЬ, НЕ МОЖЕТ ДАТЬ РЕГРЕССИЮ. Ровно так
  # прошёл виток it.72: в worktree не слинковались node_modules под-приложений,
  # весь набор apps/vibee-editor/render молча не собрался, гейт напечатал
  # чистую дельту, а новый тест не выполнился НИ РАЗУ. Заметил только по
  # абсолютному счёту (4061 против 4295 — 234 теста исчезли), и с тех пор
  # каждый раз считал членство руками: 4300 = +5, 4305 = +5, 4309 = +4.
  #
  # Здесь та же проверка за пару секунд и без полного прогона: `vitest list`
  # применяет КОРНЕВОЙ конфиг (тот самый, которым ходит гейт) и печатает по
  # строке на тест. Ноль строк = файла в популяции гейта нет. Две причины, и
  # они лечатся по-разному, поэтому обе названы в выводе.
  local target="${1:-}"
  if [ -z "$target" ]; then
    bad 'нужен путь к тесту: tri in-gate <файл.test.ts>'
    return 2
  fi
  if [ ! -f "$ROOT/$target" ] && [ ! -f "$target" ]; then
    bad "нет такого файла: $target"
    return 2
  fi
  local base out n
  base="$(basename "$target")"
  out="$(cd "$ROOT" && npx vitest list "$target" 2>&1)"
  n="$(printf '%s\n' "$out" | grep -c "$base >" || true)"
  if [ "$n" -gt 0 ]; then
    good "$base: гейт видит $n тест(ов)"
    return 0
  fi
  bad "$base: гейт НЕ СОБИРАЕТ этот файл — ноль тестов в популяции"
  echo
  echo '  Две причины, лечатся по-разному:'
  echo '   1) файл исключён в корневом vitest.config (например apps/**/player/**,'
  echo '      *.spec.ts, e2e) — тогда гейт и не должен его видеть;'
  echo '   2) ОШИБКА СБОРА: импорт не резолвится. В worktree это почти всегда'
  echo '      несвязанные node_modules под-приложений — лечится `tri worktree`,'
  echo '      который линкует root И каждый apps/*/node_modules.'
  echo
  echo '  Что сказал сам vitest:'
  printf '%s\n' "$out" | grep -iE "error|cannot find|failed to load|ERR_" | head -5 | sed 's/^/    /'
  return 1
}

cmd_in_gate_selfcheck() {
  # ЛИНЕЙКУ ПРОВЕРЯЕМ В ОБЕ СТОРОНЫ, иначе она умеет только говорить «да».
  # Нужен файл, который гейт ОБЯЗАН видеть, и файл, который он обязан НЕ
  # видеть; проверка, отвечающая одинаково на оба, бесполезна.
  local yes no rc=0
  yes="$(cd "$ROOT" && ls src/__tests__/money/*.test.ts 2>/dev/null | head -1)"
  no="$(cd "$ROOT" && ls apps/vibee-editor/player/src/**/*.test.ts 2>/dev/null | head -1)"
  if [ -z "$yes" ] || [ -z "$no" ]; then
    warn 'самопроверка пропущена: не нашёл пару образцов (да/нет)'
    return 0
  fi
  if cmd_in_gate "$yes" >/dev/null 2>&1; then
    good "положительный образец виден гейту: $(basename "$yes")"
  else
    bad "СЛОМАНА: гейт не видит заведомо собираемый $(basename "$yes")"
    rc=1
  fi
  if cmd_in_gate "$no" >/dev/null 2>&1; then
    bad "СЛОМАНА: отвечает «да» на исключённый $(basename "$no")"
    rc=1
  else
    good "исключённый образец не виден гейту: $(basename "$no")"
  fi
  return "$rc"
}

cmd_disk() {
  # САМОВОССТАНОВЛЕНИЕ ДИСКА. Цикл делит DATA-том с чужими сессиями; когда том
  # заполняется под нуль, Bash падает с ENOSPC ещё ДО запуска команды — харнесс
  # не может создать файл вывода, и весь виток встаёт (случилось it.69). Команда
  # мерит ВЕРНЫЙ том, чистит МОИ следы и называет чужих пожирателей.
  #
  # ЛИНЕЙКА «занято» — ОТКРЫТЫЙ ДЕСКРИПТОР, а не mtime. Пойман vvp-симулятор
  # Verilog, державший 31G scratch с mtime недельной давности: жив, хотя выглядел
  # мёртвым. Поэтому reap удаляет сессию только когда lsof=0 хендлов И mtime
  # старше суток (двойная страховка; текущую сессию бережёт свежий mtime).
  local mode="${1:-}"

  # (1) ВЕРНЫЙ том. `df /` показывает запечатанный системный снапшот (почти
  # всегда «полон» и неинформативен); реальное место живёт на DATA-томе.
  paint '1;36' 'DATA-том'
  df -h /System/Volumes/Data | sed -n '1,2p'

  # (2) Мои worktree'ы. prune снимает записи, чей каталог уже исчез (безопасно).
  echo; paint '1;36' 'worktree цикла'
  git -C "$ROOT" worktree prune 2>/dev/null
  git -C "$ROOT" worktree list 2>/dev/null

  # (3) Scratch сессий. Один прогон lsof, дальше сверяем по пути открытых файлов.
  echo; paint '1;36' 'scratch сессий  (к возврату = 0 хендлов И mtime>суток)'
  local tmproot="/private/tmp/claude-$(id -u)"
  local held; held="$(lsof -Fn 2>/dev/null | grep "^n$tmproot" || true)"
  local d base sz
  for d in "$tmproot"/*/*; do
    [ -d "$d" ] || continue
    base="$(basename "$d")"
    case "$base" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*) ;;
      *) continue ;;
    esac
    sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
    if printf '%s\n' "$held" | grep -q -- "$base"; then
      skip "жива (открыт дескриптор), пропуск: $sz  $base"
    elif [ -n "$(find "$d" -maxdepth 0 -mtime +1 2>/dev/null)" ]; then
      if [ "$mode" = "reap" ] || [ "$mode" = "чисти" ]; then
        rm -rf "$d" 2>/dev/null && good "освобождено $sz  $base"
      else
        warn "мёртвая, к возврату: $sz  $base   (запусти: tri диск чисти)"
      fi
    else
      skip "свежая (<суток), пропуск: $sz  $base"
    fi
  done

  # (4) Крупные ЧУЖИЕ пожиратели — НАЗВАТЬ, но не трогать: это данные владельца,
  # а удаление данных — его решение (деструктив последним, [[debugging_doctrine]]).
  echo; paint '1;36' 'крупные пожиратели  (владельцу — сам не трогаю)'
  local p
  for p in \
    "$HOME/Library/Containers/com.docker.docker" \
    "$HOME/Library/Caches" \
    "$HOME/Library/Developer/CoreSimulator" \
    "$HOME/Library/Developer/Xcode/DerivedData"; do
    [ -e "$p" ] && du -sh "$p" 2>/dev/null
  done
}

action="${1:-помощь}"
shift 2>/dev/null || true

case "$action" in
  # English is the primary name; the Russian one stays as an alias because loop
  # scripts, skills and the journal already call it. Renaming without the alias
  # would break work that already exists -- the exact thing this loop guards
  # against.
  who|кто)             cmd_who "$@" ;;
  in-tsc|в-tsc)        cmd_in_tsc "$@" ;;
  alive|жив)           cmd_alive "$@" ;;
  mutate|мутация)      cmd_mutate "$@" ;;
  deployed|выложен)    cmd_deployed ;;
  diverged|разошлись)  cmd_diverged ;;
  worktree|дерево)    cmd_worktree "$@" ;;
  price|цена)         cmd_price "$@" ;;
  money-base|база)     cmd_money_base "$@" ;;
  batch-refunds|возвраты) cmd_batch_refunds ;;
  idempotency-keys|ключи) cmd_idempotency_keys ;;
  wired|подключён)    cmd_wired "$@" ;;
  charge|заряд)       cmd_charge ;;
  ratchets|линейки)   cmd_ratchets ;;
  guards|стражи)      cmd_guards "$@" ;;
  ratchet-audit|аудит-линеек) cmd_ratchet_audit "$@" ;;
  fn-liveness|живость-функций) cmd_fn_liveness "$@" ;;
  timeouts|таймауты)  cmd_timeouts "$@" ;;
  inflight|блокировка) cmd_inflight "@" ;;
  leaks|утечки)        cmd_leaks "$@" ;;
  replay|повтор)       cmd_replay "$@" ;;
  mint|минт)           cmd_mint "$@" ;;
  stepjump|шаг)        cmd_stepjump "$@" ;;
  sweep|развёртка)  cmd_sweep "$@" ;;
  colors|цвета)        cmd_colors "$@" ;;
  ci)                  cmd_ci ;;
  gate|ворота)         cmd_gate ;;
  real|живая)          cmd_real "$@" ;;
  lesson|опыт)         cmd_lesson "$@" ;;
  lock|лок)            bash "$TOOLS/guard.sh" acquire ;;
  unlock|раслок)       bash "$TOOLS/guard.sh" release ;;
  disk|диск)           cmd_disk "$@" ;;
  in-gate|в-гейте)     cmd_in_gate "$@" ;;
  in-gate-check|в-гейте-проверка) cmd_in_gate_selfcheck ;;
  scan|скан)           node "$TOOLS/anomalies.mjs" ;;
  # Deliberately a TOP-LEVEL verb, not `tri scan check`. The sibling that took
  # the subcommand road is broken in exactly the documented spot: help promises
  # `tri colors check`, the code matches only `проверка`, and the English form
  # falls through to the directory argument and answers "нет каталога check".
  # A verb that cannot be mistyped into silence is worth the extra dispatch line.
  scan-check|скан-проверка) node "$TOOLS/anomalies-selftest.mjs" ;;
  # EVERY KIE FUNCTION, WITHOUT SPENDING A CREDIT. A rejected generation costs
  # nothing, so deliberately invalid input separates "the model exists" from
  # "the id is wrong" for free. Two seconds, and the balance is read before and
  # after so "it cost nothing" is measured rather than claimed.
  kie)                 node "$ROOT/scripts/kie-probe.mjs" "${@:2}" ;;
