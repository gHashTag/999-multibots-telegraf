#!/usr/bin/env bash
#
# tri — один вход ко всей оснастке цикла.
#
# ЗАЧЕМ ЭТО ЕСТЬ. В .claude/loop-opus/ лежит одиннадцать скриптов, и каждый
# виток я звал их полными путями с приставкой PATH=…/node. Дело не только в
# скорости: длинную команду не запоминают, а незапомненную проверку не делают.
#
# ЧЕМ ЭТО ОТЛИЧАЕТСЯ ОТ ОБЁРТКИ. Половина команд здесь — не переименованные
# старые скрипты, а УРОКИ, ставшие исполнимыми. Каждый записан в скилле словами
# и каждый стоил цикла:
#
#   tri кто     ← «признак живого маршрута — его собственное сообщение,
#                  а не статус 401». Стоило четырёх циклов.
#   tri в-tsc   ← «ноль ошибок означал „не проверено“, а не „верно“».
#   tri жив     ← «три правки легли туда, что никто не рендерит».
#   tri мутация ← «зелёная мутация — это отчёт о дыре в покрытии».
#   tri выложен ← «мерж не равен выкладке», и сравнивать надо ПОСЛЕ fetch,
#                  иначе ворота дают ложную тревогу.
#
# Записанное словами надо вспомнить. Команду — набрать. Разница решает.
#
# ИМЕНА. Подкоманды по-русски: их читает человек. Переменные и функции —
# латиницей, потому что кириллица в имени переменной bash даёт
# «command not found» без объяснения причины. Оплачено дважды.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS="$ROOT/.claude/loop-opus"

# node 20 из nvm: системный 18 ломает Vite и половину прогонов.
#
# ПУТЬ БЫЛ МЁРТВ. Стояло /Users/playom/… — опечатка в имени пользователя
# (playra). Каталога нет, PATH молча игнорировал запись, и tri всё это время
# работал на том node, который подвернётся (v22 из Homebrew) — то есть
# «закрепление версии» ничего не закрепляло. Тот же класс опечатки уже ловили
# в verify-landed.mjs, но здесь он остался.
#
# Теперь: ищем нужную версию у ТЕКУЩЕГО пользователя и добавляем её, только
# если каталог существует. Несуществующий путь в PATH — это не подстраховка,
# а тишина вместо ошибки.
_nvm20="$HOME/.nvm/versions/node/v20.19.0/bin"
[ -d "$_nvm20" ] && export PATH="$_nvm20:$PATH"
export PATH="/opt/homebrew/bin:$PATH"

# The NEWEST railway CLI first. On 2026-10-02 /usr/local/bin held an old,
# logged-out 4.5.4 ahead of nvm's 5.63: every railway call answered
# "Unauthorized", and the deploy checks here printed "railway did not answer"
# -- a state unknown that was really a stale binary. Asking each one its
# version took 23 s on a loaded Mac, so the pick is cached until that binary
# disappears (rm the cache file to re-pick after an upgrade).
_tri_railway_pick() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/tri/railway-bin" b best=''
  if [ -s "$cache" ]; then
    best=$(cat "$cache")
    [ -x "$best" ] && { printf '%s' "$best"; return 0; }
  fi
  best=$(type -ap railway | awk '!seen[$0]++' | while IFS= read -r b; do
    printf '%s\t%s\n' "$("$b" --version 2>/dev/null | awk '{print $2}')" "$b"
  done | sort -V -r | head -1 | cut -f2)
  [ -n "$best" ] || return 1
  mkdir -p "$(dirname "$cache")" && printf '%s' "$best" > "$cache"
  printf '%s' "$best"
}
_rw=$(_tri_railway_pick 2>/dev/null) && export PATH="$(dirname "$_rw"):$PATH"

RENDER="${TRI_RENDER_URL:-https://vibee-render-production.up.railway.app}"

paint() { printf '\033[%sm%s\033[0m\n' "$1" "$2"; }
good() { paint '32' "  OK   $1"; }
bad()  { paint '31' "  ✗    $1"; }
warn() { paint '33' "  ⚠    $1"; }

# THE THIRD OUTCOME NEEDS ITS OWN COLOUR, or it gets spent as one of the two.
#
# «Не измерено» was printed with warn() — yellow, and yellow next to green reads
# as «green with a remark». Cyan «?» is not a shade of either, so a reader
# cannot round it off. The counting is what actually decides the verdict (see
# cmd_gate), but a state nobody can see is a state nobody acts on.
skip() { paint '36' "  ?    $1"; }

# IS THE FACTORY ALIVE -- answered by AGE, not by the presence of a field.
#
# On 2026-08-29 the pipeline stood still for 51 hours while the regression check
# kept printing a clean run: it tested `lastPostAt` for existence (a boolean
# stays true forever) and threw away the token balance that had actually stopped
# it. This is a separate command so the answer is one line, available BEFORE the
# work rather than after.
factory_fact() {
  # THE FEED IS THE TRUTH, THE LOCAL FILE IS A HINT.
  #
  # This read loop/state.json only -- and that file is written by whichever
  # LOOP_DIR the last run used. Test runs use a temp dir, and the production
  # daemon writes inside its own container, so the repo copy goes stale and this
  # command reported a 52.9-hour stall on a day with three published reels. It
  # was making exactly the mistake it was built to catch: trusting a local
  # artefact instead of the record of what actually happened.
  local newest
  newest=$(curl -s -m 20 "$RENDER/api/feed?page=0&limit=1&sort=recent" \
    | python3 -c "
import sys, json
from datetime import datetime, timezone
try:
    t = json.load(sys.stdin).get('templates', [])
except Exception:
    print(''); raise SystemExit
if not t:
    print(''); raise SystemExit
raw = str(t[0].get('createdAt', ''))
# '2026-08-29 04:28:41.2+00' -> ISO: space to T, offset needs its colon.
iso = raw.replace(' ', 'T')
if len(iso) > 3 and (iso[-3] == '+' or iso[-3] == '-'):
    iso += ':00'
try:
    age = (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds() / 3600
except Exception:
    print(''); raise SystemExit
print(f\"{age:.1f}|{str(t[0].get('name',''))[:44]}\")
" 2>/dev/null)

  if [ -z "$newest" ]; then
    warn 'лента не ответила — судить о фабрике нечем (это НЕ «всё хорошо»)'
    return 1
  fi
  local age name
  age=${newest%%|*}
  name=${newest#*|}
  # Compare without bc: strip the fraction.
  local whole=${age%%.*}
  if [ "${whole:-99}" -le 8 ]; then
    good "last post ${age}h ago — «${name}»"
    return 0
  fi
  # THE ALARM WAS WRONG, NOT THE FACTORY.
  #
  # This printed FACTORY STALLED for sixteen days and named three suspects,
  # none of which was the answer. The logs say it plainly: the daemon is alive,
  # the queue refills, and delivery refuses because TG_POST_MAX_PER_DAY is
  # unset -- a quota of zero. That zero is DELIBERATE and documented in
  # channel-delivery.ts: the drain stays off until somebody raises it, because
  # there is a backlog of unposted reels and about a dozen of them are already
  # in the channel, so a flood would repost them.
  #
  # An alarm that calls a deliberate configuration a fault teaches people to
  # ignore alarms. It still says something -- sixteen days of silence is worth
  # seeing -- but it says the true thing, and it names the likeliest cause
  # FIRST, because that cause is the default state of the system.
  warn "no post for ${age}h — «${name}»"
  paint '33' '       FIRST: TG_POST_MAX_PER_DAY. It defaults to 0 and delivery is OFF'
  paint '33' '       until it is raised. If that is intended, this line is expected.'
  paint '33' '       Only then: autopilot daemon (AUTOPILOT_LOOP), tokens, topic queue.'
  paint '33' '       Raising it needs the ledger seeded first — see channel-delivery.ts.'
  return 1
}

usage() {
  cat <<'СПРАВКА'
tri — loop tooling. Lessons that became commands.

Command names are ENGLISH. The former Russian names still work as aliases, so
scripts, skills and journal entries written earlier keep running: renaming
without an alias would break work that already exists.

CHECKS THAT EACH COST A CYCLE
  tri who <path> [method] [body]
        Hit a route and say WHO answered: the global guard or the route itself.
        A 401 means nothing on its own -- only the vocabulary in the body does.
        Example: tri who /api/auth/pair/claim POST '{"code":"123456"}'

  tri in-tsc <file> [tsconfig]
        Is the file part of the tsc program. Zero errors in a file that is not
        in the program means "not checked", not "correct".

  tri alive <string> <build dir>
        Is the string in the BUILT chunks. Searches all of them, not just the
        index: a component usually lands in a lazy chunk, so searching index
        lies.

  tri mutate <file> <from> <to> <test>
        Break it, run the test, expect red, revert, expect green. A test that
        does not go red when you break the code checks nothing.

  tri deployed
        Does the version in production match origin/main.

  tri diverged
        How far the current branch has diverged from origin/main. Work is based
        on origin/main, not on the local HEAD.

  tri worktree <branch>
        Make a PRIVATE checkout off origin/main and symlink every node_modules
        (root AND the per-app ones: render/player/vibee-atoms) from the main
        tree, so `bun run verify` runs green immediately instead of false-failing
        on env-gaps. Prints the path on the last line:
          wt="$(tri worktree fix/my-thing | tail -1)"; cd "$wt"

  tri deps [--heal] [--own] [path]
        For a worktree tri did NOT make (a bee's, the Claude app's, a plain
        git worktree add): link every node_modules the main checkout has and
        this tree lacks, then check the binaries the gates call (esbuild,
        vitest, render tsc). Without them render-types and bundle-boots go
        red on ENOENT and read like code faults.
        Never run a root npm ci / bun install in such a tree: npm empties
        node_modules through the link, i.e. the MAIN checkout's, and every
        linked tree breaks at once. `tri deps --heal` reinstalls the main
        checkout when that has happened (it is named EMPTY, DOTFILES-ONLY,
        DANGLING or ABSENT, and the command exits 1).
        `tri deps --own` makes every linked node_modules -- root AND per-app,
        render/player are links too -- this tree's own copy (copy-on-write
        clone where the disk can: ~70 s and ~100 MB for all four on APFS),
        after which an install here is safe.
        It also names every package a tree's package.json declares that its
        node_modules lacks (root, render, player): a link carries the main
        checkout's install, made for THAT checkout's branch, so a tree on a
        newer origin/main can miss `redis` or `@tonconnect/ui` and fail tsc on
        "Cannot find module" that reads as a code fault.

  tri price <ModeName>
        Print the STATIC base cost of a mode from BASE_COSTS before you treat an
        "unbilled paid path" as a defect. A mode absent from BASE_COSTS (AiChat)
        or set to 0 (ChatWithAvatar) is free-by-design -- charging it is not a
        fix, it writes 0-value payment rows. Dynamic costs (steps, answerAi
        response.cost) are NOT shown -- read those paths directly.

  tri money-base <usdCost> [markup]
        Evaluate BOTH star-cost helpers for a USD cost so you never hand-guess a
        money base. calculateFinalImageCostInStars = ceil(usd*interestRate/starCost);
        calculateFinalPriceInStars = floor(usd/starCost*markup). Constants read from
        src/price/constants. A refund and its charge can use DIFFERENT helpers whose
        bases diverge by rounding -- match the CHARGE's helper (learned via #1263).
        NOTE: serviceBase is the THEORETICAL calculateFinalImageCostInStars(usd);
        a service may hardcode a different costPerImage (nano_banana=5) -- a false
        DIVERGE. Verify the real source costPerImage, not the formula (#1271).

  tri batch-refunds
        Audit which aiPhotoshop ALL_MODELS batch services forward the exact charge
        (chargedCostOverride) so a failure refunds what was charged. MISSING means
        the service refunds its own base -- a loss when that base diverges from the
        batch-charge base (check with tri money-base). Regression guard for #1267.

  tri idempotency-keys
        Advisory: list inv_id / idempotencyKey sites and flag non-deterministic
        keys (Date.now/random/uuid) that defeat a UNIQUE backstop -- a duplicate
        or retry can never be rejected (#1298 promo star-mint). A flag is OK only
        if the intent is unique-per-payment, not dedup (reward/bonus/refund).

  tri sweep <symbol>
        Class-sweep helper: list every `await <symbol>(` call-site by layer
        and flag the ones that DISCARD the result. Use when a point-fix lands
        to find its siblings. A flagged site is a hypothesis -- read it.

  tri reachable <url> [--size WxH ...] [--gate]
        Which controls on a LIVE page can a finger actually reach. Hit-tests
        every control's centre with elementFromPoint and names what is on top
        when the answer is not the control itself. A scripted click proves the
        handler, never the pixel: that mistake reported 11 of 11 TRI buttons
        working while nobody could press one. Offscreen (scrolled past the
        edge) and blocked (covered by something) are reported separately,
        because only the second is a defect. Default sizes include 1087x430,
        the short frame the game gives the embedded player.

  tri reachable-check | tri достижимо-проверка
        Renders one clear button and one deliberately covered button and
        demands exactly one finding. A ruler that can only pass is not a ruler.

  tri player-deploy [--check] | tri выкатка-плеера
        Redeploy app.t27.ai and WAIT for the served bundle hash to change.
        Merging the player deploys nothing on its own: the vibee-editor service
        builds from the root railway.toml, which does not watch
        apps/vibee-editor/**, and the dashboard keeps showing the previous
        build's SUCCESS. The hash the site actually serves is the only honest
        signal, so it is read before and polled after. --check only prints what
        is live right now.

  tri ratchets | tri линейки
        Run every gated safety-class ratchet in one shot, by exit code
        (double-charge / scene-id / unbilled-paid / OOM / cross-bot). Names
        each class + its file. The loop's fast pre/post-work safety check.

  tri guards | tri стражи
        Run the loop-fable invariant ratchets (guards.mjs) as one exit-code
        run -- the per-iteration regression check after syncing main. Each
        loop-fable fix pins its bug here (33 and counting). --list shows files.

  tri ratchet-audit | tri аудит-линеек
        Meta-check the guards: does each STRUCTURAL ratchet have a self-check
        (detector can fire) and a floor (fails loud if the target is gutted)?
        A ratchet that can only pass is a false ruler. Behavioral tests exempt.

  tri fn-liveness | tri живость-функций
        The complement of ratchet-audit for BEHAVIORAL ratchets: is the fn each
        one imports+calls still LIVE (referenced by >=1 production file outside
        its def)? A 0 is a "ratchet on a dead twin" (the #1572 class) -- a
        vacuous green. Verify, then delete fn+ratchet or move the invariant.

  tri ton-verify <jetton-wallet> | --owner <address> | (TON_WALLET_ADDRESS)
        Prove the USDT jetton parser on REAL chain data: the real src parser on
        v2 getTransactions of the jetton wallet vs TON Center v3 (independent
        decoder) on amount, source wallet, memo, time. Exit 0 corroborated,
        1 mismatch, 2 unavailable, 3 no transfers, 4 PARSER-BLIND (#2147 class).
        --self-check runs offline. Non-zero is never a pass.
        --self-check proves the predicate against known truth first.

  tri timeouts | tri таймауты
        List axios calls with no timeout (default is infinite), split
        likely-LIVE vs likely-DEAD. Triage, not fix-all: bound only the ones on
        a live CHARGED path whose refund fires solely on a throw (a silent hang
        there is charged-not-delivered). Most others are non-charged/dead.

  tri inflight | tri блокировка
        List scene .action handlers that reach a charge primitive but set no
        *InProgress guard -- a double-tap can re-enter and double-charge (the
        iter204 aiPhotoshop-upscale class). Triage: a hit may sit behind a
        shared guarded choke fn or not be double-tappable. Read each.

  tri leaks | tri утечки
        List files that saveFileLocally() but never unlink -- a per-call
        temp-file leak (the iter206 fluxKontextPro class). Triage: a hit may
        deliver via the file (clean up after) or via a remote url (pure waste).

  tri replay | tri повтор
        Inventory of paid .action BUTTON handlers + the guard each has against a
        stale-persistent-button replay (upscale_image #1551, ai_photoshop_-
        upscale_last #1553, upscale_neurophoto_image (iter213)). Shows CONSUME- /
        LEAVE- / INFLIGHT-ONLY / UNGUARDED. Triage, not a gate: in-flight alone
        does NOT stop a LATER re-tap; a handler is safe if its target changes
        each tap. Read each flagged handler.

  tri mint | tri минт
        Inventory of every credit call (MONEY_INCOME balance mutation) + the
        protection its enclosing fn carries: REFUND / TRANSFER / SIGNED / CAS /
        ADMIN / IDEMPOTENT / SETTLEMENT. A credit with NONE is a mint suspect.
        Triage, not a gate: the guard may live in the caller/router. Read each.

  tri stepjump | tri шаг
        Inventory of ctx.wizard.selectStep sites + the selectStep(N)+next()
        off-by-one that SKIPS Step N (next = selectStep(cursor+1)). Broke the
        veed-fabric resume (#1565); ai-reels twin is owner (charge step). Fix:
        selectStep(N) + direct-invoke steps[cursor](ctx). Triage, not a gate.

  tri charge | tri заряд
        Completeness check for the double-charge class (#1358): lists every
        scene that CHARGES money and whether it is guarded / safe / a tracked
        gap (#1372) / UNCLASSIFIED. Non-zero exit on any unclassified scene.
        Reads the classification from the vitest ratchet so it never drifts.

  tri wired <SymbolName>
        Is a handler wired or dead? Lists every src reference and flags the ones
        on commented-out lines (the shape of dead wiring, e.g. a handler whose
        only bot.on() registration is commented). Reports facts to READ, not a
        verdict: it sees `//` comments only, NOT block comments, if(false),
        feature flags, or examples-only modules.

  tri real <name>
        Does the feature work on the WEB before carrying it into the app.
        Looks at: does the server route exist, does the button have its own
        handler, is the counter a literal. Porting something broken reproduces
        the decoration and records parity with it.

  tri iphone [check|build|sim|off|test|ru]
        The Vibee app on the REAL phone: build, install, launch -- one command.
        `sim` does the same on the simulator, with a deadline on install.
        Asks devicectl first, so a locked or unplugged phone is named as such
        instead of xcodebuild's "Unable to find a destination". `check` only
        answers whether the phone is reachable (exit 0); `build` compiles for
        the phone without it. VIBEE_DEVICE picks another paired phone.

  tri gate
        Run what CI should have run: types, tests, the iOS build, Cyrillic.
        Not an equal substitute -- one machine, one Node, one Xcode -- but
        better than nothing while Actions are unpaid.

        THREE outcomes, and the EXIT CODE carries them:
          0  every section ran, nothing failed
          1  a section FAILED -- do not merge
          2  nothing failed, but a section COULD NOT MEASURE (marked «?»)
        2 is not a pass. A missing tool, a missing node_modules, an unreadable
        diff: each of those used to print a yellow warning and let the run end
        on the green line with exit 0, which is how the iOS build stayed
        unbuilt for a hundred iterations while the gate said all clear. So
        `tri gate && …` now stops on 2 too -- deliberately.

        Section 3 needs xcodegen (brew install xcodegen). Without it the iOS
        build is reported as not measured, never as passing.

  tri cyrillic [staged | --unused | msg FILE]
        WHY the Cyrillic gate blocks a line, not just which line. Prints, per
        refusal: which Cyrillic word this commit does not also remove (so the
        reflow exemption cannot apply), and the way out for that SHAPE --
        a call the formatter broke open, JSX, an object key, a regex literal.

        The marker is not always the answer, and reaching for it blindly costs
        a round trip through prettier each time: measured 2026-09-17, five
        attempts on one file, each one recreating the same complaint.

        Reads the same records the gate decides on, so the explanation cannot
        drift from the verdict. Exit code matches the gate: 0 clean, 1 blocked,
        2 the diff could not be read.

        `msg FILE` checks a commit message with the commit-msg hook's own
        script BEFORE committing. The hook runs after the slow pre-commit, so a
        Cyrillic type name in the message cost the whole run twice.

        `--unused` is `eslint --report-unused-disable-directives` for this
        marker: every  cyrillic-ok  that no longer guards anything. First run,
        2026-09-17: 234 of them, most on lines whose Cyrillic sits inside a
        string literal and was never blocked at all. A suppression nobody
        removes becomes evidence that the line needs one.

  tri truncates [--verify <script>]
        Which scripts lose their own output when something READS them.
        `process.exit` does not wait for writes already queued on a pipe --
        Node's documentation calls the result "truncated and lost" -- and stderr
        is a pipe under lefthook and under every tool that reads a gate.

        Measured on the Cyrillic gate, 2026-09-17: three runs of one script on
        one commit printed 966, 7706 and 8484 of the same 8484 complaints. The
        verdict was right every time; the evidence was a lottery.

        The plain list is a LIST OF SUSPECTS -- a script that prints two lines
        loses nothing, whatever it calls. `--verify` decides: it runs the script
        redirected to a file, then through a real pipe with a reader that sleeps
        first, and compares. Ground truth it is pinned against: 3 lines survive
        either way, 4000 lines come back as 1960.

  tri failures | tri потери
        What the seller is LOSING, counted from the hive journal in one read.

        The journal has held this answer for weeks and nobody asked it this way:
        the events scroll past one at a time, so a steady bleed reads as noise.
        Two hundred of them at once show the shape.

        First run, 2026-09-17, a 4.6-day window: 44 of 200 events were a picture
        that was generated and never reached the person it was made for -- 22% of
        everything recorded. 41 of the 44 say `replaced`: a newer draft evicted a
        pending one. Per day: 5, 8, 6, 12, 13. It is getting worse, not better.

        Read-only. The service key is read into a variable and never printed.
        The server caps the window at 200 events, so the oldest day in the
        output is partial and its count means nothing on its own.

  tri reel-check REEL.mp4|URL [--body body.json] [--words whisper.json] [--voice voice.mp3] [--sheet out.jpg] [--json]
        Look at a rendered reel the way the owner does. FACE: in every shot,
        is the face centred in the window it is shown in (the lower half of a
        split) and is the top of the head inside it? CAPTIONS: the reel's audio
        is cross-correlated with the voice file, then every caption is matched
        to the whisper word of the same text -- whisper of the FINAL voice, not
        of the notes it was cut from. Shots come from the render body's
        segments; without one, a seam in the picture marks a split.
        Thresholds live in split-reel.t27 (FACE_OFF_CENTER_MAX_PCT,
        HEADROOM_MIN_PCT). Exit 0 clean, 1 defects, 2 not measured.

  tri voice [--runs N] | tri голос
        The voice mode end to end: status, warm-up, a fixed phrase spoken in
        Russian and English by OUR engine, and each heard back by OUR whisper
        N times (default 3). The MEDIAN is the verdict -- one sample lied by
        2.5 s -- and the render's Server-Timing splits it into upload, whisper
        and the road; the hearing leg is named by the engine that did it
        (gigaam/parakeet, whisper, or both when they fell back on some runs).
        Over 3 s to speak or to hear is SLOW (exit 2). Needs a person's key in $AGENT_KEY
        (the render's AGENT_KEYS, first entry, up to ':'); without it only the
        public status is read and the exit code says NOT MEASURED (2).
        Every call goes over ONE kept-alive connection, as in the browser;
        the handshake and the warm round trip are printed on their own line.

  tri filler | tri пауза
        The phrases said while the agent thinks ("Let me see.", "Still
        working on it.", voice.filler.* in the player's dictionary), each
        synthesised once as the player does, against the lead it has: the
        audio is asked for at FILLER_PREPARE_MS and played at FILLER_FIRST_MS
        (FILLER_STILL_MS). Slower than the lead is LATE (exit 2); a phrase
        our voice cannot say is broken (exit 1). Each phrase is split into
        engine and road time; one that used over half of the player's
        speakDeadlineMs is a warning (exit 2). Also part of tri voice.
        Needs the same key as tri voice.

  tri road | tri дорога
        Just that road line: which Railway edge answered, what a new
        connection costs (DNS + TCP/TLS), and the warm round trip every call
        still pays (median of 5 empty status calls). Over 0.4 s warm is SLOW
        (exit 2). On 2026-10-02: edge sin1, render in sfo, ~250-290 ms warm.
        No key needed.

  tri turn | tri ход [--live | --record | --audio file ...] [phrase ...]
        Whether the words of a pause end the turn (player/src/lib/voice/
        turnEnd.ts): a phrase stopping on "and", "to", "uh", "и", "на" or a
        comma gets HANGING_TURN_MS of silence, anything else END_OF_TURN_MS.
        No phrases: its own battery, exit 1 on a wrong verdict. --live says
        six phrases with our mouth, hears them with our ears, judges what
        came back and prints when the words land in the pause (the "heard"
        earcon now waits for them).
        --audio judges recordings by the VOICE (Smart Turn in the ears);
        --record asks you to say ten phrases into the mic (five finished,
        five cut off), saves them under ~/.cache/tri/turn-voice/<lang> and
        runs --audio on them. Interactive; macOS asks for the mic first.

  tri words | tri слова [--lang=ru|en] [phrase ...]
        Are product words (reels, lipsync, neurophoto, Vibee...) heard as
        said? Our mouth speaks, our ears hear through the live road, with
        the render's fix-ups (render/src/voice/hotwords.ts) applied. XX = a
        new mishearing for that table, or a fix-up firing on a real word;
        "two alphabets" = a Latin letter inside a Russian word. Exit 1 on
        any XX. Needs the agent key.

  tri vad | tri шум [--legacy] [file.wav ...]
        The mic's voice-activity gate (player/src/lib/voice/vad.ts) run tick
        by tick over recordings, as the session runs it. With no files it
        makes its own battery (say + ffmpeg anoisesrc, 48 kHz mono): ru/en
        speech, fans, speech over a fan -- and prints onsets, turn ends,
        "steady room learned" and the flattest 2 s of each (spread vs
        STEADY_SPREAD). Exit 1 = speech taken for the room, a question over
        a fan not heard as a turn, or a fan held as a phrase. --legacy runs
        the gate before cycle 8 (a fan was "speech" for 30 s), unjudged.
        Your own files are judged only if named speech-*, over-fan-*, fan-*.
        No key, no network.

  tri loop | tri виток
        Where the last loop cycle stopped, before this one starts: dirty tree,
        gates or pushes running IN THIS TREE, this branch's PR, and the newest
        player/render deploys, and the player's lint ratchet (a push that
        skipped hooks gets past it; ~25 s, TRI_LOOP_FAST=1 skips it). Exit 1 =
        work in flight, continue it; a FAILED deploy on main blocks every
        later merge of that service.

  tri ears [status|deploy] [ru|en|mouth|all] | tri уши   (tri gigaam = tri ears ru, tri mouth = tri ears mouth)
        The fast ears of voice mode, one image (deployment/gigaam) as two
        services: gigaam hears Russian (GigaAM v3, ~0.15 s a phrase), parakeet
        hears English (Parakeet TDT v2 int8, ~0.3 s), where whisper takes 2-3 s.
        Without arguments: each one's newest deploy and which ears the render
        routes each language to. `deploy` uploads deployment/gigaam from a
        CLEAN tree -- neither service is wired to GitHub, so a merge alone
        does not ship them. `mouth` is the voice's own Kokoro + Piper pool
        (deployment/mouth, ~0.3 s an English phrase where speaches took
        1.2-1.7 s); it ships the same way.

  tri pay [--invoice] | tri оплата
        Can a client pay RIGHT NOW, rail by rail.

        Answering this by hand cost an hour on 2026-09-17, and none of it was
        written down: which routes exist, which keys sit on which service, what
        the mini app's three pay buttons actually do.

        What it found that day, and what it now re-checks in one command:
          Stars     works end to end -- the cashier minted a real invoice
          roubles   keys on the BOT service, no route on the render
          crypto    same
          profile   the mini app's profile page has NO way to pay; only chat
          paywall   its buttons open ?start=subscribe_..., which the bot
                    ignored until it was taught the word

        Read-only by default; keys are read into variables and never printed.
        `--invoice` also mints one real invoice, which writes a row, so it is
        opt-in rather than part of the check.

  tri clone [id] | tri клон
        Which pieces of a person's digital clone exist: a voice of their own,
        a face to render from.

        Two of the three were BUILT and unreachable, which took an hour to
        establish by hand: the voice wizard had no deep link and no status
        route, and the Telegram avatar sat in `users.photo_url` since
        registration with nothing reading it. A missing piece is what the
        welcome road opens a step for -- and it could not, until the route
        existed.

        The SOUL is not in this output on purpose: it lives behind an agent
        tool call rather than on the user row, and a line that says "not
        asked" every time is furniture.

  tri gen-refusal [BASE]
        Does every generation route name its refusal? Asks image, video,
        audio and lipsync WITHOUT credentials (refused at the charge, so
        nothing is spent) and wants a `code` from
        render/generation-refusal.ts in each answer. Run after a deploy.

  tri pr-billing N
        Is every failing check on PR N the Actions billing stop? rc 0 only if
        all are; an empty annotation (dropped connection) is re-asked, then
        counted UNKNOWN -- never billing.

  tri premerge N [--keep]
        Would PR N pass the player's deploy gate once it lands on today's
        main? Merges the PR head into origin/main in a throwaway worktree and
        runs exactly what the Docker test stage runs: tsc --noEmit and
        scripts/test-gate.mjs. rc 0 pass, 1 refused or conflict, 2 usage.
        --keep leaves the worktree for a look.

  tri deploys [--logs] | tri выкладки
        Is the player on app.t27.ai what main says it is? The serving
        commit, every later main commit that touches the image with its
        deploy status, and for a FAILED build: the failing tests, tsc
        errors, the REFUSED line, and who last touched each failing test.
        rc 0 live, 1 failed or behind, 2 unknown, 5 building.

  tri board
        Is the board on app.t27.ai trinity's main? The pinned QUEEN_REF,
        trinity main's HEAD, the commits between, and every open
        release(board) PR marked current or stale. rc 0 shipped, 1 behind,
        2 unknown. A reviewer agent merges the release PR, not its author.

  tri readers [--gate | --run FILE...] | tri читатели
        Tests that read source as TEXT, and the paths they still believe in.

        `vitest related` follows the IMPORT graph, and reading a file with fs
        is not importing it. So such a guard can be broken by MOVING code, and
        the pre-push gate will not say a word.

        Measured 2026-09-18: 180 test files read source this way. One of them
        guards a money path -- "a failed credit stops the retries and says so"
        -- and went red when the top-up flow moved into a shared hook. The
        behaviour had not changed; only the file had. It surfaced two days
        later, dragged into a run by an unrelated import.

        `--run FILE...` runs, right now, the tests that name FILE in quotes
        -- the guards on that one file, not the directory scanners. The same
        money guard broke the same way a second time on 2026-10-02, found
        only five minutes into pre-push. Run it before pushing a move.

        `--gate` reds when a path no longer exists. A path that exists is not a
        promise: only running the test says whether the string it looks for is
        still in there.

  tri flaky <test-file> [--times N] | tri шумит
        Is this test broken, or does it just not make up its mind.

        A push was refused on 2026-09-17, the same gate run twice more on the
        same files reported nothing, and the push went through on the second
        attempt. Nothing was broken. That is the worst state a gate can be in:
        it teaches "just push again", and that habit passes real breakage too.

        The gate now re-runs a fresh failure ALONE and blocks only on what
        fails twice; a noisy one is named and let through. This is the tool for
        going back to the named one.

        Exit code: 0 stable, 1 flaky or broken, 2 the runner never started.
        Passing four times in five is not passing -- it is a coin.

  tri deploy-config [service ...] | tri конфиг-деплоя
        Does each Railway service read ITS OWN railway.toml, and did a merge get
        stuck because of it.

        2026-09-17: the mini app (vibee-editor, Root Directory apps/vibee-editor)
        had its config file set to /railway.toml. Railway resolves that path from
        the REPOSITORY root, so the service read the bot's file, watched src/**,
        and answered "No changes to watched files" to every merge that touched
        only the player. Four merges sat undeployed while the right file,
        apps/vibee-editor/railway.toml, was in the repository.

        Railway does not expose the setting to the CLI, so this reads what each
        deployment RECORDED -- config file, Root Directory, applied patterns --
        and checks: the config is inside the Root Directory; its [service] name
        is this service; the running build applied that file's watchPatterns; no
        recent SKIPPED deploy changed files the service's own file watches; and
        no commit since the running build is waiting on those files.

        After fixing the setting in the UI, the first three clear on the next
        deployment Railway evaluates (even a skipped one records its config).
        Exit: 0 fine, 1 a problem, 2 Railway or git unreadable.

  tri watches [--limit N] | tri сторожа
        Are the money watches alive, and when did each last look.

        Two watches ask whether somebody paid and was never credited: TON
        hourly against the chain, Robokassa daily against the provider. Both
        were built to speak ONLY when money is owed -- so a healthy channel and
        a dead watch produced exactly the same silence. The journal had already
        learned that with the seller's sweep, and the watches shipped with the
        flaw one day after it was written down.

        They now write a heartbeat: one line per channel per 20 hours, with how
        many invoices were examined. Two missed beats is a stopped watch; ONE
        is a deploy. "Never reported" is its own answer, not a failure -- a
        watch an hour old has missed nothing.

        Not asked of Inngest on purpose: the run history would answer it better
        and needs a key only the owner holds. A tool that only somebody else
        can run is a tool that does not run.

  tri ton-pending | tri тон-зависшие
        Did TON arrive that nobody ever credited.

        The TON channel credits on a BUTTON: the person sends the coins with
        the invoice id in the comment and presses "check payment", and only
        then does anything look at the chain. Close the app or lose the
        message and the coins sit there against a PENDING row for ever.

        Same shape as `tri reconcile` for Robokassa: ask an INDEPENDENT source.
        Our table is where the defect lives -- ask it about a stuck payment and
        it says PENDING, which is what we already knew. The matching rule is
        the scene's own: the comment must EQUAL the invoice id, the amount must
        be within the 1% fee margin, and a transfer older than the invoice does
        not count.

        An invoice older than the chain window read is reported as "not an
        answer", never as unpaid. Credits nobody: that is the owner's call.

  tri replicas [service ...] | tri реплики
        How many processes are actually running.

        Every mechanism that stops a double charge is per-process: the scenes'
        in-flight flags (18 places), Inngest step.run, and the consume-once
        marks. They hold because the bot runs as ONE replica. Two processes
        have two sets of module-level flags, and a double tap lands one in
        each.

        guardsAssumeOneProcess.test.ts checks what railway.toml DECLARES. This
        reads what Railway ran: meta.serviceManifest.deploy. It adds
        multiRegionConfig up, because one replica in each of two regions is two
        processes and the top-level number still says 1.

        Exit: 0 one process, 1 more than one, 2 Railway unreadable -- never a
        green answer from no data.

  tri map [--undocumented] [<substring>] | tri карта
        Every command tri dispatches, read out of tri itself.

        101 commands are dispatched; this help text describes 53. The other 48
        exist and are invisible -- which is how `tri mutate` (break the code,
        run the test, expect red, revert, expect green) got rebuilt by hand
        over several cycles while it sat in the file.

        The name comes from the dispatch table and the one-line summary from
        each command's own leading comment, so the map cannot drift from the
        code the way a hand-written list does. A command absent from this help
        is marked with *; `--undocumented` shows only those, and a substring
        searches names and summaries.

  tri money [--all] | tri деньги

        Which money calls throw their answer away.

        updateUserBalance returns false WITHOUT throwing when the payer row is
        missing or the insert is refused; directPaymentProcessor answers
        {success:false}. A statement that starts with await and binds nothing
        cannot tell a moved star from a lost one, and everything after it
        proceeds as though the money arrived. Every money guard converted this
        week found that same shape underneath.

        Calls inside unreachable stubs are listed APART, not hidden: they move
        nothing today, and they are exactly what a future edit revives.

        refundUser is deliberately NOT counted -- it returns nothing, so there
        is no answer to discard. The first version counted it and produced 27
        invented defects in one run.

        Exit: 0 nothing live discards its answer, 1 something does, 2 the
        source tree could not be read.

  tri clock [--hours N] [--limit N] | tri часы
        Is the seller's clock beating, and what can this even tell us.

        crm-proactive-sweep ticks every 30 minutes, but the journal records
        what a tick DID, never that one happened: an idle tick writes a line,
        a HOLDING seller writes one per six hours on purpose, and a tick that
        finds no carrier writes nothing at all. On 2026-09-18 a 39-minute
        silence read as a missed tick and cost a detour to disprove.

        So the verdict is against what the system promises -- a heartbeat
        every six hours, the render watchdog's alarm at twelve -- drawn as an
        hourly strip, with the gap measured inside the window shown. An empty
        window is "nothing to judge", never "fine".

        It says every time what it cannot see: whether a tick ran and wrote
        nothing. That is the Inngest run list, and its key is the owner's.
        Exit: 0 beating, 1 silent past the alarm, 2 could not look.

  tri ship -m "..." [--branch <name>] [--all] | tri отправить
        Commit and push, and name the step that did NOT happen.

        2026-09-18: a commit was refused by the no-cyrillic gate; the refusal
        sat in a hundred lines of hook output filtered down to its passing
        lines, so every gate looked green. The push that followed sent nothing
        and said so quietly, and only `gh pr create` complained -- "No commits
        between main and ...". Three commands, two no-ops, no error.

        Each step has one fact that settles it: the commit moved HEAD, and the
        push left origin/<branch> at that same commit. Both are checked, hook
        output is shown in full rather than filtered, and a failure names the
        step instead of the tool that noticed it four steps later.

        It refuses to commit on main and never merges: landing is a separate
        decision. Exit: 0 shipped, 1 a step did not happen, 2 nothing to ship.

  tri upstream [--all] | tri откуда
        Which remote branch does each local branch pull from, and does it still
        exist.

        2026-09-18: local `main` was configured to merge `refs/heads/docs/form-111`,
        a branch deleted weeks earlier. `git pull` on main failed outright and
        `git status` reported "ahead 47" against a ref nobody has -- neither of
        which reads as "your main is misconfigured".

        Two shapes are wrong. GONE: the upstream no longer exists, so a pull
        fails and status lies. CROSSED: the upstream exists and is a DIFFERENT
        branch, so the pull SUCCEEDS and merges somebody else's work -- silent,
        and the reason this exists. A feature branch tracking origin/main is
        neither: that is what `git checkout -b` sets up on purpose.

        By default it judges the current branch and main, and merely counts the
        leftovers; --all lists every one. Exit: 0 fine, 1 a branch that matters
        is misconfigured, 2 not a repository.

  tri signin [--limit N] | tri вход
        Did the sign-in code reach anybody, and where did it stop.

        Owner, 2026-09-17: "why does the code not reach the user?" The journal
        held 23 sign-ins and not one `code-issued`, and an absence is invisible
        until somebody thinks to look for a thing that is not there.

        Four steps in the order a person walks them: signed in inside Telegram,
        a code minted and SHOWN, that code typed and accepted, a request or a
        claim refused with its reason. The code is never sent anywhere, so a
        zero at step two and a zero at step three are different repairs.

        Read-only; the key is read into a variable and never printed.

  tri ci
        Is CI running at all. A run that fails in seconds with zero steps is an
        infrastructure refusal, not a signal about the code: everything merged
        was merged blind.

  tri colors [dir]
        Literal colours and font sizes in Swift that bypass Theme.swift.
        Catches the LITERAL, not the mention: .system(size: 14) yes,
        .system(size: Theme.Size.xs) no -- that is a token in use.
        A design system leaks one literal per edit, not all at once.

  tri colors check
        Run the pattern against a built-in sample: it must find 10 literals and
        skip 9 tokens. Silence over the tree does NOT prove health -- a dead
        pattern is silent too, which has already happened here.

LOOP TOOLING
  tri lock | tri unlock   take or release the iteration lock
  tri in-gate <file>      Does the GATE actually collect this test? A suite that
                          never ran cannot regress, so a green gate proves
                          nothing about a file it never loaded -- that is how a
                          new test once passed without executing once. Zero
                          collected tests means either the config excludes it or
                          an import failed to resolve (in a worktree: unlinked
                          sub-app node_modules); the two are reported apart
                          because they are fixed differently.
  tri in-gate-check       Can `tri in-gate` still fail? Runs it against a file
                          the gate must see AND one it must not.
  tri why-red <file>      Is the gate red on this file because a test BROKE, or
                          because it was RENAMED? The gate compares sets of
                          names and cannot tell: a name that no longer exists
                          looks exactly like a failing test, and is incurable --
                          the gate's re-check clears a suspect only by seeing it
                          pass. A renamed suite therefore keeps the gate red on
                          a clean tree, and people stop reading it. The tell is
                          the COUNT: a flake does not change how many tests a
                          file has. Prints the vanished names and the snapshot
                          protocol for refreshing them.
  tri why-red-check       Can `tri why-red` still fail? Runs it against the
                          snapshot from before PR #1496 (which must report the
                          vanished names) AND the current one (which must not).
  tri disk [reap]         DATA-volume usage + self-heal. Reports stale worktrees
                          and DEAD-session scratch (0 open handles AND mtime>1d;
                          liveness is judged by OPEN HANDLE, not mtime -- a
                          week-idle 31G scratch was a LIVE vvp sim). `tri disk
                          reap` frees the dead ones. Big OWNER eaters (Docker,
                          Caches, Simulators, DerivedData) are named, never
                          touched -- deleting their data is the owner's call.
  tri scan                anomalies, and what is waiting on the owner
  tri scan-check          Can `tri scan` still fail? Stands up a local server,
                          feeds the checker deliberately broken payloads and
                          asserts every alarm fires. "0 anomalies" on prod does
                          NOT prove health: a detector that stopped detecting
                          prints exactly the same line. Both defects found in
                          anomalies.mjs on 2026-08-29 had looked green.
  tri refs                Does every `tri X` in render source AND the loop's own
                          tooling (.claude/loop-opus) name a real command?
                          Static, offline. Catches the docstring or LESSONS rule
                          that points at a command nobody built -- the defect
                          found by hand four ticks running (tri pod/journal/seal).
  tri refs-check          Can `tri refs` still fail? Drives its scan over a
                          fixture with a known phantom and asserts it rings.
  tri money-map           Repo-wide census of money-mutation CALL SITES. --json
                          for the machine-readable list.
  tri repo-hygiene        Flag repo-hygiene leaks a dead CI won't catch
                          (tracked dumps, stray secrets-shaped files).
  tri rpc-audit           List supabase RPCs the code CALLS but that are not
                          defined in the tracked SQL -- a deploy-time 404.
  tri single-telegram     Find `.single()` on a users query filtered by
                          telegram_id, which throws on the duplicate rows that
                          exist in prod. Use maybeSingle or .limit(1).
  tri panel               rebuild the dashboard
  tri tests               the full run
  tri routes              client and server addresses, compared
  tri health              the render service /health in one line
  tri factory             Is the content factory alive, answered by the AGE of
                          the last post rather than the presence of a field.
                          On 2026-08-29 the regression check reported clean while
                          the pipeline had been stopped for 51 hours, because it
                          tested lastPostAt for existence, not for staleness.

AGENT TOOLS ON THE RENDER
  tri mcp list            every tool the render offers, one per line
  tri mcp <tool> [json]   call one tool; the JSON is validated here, because a
                          malformed envelope comes back as -32600 and reads like
                          a dead route instead of a quoting bug
  tri mcp eval <file.js>  run a browser script read from a FILE (the only way
                          its quotes and newlines survive the shell).
                          `tri mcp eval --example` prints the shape that works:
                          browser_evaluate throws on a top-level await but does
                          resolve a RETURNED promise.
                          The key comes from $AGENT_KEY, then
                          $TRI_AGENT_KEY_FILE (default /tmp/.ak.tmp), then
                          Infisical. It is never printed.
  tri card <n> [text]     a kanban card's conversation, from the terminal --
                          the SAME thread the app's card sheet and every A2A
                          agent use (spec gHashTag/t27 kanban-card-chat.t27):
                          `task:gHashTag/<repo>#<n>`. <n> is 5382 (the board's
                          repository), t27#5382 or gHashTag/trinity#7. No text:
                          print the card and its last turns. With text: say it
                          and stream the agent's answer; both turns land in the
                          thread, marked surface `agent`. Exit 0 ok, 1 refused,
                          2 the render has no task threads yet (nothing sent),
                          3 the render did not answer. Key as for `tri mcp`.
  tri card-check [n]      is the card chat LIVE (spec kanban-card-chat.t27):
                          GETs only, nothing written. Four verdicts --
                          the card's thread is `task:` (render deployed),
                          /api/card-status answers (404 = not deployed,
                          503 = no GITHUB_READ_TOKEN: the client reads), and
                          the PRs that carry it are merged; plus the
                          server's GraphQL query against live GitHub (local
                          `gh` login, read-only) compared with the client's
                          read. <n> (t27#n, repo#n) defaults to 5382, the EPIC. Exit 0 all live, 2 waiting on a
                          merge, deploy or token, 1 something answered wrong.
  tri card-drift [n] [--dry]
                          the nightly half of card-check: the server's
                          card-status query against live GitHub vs the
                          client's read (needs only a `gh` login). Drift is
                          kept in ONE issue in gHashTag/t27 under the EPIC
                          #5388: opened on the first drifting night,
                          commented on the next, closed on the first night
                          they agree; a night measuring nothing touches
                          nothing. --dry prints the verb, writes nothing.
  tri hive-nightly [--shots] [--dry]
                          every card-sheet watch in one night, each with its
                          own ONE issue in gHashTag/t27 (opened, commented,
                          closed by the same verbs as card-drift): the drift,
                          the live card-check (waiting on a merge or deploy
                          is not a regression), and on Sundays or with
                          --shots `tri shot all`. A red stand is shot twice:
                          green the second time = flake, no issue.
                          Unmeasured touches nothing.
                          Exit 0 agree, 1 drift, 2 not measured.
  tri browser             can the remote browser ACT, not merely answer.
                          `/json/list` is served by the browser process, so it
                          keeps replying while every renderer is wedged -- which
                          is how the pod looked fine on 2026-09-27 with nothing
                          on it able to act. Prints the two claims apart:
                          reachable (the process) and answers (a real page
                          evaluated 1 + 1). Exit 0 alive, 1 dead or wedged,
                          2 asked nobody or sitting at the tab cap, 3 the
                          render itself did not answer.
  tri heal                the action `tri browser` points at: POST the heal.
                          Safe at ANY time -- the endpoint PROBES FIRST and
                          refuses to restart a browser that answers, so it can
                          never take a working browser from the person. Exit 0
                          healed or nothing to do, 1 restarted and STILL dead
                          (Chromium must come up inside the pod), 2 no browser
                          configured to heal, 3 the render did not answer.
  tri browser-check       proves those verdicts against a local socket, because
                          the live pod is alive today and cannot show the three
                          answers that matter. A mutant that calls a wedged pod
                          healthy fails the first case.
  tri saw [limit]         what the agent SAW when it erred. For each failed
                          browser step in the last [limit] (default 50), the
                          last thing it actually looked at and how long before
                          -- the 2026-09-22 "Queen's board vs a Google sign-in"
                          mismatch, answered in one read. Exit 0 nothing erred,
                          1 something did, 3 the render did not answer.
  tri logins              which social networks the clone is signed into RIGHT
                          NOW, read from the browser's cookies without opening a
                          page or writing anything. A login cookie means the
                          browser HOLDS a login, not that the site still honours
                          it. Exit 0 at least one live login, 2 none (or no
                          browser running), 3 the render did not answer.
  tri pod                 SINCE WHEN has the browser been well, or not? Reads
                          the watch row -- the one number missing during the
                          2026-09-24..26 outage, when nobody could say the pod
                          had been unreadable for three days. Shows how long it
                          has held its current state, failures in a row, and how
                          many reboots the watch has seen (a restart that did not
                          help still shows). Exit 0 answering, 1 NOT answering
                          (the heal case), 2 never probed / no pod watched
                          (nobody looked -- not "broken"), 3 the render did not
                          answer. `describeWatch` in watch.ts promised this
                          command; until now it did not exist.
  tri journal [limit]     the browser's full timeline: every step the agent took
     [--probes]           (default 50), newest first -- tool, ok/FAILED, ms, and
                          one line of what it touched. `tri saw` is this reader
                          narrowed to error moments; this is the whole record its
                          timings were meant to be read from. --probes folds in
                          the on-a-clock watch checks (what the docstrings called
                          `tri eyes`), kept out of the view otherwise. Exit 0
                          steps shown, 2 none recorded yet (nobody acted -- not
                          "broken"), 3 the render did not answer. journal.ts
                          named this command; until now it did not exist.

