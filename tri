cmd_dupes() {
  # ФУНКЦИЯ, ОБЪЯВЛЕННАЯ ДВАЖДЫ В ОДНОМ ФАЙЛЕ.
  #
  # В JS позднее объявление `function` МОЛЧА перекрывает раннее: первое
  # становится мёртвым, и правка, попавшая в него, не делает ничего. Дважды
  # такой дубль прятал находку (it.90: четыре мутации легли в мёртвую копию и
  # «прошли»; it.95: две копии таблицы разошлись, 33 героя против 16).
  #
  # ПОЧЕМУ ТУТ NODE, А НЕ GREP. Первая версия (it.95) искала регекспом по
  # сырому тексту и дала 10 совпадений, из которых НАСТОЯЩЕЕ ОДНО. Восемь
  # оказались образцами кода внутри шаблонных строк — тестовые фикстуры вида
  # `const gated = \`export async function h(req,res){...}\`` — а ещё одно
  # перегрузкой TypeScript. Число «9 настоящих» я успел опубликовать.
  #
  # Это уже второй раз, когда мой матчер считает не-код: в it.91 перепись
  # выключенных тестов считала упоминание `describe.skip` В КОММЕНТАРИИ.
  # Поэтому здесь перед поиском вырезаются и комментарии, и строковые
  # литералы (обычные, одинарные и шаблонные) — то есть всё, что выглядит
  # кодом, но кодом не является.
  #
  # Команда не доказывает дефект, она сужает круг чтения.
  local target="${1:-src}"
  local filelist
  if [ -f "$target" ]; then
    # Явный файл нужен самопроверке: её образцы НЕ отслеживаются git.
    filelist="$target"
  else
    filelist="$(git -C "$ROOT" ls-files "$target/**/*.ts" "$target/**/*.cjs" "$target/*.ts" "$target/*.cjs" 2>/dev/null | sed "s|^|$ROOT/|")"
  fi
  printf '%s' "$filelist" | ( cd "$ROOT" && node -e '
    const fs = require("fs");
    let input = "";
    process.stdin.on("data", d => (input += d));
    process.stdin.on("end", () => {
      const files = input.split("\n").filter(Boolean);
      // One definition, not a copy. This inline blank() was copied from
      // scripts/lib/blank-code.cjs and drifted: it kept a reference to the
      // QUOTES table it left behind, so the verb threw ReferenceError on any
      // file containing a quote -- that is, on every real source file. It had
      // been dead the whole time, and the self-check passed anyway (see
      // cmd_dupes_selfcheck).
      const { blank } = require("./scripts/lib/blank-code.cjs");
      let found = 0, read = 0;
      const unreadable = [];
      const re = /^[ \t]*(?:export[ \t]+)?(?:async[ \t]+)?function[ \t]+([A-Za-z_$][\w$]*)/gm;
      for (const f of files) {
        let src;
        // A swallowed read is a THIRD answer, not a clean one. `catch
        // { continue }` made "no duplicates" and "read nothing at all"
        // print the same words, and no probe could break the tool: every
        // injected failure was absorbed silently. Skips are counted and
        // named; reading nothing is an error, not a clean result.
        try { src = fs.readFileSync(f, "utf8"); read++; }
        catch (e) { unreadable.push(f + ": " + e.message); continue; }
        const code = blank(src);
        const seen = new Map();
        for (const m of code.matchAll(re)) {
          const name = m[1];
          if (!seen.has(name)) seen.set(name, []);
          seen.get(name).push(m.index);
        }
        for (const [name, idxs] of seen) {
          if (idxs.length < 2) continue;
          // A TypeScript overload signature has no body of its own.
          const withBody = idxs.filter(ix => {
            const j = code.indexOf("{", ix);
            if (j === -1) return false;
            let d = 0, k = j;
            for (; k < code.length; k++) {
              if (code[k] === "{") d++;
              else if (code[k] === "}") d--;
              if (d === 0) break;
            }
            return k - j > 3;
          });
          if (withBody.length < 2) continue;
          const lines = idxs.map(ix => code.slice(0, ix).split("\n").length);
          found++;
          console.log("  " + f.replace(process.argv[1] + "/", "") +
                      "  " + name + "  x" + withBody.length + "  lines=" + lines.join(","));
        }
      }
      console.log("");
      if (unreadable.length) {
        console.log("НЕ ПРОЧИТАНО файлов: " + unreadable.length + " из " + files.length);
        for (const u of unreadable.slice(0, 5)) console.log("     " + u);
      }
      console.log("прочитано файлов: " + read + " из " + files.length);
      console.log("функций, объявленных повторно: " + found);
      if (files.length && read === 0) {
        console.log("НИ ОДИН файл не прочитан -- это не чистый результат, а слепота.");
        process.exit(2);
      }
      process.exit(found === 0 ? 0 : 1);
    });
  ' "$ROOT" )
}

cmd_dupes_selfcheck() {
  # ОБЕ СТОРОНЫ на временных файлах: репозиторий не трогаем.
  local d="$ROOT/src/__tests__/.tri-dupes-probe"
  rm -rf "$d"; mkdir -p "$d"
  printf 'function twice() { return 1 }\nfunction twice() { return 2 }\n' > "$d/dup.ts"
  printf 'function once() { return 1 }\nconst other = 2\n' > "$d/clean.ts"
  # ОБРАЗЕЦ КОДА ВНУТРИ ШАБЛОННОЙ СТРОКИ — не объявление. Ровно это первая
  # версия команды считала дефектом: 8 из 10 её «находок» были тестовыми
  # фикстурами вида `const gated = \`function h(){}\``.
  printf 'const a = `function inside() { return 1 }`\nconst b = `function inside() { return 2 }`\n' > "$d/fixture.ts"
  local rc=0 out
  out="$(cmd_dupes "$d/dup.ts" 2>&1 || true)"
  local out_clean
  out_clean="$(cmd_dupes "$d/clean.ts" 2>&1 || true)"
  if printf '%s' "$out" | grep -q 'twice'; then
    good 'повторное объявление найдено'
  else
    bad 'СЛОМАНА: повторное объявление не найдено'
    rc=1
  fi
  if printf '%s' "$out_clean" | grep -q 'once'; then
    bad 'СЛОМАНА: одиночное объявление названо дублем'
    rc=1
  else
    good 'одиночное объявление дублем не названо'
  fi
  # ОТРИЦАТЕЛЬНОЕ УТВЕРЖДЕНИЕ ОБЯЗАНО ДОКАЗАТЬ, ЧТО ИНСТРУМЕНТ ВООБЩЕ РАБОТАЛ.
  #
  # До этой правки обе отрицательные проверки выполнялись УПАВШЕЙ командой:
  # копия blank() внутри cmd_dupes ссылалась на таблицу QUOTES, которую при
  # копировании не взяли, и любой файл с кавычкой ронял её с ReferenceError.
  # Пустой вывод не содержит слова 'inside' -- значит «дублем не считается»
  # проходило. Положительный образец кавычек не содержал и до этой ветки не
  # доходил, поэтому самопроверка была зелёной, а команда мёртвой.
  #
  # Теперь stderr и код возврата ловятся отдельно: «не нашёл» принимается
  # только от команды, которая отработала.
  local out_fixture err_fixture rc_fixture
  err_fixture="$(mktemp)"
  out_fixture="$(cmd_dupes "$d/fixture.ts" 2>"$err_fixture")"; rc_fixture=$?
  if [ -s "$err_fixture" ] || [ "$rc_fixture" -gt 1 ]; then
    bad "СЛОМАНА: команда упала на образце (rc=$rc_fixture): $(head -c 120 "$err_fixture")"
    rc=1
  elif printf '%s' "$out_fixture" | grep -q 'inside'; then
    bad 'СЛОМАНА: объявление внутри шаблонной строки посчитано дублем'
    rc=1
  else
    good 'образец кода в шаблонной строке дублем не считается (и команда отработала)'
  fi
  rm -f "$err_fixture"
  # ТРЕТИЙ ОТВЕТ. Пока нечитаемый файл молча пропускался, «дублей нет» и
  # «не прочитано ничего» печатались одинаково, и НИ ОДНА проба не могла
  # сломать команду: любой отказ чтения поглощался. Счётчик прочитанного
  # закрепляется здесь, иначе он тихо исчезнет обратно.
  if printf '%s' "$out" | grep -q 'прочитано файлов: 1 из 1'; then
    good 'команда сообщает, сколько файлов прочла'
  else
    bad 'СЛОМАНА: команда не сообщает число прочитанных файлов'
    rc=1
  fi
  rm -rf "$d"
  return "$rc"
}

cmd_probes() {
  # У КАЖДОГО ЛИ ИСКАТЕЛЯ ЕСТЬ ПОЛОЖИТЕЛЬНЫЙ КОНТРОЛЬ.
  #
  # Скилл утверждал: «каждый scripts/probe-*.cjs начинается с проверки на
  # заведомо-положительном и заведомо-отрицательном образце». Померил — из 38
  # контроль есть у 7. Утверждение было неверно для 31 файла, и написал его я.
  #
  # Почему это важно именно для искателей: «ничего не найдено» у сломанного
  # матчера выглядит ровно как «ничего не найдено» у чистого кода. Проверка
  # «я запустился» (все они печатают размер популяции) на этот вопрос НЕ
  # отвечает — нужен образец, который ОБЯЗАН найтись.
  #
  # Делим по тому, где контроль вообще возможен дёшево: искатель по ИСХОДНИКАМ
  # держит образец в себе, а искатель по ЖИВЫМ данным зависит от строк в проде,
  # и стабильного образца у него может не быть вовсе. Потолок ратчета стоит
  # только на первых.
  # Потолок опущен до НУЛЯ: все источниковые искатели закрыты (it.90). Теперь
  # это не потолок долга, а правило: новый искатель по исходникам без контроля
  # роняет команду сразу.
  local ceiling=0
  local total=0 withc=0 src_no=0 live_no=0
  local src_list="" live_list=""
  for f in "$ROOT"/scripts/probe-*.cjs; do
    [ -f "$f" ] || continue
    total=$((total + 1))
    # УПОМИНАНИЕ — НЕ КОНТРОЛЬ. Слова «самопроверка» в шапке достаточно, чтобы
    # искалка попала в число проверенных, хотя проверять она может ничего.
    # Тот же класс, что дважды укусил в it.91 и it.96: матчер считает текст,
    # а не поведение. Сегодня совпадение точное — у всех 13 упоминающих есть и
    # отказ, — но держится это удачей, а не построением. Требуем оба признака:
    # образец И выход с кодом 2, когда образец не найден.
    if grep -qE "SELF_CHECK|самопроверк|POSITIVE" "$f" \
       && grep -q "process.exit(2)" "$f"; then
      withc=$((withc + 1))
      continue
    fi
    # ПОВЕДЕНИЕ, А НЕ УПОМИНАНИЕ. Прежний признак «в файле встречается axios или
    # SUPABASE_URL» относил к живым данным probe-charge-order, у которого слово
    # axios лежит ВНУТРИ РЕГЕКСПА, которым он ищет по исходникам: ноль запросов,
    # два чтения с диска. Из-за этого он числился «живым», потолок его не
    # касался, и я публиковал «0 источниковых без контроля» — на деле 1.
    #
    # Тот же класс, что в #1712/#1724/#1725: матчер считал текст. Здесь
    # вырезаются строки и комментарии, и требуется настоящий вызов клиента —
    # включая createClient из supabase-js, которого прежний признак не знал
    # вовсе (четыре искалки ходят в базу именно так).
    if node -e '
      const fs = require("fs");
      const t = fs.readFileSync(process.argv[1], "utf8");
      let o = "", i = 0;
      const keep = s => s.replace(/[^\n]/g, " ");
      while (i < t.length) {
        const c = t[i];
        if (c === "/" && t[i+1] === "*") { const j = t.indexOf("*/", i+2); const e = j === -1 ? t.length : j+2; o += keep(t.slice(i,e)); i = e; continue; }
        if (c === "/" && t[i+1] === "/") { const j = t.indexOf("\n", i); const e = j === -1 ? t.length : j; o += keep(t.slice(i,e)); i = e; continue; }
        if (c === "`" || c === "\"" || c === "'"'"'") {
          let j = i+1;
          while (j < t.length) { if (t[j] === "\\") { j += 2; continue; } if (t[j] === c) break; if (c !== "`" && t[j] === "\n") break; j++; }
          const e = Math.min(j+1, t.length); o += c + keep(t.slice(i+1, e)); i = e; continue;
        }
        o += c; i++;
      }
      const NET = /(await\s+fetch\s*\(|axios\.(get|post|put|delete)\s*\(|require\(\s*.axios|from\s+.axios|createClient\s*\()/;
      process.exit(NET.test(o) ? 0 : 1);
    ' "$f"; then
      live_no=$((live_no + 1)); live_list="$live_list  $(basename "$f")
"
    else
      src_no=$((src_no + 1)); src_list="$src_list  $(basename "$f")
"
    fi
  done
  echo "искателей всего: $total"
  echo "с положительным контролем: $withc"
  echo ""
  echo "БЕЗ контроля, по ИСХОДНИКАМ (контроль дёшев — образец лежит в самом файле): $src_no"
  printf '%s' "$src_list"
  # ОГОВОРКА ИСПРАВЛЕНА. Здесь стояло «образец зависит от строк в проде», и это
  # было отговоркой, а не замером: зависят от них ДАННЫЕ, а не МАТЧЕР. У этих
  # искалок разбор — чистая функция от ответа (разбор литерала, классификация
  # ошибки, пороги по долям), и синтетический образец проверяет её полностью, не
  # трогая ничего живого.
  #
  # Прочитано глазами 4 из них: у трёх матчер отделим (money-wire разбирает
  # литерал, identity читает текст ошибки, paid-nothing-made считает доли),
  # у одной (storage-reconcile) — нет, она только перечисляет и печатает.
  # Общего числа НЕ называю: это чтение, а не перепись, и выдавать выборку за
  # знаменатель — ровно та ошибка, которую я ловил всю неделю.
  #
  # Образец возможного контроля — scripts/probe-money-wire.cjs: он выполняется
  # ДО обращения к креденшелам, то есть проверяем разбор без доступа к проду.
  # Отделимость матчера ПРОЧИТАНА ГЛАЗАМИ и лежит списком в
  # scripts/live-probe-matchers.txt. Грепом её не определить: это суждение о
  # том, есть ли в искалке чистая функция от ответа. Поэтому здесь читается
  # реестр, а не выдумывается матчер, — иначе он повторил бы ту самую ошибку,
  # ради которой файл заведён (#1730: оговорка вместо замера).
  local reg="$ROOT/scripts/live-probe-matchers.txt"
  local sep_yes=0 sep_no=0 unlisted=""
  if [ -f "$reg" ]; then
    # СЧИТАЕМ ТОЛЬКО ТЕХ, КТО СЕЙЧАС БЕЗ КОНТРОЛЯ. Реестр описывает свойство
    # матчера и живёт дольше: искалка, получившая контроль, из него не
    # удаляется. Первая версия считала все строки файла — и после двух новых
    # контролей печатала «без контроля 21, из них отделимы 21 и нечего
    # проверять 2», то есть 23 из 21. Несогласованность и выдала ошибку.
    sep_yes=0; sep_no=0
    while IFS= read -r nm; do
      nm="${nm#"${nm%%[![:space:]]*}"}"
      [ -n "$nm" ] || continue
      if grep -qE "^$nm[[:space:]]+yes[[:space:]]" "$reg"; then
        sep_yes=$((sep_yes + 1))
      elif grep -qE "^$nm[[:space:]]+no[[:space:]]" "$reg"; then
        sep_no=$((sep_no + 1))
      fi
    done <<< "$live_list"
    while IFS= read -r nm; do
      # live_list накапливается с отступом для печати — здесь он мешает.
      nm="${nm#"${nm%%[![:space:]]*}"}"
      [ -n "$nm" ] || continue
      grep -q "^$nm[[:space:]]" "$reg" || unlisted="$unlisted  $nm
"
    done <<< "$live_list"
  fi
  echo "БЕЗ контроля, по ЖИВЫМ данным (ходят в базу): $live_no"
  echo "   из них матчер ОТДЕЛИМ и контроль возможен: $sep_yes; нечего проверять: $sep_no"
  echo "   (прочитано вручную 08.09.2026, см. scripts/live-probe-matchers.txt)"
  if [ -n "$unlisted" ]; then
    bad "новая искалка по живым данным не разобрана в реестре:"
    printf '%s' "$unlisted"
    echo "  Прочитай её и допиши строку: <файл> <yes|no> <что является матчером>."
    echo "  yes = есть чистая функция от ответа, её можно проверить выдуманным"
    echo "  образцом без доступа к проду. Списком, а не грепом: отделимость —"
    echo "  это суждение, и определить её может только чтение."
    return 1
  fi
  echo ""
  if [ "$src_no" -gt "$ceiling" ]; then
    bad "источниковых искателей без контроля стало больше: $src_no > $ceiling"
    echo '  Новый искатель по исходникам обязан нести образец, который ОБЯЗАН'
    echo '  найтись, и образец, который найтись НЕ должен. Иначе его молчание'
    echo '  ничего не означает. Пример — scripts/probe-id-concat.cjs.'
    return 1
  fi
  good "потолок держится: $src_no ≤ $ceiling"
}

cmd_probes_selfcheck() {
  # ОБЕ СТОРОНЫ на временных файлах: репозиторий не трогаем.
  local d="$ROOT/scripts" rc=0 out
  local tmp_src="$d/probe-zzz-selfcheck-tmp.cjs"
  out="$(cmd_probes 2>&1 || true)"
  if printf '%s' "$out" | grep -q 'потолок держится'; then
    good 'на текущем дереве потолок держится'
  else
    bad 'СЛОМАНА (или долг вырос): потолок не держится на чистом дереве'
    rc=1
  fi
  # Новая искалка по ЖИВЫМ данным, не разобранная в реестре, обязана уронить
  # команду: отделимость матчера определяется чтением, и молча пропустить её
  # значило бы вернуть ту самую оговорку, ради снятия которой заведён реестр.
  local tmp_live="$d/probe-zzz-selfcheck-live.cjs"
  printf 'const { createClient } = require("@supabase/supabase-js")\nconst db = createClient(1, 2)\ndb.from("x").select("*")\n' > "$tmp_live"
  out="$(cmd_probes 2>&1 || true)"
  rm -f "$tmp_live"
  if printf '%s' "$out" | grep -q 'не разобрана в реестре'; then
    good 'новая живая искалка вне реестра ломает проверку'
  else
    bad 'СЛОМАНА: новая живая искалка вне реестра прошла молча'
    rc=1
  fi

  # Добавляем искателя по исходникам БЕЗ контроля — счётчик обязан вырасти.
  printf '// probe without any control\nconst fs = require("fs")\nconsole.log(fs ? 1 : 0)\n' > "$tmp_src"
  out="$(cmd_probes 2>&1 || true)"
  rm -f "$tmp_src"
  if printf '%s' "$out" | grep -q 'стало больше'; then
    good 'новый искатель без контроля ломает потолок'
  else
    bad 'СЛОМАНА: новый искатель без контроля прошёл незамеченным'
    rc=1
  fi
  return "$rc"
}

cmd_net() {
  # КТО ИЗ ТЕСТОВ ХОДИТ В СЕТЬ ПО-НАСТОЯЩЕМУ.
  #
  # Тест, зависящий от чужого сервера, однажды отвечает иначе — и разовая
  # краснота приучает считать часть провалов шумом. Инструмент был, но им ни
  # разу не пользовались, и он ВИДЕЛ ТОЛЬКО fetch: axios в Node идёт через
  # транспорт http/https, поэтому его трафик наблюдателю был не виден вовсе.
  # А axios здесь основной клиент. Его «ноль вызовов» означал не тишину, а
  # слепоту к нужному каналу — проверено зондом: два вызова, одна строка.
  #
  # Теперь перехватываются оба канала, и у переписи есть СВОЙ контроль:
  # network-observer-probe.test.ts делает по вызову каждым клиентом и требует,
  # чтобы оба попали в журнал. Нет контроля — отчёт отказывается считать.
  ( cd "$ROOT" && DETECT_NETWORK=1 npx vitest run --silent >/dev/null 2>&1
    node scripts/report-network-tests.cjs )
}

cmd_net_selfcheck() {
  # ОБЕ СТОРОНЫ. Прогон всей сьюты для этого не нужен — хватает зонда.
  local rc=0 out
  rm -f /tmp/tri-net-check.log /tmp/tri-net-check.log.mark
  out="$( cd "$ROOT" && NETWORK_LOG=/tmp/tri-net-check.log DETECT_NETWORK=1 \
      npx vitest run src/__tests__/network-observer-probe.test.ts 2>&1 || true )"
  if printf '%s' "$out" | grep -q '1 passed'; then
    good 'наблюдатель видит ОБА клиента (fetch и axios)'
  else
    bad 'СЛОМАНА: контроль наблюдателя не прошёл — перепись сети недостоверна'
    rc=1
  fi

  # Отчёт ОБЯЗАН отказаться, если контроль не отметился: иначе «ноль вызовов»
  # снова станет неотличим от слепого наблюдателя.
  rm -f /tmp/tri-net-check2.log
  printf 'ЗАГРУЖЕН\n' > /tmp/tri-net-check2.log.mark
  if ( cd "$ROOT" && NETWORK_LOG=/tmp/tri-net-check2.log \
        node scripts/report-network-tests.cjs >/dev/null 2>&1 ); then
    bad 'СЛОМАНА: отчёт посчитал ноль БЕЗ контроля — это и есть слепота'
