  # class + file, runs them by exit code (not grep). The loop's fast safety check.
  ( cd "$ROOT" && node "$TOOLS/ratchets.mjs" )
}

cmd_sweep() {
  # First step of a class-sweep: list every `await <symbol>(` call-site grouped
  # by layer and flag the ones that DISCARD the result (unbilled-paid smell).
  # A flagged site is a hypothesis -- READ it. Reports, never mutates.
