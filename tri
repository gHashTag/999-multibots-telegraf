  ( cd "$ROOT" && node scripts/probe-registries.cjs )
}

cmd_worktrees() {
  # КАКИЕ ДЕРЕВЬЯ ЗАВЕРШЕНЫ, А КАКИЕ ЕЩЁ ДЕРЖАТ РАБОТУ. НИЧЕГО НЕ УДАЛЯЕТ.
  #
  # Деревья копятся по одному на итерацию, и никто их не убирает. Померено
  # перед первой уборкой: 25 деревьев на 25 веток. Это не просто беспорядок:
  # устаревшее дерево -- окружение, в котором можно измерить устаревший ответ.
  # Итерация 156 потеряла на этом цикл: «регрессия на чистом main», которой не
  # было нигде, кроме одного старого дерева.
  #
  # ВОПРОС ОБЯЗАН СОВПАДАТЬ СО СПОСОБОМ СЛИЯНИЯ. Здесь сливают squash, а squash
  # создаёт НОВЫЙ коммит -- вершина ветки НИКОГДА не станет предком main.
  # Поэтому `git merge-base --is-ancestor` отвечает «не влито» про КАЖДУЮ
  # законченную ветку: первая перепись так и сказала про 21 из 22, а вопрос к
  # GitHub о влитых PR перевернул ответ полностью.
  #
  # Печатает команды удаления, но не исполняет их. Дерево с несохранённой
  # работой не предлагается НИКОГДА, даже если его PR влит.
  ( cd "$ROOT" && node scripts/probe-worktrees.cjs "$@" )
}

cmd_cache() {
  # КУДА НА САМОМ ДЕЛЕ ЛОЖИТСЯ КЭШ VITE ЭТОГО ДЕРЕВА.
  #
  # По умолчанию Vite кладёт cacheDir в <корень>/node_modules/.vite. В worktree
  # node_modules -- СИМЛИНК в главный чекаут, поэтому путь разрешается В ГЛАВНЫЙ
  # ЧЕКАУТ, и все деревья пишут в ОДИН кэш. Померено: 25 деревьев на 25 ветках.
  #
  # Разделяемое изменяемое состояние между ветками там, где одновременно
  # работают несколько агентов. Печатается РЕАЛЬНЫЙ путь, потому что весь
  # дефект в том, что путь внутри дерева разрешается наружу: сравнение строк из
  # конфига прошло бы и при живой ошибке.
  ( cd "$ROOT" && node -e '
    const fs = require("fs"), path = require("path")
    const root = fs.realpathSync(process.cwd())
    const show = (label, p) => {
      const real = fs.existsSync(p) ? fs.realpathSync(p) : null
      const inside = real && real.startsWith(root)
      console.log("  " + label)
      console.log("      путь:    " + p)
      console.log("      реально: " + (real || "(не создан)"))
      if (real) console.log("      " + (inside ? "внутри дерева -- свой" : "СНАРУЖИ -- ОБЩИЙ С ДРУГИМИ ДЕРЕВЬЯМИ"))
    }
    console.log("корень дерева: " + root + "\n")
    show("настроенный (.vite-cache)", path.join(root, ".vite-cache"))
    show("умолчание Vite (node_modules/.vite)", path.join(root, "node_modules/.vite"))
  ' )
}

