cmd_unguarded() {
  # СЛЕПОЕ ПЯТНО ВОРОТ. Ворота сравнивают МНОЖЕСТВА имён: они кричат, когда имя
  # ПРОПАЛО из снимка. Про тест, которого в снимке НИКОГДА НЕ БЫЛО, сказать
  # нечего — пропасть он не может. Такой тест зелёный, полезный и никем не
  # охраняемый: сломай его завтра, и ворота промолчат.
  #
  # Так вышло с PR #1696: пять тестов влились и остались вне снимка на целую
  # итерацию. Нашлось по расхождению «+11, а добавлено 6».
  #
  # ПОЧЕМУ ЗДЕСЬ ДВА ЧИСЛА, А НЕ ОДНО. Первая версия печатала одно: «80 из 531
  # не под охраной». Число оказалось завышено вдвое, и я успел опубликовать его
  # в дашборде и в сообщении коммита. Из тех 80 тридцать девять исключены из
  # прогона САМИМ vitest.config.ts, и там у каждого исключения записана
  # причина: у player свой раннер (bun run test:player), файлы с bun:test
  # гоняет npm run test:bun, ещё три умирают на загрузке модуля. Это не дыра в
  # охране, это другой сторож. Оставшиеся — в области корневого прогона и
  # действительно вне снимка; вот их и надо читать.
  #
  # Прогона нет, только текст. Точное пофайловое сравнение имён — tri в-гейте.
  local snap="${1:-$ROOT/.test-baseline.txt}"
  [ -f "$snap" ] || { bad "снимок не найден: $snap"; return 2; }

  git -C "$ROOT" ls-files '*.test.ts' '*.test.tsx' | sort > /tmp/tri-unguarded-all.txt
  node -e '
    const fs = require("fs");
    const root = process.argv[1], snapPath = process.argv[2];
    const snap = fs.readFileSync(snapPath, "utf8");
    const files = fs.readFileSync("/tmp/tri-unguarded-all.txt", "utf8").split("\n").filter(Boolean);
    const cfg = fs.readFileSync(root + "/vitest.config.ts", "utf8");
    const m = cfg.match(/exclude:\s*\[([\s\S]*?)\n    \],/);
    const pats = m ? [...m[1].matchAll(/'"'"'([^'"'"']+)'"'"'/g)].map(x => x[1]) : [];
    // ОДИН проход, а не цепочка замен: последовательные replace портят
    // собственный вывод — "**" превращается в ".*", после чего замена "*" на
    // "[^/]*" делает из него ".[^/]*", и шаблон перестаёт ходить вглубь.
    // Именно так 25 файлов player'"'"'а вывалились из "исключённых" и завысили
    // остаток с 41 до 67.
    const rx = p => {
      const esc = s2 => s2.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, "[^/]*");
      const joined = p.split("**").map(esc).join("\u0000");
      return new RegExp("^" + joined
        .replace(/\u0000\//g, "(?:.*/)?")
        .replace(/\u0000/g, ".*") + "$");
    };
    const excluded = [], residue = [];
    for (const f of files) {
      if (snap.includes(f + " :: ")) continue;
      (pats.some(p => rx(p).test(f)) ? excluded : residue).push(f);
    }
    for (const f of residue) console.log("  " + f);
    console.log("");
    console.log("файлов с тестами: " + files.length);
    console.log("исключены из прогона конфигом (свой раннер / мёртвые на импорте): " + excluded.length);
    console.log("В ОБЛАСТИ ПРОГОНА, но вне снимка: " + residue.length);
    process.exit(residue.length === 0 ? 0 : 1);
  ' "$ROOT" "$snap"
}

cmd_unguarded_selfcheck() {
  # ЛИНЕЙКА ОБЯЗАНА ОТВЕЧАТЬ ПО-РАЗНОМУ НА ДВУХ РЕАЛЬНЫХ СНИМКАХ.
  #
  # a937b089c — снимок сразу после мержа #1696: файл stars-secret-not-logged
  # уже в репозитории, но в снимке его НЕТ. Команда обязана его назвать.
  # Текущий снимок его содержит (обновлён в #1697) — назвать не должна.
  local f='apps/vibee-editor/render/stars-secret-not-logged.test.ts'
  local old_snap="/tmp/tri-unguarded-old-baseline.txt"
  if ! git -C "$ROOT" show a937b089c:.test-baseline.txt > "$old_snap" 2>/dev/null; then
    warn 'самопроверка пропущена: исторический снимок a937b089c недоступен'
    return 0
  fi
  local rc=0
  # ВЫВОД СНАЧАЛА В ПЕРЕМЕННУЮ, а не в конвейер. cmd_unguarded возвращает 1,
  # КОГДА НАХОДИТ, — это удобно для ворот, но при set -o pipefail (строка 27)
  # статус конвейера берётся от неё, а не от grep. Пайп «нашёл» читался как
  # «не нашёл», и обе половины линейки врали: вторая печатала OK всегда,
  # потому что незащищённые файлы есть ВСЕГДА. Проверка, которая не умеет
  # провалиться, ничего не проверяет.
  local out_old out_now
  out_old="$(cmd_unguarded "$old_snap" 2>/dev/null || true)"
  out_now="$(cmd_unguarded 2>/dev/null || true)"
  if printf '%s' "$out_old" | grep -qF "$f"; then
    good 'на снимке после #1696 незащищённый файл найден'
  else
    bad 'СЛОМАНА: на снимке после #1696 незащищённый файл не найден'
    rc=1
  fi
  if printf '%s' "$out_now" | grep -qF "$f"; then
    bad 'СЛОМАНА (или снимок снова отстал): файл всё ещё вне текущего снимка'
    rc=1
  else
    good 'в текущем снимке этот файл под охраной'
  fi
  # ТРЕТЬЯ ПРОВЕРКА ПИННИНГУЕТ РАЗДЕЛЕНИЕ, а не только сам список.
  # Первая версия печатала одно число (80) и была завышена вдвое: перевод
  # glob в регексп ломался на 'apps/vibee-editor/player/**', и 25 файлов
  # с собственным раннером считались незащищёнными. Регресс в переводе снова
  # раздует остаток молча, поэтому здесь: файл player'а обязан быть В
  # ИСКЛЮЧЁННЫХ (то есть НЕ в выводе), а обе доли — ненулевыми.
  local player_file
  player_file="$(git -C "$ROOT" ls-files 'apps/vibee-editor/player/**/*.test.ts*' | head -1)"
  if [ -z "$player_file" ]; then
    warn 'самопроверка раздела пропущена: у player не нашлось тестов'
  elif printf '%s' "$out_now" | grep -qF "$player_file"; then
    bad 'СЛОМАНА: файл player-раннера попал в остаток — перевод glob сломан'
    rc=1
  else
    good 'файлы своего раннера учтены как исключённые, а не как дыра'
  fi

  rm -f "$old_snap"
  return "$rc"
}

cmd_in_gate_selfcheck() {
  # ЛИНЕЙКУ ПРОВЕРЯЕМ В ОБЕ СТОРОНЫ, иначе она умеет только говорить «да».
  # Нужен файл, который гейт ОБЯЗАН видеть, и файл, который он обязан НЕ
  # видеть; проверка, отвечающая одинаково на оба, бесполезна.
  local yes no rc=0
  yes="$(cd "$ROOT" && ls src/__tests__/money/*.test.ts 2>/dev/null | head -1)"
  no="$(cd "$ROOT" && ls apps/vibee-editor/player/src/**/*.test.ts 2>/dev/null | head -1)"
  if [ -z "$yes" ] || [ -z "$no" ]; then
    warn 'самопроверка пропущена: не нашёл пару образцов (да/нет)'
    return 0
  fi
  if cmd_in_gate "$yes" >/dev/null 2>&1; then
    good "положительный образец виден гейту: $(basename "$yes")"
  else
    bad "СЛОМАНА: гейт не видит заведомо собираемый $(basename "$yes")"
    rc=1
  fi
  if cmd_in_gate "$no" >/dev/null 2>&1; then
    bad "СЛОМАНА: отвечает «да» на исключённый $(basename "$no")"
    rc=1
  else
    good "исключённый образец не виден гейту: $(basename "$no")"
  fi
  return "$rc"
}

cmd_disk() {
  # САМОВОССТАНОВЛЕНИЕ ДИСКА. Цикл делит DATA-том с чужими сессиями; когда том
  # заполняется под нуль, Bash падает с ENOSPC ещё ДО запуска команды — харнесс
  # не может создать файл вывода, и весь виток встаёт (случилось it.69). Команда
  # мерит ВЕРНЫЙ том, чистит МОИ следы и называет чужих пожирателей.
  #
  # ЛИНЕЙКА «занято» — ОТКРЫТЫЙ ДЕСКРИПТОР, а не mtime. Пойман vvp-симулятор
  # Verilog, державший 31G scratch с mtime недельной давности: жив, хотя выглядел
  # мёртвым. Поэтому reap удаляет сессию только когда lsof=0 хендлов И mtime
  # старше суток (двойная страховка; текущую сессию бережёт свежий mtime).
  local mode="${1:-}"

  # (1) ВЕРНЫЙ том. `df /` показывает запечатанный системный снапшот (почти
  # всегда «полон» и неинформативен); реальное место живёт на DATA-томе.
  paint '1;36' 'DATA-том'
  df -h /System/Volumes/Data | sed -n '1,2p'

  # (2) Мои worktree'ы. prune снимает записи, чей каталог уже исчез (безопасно).
  echo; paint '1;36' 'worktree цикла'
  git -C "$ROOT" worktree prune 2>/dev/null
  git -C "$ROOT" worktree list 2>/dev/null

  # (3) Scratch сессий. Один прогон lsof, дальше сверяем по пути открытых файлов.
  echo; paint '1;36' 'scratch сессий  (к возврату = 0 хендлов И mtime>суток)'
  local tmproot="/private/tmp/claude-$(id -u)"
  local held; held="$(lsof -Fn 2>/dev/null | grep "^n$tmproot" || true)"
  local d base sz
  for d in "$tmproot"/*/*; do
    [ -d "$d" ] || continue
    base="$(basename "$d")"
    case "$base" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*) ;;
      *) continue ;;
    esac
    sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
    if printf '%s\n' "$held" | grep -q -- "$base"; then
      skip "жива (открыт дескриптор), пропуск: $sz  $base"
    elif [ -n "$(find "$d" -maxdepth 0 -mtime +1 2>/dev/null)" ]; then
      if [ "$mode" = "reap" ] || [ "$mode" = "чисти" ]; then
        rm -rf "$d" 2>/dev/null && good "освобождено $sz  $base"
      else
        warn "мёртвая, к возврату: $sz  $base   (запусти: tri диск чисти)"
      fi
    else
      skip "свежая (<суток), пропуск: $sz  $base"
    fi
  done

  # (4) Крупные ЧУЖИЕ пожиратели — НАЗВАТЬ, но не трогать: это данные владельца,
  # а удаление данных — его решение (деструктив последним, [[debugging_doctrine]]).
  echo; paint '1;36' 'крупные пожиратели  (владельцу — сам не трогаю)'
  local p
  for p in \
    "$HOME/Library/Containers/com.docker.docker" \
    "$HOME/Library/Caches" \
    "$HOME/Library/Developer/CoreSimulator" \
    "$HOME/Library/Developer/Xcode/DerivedData"; do
    [ -e "$p" ] && du -sh "$p" 2>/dev/null
  done
}

# MERGING THE PLAYER IS NOT DEPLOYING IT, AND THE SERVICE WILL NOT TELL YOU.
#
# The vibee-editor service builds from the bot's root railway.toml, which does
# not watch apps/vibee-editor/**: a merge that only touches the player deploys
# NOTHING and the dashboard still says SUCCESS -- the previous build's success.
# The only honest signal is the bundle hash the site actually serves, so this
# reads it before, redeploys, and waits for it to CHANGE. Without that wait the
# next probe measures the old bundle and reports the fix as not working.
cmd_player_deploy () {
  local origin="${PLAYER_ORIGIN:-https://app.t27.ai}"
  local before after waited=0
  before="$(curl -s -m 20 "$origin/" | grep -oE 'assets/index-[A-Za-z0-9_-]+\.js' | head -1)"
  [ -n "$before" ] || { bad "cannot read the live bundle from $origin"; return 1; }
  printf '  live now: %s\n' "$before"
  if [ "${1:-}" = "--check" ]; then return 0; fi
  # DO NOT SWALLOW THE ERROR. The first version sent stderr to /dev/null and
  # printed "railway redeploy failed", which is the same amount of information
  # as silence: the real cause was that the Railway link lives in the main
  # checkout, and this ran from a worktree. A command that hides its own
  # diagnosis makes the next person re-discover it.
  local out
  if ! out="$(railway redeploy --service vibee-editor --from-source -y 2>&1)"; then
    bad "railway redeploy failed:"
    printf '%s\n' "$out" | tail -5
    warn "the Railway link is per-directory; run this from the main checkout, not a worktree"
    return 1
  fi
  printf '  redeploy requested, waiting for the served bundle to change\n'
  while [ "$waited" -lt 900 ]; do
    sleep 20; waited=$((waited + 20))
    after="$(curl -s -m 20 "$origin/" | grep -oE 'assets/index-[A-Za-z0-9_-]+\.js' | head -1)"
    if [ -n "$after" ] && [ "$after" != "$before" ]; then
      good "deployed: $before -> $after (${waited}s)"
      return 0
    fi
  done
  bad "the served bundle is still $before after ${waited}s -- the deploy did not land"
  return 1
}

action="${1:-помощь}"
# THE SHIFT IS WHY SUBCOMMANDS FORWARD "$@" AND NOT "${@:2}".
#
# After it, $1 is already the first argument AFTER the subcommand, so "${@:2}"
# drops that argument. Twelve subcommands did exactly that, and it was invisible
# because every one of them was TESTED BY CALLING ITS SCRIPT DIRECTLY: the flag
# reached the script every time it was tried, and never when it was used.
#
# Measured cost: `tri ledger --gate` shipped as a gate and forwarded nothing,
# so the flag whose red path was proven a day earlier never arrived.
shift 2>/dev/null || true

# --- tri secrets ---------------------------------------------------------
#
# SCAN THE PLACES NOTHING ELSE LOOKS.
#
# Two credential leaks landed on one machine on one day, and NEITHER was in the
# repository: one was a session log, the other two `railway variables` dumps in
# a scratchpad. Every guard we own reads the repo or the diff, so both were
# invisible to all of them.
#
# Deliberately NOT a pre-push hook. Measured on this repository: 44 matches,
# tightened to 16, and every one of the 16 is a placeholder in a doc, an
# .example file or a deploy script -- zero real. A gate that stops a push
# sixteen times for nothing gets removed in a day, and a scanner people have
# removed catches nothing at all.
#
# NAMED secrets-on-disk, NOT secrets: the short Russian alias was already taken
# by secrets-audit further down the same `case`, and an arm placed earlier steals
# it silently -- the dispatcher takes the first match and says nothing.
#
#   tri secrets-on-disk            scans the temp roots where dumps land
#   tri secrets-on-disk <dir>...   scans what you name
cmd_secrets() {
  local roots=("$@")
  if [ ${#roots[@]} -eq 0 ]; then
    # Where an agent's working files actually live on this machine.
    roots=()
    [ -n "${TMPDIR:-}" ] && roots+=("${TMPDIR%/}")
    [ -d /tmp ] && roots+=(/tmp)
    if [ ${#roots[@]} -eq 0 ]; then
      bad "нечего сканировать: задайте каталог явно"
      return 2
    fi
    say "каталоги по умолчанию: ${roots[*]}"
    say "репозиторий сюда НЕ входит — там смотрят другие охраны"
  fi
  node "$ROOT/scripts/scan-secrets-on-disk.cjs" "${roots[@]}"
}

# ─────────────────────────────────────────────────────────────────────────
# tri voice: the voice mode end to end, measured instead of believed.
#
# "The voice works" was said four times in one night (2026-10-01) and each
# time something else was wrong: the models were cold (10 s to the first
# word), the Russian sentence went to an English voice, the answer read card
# markup aloud. Each of those is a number this command prints. The round trip
# (our own TTS -> our own whisper) is the one check that needs no microphone
# and still proves both ears and mouth are the ones a person gets.
# ─────────────────────────────────────────────────────────────────────────
cmd_voice() {
  local key runs=3
  case "${1:-}" in --runs) runs="${2:-3}" ;; --runs=*) runs="${1#--runs=}" ;; esac
  [[ "$runs" =~ ^[1-9][0-9]?$ ]] || { bad "--runs takes 1..99, not '$runs'"; return 2; }
  key=$(_mcp_key 2>/dev/null) || key=''
  V_KEY="$key" V_BASE="$RENDER" V_RUNS="$runs" V_ROAD_ONLY="${V_ROAD_ONLY:-}" \
    V_FILLER="${V_FILLER:-}" V_LANGUAGE="$ROOT/apps/vibee-editor/player/src/atoms/language.ts" \
    V_SESSION="$ROOT/apps/vibee-editor/player/src/lib/voice/session.ts" python3 -u - <<'PY'
import json, os, re, statistics, sys, time, urllib.error, urllib.request

base, key = os.environ['V_BASE'], os.environ['V_KEY']
RUNS = int(os.environ['V_RUNS'])

# The person's wait is not the round trip alone: first the player judges the
# pause (END_OF_TURN_MS), and since voice-loop-4 it asks for the words after
# EAGER_HEAR_MS of it, so that much of the hearing hides inside the pause.
# Read from the player itself -- a copy here would drift from it.
def player_ms(name):
    try:
        src = open(os.environ['V_SESSION']).read()
    except OSError:
        return None
    m = re.search(r'const ' + name + r' = ([0-9_]+)', src)
    return int(m.group(1).replace('_', '')) if m else None
END_MS, EAGER_MS = player_ms('END_OF_TURN_MS'), player_ms('EAGER_HEAR_MS')

last_timing = {}
def server_timing(h):
    # 'read;dur=12, hear;dur=2100;desc="gigaam"'
    #   -> {'read': 12, 'hear': 2100, 'hear.desc': 'gigaam'}
    # Parameters are split on ';' -- reading "dur=" to the end of the entry
    # dropped every timing the moment the render added a desc.
    out = {}
    for part in (h or '').split(','):
        name, *params = [p.strip() for p in part.split(';')]
        for p in params:
            k, _, v = p.partition('=')
            if k == 'dur':
                try:
                    out[name] = int(float(v))
                except ValueError:
                    pass
            elif k == 'desc':
                out[name + '.desc'] = v.strip('"')
    return out

# ONE connection for every call, the way a browser keeps one. urllib opened
# a new one per request, so every "road" it reported carried a fresh DNS +
# TCP + TLS (150-400 ms) that a person in the app pays once, not per phrase
# (cycle 7). The handshake is now measured on its own, below.
from urllib.parse import urlsplit
import http.client, socket
u = urlsplit(base)
conn = None
def connect():
    global conn
    if conn:
        conn.close()
    Conn = http.client.HTTPSConnection if u.scheme == 'https' else http.client.HTTPConnection
    conn = Conn(u.hostname, u.port, timeout=240)
    t = time.monotonic()
    try:
        socket.getaddrinfo(u.hostname, u.port or 443)
        dns = int((time.monotonic() - t) * 1000)
        conn.connect()
    except Exception:
        return None, None
    return dns, int((time.monotonic() - t) * 1000) - dns

last_timing, last_headers = {}, {}
def call(path, body=None, ctype='application/json', timeout=90, retry=True):
    data = body if isinstance(body, (bytes, type(None))) else json.dumps(body).encode()
    headers = {}
    if data is not None:
        headers['Content-Type'] = ctype
    if key:
        headers['X-Agent-Key'] = key
    global last_timing, last_headers
    last_timing, last_headers = {}, {}
    if conn is None:
        connect()
    conn.timeout = timeout
    if conn.sock:
        conn.sock.settimeout(timeout)
    t = time.monotonic()
    try:
        conn.request('POST' if data is not None else 'GET', u.path.rstrip('/') + path, body=data, headers=headers)
        r = conn.getresponse()
        out = r.read()
    except (http.client.RemoteDisconnected, BrokenPipeError, ConnectionResetError, http.client.CannotSendRequest) as e:
        # The edge closed an idle connection: open a new one and say nothing
        # -- that is what a browser does too.
        if retry:
            connect()
            return call(path, body, ctype, timeout, False)
        return 0, str(e).encode(), int((time.monotonic() - t) * 1000)
    except Exception as e:
        connect()
        return 0, str(e).encode(), int((time.monotonic() - t) * 1000)
    last_timing = server_timing(r.getheader('Server-Timing'))
    last_headers = {k.lower(): v for k, v in r.getheaders()}
    return r.status, out, int((time.monotonic() - t) * 1000)

worst = 0
def mark(level):
    global worst
    worst = max(worst, level)

# THE ROAD, split (cycle 7): the handshake a new connection pays, then the
# round trip a warm one still pays -- the edge reaching the render and back.
# On 2026-10-02 the edge was sin1 (Singapore) and the render ran in sfo:
# ~250 ms warm, on every call, even for this empty status.
dns, tls = connect()
code, body, ms = call('/api/voice/status')
if code != 200:
    why = body[:120].decode(errors='replace') if code == 0 else f'HTTP {code}'
    print(f'  status: {why} -- the voice routes did not answer')
    sys.exit(3)
st = json.loads(body)
pings = [ms] + [call('/api/voice/status')[2] for _ in range(4)]
ping = int(statistics.median(pings))
edge = last_headers.get('x-railway-edge', '?')
if dns is not None:
    print(f'  road: edge {edge}, new connection {dns + tls} ms (dns {dns} + tcp/tls {tls}), '
          f'warm round trip {ping} ms [{min(pings)}..{max(pings)}] -- every call pays the warm one')
if ping >= 400:
    print('  road: SLOW -- the warm round trip alone is 0.4 s; is the render far from this edge? (tri road)')
    mark(2)
if os.environ.get('V_ROAD_ONLY'):
    sys.exit(worst)
print(f"  status: hear={st.get('hear')} (ru via {st.get('hearRu', 'whisper')}, en via {st.get('hearEn', 'whisper')}) speak={st.get('speak')} (via {st.get('speakVia', 'speaches')}) "
      f"voices ru={len(st.get('voices', {}).get('ru', []))} en={len(st.get('voices', {}).get('en', []))}")
if not (st.get('hear') and st.get('speak')):
    mark(1)
if not key:
    print('  no agent key: only the public status was read (NOT MEASURED past it)')
    sys.exit(2)

code, body, ms = call('/api/voice/warm', {'lang': 'ru'})
if code == 401:
    print('  warm: 401 -- this key is not a person; voice routes need one')
    sys.exit(2)
print(f'  warm ru: HTTP {code} {body[:80].decode(errors="replace")} in {ms} ms')
if code != 200:
    mark(1)

# THE WAIT SAID OUT LOUD (cycle 9). The player asks for a wait phrase's
# audio FILLER_PREPARE_MS into the thinking and plays it at FILLER_FIRST_MS
# (FILLER_STILL_MS for "still working"): the synthesis has to fit in between,
# or "Let me see." arrives late -- or after the answer it was covering for.
# The phrases are read from the player's dictionary, so a new variant is
# measured the day it lands. Each is synthesised once, as the player does.
FIRST, STILL, PREP = (player_ms(n) for n in ('FILLER_FIRST_MS', 'FILLER_STILL_MS', 'FILLER_PREPARE_MS'))
try:
    lang_src = open(os.environ['V_LANGUAGE'], encoding='utf-8').read()
except OSError:
    lang_src = ''
ru_at = lang_src.find('const ru: Translations')
waits = {}
for m in re.finditer(r"'voice\.filler\.(first|still)':\s*'([^']*)'", lang_src):
    lang = 'ru' if ru_at >= 0 and m.start() > ru_at else 'en'
    waits.setdefault((lang, m.group(1)), []).extend(m.group(2).split('|'))
if not (FIRST and PREP and waits):
    print('  wait phrases: not found in the player (FILLER_* or voice.filler.*) -- NOT MEASURED')
    mark(2)
for (lang, kind), texts in sorted(waits.items()):
    lead = (FIRST if kind == 'first' else STILL) - PREP
    times, parts = [], []
    for text in texts:
        code, body, ms = call('/api/voice/speak', {'text': text, 'lang': lang})
        if code != 200 or len(body) <= 1000:
            print(f'  wait {lang} "{text}": HTTP {code} -- the player falls back to the device voice')
            mark(1)
            continue
        times.append(ms)
        # Where the time went: the engine's own, or the road to it (cycle 10:
        # a cold first English phrase took 4.4 s -- engine or road?).
        eng = last_timing.get('speak')
        parts.append(f"{ms}={last_timing.get('speak.desc', '?')} {eng}+road {ms - eng}" if eng is not None else f'{ms}=?')
    if not times:
        continue
    late = max(times) > lead
    print(f'  wait {lang} {kind}: {len(times)} phrases, synth {min(times)}..{max(times)} ms, '
          f'lead {lead} ms -- {"LATE (not ready at its moment: the session skips it)" if late else "ok"}')
    print(f'      each: {"; ".join(parts)}')
    # The player gives each sentence speakDeadlineMs(chars) before the
    # device's voice reads it instead (cycle 10). Read from the source, so a
    # new deadline is checked the day it lands.
    try:
        session_src = open(os.environ['V_SESSION']).read()
    except OSError:
        session_src = ''
    dl = re.search(r'function speakDeadlineMs[^{]*\{\s*return (\d[\d_]*) \+ (\d+) \* chars', session_src)
    if dl:
        base, per = int(dl.group(1).replace('_', '')), int(dl.group(2))
        tight = [t for t, ms in zip(texts, times) if ms * 2 > base + per * len(t)]
        if tight:
            print(f'      deadline: {len(tight)} phrase(s) used over half of the player\'s speak deadline -- the device voice is near')
            mark(2)
    if late:
        mark(2)
if os.environ.get('V_FILLER'):
    sys.exit(worst)

# The same two phrases every run, so the timings compare across days.
phrases = {'ru': 'Проверка голоса: раз, два, три, четыре.',  # cyrillic-ok: the phrase IS the probe
           'en': 'Voice check: one, two, three, four.'}
audio = {}
# Speaking gets a median too: in cycle 5 one 4.6 s sample called English
# TTS "SLOW" when five more measured 2.0-2.5 s with a single 4.4 s tail.
SPEAK_RUNS = min(RUNS, 3)
for lang, text in phrases.items():
    times, engines, engine_ms = [], set(), []
    for _ in range(SPEAK_RUNS):
        code, body, ms = call('/api/voice/speak', {'text': text, 'lang': lang})
        if code != 200 or len(body) <= 1000:
            break
        audio.setdefault(lang, []).append(body)
        times.append(ms)
        engines.add(last_timing.get('speak.desc', '?'))
        if 'speak' in last_timing:
            engine_ms.append(last_timing['speak'])
    if len(times) == SPEAK_RUNS:
        med = int(statistics.median(times))
        verdict = 'ok' if med < 3000 else 'SLOW (the first word waits for this)'
        inside = f', engine {int(statistics.median(engine_ms))} ms' if engine_ms else ''
        print(f'  speak {lang}: {len(body)} bytes via {"/".join(sorted(engines))}, '
              f'median {med} ms{inside} of {len(times)} [{min(times)}..{max(times)}] -- {verdict}')
        if med >= 3000:
            mark(2)
        # The mouth is configured but speaches answered: it is down or
        # refusing, and every sentence is paying for the fallback (cycle 6).
        if st.get('speakVia') == 'mouth' and engines != {'mouth'}:
            print(f'  speak {lang}: ANOMALY -- the mouth is configured but {"/".join(sorted(engines))} spoke (tri ears mouth)')
