#!/bin/bash
################################################################################
# 🔒 PRE-COMMIT HOOK: Защита от изменения портов в docker-compose.yml
#
# Проверяет что nginx слушает ТОЛЬКО на стандартных портах 443:443 и 80:80
# Блокирует коммит если порты изменены на нестандартные (8443:443, 8080:80)
################################################################################

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Проверка docker-compose.yml..."

# Проверяем изменен ли docker-compose.yml в этом коммите
if git diff --cached --name-only | grep -q "docker-compose.yml"; then
    echo "📝 docker-compose.yml изменен, запускаем валидацию..."

    # Извлекаем порты из staged версии файла (проверяем diff, а не сам файл)
    DIFF_OUTPUT=$(git diff --cached docker-compose.yml)

    # Проверяем только если в diff есть изменения в секции портов
    if echo "$DIFF_OUTPUT" | grep -q "ports:"; then
        STAGED_PORTS=$(echo "$DIFF_OUTPUT" | grep -A 10 "container_name: bot-proxy" | grep "ports:" -A 5)
    else
        echo "ℹ️  Секция портов не изменена, пропускаем проверку"
        STAGED_PORTS=""
    fi

    # Проверяем на нестандартные порты (только если STAGED_PORTS не пуст)
    if [ -n "$STAGED_PORTS" ] && echo "$STAGED_PORTS" | grep -qE "(8443:443|8080:80)"; then
        echo -e "${RED}❌ ОШИБКА: Обнаружены нестандартные порты в docker-compose.yml!${NC}"
        echo ""
        echo -e "${YELLOW}Найдены следующие проблемы:${NC}"
        echo "$STAGED_PORTS" | grep -E "(8443:443|8080:80)" || true
        echo ""
        echo -e "${RED}NGINX ДОЛЖЕН СЛУШАТЬ НА СТАНДАРТНЫХ ПОРТАХ:${NC}"
        echo "  ✅ 443:443 (HTTPS)"
        echo "  ✅ 80:80   (HTTP)"
        echo ""
        echo -e "${RED}НЕЛЬЗЯ ИСПОЛЬЗОВАТЬ:${NC}"
        echo "  ❌ 8443:443 (ломает webhooks!)"
        echo "  ❌ 8080:80  (ломает webhooks!)"
        echo ""
        echo -e "${YELLOW}Причина:${NC} Kie.ai, Replicate и другие сервисы отправляют webhooks"
        echo "на стандартные порты. Нестандартные порты = сломанные webhooks!"
        echo ""
        echo "📖 См. WEBHOOK_TROUBLESHOOTING.md для подробностей"
        exit 1
    fi

    # Проверяем что указаны ПРАВИЛЬНЫЕ порты (только если порты изменялись)
    if [ -n "$STAGED_PORTS" ]; then
        if ! echo "$STAGED_PORTS" | grep -qE "443:443"; then
            echo -e "${RED}❌ ОШИБКА: Порт 443:443 (HTTPS) не найден!${NC}"
            echo "Nginx ДОЛЖЕН слушать на стандартном HTTPS порту 443"
            exit 1
        fi

        if ! echo "$STAGED_PORTS" | grep -qE "80:80"; then
            echo -e "${RED}❌ ОШИБКА: Порт 80:80 (HTTP) не найден!${NC}"
            echo "Nginx ДОЛЖЕН слушать на стандартном HTTP порту 80"
            exit 1
        fi

        echo -e "${GREEN}✅ docker-compose.yml валиден - порты правильные (443:443, 80:80)${NC}"
    fi
else
    echo "ℹ️  docker-compose.yml не изменен, пропускаем валидацию"
fi

# Валидация docker-compose синтаксиса
echo "🔍 Проверка синтаксиса docker-compose..."
if command -v docker &> /dev/null; then
    if docker compose -f docker-compose.yml config > /dev/null 2>&1; then
        echo -e "${GREEN}✅ docker-compose.yml синтаксически корректен${NC}"
    else
        echo -e "${RED}❌ ОШИБКА: docker-compose.yml содержит синтаксические ошибки!${NC}"
        docker compose -f docker-compose.yml config
        exit 1
    fi
else
    echo -e "${YELLOW}⚠️  Docker не установлен, пропускаем синтаксическую проверку${NC}"
fi

echo -e "${GREEN}✅ Все проверки пройдены успешно!${NC}"
exit 0
