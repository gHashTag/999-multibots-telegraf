{
  "name": "neuro-blogger-telegram-bot",
  "version": "0.0.1",
  "description": "Telegram bot for generating blog posts using AI",
  "main": "src/bot.ts",
  "scripts": {
    "prestart": "./scripts/sync-env.sh",
    "start": "bun run dist/bot.js",
    "predev": "./scripts/sync-env.sh && pkill -f 'bun.*src/bot.ts' || true && node scripts/kill-port.cjs 2999 3001 8288",
    "dev": "bun --watch src/bot.ts",
    "build": "bun run build:ts && bun run build:alias",
    "build:ts": "tsc",
    "build:alias": "tsc-alias",
    "build:prod": "tsc -p tsconfig.prod.json && bun run build:alias",
    "build:nocheck": "tsc --skipLibCheck --skipDefaultLibCheck && bun run build:alias",
    "test": "bun test",
    "test:vitest": "cross-env SUPABASE_URL=TEST_URL SUPABASE_SERVICE_KEY=TEST_KEY bun run vitest",
    "test:enhanced-neurophoto": "npx tsx tests/run-enhanced-neurophoto-tests.ts",
    "test:neurophoto-core": "npm run test:vitest -- tests/neurophoto-enhanced.test.ts",
    "test:neurophoto-performance": "npm run test:vitest -- tests/neurophoto-performance.test.ts",
    "test:neurophoto-security": "npm run test:vitest -- tests/neurophoto-security.test.ts",
    "test:hero-validation": "npm run test:vitest -- tests/hero-validation-integration.test.ts",
    "lint": "bunx eslint . --ext .ts",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:translations": "bun run scripts/check_ai_stars_translations.ts",
    "generate:translations-sql": "bun run scripts/check_ai_stars_translations.ts --generate-sql",
    "build:production": "bun install && bun run build:nocheck",
    "check:build": "./scripts/check-build-health.sh",
    "check:quick": "./scripts/quick-build-check.sh",
    "check:merge": "./scripts/pre-merge-check.sh",
    "deploy:production": "chmod +x scripts/deploy-production.sh && ./scripts/deploy-production.sh",
    "deploy": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh",
    "webhook:setup": "bun run src/utils/webhook-setup-cli.ts",
    "webhook:verify": "bun run src/utils/webhook-verify-cli.ts",
    "env:validate": "bun run src/utils/env-validator.ts validate",
    "env:template": "bun run src/utils/env-validator.ts template",
    "env:audit": "bun run src/utils/env-validator.ts audit",
    "docker:build": "chmod +x scripts/build-and-push.sh && ./scripts/build-and-push.sh",
    "docker:push": "chmod +x scripts/build-and-push.sh && ./scripts/build-and-push.sh --push",
    "health:check": "chmod +x scripts/health-monitor.sh && ./scripts/health-monitor.sh check",
    "health:monitor": "chmod +x scripts/health-monitor.sh && ./scripts/health-monitor.sh monitor",
    "health:rollback": "chmod +x scripts/health-monitor.sh && ./scripts/health-monitor.sh rollback",
    "deploy:manual": "chmod +x scripts/manual-deploy.sh && ./scripts/manual-deploy.sh",
    "deploy:check": "chmod +x scripts/js-error-check.sh && ./scripts/js-error-check.sh",
    "deploy:check:quick": "chmod +x scripts/js-error-check.sh && ./scripts/js-error-check.sh --quick",
    "deploy:check:fix": "chmod +x scripts/js-error-check.sh && ./scripts/js-error-check.sh --fix",
    "webhook:server": "node scripts/webhook-deploy-server.js",
    "security:scan": "chmod +x scripts/security-token-guard.sh && ./scripts/security-token-guard.sh",
    "security:history": "chmod +x scripts/git-history-security-scan.sh && ./scripts/git-history-security-scan.sh",
    "security:full": "npm run security:scan && npm run security:history",
    "report:financial": "npx tsx scripts/generateFinancialReport.ts",
    "report:test": "npx tsx scripts/testExcelGenerator.ts",
    "report:monthly": "npx tsx scripts/generateFinancialReport.ts -m",
    "report:bot": "npx tsx scripts/generateFinancialReport.ts -b",
    "logs": "node scripts/logs-monitor.js",
    "logs:follow": "node scripts/logs-monitor.js --follow",
    "logs:no-fix": "node scripts/logs-monitor.js --no-fix",
    "logs:tail": "node scripts/logs-monitor.js --tail=200",
    "test:model": "npx tsx tests/video-models-test.ts",
    "test:models:validate": "npx tsx tests/video-models-test.ts validate",
    "test:models:webhooks": "npx tsx tests/video-models-test.ts webhooks",
    "test:models:batch": "npx tsx tests/video-models-test.ts batch"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fal-ai/client": "^1.7.0",
    "@fastify/express": "^4.0.2",
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.39.3",
    "@types/pg": "^8.15.4",
    "adm-zip": "^0.5.16",
    "apify-client": "^2.12.5",
    "archiver": "^7.0.0",
    "axios": "1.8.2",
    "bcrypt": "^5.1.1",
    "commander": "^14.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "elevenlabs": "^0.16.1",
    "envalid": "^7.3.1",
    "face-api.js": "^0.22.2",
    "canvas": "^2.11.2",
    "@tensorflow/tfjs-node": "^4.20.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.4.3",
    "express-rate-limit": "^8.0.1",
    "express-serve-static-core": "^0.1.1",
    "fastify": "^5.3.2",
    "form-data": "^4.0.0",
    "inngest": "^2.7.2",
    "jest-mock": "^29.7.0",
    "md5": "^2.3.0",
    "multer": "^2.0.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.24.7",
    "pg": "^8.16.3",
    "pinata-web3": "^0.5.4",
    "qs": "^6.11.2",
    "replicate": "^0.25.2",
    "telegraf": "4.16.3",
    "tsc-alias": "^1.8.8",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "yt-dlp-wrap": "^2.3.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/express-fileupload": "^1.5.1",
    "@types/jest": "^29.5.14",
    "@types/md5": "^2.3.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.5.2",
    "@types/node-fetch": "^2.6.12",
    "@types/qs": "^6.9.18",
    "@types/uuid": "^10.0.0",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "nodemon": "^2.0.22",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
