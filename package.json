{
  "name": "vibee",
  "version": "0.1.0",
  "description": "VIBEE - AI-powered Telegram bot platform",
  "main": "src/bot.ts",
  "scripts": {
    "prestart": "./scripts/worktree-env-sync.sh",
    "start": "bun run dist/index.js",
    "predev": "./scripts/worktree-env-sync.sh && pkill -f 'bun.*src/index.ts' || true && node scripts/kill-port.cjs 2999 3001 8288",
    "dev": "bun --watch src/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:3001": "cloudflared tunnel --url http://localhost:3001",
    "mobile": "cd mobile && npm start",
    "mobile:install": "cd mobile && npm install",
    "mobile:android": "cd mobile && npm run android",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:web": "cd mobile && npm run web",
    "start:all": "chmod +x scripts/start-all.sh && ./scripts/start-all.sh",
    "env:sync": "./scripts/worktree-env-sync.sh",
    "env:fix": "./scripts/fix-env.sh",
    "env:watch": "./scripts/env-watcher.sh",
    "env:setup": "./scripts/setup-worktree-hooks.sh",
    "build": "bun run typecheck && bun run build:ts && bun run build:alias",
    "build:ts": "tsc",
    "build:alias": "tsc-alias",
    "build:prod": "bun run typecheck && tsc -p tsconfig.prod.json && bun run build:alias",
    "build:nocheck": "tsc --skipLibCheck --skipDefaultLibCheck && bun run build:alias",
    "test": "cross-env SUPABASE_URL=TEST_URL SUPABASE_SERVICE_KEY=TEST_KEY bun run vitest",
    "test:bun": "bun test",
    "test:gate": "node scripts/test-gate.cjs",
    "test:gate:save": "node scripts/test-gate.cjs --save",
    "test:enhanced-neurophoto": "npx tsx tests/run-enhanced-neurophoto-tests.ts",
    "test:inngest": "cd src/inngest_app && vitest run",
    "test:inngest:unit": "cd src/inngest_app && vitest run test/unit",
    "test:inngest:integration": "cd src/inngest_app && vitest run test/integration",
    "test:inngest:coverage": "cd src/inngest_app && vitest run --coverage",
    "test:inngest:mcp": "cd src/inngest_app && vitest run test/mcp",
    "test:inngest:mcp:watch": "cd src/inngest_app && vitest test/mcp",
    "test:mcp": "npx tsx src/inngest_app/test-mcp.ts",
    "inngest:dev": "npx inngest-cli@latest dev",
    "inngest:mcp-server": "bun run src/inngest_app/mcp-server.ts",
    "test:neurophoto-core": "npm run test:vitest -- tests/neurophoto-enhanced.test.ts",
    "test:neurophoto-performance": "npm run test:vitest -- tests/neurophoto-performance.test.ts",
    "test:neurophoto-security": "npm run test:vitest -- tests/neurophoto-security.test.ts",
    "test:hero-validation": "npm run test:vitest -- tests/hero-validation-integration.test.ts",
    "lint": "bunx eslint . --ext .ts",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:translations": "bun run scripts/check_ai_stars_translations.ts",
    "test:webhook-health": "npx ts-node tests/test-webhook-endpoint-health.ts",
    "generate:translations-sql": "bun run scripts/check_ai_stars_translations.ts --generate-sql",
    "build:production": "bun install && bun run build:nocheck",
    "check:build": "./scripts/check-build-health.sh",
    "check:quick": "./scripts/quick-build-check.sh",
    "check:merge": "./scripts/pre-merge-check.sh",
    "deploy:production": "npm run deploy",
    "deploy": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh",
    "webhook:setup": "bun run src/utils/webhook-setup-cli.ts",
    "webhook:verify": "bun run src/utils/webhook-verify-cli.ts",
    "env:validate": "bun run src/utils/env-validator.ts validate",
    "env:template": "bun run src/utils/env-validator.ts template",
    "env:audit": "bun run src/utils/env-validator.ts audit",
    "docker:build": "chmod +x scripts/build-and-push.sh && ./scripts/build-and-push.sh",
    "docker:push": "chmod +x scripts/build-and-push.sh && ./scripts/build-and-push.sh --push",
    "health:check": "chmod +x scripts/health-monitor.sh && ./scripts/health-monitor.sh check",
    "health:monitor": "chmod +x scripts/health-monitor.sh && ./scripts/health-monitor.sh monitor",
    "health:rollback": "chmod +x scripts/health-monitor.sh && ./scripts/health-monitor.sh rollback",
    "deploy:manual": "chmod +x scripts/manual-deploy.sh && ./scripts/manual-deploy.sh",
    "deploy:check": "chmod +x scripts/js-error-check.sh && ./scripts/js-error-check.sh",
    "deploy:check:quick": "chmod +x scripts/js-error-check.sh && ./scripts/js-error-check.sh --quick",
    "deploy:check:fix": "chmod +x scripts/js-error-check.sh && ./scripts/js-error-check.sh --fix",
    "webhook:server": "node scripts/webhook-deploy-server.js",
    "security:scan": "chmod +x scripts/security-token-guard.sh && ./scripts/security-token-guard.sh",
    "security:history": "chmod +x scripts/git-history-security-scan.sh && ./scripts/git-history-security-scan.sh",
    "security:full": "npm run security:scan && npm run security:history",
    "report:financial": "npx tsx scripts/generateFinancialReport.ts",
    "report:test": "npx tsx scripts/testExcelGenerator.ts",
    "report:monthly": "npx tsx scripts/generateFinancialReport.ts -m",
    "report:bot": "npx tsx scripts/generateFinancialReport.ts -b",
    "logs": "node scripts/logs-monitor.js",
    "logs:follow": "node scripts/logs-monitor.js --follow",
    "logs:no-fix": "node scripts/logs-monitor.js --no-fix",
    "logs:tail": "node scripts/logs-monitor.js --tail=200",
    "test:glm": "npx tsx scripts/test-glm-provider.ts",
    "test:infisical": "npx tsx scripts/infisical/check-infisical-keys.ts",
    "test:model": "npx tsx tests/video-models-test.ts",
    "test:models:validate": "npx tsx tests/video-models-test.ts validate",
    "test:models:webhooks": "npx tsx tests/video-models-test.ts webhooks",
    "test:models:batch": "npx tsx tests/video-models-test.ts batch",
    "user:check-models": "bun run scripts/users/check-user-models.ts",
    "user:check-models:remote": "chmod +x scripts/users/check-models-remote.sh && ./scripts/users/check-models-remote.sh",
    "user:force-exit": "bun run scripts/users/force-exit-scene.ts",
    "check:events": "node scripts/orphan-events.cjs",
    "check:dead-domain": "node scripts/check-dead-domain.cjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:network": "DETECT_NETWORK=1 vitest run --silent && node scripts/report-network-tests.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fal-ai/client": "^1.7.0",
    "@infisical/sdk": "^4.0.6",
    "@mtproto/core": "^6.3.0",
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.39.3",
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.1.0",
    "@types/archiver": "^7.0.0",
    "@types/pg": "^8.15.4",
    "@types/ssh2": "^1.15.5",
    "apify-client": "^2.12.5",
    "archiver": "^7.0.1",
    "axios": "1.8.2",
    "commander": "^14.0.1",
    "dotenv": "^16.3.1",
    "elevenlabs": "^0.16.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "form-data": "^4.0.0",
    "inngest": "^3.54.0",
    "io-ts": "^2.2.22",
    "jest-mock": "^29.7.0",
    "md5": "^2.3.0",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "openai": "^4.24.7",
    "pg": "^8.16.3",
    "readline-sync": "^1.4.10",
    "replicate": "^0.25.2",
    "ssh2": "^1.17.0",
    "telegraf": "4.16.3",
    "telegram": "^2.26.22",
    "tsc-alias": "^1.8.8",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "x402-express": "^0.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.9",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@ngrok/ngrok": "^1.5.2",
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.2",
    "@types/md5": "^2.3.5",
    "@types/node": "20",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  }
}