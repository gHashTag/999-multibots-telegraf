{
  "name": "vibee",
  "version": "0.1.0",
  "description": "VIBEE - AI-powered Telegram bot platform",
  "main": "src/bot.ts",
  "scripts": {
    "build": "bun run typecheck && bun run build:ts && bun run build:alias",
    "build:alias": "tsc-alias",
    "build:nocheck": "tsc --skipLibCheck --skipDefaultLibCheck && bun run build:alias",
    "build:prod": "bun run typecheck && tsc -p tsconfig.prod.json && bun run build:alias",
    "build:production": "bun install && bun run build:nocheck",
    "build:ts": "tsc",
    "check:dead-domain": "node scripts/check-dead-domain.cjs",
    "check:player-types": "node scripts/check-player-types.cjs",
    "check:events": "node scripts/orphan-events.cjs",
    "dashboard": "node scripts/dashboard.cjs",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy:production": "npm run deploy",
    "dev": "bun --watch src/index.ts",
    "env:audit": "bun run src/utils/env-validator.ts audit",
    "env:sync": "./scripts/worktree-env-sync.sh",
    "env:template": "bun run src/utils/env-validator.ts template",
    "env:validate": "bun run src/utils/env-validator.ts validate",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "inngest:dev": "npx inngest-cli@latest dev",
    "inngest:mcp-server": "bun run src/inngest_app/mcp-server.ts",
    "lint": "bunx eslint . --ext .ts",
    "mobile": "cd mobile && npm start",
    "mobile:android": "cd mobile && npm run android",
    "mobile:install": "cd mobile && npm install",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:web": "cd mobile && npm run web",
    "predev": "./scripts/worktree-env-sync.sh && pkill -f 'bun.*src/index.ts' || true && node scripts/kill-port.cjs 2999 3001 8288",
    "prepare": "node scripts/install-hooks.cjs",
    "prestart": "./scripts/worktree-env-sync.sh",
    "security:full": "npm run security:scan",
    "security:scan": "chmod +x scripts/security-token-guard.sh && ./scripts/security-token-guard.sh",
    "start": "bun run dist/index.js",
    "start:all": "chmod +x scripts/deploy/start-all.sh && ./scripts/deploy/start-all.sh",
    "test": "cross-env SUPABASE_URL=TEST_URL SUPABASE_SERVICE_KEY=TEST_KEY bun run vitest",
    "test:baseline": "vitest run --reporter=json --outputFile=/tmp/vitest-baseline.json && node scripts/update-tests-baseline.cjs",
    "test:bun": "bun test --preload ./scripts/bun-test-env.ts $(grep -rl 'bun:test' src packages --include='*.ts')",
    "test:gate": "node scripts/test-gate.cjs",
    "test:gate:save": "node scripts/test-gate.cjs --save",
    "test:glm": "npx tsx scripts/test-glm-provider.ts",
    "test:infisical": "npx tsx scripts/infisical/check-infisical-keys.ts",
    "test:inngest": "cd src/inngest_app && vitest run",
    "test:inngest:coverage": "cd src/inngest_app && vitest run --coverage",
    "test:inngest:integration": "cd src/inngest_app && vitest run test/integration",
    "test:inngest:mcp": "cd src/inngest_app && vitest run test/mcp",
    "test:inngest:mcp:watch": "cd src/inngest_app && vitest test/mcp",
    "test:inngest:unit": "cd src/inngest_app && vitest run test/unit",
    "test:mcp": "npx tsx src/inngest_app/test-mcp.ts",
    "test:vitest": "vitest run",
    "test:network": "DETECT_NETWORK=1 vitest run --silent && node scripts/report-network-tests.cjs",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:3001": "cloudflared tunnel --url http://localhost:3001",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "user:check-models": "bun run scripts/users/check-user-models.ts",
    "user:check-models:remote": "chmod +x scripts/users/check-models-remote.sh && ./scripts/users/check-models-remote.sh",
    "user:force-exit": "bun run scripts/users/force-exit-scene.ts",
    "webhook:setup": "bun run src/utils/webhook-setup-cli.ts",
    "webhook:verify": "bun run src/utils/webhook-verify-cli.ts",
    "test:player": "cd apps/vibee-editor/player && npx --no-install vitest run",
    "test:bun:live": "RUN_LIVE_AI_TESTS=1 bun test src/__tests__/services/ai-models.test.ts",
    "verify": "node scripts/verify.cjs",
    "inngest:mcp-proxy": "npx tsx src/inngest_app/mcp-rest-proxy.ts"
  },
  "overrides": {
    "@grpc/grpc-js@1": "^1.14.4",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "browserslist": "^4.28.7",
    "defu@6": "^6.1.5",
    "fast-uri@3": "^3.1.6",
    "fast-xml-parser": "5.7.0",
    "flatted@3": "^3.4.2",
    "glob@10": "^10.5.0",
    "h3@1": "^1.15.9",
    "handlebars": "4.7.9",
    "ip-address@10": "^10.3.1",
    "js-yaml@3": "^3.15.2",
    "js-yaml@4": "^4.3.2",
    "lodash@4": "^4.17.24",
    "minimatch@3": "^3.1.4",
    "minimatch@5": "^5.1.8",
    "minimatch@9": "^9.0.7",
    "nanoid@3": "^3.3.18",
    "path-to-regexp@0": "^0.1.13",
    "path-to-regexp@8": "^8.3.1",
    "picomatch@2": "^2.3.2",
    "postcss@8": "^8.5.18",
    "preact@10": "^10.28.2",
    "protobufjs@7": "^7.6.1",
    "rollup@4": "^4.59.0",
    "socket.io-parser@4": "^4.2.7",
    "vite@7": "^7.3.5",
    "ws@7": "^7.5.13",
    "ws@8": "^8.21.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@fal-ai/client": "^1.7.0",
    "@infisical/sdk": "^4.0.6",
    "@mtproto/core": "^6.3.0",
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.39.3",
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.1.0",
    "@types/archiver": "^7.0.0",
    "@types/pg": "^8.15.4",
    "@types/ssh2": "^1.15.5",
    "apify-client": "^2.12.5",
    "archiver": "^7.0.1",
    "axios": "1.20.0",
    "commander": "^14.0.1",
    "dotenv": "^16.3.1",
    "elevenlabs": "^0.16.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "form-data": "^4.0.0",
    "fp-ts": "^2.16.11",
    "hono": "4.13.5",
    "inngest": "^3.54.0",
    "io-ts": "^2.2.22",
    "jest-mock": "^29.7.0",
    "md5": "^2.3.0",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "openai": "^4.24.7",
    "pg": "^8.16.3",
    "readline-sync": "^1.4.10",
    "redis": "6.2.1",
    "replicate": "^0.25.2",
    "ssh2": "^1.17.0",
    "telegraf": "4.16.3",
    "telegram": "^2.26.22",
    "tsc-alias": "^1.8.8",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "x402-express": "^0.7.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.9",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@ngrok/ngrok": "^1.5.2",
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.2",
    "@types/md5": "^2.3.5",
    "@types/node": "20",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jotai": "^2.20.3",
    "lefthook": "^2.1.10",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  }
}
