# Multi-stage build for optimized production image
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including dev dependencies for build)
RUN npm ci --legacy-peer-deps

# Install build tools globally
RUN npm install -g tsc-alias

# Copy source code
COPY . .

# Remove test files for production build
RUN find src -name "__tests__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find src -name "*.test.ts" -type f -delete 2>/dev/null || true && \
    find src -name "*.spec.ts" -type f -delete 2>/dev/null || true

# Build TypeScript with optimizations
RUN npm run build:prod

# Verify build output
RUN ls -la dist/ && echo "Build completed successfully"

# Production stage
FROM node:20-alpine as production

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache \
    openssh-client \
    sshpass \
    python3 \
    py3-pip \
    ffmpeg \
    curl \
    jq \
    bash

# Install yt-dlp
RUN pip3 install --break-system-packages yt-dlp[default] && \
    yt-dlp --version

# Create necessary directories
RUN mkdir -p /app/.ssh && \
    chmod 700 /app/.ssh && \
    chown -R node:node /app/.ssh && \
    mkdir -p /app/logs && \
    chown -R node:node /app/logs

# Copy package files
COPY package*.json ./

# Install only production dependencies
RUN npm ci --omit=dev --ignore-scripts --legacy-peer-deps

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist/

# Copy essential runtime files
COPY scripts/docker-entrypoint.sh ./
COPY scripts/healthcheck.sh ./
RUN chmod +x /app/docker-entrypoint.sh /app/healthcheck.sh

# Copy configuration files
COPY .env* ./

# Create empty .env as fallback
RUN touch .env && chown node:node .env

# Health check configuration
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD /app/healthcheck.sh

# Expose ports for API server and webhook endpoints
EXPOSE 2999 3000 3001 3002 3003 3004 3005 3006 3007 3008 3009 3010

# Use node user for security
USER node

# Set environment variables
ENV NODE_ENV=production
ENV TZ=UTC

# Use entrypoint for environment setup
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Default command
CMD ["node", "dist/bot.js"]

# Labels for metadata
LABEL maintainer="999-agents-team"
LABEL version="1.0.0"
LABEL description="999 Agents Telegraf Multi-Bot System"
LABEL org.opencontainers.image.source="https://github.com/playra/999-agents-telegraf"