# syntax=docker/dockerfile:1.4
# 🚀 Ultra-Optimized Dockerfile с Bun для 999-agents-telegraf
# Bun = 3-4x быстрее установки зависимостей + встроенный bundler

# =============================================================================
# Stage 1: Dependencies (с Bun)
# =============================================================================
FROM oven/bun:1-alpine AS deps

WORKDIR /app

# Копируем package files
COPY package.json bun.lockb* package-lock.json* ./

# Устанавливаем ТОЛЬКО production dependencies через Bun
# Bun в 3-4x быстрее npm ci
RUN bun install --production --frozen-lockfile

# =============================================================================
# Stage 2: Builder (компиляция TypeScript с Bun)
# =============================================================================
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Копируем package files
COPY package.json bun.lockb* package-lock.json* ./

# Устанавливаем ВСЕ зависимости (включая dev)
RUN bun install --frozen-lockfile

# Копируем исходный код
COPY . .

# 🔥 КРИТИЧНО: Полная проверка типов
RUN bun run typecheck || (echo "❌ Type check failed!" && exit 1)

# Собираем через Bun (быстрее чем tsc)
RUN bun run build

# =============================================================================
# Stage 3: Production Runtime
# =============================================================================
# Используем Node.js для runtime (совместимость)
# Можно использовать Bun runtime, но Node.js более стабильный для production
FROM node:20-alpine AS production

LABEL maintainer="999-agents-telegraf"
LABEL version="3.0-bun-optimized"

WORKDIR /app

# Non-root пользователь
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Копируем production dependencies
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules

# Копируем собранный код
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Копируем конфиги
COPY --chown=nodejs:nodejs package*.json ./

# Директории
RUN mkdir -p uploads logs && \
    chown -R nodejs:nodejs uploads logs

USER nodejs

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1));"

EXPOSE 3001

CMD ["node", "dist/index.js"]

# =============================================================================
# 📊 Ожидаемые улучшения:
# - Установка зависимостей: 3-4x быстрее
# - Общее время сборки: 40-60% быстрее
# - Размер образа: ~130-140MB (на 10-20MB меньше)
# =============================================================================
