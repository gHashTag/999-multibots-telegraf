# Claude Code Security Hooks - файлы для игнорирования

# Логи выполнения хуков
logs/*.log
*.log

# Временные файлы проверок
SECURITY_ALERT.txt
COMPLETION_BLOCKED.txt
activation-summary.txt
task-completion-summary.md

# Временные файлы скриптов
*.tmp
*.temp
*~
*.bak

# Не игнорируем важные файлы:
# !settings.json     # Конфигурация хуков
# !README.md         # Документация
# !hooks/*.sh        # Скрипты хуков
# !activate-hooks.sh # Активационный скрипт