# Официальный Dockerfile для Bun (Debian-slim вместо Alpine!)
# Alpine 5x медленнее для bun install

# Stage 1: Dependencies (используем Debian, НЕ Alpine!)
FROM oven/bun:1-debian AS deps
WORKDIR /app

# Копируем только package files для кэширования
COPY package.json bun.lockb* ./

# Установка ТОЛЬКО production зависимостей
RUN bun install --frozen-lockfile --production

# Stage 2: Builder
FROM oven/bun:1-debian AS builder
WORKDIR /app

# Копируем package files
COPY package.json bun.lockb* ./

# Установка ВСЕХ зависимостей
RUN bun install --frozen-lockfile

# Копируем исходный код
COPY . .

# Build
RUN bun run build

# Stage 3: Production (минимальный образ)
FROM node:20-slim
WORKDIR /app

# Production зависимости
COPY --from=deps /app/node_modules ./node_modules

# Compiled code
COPY --from=builder /app/dist ./dist

# Package.json
COPY package.json ./

EXPOSE 3001
CMD ["node", "dist/index.js"]
