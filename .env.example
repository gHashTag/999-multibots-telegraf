APIFY_TOKEN=your_apify_token_here
CREATOMATE_API_KEY=your_creatomate_key_here
SYNC_LABS_API_KEY=your_sync_labs_key_here

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_key_here

RUNWAY_API_KEY=your_runway_api_key_here

ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_API_KEY=sk-your_elevenlabs_key_here

API_SERVER_URL=https://your-domain.com
USE_PRODUCTION_API=true

PIXEL_API_KEY=your_pixel_api_key_here

HUGGINGFACE_TOKEN=your_huggingface_token_here

ADMIN_IDS=your_telegram_ids_here

SECRET_KEY=your_secret_key_here
CREDENTIALS=true
LOG_FORMAT=combined
SECRET_API_KEY=your_secret_api_key_here

MERCHANT_LOGIN=your_robokassa_login
ROBOKASSA_PASSWORD_1=your_password_1_here
ROBOKASSA_PASSWORD_2=your_password_2_here
RESULT_URL2=https://your-domain.com/payment-success

# Тестовые пароли Robokassa
TEST_PASSWORD1=your_test_password_here
TEST_PASSWORD2=your_test_password_here

PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://your-gateway.mypinata.cloud

DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# KIE.AI API for Video Generation
KIE_AI_API_KEY=your_kie_ai_key_here

# OpenRouter
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Inngest Configuration
BOT_INNGEST_EVENT_KEY=your_inngest_event_key_here
BOT_INNGEST_BASE_URL=https://your-domain.com/api/inngest
BOT_INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# Docker Development Settings
DOCKER_SOCKET=/var/run/docker.sock
ALLOWED_DIR=/workspace
ALLOWED_COMMANDS=ls,cat,pwd,echo,docker,git,which,systemctl,service,ps,netstat
ALLOWED_FLAGS=all
MAX_COMMAND_LENGTH=1024
COMMAND_TIMEOUT=60

NPM_TOKEN=your_npm_token_here

# Glama MCP API
GLAMA_API_KEY=glama_your_api_key_here

# ZEP
ZEP_API_KEY=your_zep_api_key_here

TEST_TELEGRAM_ID=your_test_telegram_id

# MCP Services Configuration
# INNGEST_DEV=1  # Закомментировано, так как уже определено выше

# Docker Network
DOCKER_NETWORK=app-network

TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_API_ID=your_telegram_api_id

# Telegram API
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+your_phone_number

# Telegram Webhook
SECRET_TOKEN=your_secret_token_here

LOCAL_SERVER_URL=http://localhost:4000

# GitHub Container Registry
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_token_here

MCP_MODE=stdio
DOCKER_HOST=unix:///var/run/docker.sock
PLATFORM=Darwin
HOST_DIR=/workspace
DOCKER_CONFIG=/root/.docker
DOCKER_DESKTOP_DISABLED=true
DOCKER_CLI_HINTS=false
DOCKER_CONTEXT=default
DOCKER_DESKTOP_ENABLED=false
DOCKER_DESKTOP_CHECK=false
DOCKER_DESKTOP_LOGIN_CHECK=false
WORKSPACE_DIR=/workspace

E2B_API_KEY=your_e2b_api_key_here
BOT_OWNER_ID=your_bot_owner_id
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

USE_SERVE=true

SERVER_PORT=2999

WEBHOOK_DOMAIN=https://your-domain.com/
WEBHOOK_PATH=/webhook
BOT_PATH=/bot

MODE=polling
BASE_WEBHOOK_URL=https://your-domain.com

# 🔥 API Keys для AI Video Generation
# Получите на https://app.hedra.ai/
HEDRA_API_KEY=sk_hedra_your_api_key_here

# HeyGen API Keys
# Получите на https://app.heygen.com/
HEYGEN_COCOAGE_API_KEY=sk_V2_your_heygen_cocoage_key_here
HEYGEN_HAIM_API_KEY=sk_V2_your_heygen_haim_key_here

# RENDER INNGEST (Railway render-server)
# Получите в Railway dashboard
RENDER_INNGEST_EVENT_KEY=your_render_inngest_event_key_here
RENDER_INNGEST_SIGNING_KEY=your_render_inngest_signing_key_here
RENDER_INNGEST_BASE_URL=https://your-railway-app.up.railway.app/api/inngest

# AI REELS TEST MODE FLAGS
USE_TEST_LIPSYNC=false
USE_TEST_VEO31=false

GEMINI_API_KEY=your_gemini_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
