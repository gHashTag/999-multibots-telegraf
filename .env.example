# =============================================================================
# 🔐 ИНСТРУКЦИЯ ПО НАСТРОЙКЕ ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# =============================================================================
# ВНИМАНИЕ: Это пример файла! НЕ КОММИТЬТЕ РЕАЛЬНЫЕ КЛЮЧИ В РЕПОЗИТОРИЙ!
#
# Для настройки:
# 1. Скопируйте этот файл как .env: cp .env.example .env
# 2. Замените все значения YOUR_*_HERE на ваши реальные ключи
# 3. Добавьте .env в .gitignore (уже настроен)
#
# =============================================================================

NODE_ENV=development

API_PORT=2999
ORIGIN=https://your-domain.com
SERVER_API_URL=https://your-domain.com

# TELEGRAM
# Получите токены у @BotFather
BOT_TOKEN_1=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_2=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_3=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_4=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_5=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_6=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_7=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_8=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_9=YOUR_BOT_TOKEN_HERE
BOT_TOKEN_10=YOUR_BOT_TOKEN_HERE

TEST_BOT_NAME=your_test_bot
BOT_TOKEN_TEST_1=YOUR_TEST_BOT_TOKEN_HERE
BOT_TOKEN_TEST_2=YOUR_TEST_BOT_TOKEN_HERE

ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_ID
SERVER_FILES_DIR=/etc/nginx/html/files/
