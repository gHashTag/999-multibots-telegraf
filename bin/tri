      console.log(composePitch({ name: name || null, tokens: p.токенов, stars: p.звёзд, url: "https://t.me/$invoice-link-here", note: note || undefined }));
      console.log("\n— цена по шкале:", p.токенов, "токенов =", p.звёзд, "⭐️");
    ' -- "$NAME" "$TOK" "$NOTE")
    ;;
  tg-as)
    # What the Telegram tools answer to THIS person on production. The live
    # check for "clients get their own tools": a stranger with no session must
    # hear "not connected" (their own fix), never "belongs to the owner", and
    # never anything from the owner's account. Read-only: tg_dialogs by
    # default. Usage: tri tg-as <telegram_id> [tool]
    ID="${2:-}"; TOOL="${3:-tg_dialogs}"
    [ -z "$ID" ] && { echo "usage: tri tg-as <telegram_id> [tool]"; exit 64; }
    case "$TOOL" in
      tg_dialogs|tg_unanswered|tg_contacts) ;;
      *) echo "only reading tools here: tg_dialogs, tg_unanswered, tg_contacts"; exit 64 ;;
    esac
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY not readable"; exit 1; }
    ANSWER=$(curl -s "https://vibee-render-production.up.railway.app/mcp?telegram_id=$ID" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$TOOL\",\"arguments\":{\"limit\":3}}}")
    ANSWER="$ANSWER" TOOL="$TOOL" ID="$ID" python3 - <<'PYEOF'
import json, os
r = json.loads(os.environ['ANSWER'])
if 'error' in r:
    # A thrown tool error arrives as a JSON-RPC error, not as isError content.
    print(f"{os.environ['TOOL']} as {os.environ['ID']}: refused -> {r['error'].get('message','')[:220]}"); raise SystemExit(0)
res = r.get('result', {})
text = (res.get('content') or [{}])[0].get('text', '')
if res.get('isError'):
    print(f"{os.environ['TOOL']} as {os.environ['ID']}: refused -> {text[:200]}")
else:
    try: s = res.get('structuredContent') or json.loads(text)
    except Exception: s = {}
    n = len(s.get('dialogs') or s.get('contacts') or s.get('диалоги') or [])
    print(f"{os.environ['TOOL']} as {os.environ['ID']}: ok, {n} item(s) on THEIR account")
PYEOF
    ;;
  crm-ingest|crm-leads)
    # crm-ingest [dialogs] [depth]: the owner's DMs into the CRM memory.
    # crm-leads [n]: who to write to next, scored, from that memory. Both
    # read-only on Telegram; both as the owner, on production.
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY not readable"; exit 1; }
    if [ "${1:-}" = "crm-ingest" ]; then
      TOOL=crm_ingest_chats; ARGS="{\"limit\":${2:-30},\"depth\":${3:-100}}"
    else
      TOOL=crm_leads; ARGS="{\"limit\":${2:-15}}"
    fi
    ANSWER=$(curl -s --max-time 170 "https://vibee-render-production.up.railway.app/mcp?telegram_id=144022504" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$TOOL\",\"arguments\":$ARGS}}")
    ANSWER="$ANSWER" TOOL="$TOOL" python3 - <<'PYEOF'
import json, os
r = json.loads(os.environ['ANSWER'])
if 'error' in r: print('refused ->', str(r['error'].get('message',''))[:300]); raise SystemExit(1)
res = r.get('result', {}); text = (res.get('content') or [{}])[0].get('text', '')
try: s = res.get('structuredContent') or json.loads(text)
except Exception: s = {'raw': text[:400]}
if os.environ['TOOL'] == 'crm_ingest_chats':
    print(f"dialogs={s.get('dialogs_seen')} people={s.get('people')} read={s.get('messages_read')} new={s.get('messages_new')} zep={s.get('zep_mirrored')} stopped={s.get('stopped')}")
    print(s.get('zep',''))
else:
    import re
    for c in s.get('candidates', []):
        who = c.get('display') or f"id {c.get('lead')}"
        words = re.sub(r'\[(?:END )?FOREIGN CONTENT[^\]]*\]', '', str(c.get('last_words') or '')).strip()
        print(f"  [{c.get('score'):>3}] {c.get('next'):<8} {who} · {c.get('lead')} · {c.get('stage')}{' · платил' if c.get('paid') else ''}")
        print(f"        {c.get('because')}")
        if words: print(f"        «{words[:100]}» · {c.get('messages')} сообщ., последнее {c.get('days_since_their_last_word')} дн. назад")
    print(s.get('how_to_read',''))
PYEOF
    ;;
  open)     sed -n '/^## Открыто/,/^## Не переоткрывать/p' "$LOOP/pipeline-STATUS.md" ;;
  tests)
    (cd "$RENDER" && npx vitest run src/agent/billing-prices.test.ts miniapp-receipt miniapp-billing) ;;
  all)
    # ВЕСЬ набор, а не свои файлы. Две проверки падали сутки незамеченными:
    # я гонял только те тесты, что писал сам, и «зелено» означало «зелено у
    # меня», а не «зелено в проекте». Обе поломки оказались моими.
    #
    # NODE 20 ЯВНО. По умолчанию в оболочке 18, и прогонщик падает на
    # `styleText` из node:util, которого там нет: «Startup Error» вместо
    # тестов читается как поломка проекта, а это поломка окружения.
    (cd "$RENDER" && PATH="$NODE20:$PATH" npx vitest run) ;;
  ios)
    # СБОРКА iOS И УБОРКА ЗА НЕЙ — ОДНОЙ КОМАНДОЙ.
    #
    # Каталог `/tmp/dd` растёт на каждой сборке. За ночь мои итерации набили
    # им диск ДО НУЛЯ — до состояния, когда не выполняется ни одна команда,
    # включая чистилку. Убирать после себя нельзя «не забыть»: это должно быть
    # частью самой сборки.
    # xcodegen ПЕРЕД сборкой: новый файл в каталоге ещё не значит файл в
    # проекте, и «cannot find X in scope» выглядит как ошибка кода.
    (cd "$ROOT/apps/vibee-ios" && xcodegen generate >/dev/null 2>&1)
    # УСПЕХ СБОРКИ ПРОВЕРЯЕТСЯ, А НЕ ПРЕДПОЛАГАЕТСЯ. Первая версия печатала
    # «установлено» после ПРОВАЛИВШЕЙСЯ сборки и ставила старый .app с диска:
    # проверка глазами шла по вчерашнему коду и ничего не доказывала.
    # ИМЯ ЛАТИНИЦЕЙ: первая версия звалась кириллицей, и проверка скриптов
    # поймала её сразу — тот же класс, что дважды ломал free-disk.sh.
    built=0
    (cd "$ROOT/apps/vibee-ios" && \
      xcodebuild build -scheme Vibee \
        -destination "platform=iOS Simulator,id=${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" \
        -derivedDataPath /tmp/dd 2>&1 | grep -E "error:|BUILD" | head -5) \
      | tee /tmp/tri-build.txt
    grep -q "BUILD SUCCEEDED" /tmp/tri-build.txt && built=1
    # УСТАНОВКА ДО УБОРКИ, иначе смотреть будет нечего: первая версия команды
    # сносила каталог вместе с собранным .app, и проверка глазами становилась
    # невозможной — уборка мешала тому, ради чего сборка и делалась.
    APP=/tmp/dd/Build/Products/Debug-iphonesimulator/Vibee.app
    if [ "$built" = "1" ] && [ -d "$APP" ]; then
      xcrun simctl install "${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" "$APP" \
        >/dev/null 2>&1 && echo "установлено на симулятор"
      xcrun simctl terminate "${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" ai.t27.vibee >/dev/null 2>&1
      xcrun simctl launch "${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" ai.t27.vibee >/dev/null 2>&1
    fi
    rm -rf /tmp/dd
    [ "$built" = "1" ] || echo "СБОРКА НЕ ПРОШЛА — на симулятор ничего не ставил"
    df -k /System/Volumes/Data | awk '{if(NR==2) printf "убрано за сборкой, свободно %d МБ\n", $4/1024}' ;;
  deps)
    # `npm ci`, а НЕ `npm install`.
    #
    # Один набор не грузился из-за отсутствующего `undici` — при том, что в
    # package.json он объявлен. То есть разъехалось node_modules, а не
    # манифест. `npm install` в такой ситуации подтянул новые версии соседей
    # и сломал прогонщик целиком: было 599 зелёных и один нерабочий набор,
    # стало ноль. `npm ci` ставит РОВНО то, что в локе, и вылечил оба разом:
    # 75 наборов, 621 тест.
    (cd "$RENDER" && PATH="$NODE20:$PATH" npm ci) ;;
  loop)
    # С ЧЕГО НАЧИНАЕТСЯ КАЖДЫЙ ВИТОК.
    #
    # Крон бьёт каждые 15 минут, а задача живёт часами. Половина риска
    # автономного цикла не в коде, а в том, что новый виток не знает о
    # прошлом: делает работу заново или поверх неё. Три вопроса разом —
    # где я, что уже занято, что не сделано.
    echo "── где я ──"
    echo "  ветка:  $(git -C "$ROOT" branch --show-current)"
    git -C "$ROOT" log --oneline -3 | sed "s/^/  /"
    N=$(git -C "$ROOT" status --porcelain | wc -l | tr -d " ")
    [ "$N" != "0" ] && echo "  НЕЗАКОММИЧЕНО: $N файл(ов) — следующий виток их не увидит"
    echo
    echo "── что в работе ──"
    sed -n "/^## СЕЙЧАС В РАБОТЕ/,/^## Что уже есть/p" "$LOOPSTATE" |
      grep -v "^## " | sed "/^$/d" | sed "s/^/  /"
    echo
    echo "── не сделано (первые 5) ──"
    grep -n "^- \[ \]" "$LOOPSTATE" | head -5 | sed "s/^/  /" ||
      echo "  всё помечено сделанным — пора писать новый план"
    ;;

  loop-note)
    # ОПЫТ, КОТОРЫЙ ИНАЧЕ ПОТЕРЯЕТСЯ.
    #
    # Виток обрывается внезапно. Всё, что не записано в память, следующая
    # смена выведет заново — а чаще не выведет и наступит на то же место.
    shift
    if [ $# -eq 0 ]; then
      echo "нужен текст: tri loop-note \"что выяснилось\""; exit 2
    fi
    printf "\n- %s: %s\n" "$(date "+%d.%m.%Y %H:%M")" "$*" >> "$LOOPSTATE"
    echo "записано в ${LOOPSTATE#$ROOT/}"
    ;;

  mutate) shift; bash "$ROOT/bin/helpers/mutate.sh" "$@" ;;

  api)    shift; bash "$ROOT/bin/helpers/tg-api.sh" "$CACHE" "$@" ;;

  wired)  shift; bash "$ROOT/bin/helpers/wired.sh" "$ROOT" "$@" ;;
  self)   shift; bash "$ROOT/bin/helpers/self.sh" "$ROOT" "$@" ;;
  rotten) shift; bash "$ROOT/bin/helpers/rotten.sh" "$ROOT" "$@" ;;
  books)  shift; bash "$ROOT/bin/helpers/books.sh" "$ROOT" "$@" ;;
  vs-main) shift; bash "$ROOT/bin/helpers/vs-main.sh" "$ROOT" "$@" ;;
  scan)   shift; bash "$ROOT/bin/helpers/scan.sh" "$ROOT" "$@" ;;
  owners) shift; bash "$ROOT/bin/helpers/owners.sh" "$ROOT" "$@" ;;
  promises) shift; bash "$ROOT/bin/helpers/promises.sh" "$ROOT" "$@" ;;
  waiting) shift; bash "$ROOT/bin/helpers/waiting.sh" "$ROOT" "$@" ;;
  clock)  shift; bash "$ROOT/bin/helpers/clock.sh" "$ROOT" "$@" ;;
  landing) shift; bash "$ROOT/bin/helpers/landing.sh" "$ROOT" "$@" ;;
  facts)  shift; bash "$ROOT/bin/helpers/facts.sh" "$ROOT" "$@" ;;
  sweep)  shift; bash "$ROOT/bin/helpers/sweep.sh" "$ROOT" "$@" ;;
  funnel) shift; bash "$ROOT/bin/helpers/funnel.sh" "$ROOT" "$@" ;;
  headroom) shift; bash "$ROOT/bin/helpers/headroom.sh" "$ROOT" "$@" ;;
  lost)   shift; bash "$ROOT/bin/helpers/lost.sh" "$ROOT" "$@" ;;
  binary) shift; bash "$ROOT/bin/helpers/binary.sh" "$ROOT" "$@" ;;

  doctor)
    echo "── копия ──";     fresh || true
    echo; echo "── диск ──"; bash "$LOOP/check-free-disk.sh" | tail -1; bash "$LOOP/free-disk.sh" | tail -1
    echo; echo "── конвейер ──"; (cd "$RENDER" && npx tsx scripts/pipeline-check.ts | tail -3)
    # САМА ОБОЛОЧКА -- ТОЖЕ ЧАСТЬ СМЕНЫ. Инструмент, который молча
    # перестал звать свой хелпер, отправляет работать не туда весь виток.
    echo; echo "── оболочка ──"; bash "$ROOT/bin/helpers/self.sh" "$ROOT" | tail -2 ;;
  # 64 = "not mine", so the root tri can tell an unknown command from a
  # command that ran and failed. Any other exit code is the command's own.
  # Under the bridge the root prints the one usage; two for one typo is noise.
  *) [ -n "${TRI_BRIDGE:-}" ] || usage; exit 64 ;;
esac
