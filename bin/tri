#!/bin/bash
# tri — командная оболочка проекта Trinity S³AI.
#
# ЗАЧЕМ. Автономный цикл каждые 15 минут начинается с одних и тех же вопросов:
# хватает ли места, сходится ли конвейер, что уже закрыто, какие цены сейчас,
# какие посты в ленте. Раньше каждый ответ собирался заново из пяти команд, и
# половина ошибок цикла была именно в этой сборке: то кириллица в арифметике,
# то устаревшая рабочая копия, то проверка не того дерева.
#
# Каждая команда здесь — это ответ, добытый один раз и записанный, чтобы
# следующая смена его не выводила заново.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RENDER="$ROOT/apps/vibee-editor/render"
LOOP="$ROOT/.claude/loop-opus"
# Память автономного цикла по CRM. Отдельно от $LOOP: там скрипты смены,
# здесь единственный файл, который переживает виток крона.
# TRI_LOOP picks which loop's memory: crm (default) or agents (the agent
# marketplace loop, 24.09.2026). Two loops, two files: one loop's cron must
# never read, or write over, the other's state.
LOOPSTATE="$ROOT/.claude/loop-state/${TRI_LOOP:-crm}-loop.md"
# Для того, что качается один раз и чему не место в репозитории.
CACHE="$ROOT/.claude/cache"
# Прогонщик тестов требует Node 20; в оболочке по умолчанию 18.
NODE20="$HOME/.nvm/versions/node/v20.19.0/bin"
# ...И ЭТОГО МАЛО, ЕСЛИ ПЕРЕМЕННУЮ ТОЛЬКО ОБЪЯВИТЬ.
#
# Она была объявлена и использовалась не везде: `tri guards` падал с
# `ERR_REQUIRE_ESM`, потому что звал `npx` из PATH, где node 18. Хуже: команда
# при этом печатала пустоту, неотличимую от «сторожа молчат».
#
# Ставим Node 20 в начало PATH ОДИН раз, здесь: тогда любая новая команда
# получает верную версию, не вспоминая об этом.
[ -d "$NODE20" ] && PATH="$NODE20:$PATH" && export PATH

usage() {
  cat <<'U'
tri — оболочка Trinity S³AI

  tri doctor     всё перед началом смены: копия, диск, конвейер, влито = выехало
  tri fresh      сверить рабочую копию с origin/main (частая причина ложных диагнозов)
  tri disk       освободить место и проверить сам инструмент чистки
  tri pipeline   проверка конвейера без единой траты кредитов
  tri prices     таблица цен: модель, токены, единица
  tri margin     маржа каждой картинки и видео: себестоимость, токены, выручка по курсу клуба
  tri card       как выглядит карточка владельца на живых данных
  tri feed       посты в ленте с id (в интерфейсе ссылок на посты нет)
  tri feed-hide <id>  скрыть все свои посты, кроме одного (обратимо)
  tri loop       с чего начинать виток: где я, что занято, что не сделано (TRI_LOOP=agents — цикл агентов)
  tri agents [--dry] [--no-record] [ids…]  приёмка агентов на владельце; итог уходит на карточки рынка
  tri logins     в какие сети браузер владельца уже вошёл (#2962), без значений cookies
  tri verdicts   последний итог приёмки по каждому агенту (тот, что на карточках /agents)
  tri secret NAME  положить секрет в Railway скрытым вводом — значение не проходит через чат
  tri traffic [дни]  откуда приходят люди, по каналам (utm_source), по умолчанию 30 дней
  tri reach /путь [метод]  пропустит ли замок рендера вызов без подписи (isPublic)
  tri bare-fetch  вызовы приложения без подписи, которые упрутся в замок рендера (401 до обработчика)
  tri tag URL канал [кампания]  ссылка с меткой канала: utm на наших страницах, __канал в /start нашего бота
  tri loop-note <текст>   записать вывод витка в память (иначе потеряется)
  tri stop [id]  прервать идущие ходы человека (дуэт и a2a — у них нет сокета)
  tri faces [id]  очередь продавца в том порядке, в каком её увидит обход: у кого есть лицо
  tri writers <колонка>  кто ПИШЕТ то, что читает код: может ли писатель не сработать ни разу
  tri wake <модуль>  что проверить ПЕРЕД подключением мёртвого модуля: unknown как «нет», фикстуры
  tri swallow  где сбой неотличим от честного пустого ответа (форма 185)
  tri layout [селектор]  как замерить высоту ДО и ПОСЛЕ правки верстки (форма 186)
  tri touch  какие кнопки меньше 44px под палец, и как чинить без двух ловушек (форма 190)
  tri halfdone <файл>  где защита написана для одного элемента, а нужна соседям (форма 187)
  tri family <Компонент> [признак]  кто ещё в семье и до кого лекарство не дошло (форма 191)
  tri byload [каталог] [тест]  падает от кода или от ЗАГРУЗКИ машины: три прогона, три числа (форма 188)
  tri mutate <файл> <было> <стало> -- <тесты>   убил ли тест мутацию
  tri api <имя>  метод или класс Bot API из справочника Telegram
  tri wired <имя>  зовёт ли кто-то эту функцию из рабочего пути (не из тестов)
  tri self       сама оболочка: достижима ли каждая команда и на месте ли хелпер
  tri rotten [n] какие открытые PR конфликтуют и ПОЧЕМУ — по общей причине
  tri books      какие факты код читает, а прод НИ РАЗУ не записал
  tri alive      дышит ли продавец: сколько прошло с последнего обхода
  tri vs-main <команда…>  падает ли это и БЕЗ ваших правок (копия на main)
  tri queue [n]  очередь открытых PR: что свободно, а что стоит за другим
  tri stale [N…]  не сделано ли то, что лежит в PR, уже на main
  tri scan       чем этот код может соврать: обзор сторожей и дыр
  tri spelling   тесты, сторожащие написание исходника, а не свойство
  tri spelling --gate|--update-baseline  ворота: падать только на НОВЫХ
  tri boundary   держат ли инструменты обещание не отправлять без нажатия
  tri rehearse [ветки…]  сольются ли открытые PR друг с другом, по порядку
  tri owners <файл>  кто ещё держит состояние этого модуля между вызовами
  tri promises   обещания в тексте, за которыми стоит число в другом файле
  tri promises --defaults  сверить «по умолчанию N» с запасным вариантом в коде
  tri waiting    что лежит в открытом PR и чем рискует — по группам
  tri clock [дней] [render|bot|all]  прогон так, будто прошло N дней:
                 два прогона, фон вычитается — видно только то, что сгниёт
  tri landing    доедет ли работа этой ветки до main и что застрянет с ней
  tri lost       коммиты, до которых не достаёт ни одна ветка (сеть под reset)
  tri binary     исходники, невидимые для grep из-за нулевого байта
  tri facts      на чём стоят факты CRM в ПРОДЕ: не пуст ли журнал под выводом
  tri funnel     воронка владельца одним экраном: этапы, шаги, утечка карточек
  tri headroom   числа, которые говорят про запас, а не про потери (форма 54)
  tri sweep [hive|log] [n]  обходы продавца в проде: журнал улья (навсегда)
                 или лог Railway (с последнего деплоя)
  tri open       что ещё открыто по pipeline-STATUS.md
  tri tests      тесты денег и iOS-модулей
  tri all        ВЕСЬ серверный набор (Node 20) — свои файлы зелёные ≠ зелёный проект
  tri deps       вылечить node_modules: npm ci, а не install
  tri ios        собрать приложение И УБРАТЬ за собой — иначе диск кончится
  tri blind <файл> <было> <стало> <тест>
                 сломать код и посмотреть, покраснеет ли тест
                 (тест, который не может упасть, — не защита, а её изображение)
  tri entry      двери входа: чем отвечают на мусор, есть ли тормоз

  Обучение под t27 — живой путь (писать .t27)
  tri igla report [--self-test]  ВСЯ панель оценки с правилом чтения
  tri igla dataset-specs [кат] [вых]  собрать train/eval для написания .t27
  tri igla count <каталог>       честный размер корпуса по spec-status
  tri igla specs [каталог]       classify + статус реализации
  tri igla config [каталог]      совпадает ли конфигурация обучения с данными
  tri igla validate <спек>       годен ли спек (разбирается И не пуст)
  tri igla gate <большой.t27>    поверить ворота (нужен вход с AST > 1 МБ)
  tri igla score [--self-test]   валидность / релевантность / существо
  tri igla blocked [кат|eval.jsonl]  глубина дефектов ПО VERILOG (не по Zig)
  tri igla rivals                кто ещё решает эту задачу и наш разрыв
  tri igla floor                 краснеют ли батареи БЕЗ компилятора
  tri igla selfcheck             не разошлись ли справка и код

  Обучение под t27 — УСТАРЕЛО (путь спек→Verilog, годных пар ноль)
  tri igla pairs                 сбор пар спек→код
  tri igla dataset               датасет из пар
  tri igla audit                 годен ли Verilog-корпус (счёт печатает сам)
  tri igla status                узкое место корпуса пар (Verilog-путь)
  tri igla bench <задачи.json>   поверка на VerilogEval v2 (нужен iverilog)

  Улей и наблюдение
  tri hive       смотритель, журнал событий, отчёты королевы
  tri bridge [id...]  радужный мост: вся ферма и обе стороны разом, никому не пишет
  tri commands   каждая команда меню на каждом боте: ответил / молчит / не пробовали
  tri pack <id> <username>  упаковка клиента: восемь частей, у каждой — следующее нажатие
  tri botapi     какие боты на нашем Bot API сервере и согласны ли бот, рендер и сервер
  tri auto       включён ли режим AUTO: до какого часа и сколько автоотправок осталось
  tri outcomes [дней]  сколько ушло без тебя: авто, твоей кнопкой, отменено, обходы
  tri contracts  слова, которыми службы договариваются: кто говорит, а кого не слышат
  tri dead       модули, которые никто не импортирует: написано и не включено
  tri inflight   что в работе: открытые PR, рабочие деревья, диск, последние выкатки
  tri session    сессии: срок жизни, ротация, обнаружение повторного использования
  tri pairing    вход по коду: длина, срок, попытки — и совпадают ли клиенты с сервером
  tri throttle   тормоз на входе: по чему считает и кого не заденет
  tri tma        мини-апп: какой ключ уходит с запросом (два сразу = отказ сервера)

  Состояние проекта
  tri schema     таблицы, которые код считает существующими, против настоящих
  tri crm-source какая копия users/payments живая: Supabase или Railway
  tri shipped    уехало ли в прод — и пользуется ли им кто-нибудь
  tri drift      влито, но не выехало: сервис отвязан, main застрял или сборка падает
  tri eyes       видит ли агент браузер человека: вкладки, снимок, описание от зрения
  tri main-guard [--eyes]  здоров ли сам main: типы плеера, загрузка бота, влито = выехало
  tri flaky <N> <пакет> <тесты…>  прогнать набор N раз: нестабильность или поломка
  tri journal [n] что агент делал в браузере владельца: шаги, адреса, что видел
  tri deployed <PR|sha> [сервис…]  дождаться выкатки ИМЕННО этого коммита и её статуса
  tri in-bundle <текст> [app|queen]  доехал ли текст в живой бандл приложения или доски
  tri work-report <PR> [repo]  примет ли шлюз trinity отчёт о работе: head_sha и валидатор
  tri a2a "<задача>" [--surface s] [--fresh]  дать задачу агенту владельца и смотреть, как он справится
  tri remote-check [render|player|root] [-- файлы]  проверки в облаке (Railway), а не на Mac
  tri bench                    балл агента: находит ли он кнопки на страницах из боя
  tri lesson <скил> <текст>    записать урок в скил одной строкой, с датой
  tri app-smoke  что app.t27.ai обязан отвечать [--save|--compare ФАЙЛ]
  tri guards     защиты, которые ничего не защищают
  tri space      место на диске: что заняли мы и что можно вернуть
  tri worktrees  брошенные копии репозитория (могут хранить несохранённое)
  tri skills     ссылаются ли скиллы на файлы, которых уже нет

  CRM и личный продавец
  tri crm-waiting          кто ждёт ответа (прод, от имени владельца, только чтение)
  tri crm-pitch <name> [tokens] [note]  текст предложения, локально, без счёта
  tri tg-as <telegram_id> [tool]  что инструменты Telegram отвечают ЭТОМУ человеку на проде
  tri crm-ingest [dialogs] [depth]  переписки владельца в память CRM (и в Zep, если задан)
  tri crm-leads [n]        кому писать следующему, со счётом и причиной
  tri orphans [n]          сколько карточек ушло НЕ нажатыми (и сколько картинок зря)
  tri deadlines [что]      все сроки проекта в одном столбике, по возрастанию
  tri turn-time [n]        сколько длится ход обхода против его бюджета
U
}

# КОПИЯ ОТСТАЁТ — САМАЯ ДОРОГАЯ ИЗ ДЕШЁВЫХ ОШИБОК.
# Однажды проверка упала с «файла нет», и первая мысль была «влил сломанное».
# На деле копия стояла на локальном main на десять коммитов позади.
fresh() {
  git -C "$ROOT" fetch -q origin main
  # ИМЕНА ЛАТИНИЦЕЙ. Первая версия этой функции была написана
  # кириллицей и упала на `local`: bash принимает только
  # [A-Za-z_][A-Za-z0-9_]*. Тот же класс уже ломал free-disk.sh дважды —
  # и печатал ошибку, продолжая работать, поэтому выглядел исправным.
  local here there
  here=$(git -C "$ROOT" rev-parse --short HEAD)
  there=$(git -C "$ROOT" rev-parse --short origin/main)
  if [ "$here" = "$there" ]; then
    echo "✓ копия совпадает с origin/main ($here)"
  else
    echo "✗ КОПИЯ ОТСТАЁТ ИЛИ РАЗОШЛАСЬ: тут $here, origin/main $there"
    echo "  git log --oneline origin/main..HEAD   # что есть только тут"
    echo "  git log --oneline HEAD..origin/main   # чего не хватает"
    return 1
  fi
  local dirty
  dirty=$(git -C "$ROOT" status --short | grep -v '^??' | wc -l | tr -d ' ')
  [ "$dirty" = "0" ] && echo "✓ незакоммиченных правок нет" \
    || echo "! незакоммиченных файлов: $dirty (git status)"
}


# МУТАЦИЯ КАК ЕДИНСТВЕННОЕ ДОКАЗАТЕЛЬСТВО.
#
# За смену 07.09.2026 нашлось семнадцать тестов, которые не могли упасть, —
# две из них написал я сам в тот же день. Проверка «сломай и посмотри» занимает
# минуту и ловит то, чего не видно чтением.
#
# Замена ОБЯЗАНА примениться: молчаливый промах выглядит как «тест поймал»,
# поэтому при ненайденном образце команда отказывается работать.
# ИМЕНА ПЕРЕМЕННЫХ ЗДЕСЬ ЛАТИНСКИЕ, И ЭТО НЕ ВКУСОВЩИНА.
# bash разбирает `К=401` как команду, а не как присваивание: скрипт с
# кириллическими идентификаторами падает строкой «command not found» на пустом
# месте. В комментариях кириллица уместна, в идентификаторах — нет.
mutate() {
  f="$1"; old="$2"; new="$3"; t="$4"
  [ -f "$f" ] || { echo "нет файла: $f"; return 1; }
  cp "$f" /tmp/tri-blind.bak
  BLIND_FILE="$f" BLIND_OLD="$old" BLIND_NEW="$new" python3 -c 'import io,os,sys
p=os.environ["BLIND_FILE"]; было=os.environ["BLIND_OLD"]; стало=os.environ["BLIND_NEW"]
s=io.open(p,encoding="utf-8").read()
if было not in s:
    print("МУТАЦИЯ НЕ ПРИМЕНЕНА: искомого текста нет в файле"); sys.exit(1)
io.open(p,"w",encoding="utf-8").write(s.replace(было,стало,1))' || { cp /tmp/tri-blind.bak "$f"; return 1; }
  cp /tmp/tri-blind.bak "$f"   # run the BEFORE pass on the unmutated file

  # ТЕСТ ОБЯЗАН БЫТЬ ЗЕЛЁНЫМ ДО МУТАЦИИ.
  #
  # Без этого «красный после» ничего не значит: он мог быть красным всегда, и
  # тогда мутация здесь ни при чём. Проверка «до» — половина опыта, и её тут
  # не было.
  # Вывод сохраняется, а не выбрасывается: без него нельзя отличить слепой
  # тест от ХОЛОСТОЙ мутации. 08.09.2026 замена фильтра длины частей с «>2» на
  # «>0» была объявлена выжившей — а на деле не сдвинула ни одного числа: в
  # этих именах нет частей короче трёх букв. Тест был ни при чём.
  run_probe() {
    case "$t" in
      *.test.ts|*.test.js|*.spec.ts)
        ( cd "$(dirname "$t")" 2>/dev/null || cd .
          PATH="$HOME/.nvm/versions/node/v20.19.0/bin:$PATH" \
            npx vitest run "$(basename "$t")" 2>&1 ) > "$PROBE_OUT" 2>&1
        ;;
      *)
        # Любая команда: вердикт — её КОД ВОЗВРАТА. Так проверяются батареи
        # приборов, которые тестами vitest не являются.
        ( eval "$t" ) > "$PROBE_OUT" 2>&1
        ;;
    esac
  }

  PROBE_OUT=/tmp/tri-blind.before
  run_probe; before=$?
  if [ $before -ne 0 ]; then
    echo "⛔ тест КРАСНЫЙ ещё до мутации (код $before) — опыт бессмыслен"
    echo "   почините тест, потом возвращайтесь"
    return 2
  fi

  # Re-apply the mutation for the AFTER pass.
  BLIND_FILE="$f" BLIND_OLD="$old" BLIND_NEW="$new" python3 -c 'import io,os
p=os.environ["BLIND_FILE"]
s=io.open(p,encoding="utf-8").read()
io.open(p,"w",encoding="utf-8").write(s.replace(os.environ["BLIND_OLD"],os.environ["BLIND_NEW"],1))'
  echo "— мутация применена, гоняю тест —"
  PROBE_OUT=/tmp/tri-blind.after
  run_probe; after=$?
  cp /tmp/tri-blind.bak "$f"
  echo "— файл восстановлен —"

  # ВЕРДИКТ. Прошлая версия печатала строку vitest и молчала о смысле, а
  # выходила всегда нулём: инструмент, заведённый отвечать на один вопрос,
  # на него не отвечал.
  if [ $after -eq 0 ]; then
    # ХОЛОСТАЯ МУТАЦИЯ — НЕ СЛЕПОЙ ТЕСТ, И ПУТАТЬ ИХ ДОРОГО.
    #
    # Если вывод совпал байт в байт, поведение не изменилось: винить тест не за
    # что, менять надо мутацию. Обвинить исправный тест — потерять день на
    # починку того, что не сломано.
    if cmp -s /tmp/tri-blind.before /tmp/tri-blind.after; then
      echo "◻️  МУТАЦИЯ ХОЛОСТАЯ: вывод не изменился ни на байт."
      echo "   Тест ни при чём — подберите замену, которая правда что-то меняет."
      return 3
    fi
    echo "⛔ МУТАЦИЯ ВЫЖИЛА: поведение изменилось, а тест остался зелёным."
    echo "   Он этого не проверяет."
    return 1
  fi
  echo "✅ мутация поймана: было 0, стало $after"
}

case "${1:-}" in
  skills)
    # ОПИСЫВАЮТ ЛИ СКИЛЛЫ ЭТОТ РЕПОЗИТОРИЙ ДО СИХ ПОР.
    #
    # Сорок один скилл, 28 тысяч строк, ни разу не сверенных с деревом.
    #
    # Делит найденное на АДРЕСА и ИМЕНА, потому что ломается только первое.
    # «render/steps.ts подставляет job_id» — имя, и переписывать его в полный
    # путь значит испортить фразу. А `npx tsx scripts/...` в bash-блоке —
    # адрес: неверный, он падает у читателя в руках.
    #
    # Читает все .md скилла и заглядывает внутрь блоков команд: восемнадцать
    # сломанных вызовов прятались именно там, вне обратных кавычек.
    #
    # --self-test прогоняет батарею из прошлых ошибок самого прибора.
    node "$ROOT/scripts/skills-drift.cjs" "${2:-}"
    ;;
  igla)
    # ОБУЧЕНИЕ ПОД t27: СОБРАТЬ КОРПУС И УВИДЕТЬ, ГДЕ ОН УПИРАЕТСЯ.
    #
    # Заведено 08.09.2026. Опубликованный датасет IGLA CODER — восемь пар, и
    # он сам об этом говорит: «CANNOT train a working model». При этом 35 пар
    # уже лежат в репозитории закоммиченными, просто не собраны. Эта команда
    # собирает их и НЕ даёт соврать: каждая пара подтверждается шапкой t27c
    # внутри сгенерированного файла, заглушки отбрасываются.
    #
    # Почему это команда, а не разовый скрипт: корпус будет расти по мере
    # прогона кодогенератора, и число пар надо перепроверять, а не помнить.
    S="$ROOT/.claude/skills/t27-model-training/scripts"
    export PATH="$HOME/.nvm/versions/node/v20.19.0/bin:$PATH"
    export GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token 2>/dev/null)}"
    case "${2:-report}" in
      pairs)   node "$S/harvest-igla-pairs.mjs" ;;
      dataset)
        [ -f igla-pairs-manifest.json ] || node "$S/harvest-igla-pairs.mjs"
        node "$S/prepare-lora-dataset.mjs" --max-tokens "${3:-32768}"
        ;;
      status)
        node "$S/harvest-igla-pairs.mjs" | grep -E 'СОБРАНО|токенов|порог'
        echo "— узкое место —"
        echo "  связывает ЧИСЛО ПРИМЕРОВ, а не токенов: спеков 493,"
        echo "  вывод кодогенератора закоммичен у 35. Прогон генератора по"
        echo "  остальным — единственный рычаг; резать длинные пары ПРОВЕРЕНО"
        echo "  и не выходит (крупный Verilog — ровно один модуль в файле)."
        ;;
      validate)
        # ВОРОТА ДЛЯ СГЕНЕРИРОВАННОГО СПЕКА.
        #
        # НЕ `t27c parse` в одиночку: он возвращает 0 на пустом файле, на одних
        # пробелах, на `module m {}` и на модуле без функций. Модель, выучившая
        # молчание, получила бы по нему 100%.
        export T27C="${T27C:-$(command -v t27c)}"
        [ -x "$T27C" ] || { echo "нет t27c. Сборка: см. скилл t27-model-training"; exit 2; }
        if [ "${3:-}" = "--self-test" ]; then
          node "$S/validate-t27.mjs" --self-test "${4:-}"
        else
          node "$S/validate-t27.mjs" "${3:?укажите файл .t27}"
        fi
        ;;
      dataset-specs)
        # СБОРКА ДАТАСЕТА ДЛЯ НАСТОЯЩЕЙ ЗАДАЧИ: ПИСАТЬ .t27.
        export T27C="${T27C:-$(command -v t27c)}"
        [ -x "$T27C" ] || { echo "нет t27c. Сборка: см. скилл"; exit 2; }
        node "$S/build-spec-dataset.mjs" --specs "${3:-specs}" --out "${4:-spec-dataset}"
        ;;
      gate)
        # ПОВЕРКА ВОРОТ. Контроль обязан быть БОЛЬШИМ: батарея из мелких
        # входов пропустила ошибку maxBuffer, потому что вырожденные случаи
        # всегда малы, а AST растёт ~53x от размера спека.
        export T27C="${T27C:-$(command -v t27c)}"
        node "$S/validate-t27.mjs" --self-test "${3:?укажите БОЛЬШОЙ спек, напр. specs/base/ops.t27}"
        ;;
      report)
        # ОДИН ОТЧЁТ, ПОТОМУ ЧТО ЧИСЛА ВЕРНЫ ТОЛЬКО ВМЕСТЕ.
        #
        # Заведено после того, как дважды за смену прибор проходил проверку не
        # по той причине, по какой казалось. Каждое из трёх чисел в одиночку
        # обманывает: VALID даёт 100% постоянному чужому ответу; RELEVANT молчит
        # о содержимом; исполнение даёт 100% жульнику с ИСПОЛНИМЫМ спеком.
        # Панель печатает и правило чтения, и то, чего измерить нельзя.
        export T27C="${T27C:-$(command -v t27c)}"
        node "$S/report.mjs" "${@:3}"
        ;;
      blocked)
        # ГЛУБИНА ДЕФЕКТОВ ПО VERILOG-ПУТИ. НЕ ПО ZIG.
        #
        # Считает их же backlog, и это важно понимать буквально: в его выводе
        # стоят строки `iverilog accepts` и `does not generate Verilog` --
        # он меряет ВЕРИЛОГОВЫЙ бэкенд. Панель оценки меряет ЗИГОВЫЙ.
        #
        # 08.09.2026 я несколько кругов подряд докладывал «семь спеков глубины
        # 2 -- самая дешёвая цель» как совет по тем 18, что блокирует Zig. Это
        # были числа про другой бэкенд.
        #
        # Глубину Zig-пути так не узнать вовсе: Zig сообщает РОВНО ОДНУ ошибку
        # за проход (проверено на всех 18), поэтому «виден один класс» не
        # значит «класс один». Единственный способ -- починить и померить
        # заново; так и выяснилось, что после правки числового суффикса два
        # спека прошли слой и упёрлись в следующий.
        export T27C="${T27C:-$(command -v t27c)}"
        [ -x "$T27C" ] || { echo "нет t27c. Сборка: см. скилл"; exit 2; }
        ARG="${3:-specs}"
        # ОЦЕНОЧНЫЙ НАБОР -- НЕ КАТАЛОГ, А СТРОКИ JSONL.
        #
        # backlog читает дерево спеков, а вопрос, ради которого его зовут,
        # почти всегда про ОЦЕНОЧНЫЕ 34: сколько из них починит одна правка
        # компилятора. Раскладывать их руками пришлось 08.09.2026, и без этого
        # ответ получить было нельзя.
        #
        # Раскладываются только ЗАБЛОКИРОВАННЫЕ: у исполнимых глубина нулевая
        # по определению, и включать их значит разбавлять распределение.
        case "$ARG" in
          *.jsonl)
            [ -f "$ARG" ] || { echo "нет файла: $ARG"; exit 2; }
            SPECS_ROOT="${T27_SPECS:-$HOME/.cache/t27-src/specs}"
            [ -d "$SPECS_ROOT" ] || { echo "нет дерева спеков: $SPECS_ROOT (задайте T27_SPECS)"; exit 2; }
            OUT="$SPECS_ROOT/.depth"
            node "$ROOT/bin/helpers/lay-out-blocked.mjs" "$ARG" "$OUT" || exit 1
            "$T27C" backlog --specs-dir "$OUT" 2>&1 | tail -22
            rm -rf "$OUT"
            ;;
          *)
            "$T27C" backlog --specs-dir "$ARG" 2>&1 | tail -20
            ;;
        esac
        ;;
      config)
        # СОГЛАСОВАНА ЛИ КОНФИГУРАЦИЯ С ДАННЫМИ, НА КОТОРЫЕ УКАЗЫВАЕТ.
        #
        # Заведено после того, как конфигурация обучения три итерации указывала
        # на lora-dataset/ -- заброшенный Verilog-набор, -- пока живым был
        # spec-dataset/. Арендуй кто-нибудь GPU и запусти, обучение пошло бы на
        # 26 примерах несобирающегося Verilog вместо 207 спеков, и ошибка
        # обнаружилась бы по счёту за аренду.
        C="$ROOT/.claude/skills/t27-model-training/resources/lora-config.yaml"
        D="${3:-spec-dataset}"
        echo "— на что указывает конфигурация —"
        grep -E '^\s+- path:' "$C" | sed 's/^/  /'
        echo "— что есть на диске —"
        for f in train eval; do
          if [ -f "$D/$f.jsonl" ]; then
            echo "  $D/$f.jsonl: $(wc -l < "$D/$f.jsonl" | tr -d ' ') примеров"
          else
            echo "  $D/$f.jsonl: НЕТ"
          fi
        done
        if grep -q "path: $D/" "$C"; then
          echo "  ✅ конфигурация и данные совпадают"
        else
          echo "  ⛔ РАСХОЖДЕНИЕ: конфигурация указывает не на $D"
          echo "     обучение пошло бы не на тех данных, и узналось бы по счёту"
          exit 1
        fi
        ;;
      score)
        # ИЗМЕРИТЕЛЬ ОТВЕТОВ МОДЕЛИ: валидность, РЕЛЕВАНТНОСТЬ, существо.
        # Без релевантности жульник, отвечающий одним спеком на всё, даёт 100%.
        export T27C="${T27C:-$(command -v t27c)}"
        node "$S/score-spec-answers.mjs" "${@:3}"
        ;;
      count)
        # ЧЕСТНЫЙ ПОДСЧЁТ КОРПУСА -- ПО spec-status, А НЕ ПО РАСШИРЕНИЮ.
        #
        # Заведено после того, как «1257 спеков» оказалось неверным дважды:
        # считалось по расширению .t27 (четверть не разбирается вовсе) и
        # включало 760 копий внутри apps/website как отдельный корпус.
        export T27C="${T27C:-$(command -v t27c)}"
        [ -x "$T27C" ] || { echo "нет t27c. Сборка: см. скилл"; exit 2; }
        D="${3:?укажите каталог}"
        find "$D" -name '*.t27' -not -path '*/scratch/*' -print0 \
          | xargs -0 -P 8 -n 1 "$T27C" spec-status 2>/dev/null \
          | awk '{print $NF}' | sort | uniq -c | sort -rn
        echo "  корпус = только IMPLEMENTED. classify отвечает на ДРУГОЙ вопрос:"
        echo "  «похоже ли на код», а не «на этом ли языке»."
        ;;
      specs)
        # КОРПУС ДЛЯ НАСТОЯЩЕЙ ЗАДАЧИ: ПИСАТЬ .t27.
        #
        # Четыре итерации ушли на «спек -> Verilog», где годных пар ноль.
        # Настоящая цель -- писать сам спек; тогда корпус это спеки, а их
        # 317 написанных. Считает t27c, а не регулярка: у них есть classify
        # (что вообще исходник) и spec-status (написан ли спек).
        T27C="${T27C:-$(command -v t27c)}"
        [ -x "$T27C" ] || { echo "нет t27c. Сборка: см. скилл t27-model-training"; exit 2; }
        D="${3:-specs}"
        "$T27C" classify --specs-dir "$D" 2>&1 | tail -14
        echo "— статус реализации —"
        find "$D" -name '*.t27' -not -path '*/scratch/*' -print0 \
          | xargs -0 -P 8 -n 1 "$T27C" spec-status 2>/dev/null \
          | awk '{print $NF}' | sort | uniq -c | sort -rn
        echo "  ОБУЧАТЬ ТОЛЬКО НА IMPLEMENTED: UNWRITTEN это скелеты,"
        echo "  они учат отвечать ничем -- тот же класс, что пустые оболочки."
        ;;
      audit)
        node "$S/audit-corpus-compiles.mjs"
        ;;
      bench)
        # ПОВЕРКА ИЗМЕРИТЕЛЯ, А НЕ МОДЕЛИ.
        #
        # VerilogEval v2 (156 задач, MIT) проверяет правильность СИМУЛЯЦИЕЙ:
        # у каждой задачи свой стенд. Прогон эталонных решений через этот же
        # прибор обязан дать ~100%: если нет -- сломан прибор, и все замеры
        # модели после него будут враньём.
        #
        # На первом прогоне дал 0 из 12: стенды VerilogEval ссылаются в
        # $dumpvars на tb_mismatch раньше его объявления, коммерческие
        # симуляторы это прощают, а iverilog -- нет.
        B="${3:-verilogeval.json}"
        [ -f "$B" ] || { echo "нет $B -- сначала скачайте задачи (см. скилл)"; exit 2; }
        node "$S/verilogeval-score.mjs" --self-test --bench "$B"
        ;;
      floor)
        # ЕСТЬ ЛИ У БАТАРЕЙ ПОЛ: МЕРЯЮТ ЛИ ОНИ КОМПИЛЯТОР ВООБЩЕ.
        #
        # Замерено 08.09.2026: батарея score-spec-answers печатала «прибор
        # поверен», когда t27c подменили сценарием, отвечающим IMPLEMENTED на
        # всё. Эталон даёт 100% при любом компиляторе, жульник -- тоже, а
        # пустой ответ отсекается ДО вызова компилятора. Ни один ряд не
        # отличал настоящий инструмент от подставного.
        #
        # Проверка механическая и потому годится в цикл: подменяем компилятор
        # заглушкой и требуем, чтобы КАЖДАЯ батарея покраснела. Та, что
        # осталась зелёной, меряет что угодно, только не то, что обещает.
        STUB="$ROOT/bin/helpers/stub-t27c.sh"
        DS="${3:-$HOME/.cache/igla-spec-dataset}"
        [ -f "$DS/eval.jsonl" ] || { echo "нет датасета: $DS"; exit 2; }
        BLIND=0
        for INSTR in score-spec-answers score-by-execution; do
          OUT=$(T27C="$STUB" node "$S/$INSTR.mjs" \
                  --eval "$DS/eval.jsonl" --train "$DS/train.jsonl" \
                  --self-test 2>&1)
          RC=$?
          if [ $RC -eq 0 ]; then
            echo "  ⛔ $INSTR — ЗЕЛЁНАЯ без компилятора (слепа)"
            BLIND=$((BLIND+1))
          else
            echo "  ✅ $INSTR — покраснела, как и должна"
          fi
        done
        echo
        if [ "$BLIND" -gt 0 ]; then
          echo "  $BLIND батарей(и) проходят с заглушкой вместо t27c."
          echo "  Такая батарея зелена не потому, что прибор здоров."
          exit 1
        fi
        echo "  у всех батарей есть пол: заглушка их роняет"
        ;;
      selfcheck)
        # СПРАВКА И КОД РАСХОДЯТСЯ МОЛЧА -- ЭТО ПРОВЕРЯЕТСЯ, А НЕ ПОМНИТСЯ.
        #
        # За ночь igla оброс с нуля до пятнадцати подкоманд, и справка отстала:
        # описаны были ШЕСТЬ, причём именно устаревшие, а девять живых не
        # значились вовсе. Хуже: подкомандой по умолчанию оставалась `status`
        # из мёртвого Verilog-пути, так что `tri igla` без аргументов запускал
        # не то, что нужно.
        # Диапазон закрывается ЗАКРЫВАЮЩИМ esac с отступом, а не словом
        # где угодно: этот самый блок содержит слово в строке awk, и первая
        # версия стража обрывала разбор на собственном исходнике, объявляя
        # `rivals` отсутствующей в коде. Проверяющий, сломанный тем, что
        # проверяет, -- ровно тот класс, что ловился всю смену.
        code=$(awk '/case "\$\{2:-report\}"/,/^    esac/' "$ROOT/bin/tri" \
               | grep -oE '^      [a-z-]+\)' | tr -d ' )' | sort -u)
        help=$("$ROOT/bin/tri" 2>&1 | grep -oE 'tri igla [a-z-]+' | awk '{print $3}' | sort -u)
        miss=$(comm -23 <(echo "$code") <(echo "$help"))
        extra=$(comm -13 <(echo "$code") <(echo "$help"))
        [ -n "$miss" ] && { echo "⛔ igla: в коде есть, в справке нет: $miss"; exit 1; }
        [ -n "$extra" ] && { echo "⛔ igla: в справке есть, в коде нет: $extra"; exit 1; }

        # ВЕРХНИЙ УРОВЕНЬ ТОЖЕ. Дрейф нашёлся в igla, но ничто не охраняло
        # остальные двадцать пять команд -- они совпали по счастливой
        # случайности, а не потому, что кто-то следил.
        # main тем временем завёл команды с цифрами (`a2a`) и совмещённые
        # кейсы (`crm-ingest|crm-leads)`); первая версия стража кричала
        # ⛔ на оба -- проверяющий обязан разбирать стиль проверяемого.
        tcode=$(awk '/^case "\$\{1:-\}" in/,/^esac/' "$ROOT/bin/tri" \
                | grep -oE '^  [a-z0-9-]+(\|[a-z0-9-]+)*\)' | tr -d ' )' \
                | tr '|' '\n' | sort -u)
        thelp=$("$ROOT/bin/tri" 2>&1 | grep -oE '^  tri [a-z0-9-]+' \
                | awk '{print $2}' | sort -u)
        tmiss=$(comm -23 <(echo "$tcode") <(echo "$thelp"))
        textra=$(comm -13 <(echo "$tcode") <(echo "$thelp"))
        [ -n "$tmiss" ] && { echo "⛔ верхний уровень: в коде есть, в справке нет: $tmiss"; exit 1; }
        [ -n "$textra" ] && { echo "⛔ верхний уровень: в справке есть, в коде нет: $textra"; exit 1; }

        # ИЗМЕНЧИВЫЕ ЧИСЛА В СПРАВКЕ. Строка «сегодня 0 из 31» устаревала уже
        # дважды: справка обязана говорить, ЧТО команда делает, а не что она
        # сейчас отвечает. Числа-пороги (Node 20, AST > 1 МБ) остаются -- они
        # свойства инструмента, а не его вывод.
        stale=$("$ROOT/bin/tri" 2>&1 | grep -nE 'сегодня|сейчас [0-9]|уже [0-9]+ из' || true)
        [ -n "$stale" ] && { echo "⛔ справка цитирует результат, а он устареет:"; echo "$stale"; exit 1; }

        echo "✅ справка и код совпадают: $(echo "$code" | wc -w | tr -d ' ') подкоманд igla, $(echo "$tcode" | wc -w | tr -d ' ') команд верхнего уровня"
        ;;
      rivals)
        # КТО УЖЕ РЕШАЕТ ЭТУ ЗАДАЧУ.
        #
        # Заведено 08.09.2026, когда выяснилось, что генерация Verilog из
        # спецификации -- отдельная область с эталоном и датасетами, а мы
        # собирались учить язык заново на 26 примерах. Команда есть, чтобы
        # разрыв пересчитывался, а не помнился: и наш корпус, и чужие растут.
        echo "— эталон и датасеты (HF) —"
        for d in dakies/nvlabs-verilogeval-v2-spec-to-rtl GaTech-EIC/MG-Verilog \
                 bnadimi/PyraNet-Verilog davide221/verilog-instruct-60k; do
          curl -sL --max-time 20 "https://huggingface.co/api/datasets/$d" \
          | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
              try{const x=JSON.parse(s),c=x.cardData||{};
              console.log("  "+(x.id||"?").padEnd(46)+" лицензия="+(c.license||"НЕ УКАЗАНА"));
              }catch(e){console.log("  ?")}})'
        done
        echo "— наш корпус против них —"
        echo "  verilog-instruct-60k: 60199 примеров | наш: 26 обучение / 7 оценка"
        echo "  разрыв ~2300x -- учить Verilog с нуля на нашем корпусе нельзя,"
        echo "  брать базу линии RTLCoder/VeriReason и адаптировать ДИАЛЕКТ t27."
        echo "  ВНИМАНИЕ: PyraNet -- CC-BY-NC-SA, коммерчески использовать нельзя."
        ;;
      *) echo "tri igla {pairs|dataset [макс_токенов]|status|rivals}"; exit 2 ;;
    esac
    ;;
  fresh)    fresh ;;
  disk)     bash "$LOOP/check-free-disk.sh" && bash "$LOOP/free-disk.sh" ;;
  pipeline) (cd "$RENDER" && npx tsx scripts/pipeline-check.ts) ;;
  card)   shift; bash "$ROOT/bin/helpers/card.sh" "$ROOT" "$@" ;;
  prices)   (cd "$RENDER" && npx tsx scripts/prices.ts) ;;
  # The margin of every image and video the code can sell, from the code's
  # own tables: no network, no tokens. Exit 1 when any sale is below cost.
  margin)   (cd "$RENDER" && npx tsx scripts/margin.ts) ;;
  feed)
    # В ЛЕНТЕ НЕТ ССЫЛОК НА ПОСТЫ — ни в вебе, ни в приложении. Сослаться на
    # конкретный ролик из интерфейса нечем, поэтому id достаём отсюда.
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    if [ -z "$KEY" ]; then echo "нет RENDER_API_KEY в окружении сервиса"; exit 1; fi
    curl -s -m 30 "https://vibee-render-production.up.railway.app/api/feed?limit=100" \
      -H "X-Api-Key: $KEY" | python3 "$ROOT/bin/helpers/feed.py" ;;
  blind)
    shift
    [ $# -eq 4 ] || { echo "tri blind <файл> <было> <стало> <тест>"; exit 1; }
    mutate "$1" "$2" "$3" "$4"
    ;;

  entry)
    # ДВЕРИ ВХОДА. Пять маршрутов, каждый обязан отказывать мусору внятно, а
    # pair/claim — ещё и тормозить: он не требует личности и не может.
    B="https://vibee-render-production.up.railway.app"
    echo "— чем отвечают на мусор —"
    for P in /api/auth/telegram /api/auth/widget /api/auth/refresh /api/auth/pair/claim; do
      code=$(curl -s -o /tmp/tri-entry -w "%{http_code}" --max-time 25 -X POST "$B$P" -H "Content-Type: application/json" -d "{}")
      printf "%-26s %s  %s\n" "$P" "$code" "$(head -c 90 /tmp/tri-entry)"
    done
    echo
    echo "— тормоз на дверях —"
    for P in pair/claim auth/refresh auth/widget auth/telegram; do
      if grep -q "пуститьВход" apps/vibee-editor/render/session-routes.ts; then
        echo "  $P: тормоз есть"
      else
        echo "  $P: НЕТ — поток ничем не ограничен"
      fi
    done
    echo "— длина кода —"
    grep -n "DIGITS:" apps/vibee-editor/render/session-store.ts | head -1
    ;;

  throttle)
    # ЗА ЧЕЙ АДРЕС СЧИТАЕМ. Урок 07.09.2026, ошибка моя же.
    #
    # Railway обрывает TLS у себя и идёт в контейнер сам, поэтому
    # `remoteAddress` -- адрес ПРОКСИ, один на всех. Лимит, ключом которого
    # служит только он, считает всю платформу за одного человека: десять
    # попыток в минуту -- и вход закрыт всем сразу. Это не защита, это авария,
    # и выглядит она в точности как атака, которую защита должна была отбить.
    #
    # Правильная форма -- два ключа: узкий лимит на клиента (левый
    # X-Forwarded-For, подделываемый) и широкий потолок на соединение
    # (неподделываемый). Команда показывает, какая форма в коде сейчас.
    echo "— ключи лимитов —"
    grep -rn "remoteAddress" apps/vibee-editor/render --include="*.ts" \
      | grep -v node_modules | grep -v ".test.ts" \
      | sed 's|apps/vibee-editor/render/||'
    echo
    echo "— доходит ли X-Forwarded-For до контейнера —"
    # Единственная проверка, которую нельзя сделать из кода: дюжина запросов с
    # одного адреса. 429 после десятого -- заголовок доходит, ключ клиента
    # живой. Сплошные 400 -- заголовка нет, работает только потолок канала.
    B="https://vibee-render-production.up.railway.app"
    printf "  "
    for i in $(seq 1 12); do
      printf "%s " "$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 \
        -X POST "$B/api/auth/refresh" -H 'Content-Type: application/json' -d '{}')"
    done
    echo
    echo "— есть ли разделение клиент/канал —"
    if grep -q "ПОТОЛОК_КАНАЛА" apps/vibee-editor/render/src/entry-throttle.ts 2>/dev/null; then
      grep -n "ПОПЫТОК_В_ОКНЕ = \|ПОТОЛОК_КАНАЛА = \|ОКНО_МС = " \
        apps/vibee-editor/render/src/entry-throttle.ts
    else
      echo "  НЕТ потолка канала: лимит считает всех за прокси как одного"
    fi
    ;;

  session)
    # ЖИЗНЬ СЕССИИ: сроки, окно гонки и то, как на неё отвечают три клиента.
    #
    # Урок 07.09.2026: повторное предъявление refresh-токена читалось как
    # кража и гасило ВСЮ семью. Но две вкладки одного браузера держат общий
    # токен в localStorage и обновляются с разницей в миллисекунды -- то есть
    # человека выкидывало из приложения ежедневно, без злоумышленника.
    # Различает их не факт повтора, а ПРОМЕЖУТОК.
    R=apps/vibee-editor/render
    echo "— сроки —"
    grep -n "ACCESS_TTL_SECONDS = \|REFRESH_TTL_SECONDS = \|REUSE_GRACE_SECONDS = " \
      "$R/session.ts" | sed 's|^|  |'
    echo "— как отвечают на гонку —"
    for F in "$R/session-routes.ts:сервер" \
             "apps/vibee-editor/player/src/lib/appSession.ts:мини-апп" \
             "apps/vibee-ios/Vibee/Identity.swift:iOS"; do
      # ИМЕНА ТОЛЬКО ASCII. Кириллическая переменная в bash -- это "command
      # not found", и цикл продолжает крутиться дальше: здесь он напечатал
      # "НЕТ" про все три клиента, то есть выдал уверенную ложь вместо ошибки.
      FILE="${F%%:*}"; NAME="${F##*:}"
      if [ ! -f "$FILE" ]; then
        echo "  $NAME: файла нет ($FILE) -- проверка НЕ выполнена"
      elif grep -q "auth_refresh_raced" "$FILE"; then
        echo "  $NAME: гонка отличается от кражи"
      else
        echo "  $NAME: НЕТ -- повтор читается как кража, человека выбросит"
      fi
    done
    echo "— выход гасит семью, а не одну сессию —"
    if grep -q "SELECT family_id FROM app_sessions" "$R/session-routes.ts"; then
      echo "  да"
    else
      echo "  НЕТ -- после «Выйти» может остаться живой 60-дневный токен"
    fi
    ;;

  crm-source)
    # ИЗ КАКОЙ КОПИИ CRM СЧИТАЕТ ДЕНЬГИ.
    #
    # `users` и `payments_v2` лежат ДВАЖДЫ: в облачном Supabase и в Postgres
    # на Railway. Замер 08.09.2026: копии разошлись -- платежи в Railway
    # отставали на 12 дней, -- а `crm-tools.ts` читает Supabase, тогда как все
    # остальные таблицы агента (tg_sessions, hive_events, crm_touches) на
    # Railway. Инструмент продаж, смотрящий в отставшую копию, показывает
    # позапрошлую выручку как сегодняшнюю.
    #
    # Код возврата 1, если CRM читает НЕ самую свежую копию.
    railway service postgres-nfrq >/dev/null 2>&1 || {
      echo "нет доступа к сервису базы"; exit 2; }
    DB=$(railway variables --kv 2>/dev/null | grep -E "^DATABASE_PUBLIC_URL=" | head -1 | cut -d= -f2-)
    railway service vibee-render >/dev/null 2>&1 || {
      echo "нет доступа к vibee-render"; exit 2; }
    SU=$(railway variables --kv 2>/dev/null | grep '^SUPABASE_URL=' | head -1 | cut -d= -f2-)
    SK=$(railway variables --kv 2>/dev/null | grep '^SUPABASE_SERVICE_KEY=' | head -1 | cut -d= -f2-)
    if [ -z "$DB" ] || [ -z "$SU" ] || [ -z "$SK" ]; then
      echo "не прочитались доступы -- проверка НЕ выполнена"; exit 2; fi
    (cd "$RENDER" && DB="$DB" SU="$SU" SK="$SK" node "$ROOT/bin/helpers/crm-source.mjs")
    ;;

  schema)
    # СХЕМА В КОДЕ ПРОТИВ СХЕМЫ В БАЗЕ.
    #
    # `CREATE TABLE IF NOT EXISTS` на существующей базе не выполняется вовсе:
    # объявление и прод расходятся молча и живут так годами. Вылезает это в
    # день пересоздания базы -- на новом окружении, на стенде, при
    # восстановлении, -- то есть в худший день из возможных.
    railway service postgres-nfrq >/dev/null 2>&1 || {
      echo "нет доступа к сервису базы"; exit 1; }
    URL=$(railway variables --kv 2>/dev/null | grep -E "^DATABASE_PUBLIC_URL=" | head -1 | cut -d= -f2-)
    if [ -z "$URL" ]; then echo "нет DATABASE_PUBLIC_URL -- проверка НЕ выполнена"; exit 1; fi
    echo "— вход (session-store.ts) —"
    (cd "$RENDER" && DB="$URL" node "$ROOT/bin/helpers/schema-drift.mjs" session-store.ts)
    ;;

  pairing)
    # ДЛИНА КОДА ВХОДА: СЕРВЕР ПРОТИВ КЛИЕНТОВ.
    #
    # Урок 07.09.2026, регрессия моя же. Длину подняли с шести цифр до восьми
    # ради стойкости -- серверной правкой, с тестом и мутацией. Клиентов никто
    # не посмотрел: поле iOS обрезало ввод на шестой цифре, и вход в
    # приложение не работал ВООБЩЕ. Серверное ужесточение убило клиентскую
    # дверь, и это не заметил ни один тест.
    R=apps/vibee-editor/render
    echo "— сервер —"
    grep -n "DIGITS:" "$R/session-store.ts" | sed 's|^|  |'
    echo "— что отвечает живой сервер на пустой код —"
    curl -s --max-time 25 -X POST \
      "https://vibee-render-production.up.railway.app/api/auth/pair/claim" \
      -H "Content-Type: application/json" -d '{"code":""}' | head -c 120; echo
    echo "— копии длины у клиентов (их не должно быть) —"
    python3 "$ROOT/bin/helpers/code-length-copies.py" \
      apps/vibee-ios/Vibee/SignIn.swift \
      apps/vibee-ios/Vibee/Identity.swift \
      apps/vibee-editor/player/src/components/Profile/PairWithApp.tsx \
      src/commands/appLoginCommand.ts
    ;;

  tma)
    # ПОСМОТРЕТЬ ЭКРАНЫ ВХОДА МИНИ-АППА ГЛАЗАМИ.
    #
    # Урок 07.09.2026: вне Telegram мини-апп экраны входа не показывает вовсе,
    # поэтому правки в них шли вслепую -- и дважды стоили входа на iOS. Теперь
    # есть подставка для разработки; команда печатает готовые адреса.
    #
    # Подставка вырезается из ЛЮБОЙ сборки плагином Vite, и это проверяется
    # тестом, который собирает бандл и ищет метку.
    PORT="${VIBEE_PORT:-5174}"
    echo "— адреса (dev-сервер на :$PORT) —"
    echo "  профиль:        http://localhost:$PORT/profile?mock-telegram=144022504"
    echo "  экран кода:     http://localhost:$PORT/profile?mock-telegram=144022504&mock-username=t27_dev&mock-pair-code=12345678"
    echo "  без @имени:     http://localhost:$PORT/profile?mock-telegram=999000111"
    echo
    echo "— жив ли dev-сервер —"
    if curl -s -o /dev/null -m 5 "http://localhost:$PORT/"; then
      echo "  отвечает"
    else
      echo "  НЕ отвечает: npm run dev в apps/vibee-editor/player"
    fi
    echo "— берёт ли мини-апп сессию —"
    # Урок 07.09.2026: /api/auth/telegram не звал никто, и вся работа вокруг
    # сессий касалась только веба. Проверка смотрит, что вызов на месте.
    if grep -q "exchangeTelegramLaunch(initData)" \
      apps/vibee-editor/player/src/components/Telegram/TelegramProvider.tsx; then
      echo "  обмен подписи на сессию есть"
    else
      echo "  НЕТ -- мини-апп работает только по заголовку подписи"
    fi
    echo "— кнопки, которые отменяет соседний код —"
    # Урок 07.09.2026: «Выйти» внутри Telegram чистила память, а автологин
    # возвращал человека за доли секунды. Кнопка не сломана -- она лишняя там,
    # где отменяющий механизм работает.
    if grep -q "onLogout={getAppAccessToken() ? handleLogout : undefined}" \
      apps/vibee-editor/player/src/components/Header/Header.tsx; then
      echo "  выход показывается только при сессии браузера"
    else
      echo "  ВЫХОД БЕЗУСЛОВЕН -- внутри Telegram он не может сработать"
    fi
    echo "— вырезана ли подставка из сборки —"
    if grep -q "вырезатьПодставнойTelegram" apps/vibee-editor/player/vite.config.ts; then
      echo "  плагин на месте (проверка: telegram-dev-mock.test.ts)"
    else
      echo "  НЕТ ПЛАГИНА -- подставка уедет в продакшен"
    fi
    ;;

  in-bundle) shift; bash "$ROOT/bin/helpers/in-bundle.sh" "$ROOT" "$@" ;;
  work-report) shift; bash "$ROOT/bin/helpers/work-report.sh" "$@" ;;
  a2a) shift; bash "$ROOT/bin/helpers/a2a.sh" "$ROOT" "$@" ;;
  remote-check) shift; bash "$ROOT/bin/helpers/remote-check.sh" "$ROOT" "$@" ;;
  bench) shift; bash "$ROOT/bin/helpers/bench.sh" "$ROOT" "$@" ;;
  lesson) shift; bash "$ROOT/bin/helpers/lesson.sh" "$ROOT" "$@" ;;
  deployed) shift; bash "$ROOT/bin/helpers/deployed.sh" "$ROOT" "$@" ;;
  journal) shift; bash "$ROOT/bin/helpers/journal.sh" "$ROOT" "$@" ;;
  flaky)  shift; bash "$ROOT/bin/helpers/flaky.sh" "$ROOT" "$@" ;;
  main-guard) shift; bash "$ROOT/bin/helpers/main-guard.sh" "$ROOT" "$@" ;;
  eyes)   shift; bash "$ROOT/bin/helpers/eyes.sh" "$ROOT" "$@" ;;
  drift)
    # Merged is not shipped. 0 clear, 1 an anomaly (named), 2 could not look.
    shift; node "$ROOT/scripts/railway-drift.mjs" "$@" ;;

  shipped)
    # Уехало ли в прод -- и пользуется ли им кто-нибудь. Два разных вопроса.
    bash "$ROOT/bin/helpers/shipped.sh"
    ;;

  app-smoke)
    # Маршруты и заголовки app.t27.ai, от которых зависят боты, iOS, OAuth и
    # медиа. Только чтение. 0 -- прошло, 1 -- изменилось, 2 -- НЕ проверено.
    shift
    bash "$ROOT/bin/helpers/app-t27-smoke.sh" "$@"
    ;;

  space)
    # МЕСТО — БЕЗ ОБХОДА ВСЕГО ДИСКА.
    #
    # 07.09.2026 цикл встал на ENOSPC: оболочка создаёт файл под вывод ДО
    # команды, поэтому при полном диске не стартует ничего, включая чистилку.
    # Смысл этой команды -- увидеть подход к обрыву РАНЬШЕ него.
    #
    # `du` по домашнему каталогу тут не годится: он идёт минутами и сам
    # упирается в тайм-аут. Смотрим только то, что мы же и создаём.
    echo "— тома —"
    df -h / /System/Volumes/Data 2>/dev/null | awk 'NR==1 || /disk/ {print "  "$0}'
    FREE_MB=$(df -m / | awk 'NR==2 {print $4}')
    if [ "${FREE_MB:-0}" -lt 2048 ]; then
      echo "  МАЛО: ${FREE_MB} МБ. Сборка iOS откажется работать (и правильно)."
    fi
    echo "— что создаём мы и можно вернуть —"
    # Стенограммы агентов добавлены 07.09.2026: за один заход они съели 7 ГБ и
    # уронили цикл в ENOSPC ДВАЖДЫ. Прошлая версия списка их не знала, поэтому
    # команда показывала «всё в порядке» ровно тогда, когда всё было не в
    # порядке. Диск забивает не только сборка.
    # Каталог сборки cargo добавлен 08.09.2026: 686 МБ, оставленные в
    # песочнице, за шесть итераций довели диск до ENOSPC в ТРЕТИЙ раз. Список
    # снова не знал виновника -- как не знал стенограмм накануне. Он растёт
    # только задним числом, и это его главное ограничение: он видит то, чем
    # диск забивали ПРОШЛЫЙ раз.
    #
    # ~/.cache/zig добавлен в тот же день и оказался быстрее всех прочих
    # вместе взятых: 2.2 ГБ примерно за час. Причина -- восемь агентов,
    # гоняющих `t27c test-report`; каждый вызов компилирует Zig, а кэш у Zig
    # ОБЩИЙ и не подрезается сам. Замерено: 200 МБ в минуту, то есть от
    # спокойного гигабайта до обрыва -- пять минут.
    #
    # Отсюда правило, которого в списке не было: считать не только то, что
    # создаёшь ТЫ, но и то, что создают ТВОИ ИНСТРУМЕНТЫ, когда их много.
    for D in "$ROOT/apps/vibee-ios/build2" /tmp/dd "$ROOT/.vite-cache" \
             "$ROOT/.claude/worktrees" "$HOME/Library/Developer/Xcode/DerivedData" \
             "/private/tmp/claude-501" \
             "$HOME/.cache/t27-build" "$HOME/.cargo/registry" \
             "$HOME/.cache/zig" \
             "${TMPDIR:-/tmp}" \
             "$HOME/.claude/projects"; do
      [ -e "$D" ] && printf "  %-52s %s\n" "$D" "$(du -sh "$D" 2>/dev/null | cut -f1)"
    done
    # ИТОГ ВИДЕН, ВИНОВНИК -- НЕТ.
    #
    # 08.09.2026 эта команда честно печатала «/private/tmp/claude-501 1.4G» в
    # каждом прогоне. Строку читали, внутрь не заглядывали -- а там лежали
    # t27copy (634 МБ) и t27build (628 МБ), два забытых клона с каталогами
    # сборки. Искали t27target, тот единственный, что помнили, и не нашли
    # двух других.
    #
    # Одно число на большой каталог не помогает: оно велико всегда. Поэтому
    # три самых крупных ребёнка называются поимённо -- ровно на один уровень,
    # чтобы не превратить команду в обход диска, которого она избегает.
    for BIG in "/private/tmp/claude-501" "$HOME/.claude/projects"; do
      [ -d "$BIG" ] || continue
      SUB=$(du -sm "$BIG"/*/*/ 2>/dev/null | sort -rn | awk '$1>=100' | head -3)
      # A header with nothing under it reads as "checked, all clear" -- which is
      # the same lie as a truncated report. Print it only when there is a line.
      [ -n "$SUB" ] || continue
      echo "  крупнейшее внутри $(basename "$BIG"):"
      echo "$SUB" | while read -r MB PATHNAME; do
        [ "${MB:-0}" -ge 100 ] || continue
        printf "    %5s МБ  %s\n" "$MB" "${PATHNAME#$BIG/}"
        CHILD=$(du -sm "$PATHNAME"/* 2>/dev/null | sort -rn | head -2)
        echo "$CHILD" | while read -r CMB CPATH; do
          [ "${CMB:-0}" -ge 100 ] || continue
          printf "             %5s МБ  %s\n" "$CMB" "${CPATH#$PATHNAME/}"
        done
      done
    done
    echo "  (worktrees могут содержать несохранённую работу -- см. tri worktrees)"
    echo "— вернуть место, ничего своего не теряя —"
    echo "  rm -rf /private/tmp/claude-501 \$HOME/.claude/projects/*/*/subagents/workflows/wf_*"
    ;;

  hive)
    # УЛЕЙ: КТО СМОТРИТЕЛЬ, ЖИВ ЛИ ЖУРНАЛ, ИДУТ ЛИ ОТЧЁТЫ.
    #
    # Заведено 07.09.2026. Причина в другом репозитории: в trios лежат два
    # append-only журнала, `gardener_decisions` и `railway_audit_events`, и у
    # ОБОИХ ноль читателей -- ничего из них не выбирает. Журнал умирает не от
    # ошибки, а от того, что в него перестают смотреть. Эта команда и есть
    # способ смотреть.
    echo "— роли —"
    # НАЗВАТЬ СЕРВИС, А НЕ НАДЕЯТЬСЯ НА ПРИВЯЗАННЫЙ.
    #
    # Строка ниже говорила «НЕ ЗАДАН на vibee-render», а читала переменные
    # ТОГО сервиса, что привязан прямо сейчас. 20.09.2026 привязан был бот —
    # и команда доложила, что смотрителя нет, хотя на vibee-render он задан.
    # Я поверил своему же инструменту и полез чинить то, что не сломано.
    # Вывод, который называет место, обязан это место и прочитать.
    railway service vibee-render >/dev/null 2>&1
    V=$(railway variables --kv 2>/dev/null | grep '^HIVE_KEEPERS=' | cut -d= -f2-)
    if [ -z "$V" ]; then
      echo "  HIVE_KEEPERS НЕ ЗАДАН на vibee-render -- смотрителя нет,"
      echo "  отчёты выключены, супер-админ видит только свои события."
    else
      echo "  смотрителей: $(echo "$V" | tr ',' '\n' | grep -c .) (…${V: -4})"
    fi
    echo "— проверки улья —"
    export PATH="$HOME/.nvm/versions/node/v20.19.0/bin:$PATH"
    npx vitest run apps/vibee-editor/render/hive-*.test.ts 2>&1 |
      grep -E "Tests |FAIL" | sed "s|^|  |"
    echo "— места, откуда события приходят —"
    printf "  %-28s %s\n" "эмиссия в коде:" \
      "$(grep -rn 'записать(pool' apps/vibee-editor/render --include='*.ts' 2>/dev/null | grep -vc test)"
    echo "  (31 место найдено разведкой; подключено меньше -- остальное впереди)"
    ;;

  worktrees)
    # БРОШЕННЫЕ КОПИИ РЕПОЗИТОРИЯ. Обнаружено 07.09.2026: `find` по имени
    # файла вывел копию из `.claude/worktrees/`, и я едва не измерил не тот
    # файл. Плюс 286 МБ на диске, который этот цикл уже забивал до нуля.
    #
    # Команда НЕ УДАЛЯЕТ: в брошенной копии может лежать несохранённая работа.
    # Она показывает, что есть, и оставляет решение человеку.
    echo "— копии репозитория —"
    git worktree list | sed "s|^|  |"
    if [ -d "$ROOT/.claude/worktrees" ]; then
      echo "— вес —"
      du -sh "$ROOT/.claude/worktrees" 2>/dev/null | sed "s|^|  |"
      echo "  удалять: git worktree remove <путь>  (сначала посмотрите git -C <путь> status)"
    fi
    ;;

  guards)
    # ЖИВЫ ЛИ СТОРОЖА. Урок 07.09.2026: пять денежных сторожей падали
    # НЕДЕЛЯМИ, и падение выглядело как находка -- «набор мест, способных
    # списать деньги, изменился». Причина была в скрипте, звавшем
    # process.exit() сразу после печати: вывод обрубался на буфере канала.
    #
    # Отдельная команда нужна потому, что в общем прогоне это тонет: файлов
    # 450, и красное среди них не замечают.
    echo "— перепись мест списания читается целиком —"
    LEN=$(node .claude/loop-opus/money-map.mjs --json 2>/dev/null | wc -c | tr -d ' ')
    if [ "${LEN:-0}" -le 8192 ]; then
      echo "  ОБРЫВ на $LEN байт -- сторожа слепы (ищите process.exit после печати)"
    else
      echo "  целиком: $LEN байт"
    fi
    echo "— исполняется ли приём денег, а не только его форма —"
    # Урок 07.09.2026: вокруг вебхука Робокассы было 32 теста, и ни один не
    # импортировал маршрут; ещё четыре файла читали его ИСХОДНЫЙ ТЕКСТ.
    # Форма -- не поведение: переделка, сохранившая форму, прошла бы насквозь.
    if [ -f src/__tests__/money/robokassa-webhook-behaviour.test.ts ]; then
      echo "  поведенческий тест на месте"
    else
      echo "  НЕТ -- приём денег проверяется только по форме"
    fi
    echo "— удаление чужих файлов проверяется исполнением —"
    # Урок 07.09.2026: защита от «удалить чужое» -- одно условие в запросе, и
    # стереглось оно только по тексту. Текстовый сторож сам писал, что не
    # проверяет верность самой проверки.
    if [ -f "$RENDER/delete-own-photo.test.ts" ]; then
      echo "  поведенческий тест на месте"
    else
      echo "  НЕТ -- чужие файлы охраняются только формой"
    fi
    echo "— денежные сторожа —"
    # ТРЕТЬЕ СОСТОЯНИЕ ОБЯЗАТЕЛЬНО.
    #
    # Первая версия просто фильтровала вывод vitest и при неудаче запуска
    # печатала ПУСТОТУ -- неотличимо от «сторожа молчат». А не запускался он
    # буднично: без нужной версии node в PATH. Сначала проверяем, что прогон
    # вообще состоялся.
    OUT="$(cd "$ROOT" && npx vitest run src/__tests__/money 2>&1)"
    SUMMARY="$(printf '%s' "$OUT" | grep -aE "Tests +[0-9]" | tail -1)"
    if [ -z "$SUMMARY" ]; then
      echo "  прогон НЕ состоялся -- проверка не выполнена"
      printf '%s' "$OUT" | tail -3 | sed "s|^|    |"
    else
      printf '%s' "$OUT" | grep -aE "Test Files|Tests +[0-9]" | tail -2 | sed "s|^|  |"
    fi
    ;;

  feed-hide)
    # СКРЫТЬ ВСЁ, КРОМЕ ОДНОГО. Скрытие обратимо: маршрут ставит `deleted_at`,
    # а повторная публикация того же имени его снимает. Удаления здесь нет и
    # быть не должно — вернуть удалённое неоткуда.
    #
    # id того, что ОСТАЁТСЯ, передаётся руками и обязателен. Угаданный выбор
    # владелец заметит не сразу, а лента — это чужие глаза.
    KEEP="${2:-}"
    if [ -z "$KEEP" ]; then
      echo "нужен id поста, который остаётся: tri feed-hide <id>"; exit 1
    fi
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    if [ -z "$KEY" ]; then echo "нет RENDER_API_KEY в окружении сервиса"; exit 1; fi
    BASE="https://vibee-render-production.up.railway.app"
    # Владельца берём у самого поста, который оставляем: скрывать можно только
    # своё, и сервер это проверяет тем же UPDATE. Мы лишь не шлём заведомо
    # чужие запросы.
    OWNER=$(curl -s -m 30 "$BASE/api/feed/$KEEP" -H "X-Api-Key: $KEY" \
             | python3 -c "import json,sys; print(json.load(sys.stdin).get('telegramId',''))")
    if [ -z "$OWNER" ]; then echo "поста $KEEP нет — ничего не трогаю"; exit 1; fi
    echo "оставляю id $KEEP (владелец $OWNER); остальное скрываю по всем аккаунтам ленты"
    # ВСЕ ВЛАДЕЛЬЦЫ, А НЕ ТОЛЬКО ХОЗЯИН СОХРАНЯЕМОГО ПОСТА.
    #
    # Первая версия брала владельца у сохраняемого поста и трогала только его
    # строки. В ленте после уборки осталось ДВА поста: нужный и чужой — от
    # `@vibee_agent`, аккаунта нашего же агента. Команда о нём промолчала, и
    # «готово» означало «почти готово».
    #
    # Теперь идём по всем аккаунтам, которые видны в ленте, и КАЖДЫЙ называем
    # вслух: скрытие в публичной ленте нельзя делать молча, даже когда
    # скрывать правильно.
    #
    # СПИСОК БЕРЁМ ИЗ ПРОФИЛЯ, А НЕ ИЗ ЛЕНТЫ.
    #
    # Лента с недавних пор отдаёт ОДНУ запись на шаблон — иначе сорок три
    # карточки одного шаблона были спамом. Для скрытия это ровно неверный
    # список: по нему скрылись бы три поста из сорока шести, и выглядело бы
    # как «сработало».
    #
    # Профиль отдаёт все свои, страницами по 20; идём страницами, пока они не
    # кончатся.
    : > /tmp/tri-hide-pairs
    # Аккаунты берём из самой ленты: там видно всех, кто в ней стоит.
    curl -s -m 30 "$BASE/api/feed?limit=200" -H "X-Api-Key: $KEY" \
      | python3 -c "
import json,sys
seen=set()
for t in json.load(sys.stdin).get('templates') or []:
    tid=str(t.get('telegramId') or '')
    if tid and tid not in seen:
        seen.add(tid)
        print(tid, t.get('creatorUsername') or '')
" > /tmp/tri-hide-owners
    while read -r TID UNAME; do
      [ -n "$UNAME" ] || continue
      echo "  аккаунт @$UNAME ($TID)"
      PAGE=0
      while [ "$PAGE" -lt 20 ]; do
        GOT=$(curl -s -m 30 "$BASE/api/users/$UNAME/templates?page=$PAGE&limit=20" \
              | python3 -c "
import json,sys
data=json.load(sys.stdin)
ts=data.get('templates') or []
for t in ts:
    if str(t.get('id'))!='$KEEP':
        print('$TID', t['id'])
sys.stderr.write(str(len(ts)))
" 2>/tmp/tri-hide-count)
        echo "$GOT" >> /tmp/tri-hide-pairs
        [ "$(cat /tmp/tri-hide-count)" = "20" ] || break
        PAGE=$((PAGE + 1))
      done
    done < /tmp/tri-hide-owners
    grep -E '^[0-9]+ [0-9]+$' /tmp/tri-hide-pairs | sort -u | while read -r TID ID; do
        ANSWER=$(curl -s -m 30 -X DELETE "$BASE/api/feed/$ID?telegram_id=$TID" -H "X-Api-Key: $KEY")
        echo "  $ID -> $ANSWER"
      done
    echo "готово. вернуть можно повторной публикацией — скрытие обратимо" ;;
  turn-time)
    bash "$ROOT/bin/helpers/turn-time.sh" "$ROOT" "${2:-200}" ;;
  deadlines)
    bash "$ROOT/bin/helpers/deadlines.sh" "$ROOT" "${2:-}" ;;
  orphans)
    bash "$ROOT/bin/helpers/orphans.sh" "$ROOT" "${2:-200}" ;;
  crm-waiting)
    # Who is waiting for an answer, from production, as the owner. Read-only.
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY not readable"; exit 1; }
    # The answer travels in an env var, not on stdin: `python3 -` takes its
    # script from stdin, so a heredoc there would displace the pipe.
    ANSWER=$(curl -s "https://vibee-render-production.up.railway.app/mcp?telegram_id=144022504" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"crm_waiting","arguments":{}}}')
    ANSWER="$ANSWER" python3 - <<'PYEOF'
import json, os
r = json.loads(os.environ['ANSWER']); res = r.get('result', {})
s = res.get('structuredContent') or json.loads(res['content'][0]['text'])
print(f"ждут: {s.get('total')}  ours={s.get('ours')} due={s.get('due')} theirs={s.get('theirs')}")
for w in s.get('waiting', [])[:20]:
    who = w.get('name') or w.get('telegram_id')
    print(f"  [{w.get('waiting')}] {w.get('days')}д  {who}  {w.get('stage')}  — {w.get('because')}")
print(s.get('what_to_do', ''))
PYEOF
    ;;
  crm-pitch)
    # What the personal seller would say, LOCALLY: no network, no invoice
    # minted, no row written. Price from the one scale; the link is a
    # placeholder. Usage: tri crm-pitch <name> [tokens] [note]
    NAME="${2:-}"; TOK="${3:-50}"; NOTE="${4:-}"
    (cd "$RENDER" && npx tsx -e '
      const { composePitch } = require("./src/agent/crm-offer-tool.ts");
      const { ценаТокенов } = require("./src/agent/token-packs.ts");
      const [name, tok, note] = process.argv.slice(1);
      const p = ценаТокенов(Number(tok));
      console.log(composePitch({ name: name || null, tokens: p.токенов, stars: p.звёзд, url: "https://t.me/$invoice-link-here", note: note || undefined }));
      console.log("\n— цена по шкале:", p.токенов, "токенов =", p.звёзд, "⭐️");
    ' -- "$NAME" "$TOK" "$NOTE")
    ;;
  bridge)
    # РАДУЖНЫЙ МОСТ: вся ферма и обе стороны за один проход, параллельно.
    #
    # Владелец, 20.09.2026: «мы тестим вдвоём с двух аккаунтов — это радужный
    # мост, через него всегда проверяются все функции с двух сторон. Придумай,
    # как ускорить: все функции через юзер-ботов параллельно».
    #
    # Медленной была не проверка, а то, что каждая — это человек, печатающий в
    # чат, по одному боту за раз; к десятому уже не помнишь, что ответил
    # третий. Здесь ферма обходится параллельно и печатается матрица.
    #
    # НИ ОДНОГО СООБЩЕНИЯ ЧЕЛОВЕКУ не уходит: сторона ботов — читающий Bot API,
    # сторона агента — чат рендера по ключу сервиса. Поэтому это можно гонять
    # хоть сто раз в день. Чего так проверить НЕЛЬЗЯ — печатается отдельно.
    #
    # Запускать на сервисе бота: там и токены ботов, и RENDER_API_KEY.
    #
    # `--service`, never `railway service`: the link is per directory and
    # shared by every session in this checkout (see `commands` below).
    shift
    bash "$ROOT/bin/helpers/fresh-for-tokens.sh" "$ROOT" || exit 3
    railway run --service 999-multibots-telegraf -- \
      node "$ROOT/scripts/bridge.cjs" "$@"
    ;;

  pack)
    # IS THIS CLIENT PACKAGED, and what is the next press for each part.
    # Profile, SOUL, content plan, seller, wallet, duets, and the parts only
    # the person can do -- read-only over the server key, sends nothing.
    # First case, 2026-09-21: plan 0 of 14 and a platform-written SOUL eight
    # days after the package was installed.
    shift
    bash "$ROOT/bin/helpers/fresh-for-tokens.sh" "$ROOT" || exit 3
    railway run --service 999-multibots-telegraf -- \
      node "$ROOT/scripts/client-pack.cjs" "$@"
    ;;

  agents)
    # DO THE FIVE MARKETPLACE AGENTS WORK FOR THE OWNER (#2959).
    #
    # One draft-only canary per agent on the live service, as the owner.
    # PASS: it answered in its own words and called one of its tools. FAIL:
    # anything that publishes, sends or spends. The key comes from AGENT_KEYS
    # injected by `railway run` and is never printed.
    #
    # First run, 2026-09-24 (a one-off Railway function, the cloud session
    # had no CLI): 5/5 PASS. Google's search provider answered HTTP 402 and
    # it fell back to the keyless floor -- BRAVE_SEARCH_API_KEY fixes that.
    shift
    if [ "${1:-}" = "--dry" ]; then
      node "$ROOT/scripts/agents-acceptance.cjs" --dry; exit $?
    fi
    railway run --service vibee-render -- \
      node "$ROOT/scripts/agents-acceptance.cjs" "$@"
    ;;

  commands)
    # DOES EVERY MENU COMMAND ANSWER -- from the owner's own correspondence.
    #
    # `tri bridge` proves a command is SET (getMyCommands); this proves it was
    # ANSWERED the last time a person sent it. First run, 2026-09-21: 11
    # answered, 0 silent, 55 never tried by anybody. The code-side twin is
    # src/__tests__/bot/everyAdvertisedCommandAnswers.test.ts.
    #
    # Read-only: tg_history over the render's MCP. It sends nothing.
    #
    # `--service`, not `railway service`: the link is per directory and shared
    # by every session working in this checkout. Switching it here once pulled
    # the link out from under a session deploying the browser pod.
    shift
    bash "$ROOT/bin/helpers/fresh-for-tokens.sh" "$ROOT" || exit 3
    railway run --service 999-multibots-telegraf -- \
      node "$ROOT/scripts/commands-answered.cjs" "$@"
    ;;

  dead)
    # A MODULE NOTHING IMPORTS IS A FEATURE NOBODY SWITCHED ON.
    #
    # Named `dead`, not `orphans`: that word is taken by the invoice orphans
    # above, and a second arm with the same name is unreachable -- the first
    # case wins, silently, which is how this very command printed somebody
    # else's report on its first run.
    # Measured on my own work: two modules shipped with passing tests and no
    # caller at all -- and a green suite on a dead module looks exactly like a
    # green suite on a live one. Matches an IMPORT of the exact specifier,
    # including the dynamic `import('@/services/x')` this repository uses for
    # half its services; a matcher blind to that called fifteen live modules
    # dead in its first run.
    shift
    node "$ROOT/scripts/orphan-modules.cjs" "$@"
    ;;

  stop)
    # STOP A TURN NOBODY IS HOLDING A SOCKET FOR, WITHOUT THE PHONE.
    #
    # The button in the bot aborts a fetch, which reaches the turn the person
    # is watching and nothing else: a duet turn writes into a chat of its own
    # and an a2a run outlives the request that started it. Both keep spending.
    # This presses the same written stop the button now also writes -- running
    # turns read it at their step boundary (render src/agent/agent-stops.ts).
    #
    # It stops runs that are ALREADY going. A stop written now says nothing
    # about the next turn, by design: one press must not silence the seller.
    shift
    ID="${1:-144022504}"
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY недоступен: railway link в корне копии"; exit 69; }
    OUT=$(curl -s -o /dev/null -w '%{http_code}' -X POST \
      "https://vibee-render-production.up.railway.app/api/agent/stop?telegram_id=$ID" \
      -H "X-Api-Key: $KEY")
    if [ "$OUT" = "200" ]; then
      echo "записано: идущие ходы $ID прервутся на ближайшем шаге"
    else
      echo "рендер ответил $OUT — остановка НЕ записана"; exit 1
    fi
    ;;

  faces)
    # WHOSE FACE THE SELLER CAN ACTUALLY WORK FROM.
    #
    # The sweep's first action is a portrait, and a candidate with no face
    # turns the whole sweep into "send me a photo" -- a card that displaces
    # the portrait somebody further down would have got. This prints the
    # queue as the brief will order it: known faces first, then the ones
    # nobody has looked at yet. Read-only; it asks crm_leads and nothing else.
    #
    # Two answers, never three: 'unknown' means nobody has looked, NOT that
    # the person has no photo. A count of unknowns is a to-do for the CRM
    # screen (crm_client_avatars), not a verdict about those people.
    shift
    ID="${1:-144022504}"
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY недоступен: railway link в корне копии"; exit 69; }
    curl -s "https://vibee-render-production.up.railway.app/mcp" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"crm_leads\",\"arguments\":{\"limit\":15},\"telegram_id\":\"$ID\"}}" \
      | node -e '
        let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
          let j;try{j=JSON.parse(s)}catch{console.log(s.slice(0,300));process.exit(1)}
          if(j.error){console.log("рендер:",j.error.message);process.exit(1)}
          let t=j.result&&j.result.content&&j.result.content[0]&&j.result.content[0].text;
          let d;try{d=JSON.parse(t)}catch{console.log(String(t).slice(0,300));process.exit(1)}
          const c=d.candidates||[];
          const yes=c.filter(x=>x.face==="yes"), unk=c.filter(x=>x.face!=="yes");
          for(const x of yes) console.log("  лицо есть  ", x.display||x.lead, "next="+x.next);
          for(const x of unk) console.log("  не смотрели", x.display||x.lead, "next="+x.next);
          console.log(`\n${yes.length} с лицом, ${unk.length} ещё не смотрели (не «фото нет»).`);
        })'
    ;;

  writers)
    # WHO WRITES WHAT I READ -- and can that writer never run?
    #
    # A whole change can be correct, measured, mutation-checked and still do
    # nothing, because the column it sorts by is filled only by a screen
    # nobody opens. Prints every place a column is WRITTEN (tests excluded),
    # so "two writers, both somebody else\'s decision" is visible before the
    # work is built on it rather than a tick later.
    shift
    COL="${1:-}"
    [ -z "$COL" ] && { echo "usage: tri writers <column>"; exit 64; }
    echo "пишут $COL:"
    grep -rn "SET $COL\|$COL = \|$COL=" --include="*.ts" "$ROOT/src" \
         "$ROOT/apps/vibee-editor/render/src" 2>/dev/null \
      | grep -viE "\.test\.|__tests__|SELECT|ADD COLUMN" | sed "s|$ROOT/||" | head -20
    echo
    echo "читают $COL:"
    grep -rln "$COL" --include="*.ts" "$ROOT/src" \
         "$ROOT/apps/vibee-editor/render/src" 2>/dev/null \
      | grep -viE "\.test\.|__tests__" | sed "s|$ROOT/||" | head -12
    echo
    echo "Если писателей мало и каждый зависит от чужого решения — читатель"
    echo "полагается на событие, которого может не быть (форма 180)."
    echo "НИ ОДНОГО писателя — чаще всего поле ВЫЧИСЛЯЕМОЕ, а не сломанное"
    echo "(intent_score считается из переписки). Прежде чем звать это дефектом,"
    echo "проверь, колонка ли это вообще: grep \"<имя>:\" в источнике читателя."
    ;;

  wake)
    # BEFORE WIRING A DEAD MODULE, READ IT AS SOMEBODY ELSE\'S CODE.
    #
    # A module with no caller has never run, so nothing in it has ever been
    # wrong in production -- and its green tests may be green BECAUSE of the
    # defect (fixtures written to match it). `groupDayPlan` would have told a
    # real person, in a room full of their colleagues, that they have no
    # profile, on a field nobody had filled: `!undefined` is true.
    #
    # This prints what to look at before the first caller exists: the optional
    # fields read as booleans (the three-states trap, forms 178/180/184) and
    # the tests that will need new fixtures.
    shift
    M="${1:-}"
    [ -z "$M" ] && { echo "usage: tri wake <path/to/module.ts>"; exit 64; }
    [ -f "$ROOT/$M" ] || [ -f "$M" ] || { echo "нет такого файла: $M"; exit 66; }
    F="$ROOT/$M"; [ -f "$F" ] || F="$M"
    echo "необязательные поля, прочитанные как «нет» (unknown == false?):"
    grep -nE "if \(![a-zA-Z_.]+\)|\|\| *!|\? *[^:]+ *: *false" "$F" | head -12
    echo
    echo "их объявления (есть ли ? -- значит, бывает undefined):"
    grep -nE "^\s+[a-zA-Z_]+\?:" "$F" | head -12
    echo
    echo "тесты, которые сейчас его держат:"
    grep -rln "$(basename "$F" .ts)" "$ROOT/src/__tests__" 2>/dev/null | sed "s|$ROOT/||" | head -5
    echo
    echo "Зелёный тест мёртвого модуля ничего не значит: фикстуры могли быть"
    echo "написаны ПОД дефект. Правило в blind-guards, форма 184."
    ;;

  swallow)
    # A FAILURE THAT LOOKS EXACTLY LIKE AN HONEST EMPTY ANSWER.
    #
    # `catch { return [] }` is often right: a post that stays quiet beats one
    # that crashes. It is WRONG when the caller turns the empty answer into a
    # claim -- "nobody in this room has a profile" printed to that room
    # because a query failed. Form 185.
    #
    # Prints every swallow of that shape. It does NOT judge them: most of
    # this repository swallows in the safe direction on purpose (a fault does
    # not mark a link dead, or a lead enrolled in AUTO). The question to ask
    # at each one is the same: can the caller tell this from a real empty
    # answer, and does it then SAY something about a person?
    shift
    echo "проглоченные ошибки, неотличимые от пустого ответа:"
    grep -rn -A 3 "} catch {" --include="*.ts" "$ROOT/src" \
         "$ROOT/apps/vibee-editor/render/src" 2>/dev/null \
      | grep -E "return (\[\]|new Set|new Map|0$|false|null)" \
      | grep -viE "\.test\.|__tests__" | sed "s|$ROOT/||" | head -25
    echo
    echo "Судить каждое место по одному вопросу: отличит ли вызывающий это от"
    echo "честного пустого ответа -- и УТВЕРЖДАЕТ ли он потом что-то о человеке."
    ;;

  layout)
    # A LAYOUT FIX HAS A NUMBER. TAKE IT BEFORE AND AFTER.
    #
    # Three of my four attempts at "the cards are too tall" looked like an
    # improvement in a screenshot and were WORSE in pixels -- on the phone,
    # which is where the owner looks. Form 186.
    #
    # Prints the recipe rather than doing it, because the measuring belongs
    # in the browser pane where the page actually is.
    shift
    SEL="${1:-.agent-card}"
    cat <<RECIPE
Замер высоты для «$SEL» -- ДО и ПОСЛЕ, на обеих ширинах:

  1. preview_start name=vibee-tma          (порт печатает preview_logs)
  2. resize_window preset=mobile           (375px -- экран владельца)
  3. javascript_tool:
       Array.from(document.querySelectorAll('$SEL'))
         .map(c => Math.round(c.getBoundingClientRect().height))
  4. git stash -q  -> замерить снова -> git stash pop -q
  5. resize_window preset=desktop          и повторить 3

Впечатление от снимка не считается: подпись рядом с заголовком экономит
строку на широком экране и ДОБАВЛЯЕТ её на телефоне, когда заголовок
переносится. Сторож писать структурой (сколько элементов, внутри чего),
а не словами -- в тестовой среде язык может быть другим.
RECIPE
    ;;

  halfdone)
    # A REMEDY APPLIED IN ONE PLACE OUT OF TWO.
    #
    # The cheapest defects in this repository are the ones where the rule is
    # already written down, argued for, and wired into ONE of the siblings it
    # covers: the image could admit it failed to load and the video could not,
    # in the same file, under a five-line comment explaining exactly why it
    # matters. Form 187.
    #
    # Lists elements that usually need a failure path beside the guards that
    # exist in the same file, so the gap is a diff rather than a memory.
    shift
    F="${1:-}"
    [ -z "$F" ] && { echo "usage: tri halfdone <файл>"; exit 64; }
    P="$ROOT/$F"; [ -f "$P" ] || P="$F"
    [ -f "$P" ] || { echo "нет такого файла: $F"; exit 66; }
    echo "защита есть здесь:"
    grep -nE "onError|onAbort|catch *\(|fallback|setBroken" "$P" | head -12
    echo
    echo "а полагается этим:"
    grep -nE "<(video|audio|img|iframe|object)\b" "$P" | head -12
    echo
    echo "Разница между списками -- места, где правило уже признано верным и"
    echo "не дописано. Обоснование писать не нужно: оно лежит рядом."
    ;;

  byload)
    # DOES THIS SUITE FAIL BY CODE, OR BY MACHINE LOAD?
    #
    # Named `byload`, not `flaky`: that word is taken by the repeat-runner
    # above, and a second arm with the same name is unreachable -- the first
    # case wins, silently. The same trap `dead` was renamed out of.
    #
    # The player suite failed 21 times in a parallel run, 5 sequentially and
    # 0 alone -- the count tracked the LOAD, not the code, because a 5.5 s
    # module import sat inside a test with a 5 s budget. Twice I nearly
    # blamed my own change for it. Form 188.
    #
    # Runs the same target three ways and prints the three numbers. Different
    # numbers = a stopwatch measuring the wrong thing; look for heavy work
    # inside the test (a lazy page import, a real fetch), not for flakiness.
    shift
    DIR="${1:-apps/vibee-editor/player}"
    T="${2:-}"
    cd "$ROOT/$DIR" 2>/dev/null || { echo "нет каталога: $DIR"; exit 66; }
    count() { npx vitest run $T "$@" 2>&1 | grep -E "^ +Tests +[0-9]" | tail -1; }
    echo "в одиночку / последовательно / параллельно -- три числа:"
    [ -n "$T" ] && { printf "  одиночно:      "; count; }
    printf "  последовательно: "; count --no-file-parallelism
    printf "  параллельно:     "; count
    echo
    echo "Числа разные -- дело во ВРЕМЕНИ, а не в коде. Замерь тяжёлое:"
    echo "  it('probe', async () => { const t=Date.now();"
    echo "    await import('@/pages/X'); console.log(Date.now()-t) }, 30000)"
    echo "и унеси эту цену в beforeAll со своим бюджетом."
    ;;

  touch)
    # WHICH CONTROLS ARE TOO SMALL FOR A FINGER, AND WHICH ONE MATTERS MOST.
    #
    # Measured 25.09.2026: the AUTO switch -- the one that decides whether the
    # account writes to people by itself -- was 28px tall, with no size rule
    # at all, on a screen whose own heading button already declared 44. The
    # rule was agreed and applied to some of what it covers. Form 190.
    #
    # Prints the recipe, because the measuring happens in the browser pane
    # where the page is. Two traps are in it, both of which cost a pass.
    shift
    cat <<RECIPE
Проверка целей под палец -- в панели браузера:

  1. preview_start name=vibee-tma ; resize_window preset=mobile
  2. navigate на нужный экран (НЕ pushState: замер во время перехода
     показывает недовёрстанные числа -- 43 вместо 44)
  3. javascript_tool:
       const small=[]
       document.querySelectorAll('button,a[href],[role="button"]').forEach(e=>{
         const r=e.getBoundingClientRect()
         if (r.height && r.width && r.height < 44)
           small.push([e.className, Math.round(r.height)])
       })
       small

Чинить так:
  - то, чем включают необратимое (отправку, оплату), -- цель ВЕЗДЕ;
  - остальное -- \`@media (pointer: coarse)\`, и блок ставить ПОСЛЕ базового
    правила: сила та же, побеждает последний. Выше -- медиазапрос совпадёт
    и не изменит ничего.

Сторож писать на то, что решает: из всех блоков селектора применяется
ПОСЛЕДНИЙ, цель должна быть в нём. Сравнение indexOf() обманывается тем,
что селектор встречается и внутри медиазапроса.
RECIPE
    ;;

  family)
    # WHO ELSE IS IN THIS FAMILY, AND DID THE REMEDY REACH THEM?
    #
    # Three times in one week the cheapest defect here was a rule wired into
    # ONE of the siblings it covers: the image could admit a failure and the
    # video could not; the client LIST said a shared failure once and the
    # client PAGE said it six times -- that one was mine, the morning after.
    #
    # Give it the component everyone shares. It prints who renders it and
    # which of them carry the remedy, so the gap is a list rather than a
    # memory. Form 191: guard the FAMILY, not the case you happened to hit.
    shift
    C="${1:-}"; R="${2:-}"
    [ -z "$C" ] && { echo "usage: tri family <Компонент> [признак-лекарства]"; exit 64; }
    DIRS="$ROOT/apps/vibee-editor/player/src $ROOT/src"
    echo "рисуют <$C>:"
    # `<Panel` is often followed by a NEWLINE rather than a space, so the
    # class must allow end-of-line. The first version matched nothing and
    # printed an empty family -- which reads exactly like "nobody is missing".
    grep -rlE "<$C([ />]|$)" --include="*.tsx" $DIRS 2>/dev/null \
      | grep -viE "\.test\." | sed "s|$ROOT/||" | head -20
    if [ -n "$R" ]; then
      echo
      echo "из них НЕ несут «$R»:"
      for f in $(grep -rlE "<$C([ />]|$)" --include="*.tsx" $DIRS 2>/dev/null | grep -viE "\.test\."); do
        grep -q "$R" "$f" || echo "  $(echo "$f" | sed "s|$ROOT/||")"
      done
    fi
    echo
    echo "Сторожа писать на СЕМЬЮ: перечислить всех, кто рисует компонент, и"
    echo "потребовать лекарство у каждого. Признак брать по СМЫСЛУ роли, а не"
    echo "по виду текста -- имя из пути импорта и имя из объявления свойства"
    echo "оба «встречаются в файле» и проверяют разное (форма 191)."
    ;;

  contracts)
    # WORDS TWO SERVICES AGREE BY, AND NOTHING CHECKING THE AGREEMENT.
    # The bot posted a journal kind the render's door never knew: 400 on
    # every automatic send, written nowhere, and the figure built on those
    # rows read zero by construction. The writer swallows refusals on
    # purpose, so nothing said a word. Compares the vocabularies as source
    # text; a pattern that finds nothing is reported as a BROKEN CHECK.
    shift
    node "$ROOT/scripts/cross-service-vocabularies.cjs" "$@"
    ;;

  outcomes)
    # HOW MUCH WENT OUT WITHOUT THE OWNER over the last N days (7 by default):
    # automatic sends, his own presses, refusals, and the sweep totals beside
    # them. Counted from journal rows that already exist, never a new counter.
    shift
    node "$ROOT/scripts/outcomes-state.cjs" "$@"
    ;;

  auto)
    # IS AUTO MODE ON, AND WHAT BOUNDS IT. Read-only by design: the switch
    # that lets the account send by itself is flipped by a hand, in the app or
    # the bot, never by a script (DIRECT_CALL_ONLY, render tools.ts).
    shift
    node "$ROOT/scripts/autopilot-state.cjs" "$@"
    ;;

  botapi)
    # WHICH BOTS LIVE ON OUR OWN BOT API SERVER, and do the bot, the render and
    # the server's allow-list agree -- with the next step for each bot that is
    # mid-move, silent, half rolled back or split. Token-free and read-only:
    # three variables and the boot lines (scripts/botapi-state.cjs).
    shift
    node "$ROOT/scripts/botapi-state.cjs" "$@"
    ;;

  tg-as)
    # What the Telegram tools answer to THIS person on production. The live
    # check for "clients get their own tools": a stranger with no session must
    # hear "not connected" (their own fix), never "belongs to the owner", and
    # never anything from the owner's account. Read-only: tg_dialogs by
    # default. Usage: tri tg-as <telegram_id> [tool]
    ID="${2:-}"; TOOL="${3:-tg_dialogs}"
    [ -z "$ID" ] && { echo "usage: tri tg-as <telegram_id> [tool]"; exit 64; }
    case "$TOOL" in
      tg_dialogs|tg_unanswered|tg_contacts) ;;
      *) echo "only reading tools here: tg_dialogs, tg_unanswered, tg_contacts"; exit 64 ;;
    esac
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY not readable"; exit 1; }
    ANSWER=$(curl -s "https://vibee-render-production.up.railway.app/mcp?telegram_id=$ID" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$TOOL\",\"arguments\":{\"limit\":3}}}")
    ANSWER="$ANSWER" TOOL="$TOOL" ID="$ID" python3 - <<'PYEOF'
import json, os
r = json.loads(os.environ['ANSWER'])
if 'error' in r:
    # A thrown tool error arrives as a JSON-RPC error, not as isError content.
    print(f"{os.environ['TOOL']} as {os.environ['ID']}: refused -> {r['error'].get('message','')[:220]}"); raise SystemExit(0)
res = r.get('result', {})
text = (res.get('content') or [{}])[0].get('text', '')
if res.get('isError'):
    print(f"{os.environ['TOOL']} as {os.environ['ID']}: refused -> {text[:200]}")
else:
    try: s = res.get('structuredContent') or json.loads(text)
    except Exception: s = {}
    n = len(s.get('dialogs') or s.get('contacts') or s.get('диалоги') or [])
    print(f"{os.environ['TOOL']} as {os.environ['ID']}: ok, {n} item(s) on THEIR account")
PYEOF
    ;;
  crm-ingest|crm-leads)
    # crm-ingest [dialogs] [depth]: the owner's DMs into the CRM memory.
    # crm-leads [n]: who to write to next, scored, from that memory. Both
    # read-only on Telegram; both as the owner, on production.
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY not readable"; exit 1; }
    if [ "${1:-}" = "crm-ingest" ]; then
      TOOL=crm_ingest_chats; ARGS="{\"limit\":${2:-30},\"depth\":${3:-100}}"
    else
      TOOL=crm_leads; ARGS="{\"limit\":${2:-15}}"
    fi
    ANSWER=$(curl -s --max-time 170 "https://vibee-render-production.up.railway.app/mcp?telegram_id=144022504" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$TOOL\",\"arguments\":$ARGS}}")
    ANSWER="$ANSWER" TOOL="$TOOL" python3 - <<'PYEOF'
import json, os
r = json.loads(os.environ['ANSWER'])
if 'error' in r: print('refused ->', str(r['error'].get('message',''))[:300]); raise SystemExit(1)
res = r.get('result', {}); text = (res.get('content') or [{}])[0].get('text', '')
try: s = res.get('structuredContent') or json.loads(text)
except Exception: s = {'raw': text[:400]}
if os.environ['TOOL'] == 'crm_ingest_chats':
    print(f"dialogs={s.get('dialogs_seen')} people={s.get('people')} read={s.get('messages_read')} new={s.get('messages_new')} zep={s.get('zep_mirrored')} stopped={s.get('stopped')}")
    print(s.get('zep',''))
else:
    import re
    for c in s.get('candidates', []):
        who = c.get('display') or f"id {c.get('lead')}"
        words = re.sub(r'\[(?:END )?FOREIGN CONTENT[^\]]*\]', '', str(c.get('last_words') or '')).strip()
        print(f"  [{c.get('score'):>3}] {c.get('next'):<8} {who} · {c.get('lead')} · {c.get('stage')}{' · платил' if c.get('paid') else ''}")
        print(f"        {c.get('because')}")
        if words: print(f"        «{words[:100]}» · {c.get('messages')} сообщ., последнее {c.get('days_since_their_last_word')} дн. назад")
    print(s.get('how_to_read',''))
PYEOF
    ;;
  open)     sed -n '/^## Открыто/,/^## Не переоткрывать/p' "$LOOP/pipeline-STATUS.md" ;;
  tests)
    (cd "$RENDER" && npx vitest run src/agent/billing-prices.test.ts miniapp-receipt miniapp-billing) ;;
  all)
    # ВЕСЬ набор, а не свои файлы. Две проверки падали сутки незамеченными:
    # я гонял только те тесты, что писал сам, и «зелено» означало «зелено у
    # меня», а не «зелено в проекте». Обе поломки оказались моими.
    #
    # NODE 20 ЯВНО. По умолчанию в оболочке 18, и прогонщик падает на
    # `styleText` из node:util, которого там нет: «Startup Error» вместо
    # тестов читается как поломка проекта, а это поломка окружения.
    (cd "$RENDER" && PATH="$NODE20:$PATH" npx vitest run) ;;
  ios)
    # СБОРКА iOS И УБОРКА ЗА НЕЙ — ОДНОЙ КОМАНДОЙ.
    #
    # Каталог `/tmp/dd` растёт на каждой сборке. За ночь мои итерации набили
    # им диск ДО НУЛЯ — до состояния, когда не выполняется ни одна команда,
    # включая чистилку. Убирать после себя нельзя «не забыть»: это должно быть
    # частью самой сборки.
    # xcodegen ПЕРЕД сборкой: новый файл в каталоге ещё не значит файл в
    # проекте, и «cannot find X in scope» выглядит как ошибка кода.
    (cd "$ROOT/apps/vibee-ios" && xcodegen generate >/dev/null 2>&1)
    # УСПЕХ СБОРКИ ПРОВЕРЯЕТСЯ, А НЕ ПРЕДПОЛАГАЕТСЯ. Первая версия печатала
    # «установлено» после ПРОВАЛИВШЕЙСЯ сборки и ставила старый .app с диска:
    # проверка глазами шла по вчерашнему коду и ничего не доказывала.
    # ИМЯ ЛАТИНИЦЕЙ: первая версия звалась кириллицей, и проверка скриптов
    # поймала её сразу — тот же класс, что дважды ломал free-disk.sh.
    built=0
    (cd "$ROOT/apps/vibee-ios" && \
      xcodebuild build -scheme Vibee \
        -destination "platform=iOS Simulator,id=${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" \
        -derivedDataPath /tmp/dd 2>&1 | grep -E "error:|BUILD" | head -5) \
      | tee /tmp/tri-build.txt
    grep -q "BUILD SUCCEEDED" /tmp/tri-build.txt && built=1
    # УСТАНОВКА ДО УБОРКИ, иначе смотреть будет нечего: первая версия команды
    # сносила каталог вместе с собранным .app, и проверка глазами становилась
    # невозможной — уборка мешала тому, ради чего сборка и делалась.
    APP=/tmp/dd/Build/Products/Debug-iphonesimulator/Vibee.app
    if [ "$built" = "1" ] && [ -d "$APP" ]; then
      xcrun simctl install "${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" "$APP" \
        >/dev/null 2>&1 && echo "установлено на симулятор"
      xcrun simctl terminate "${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" ai.t27.vibee >/dev/null 2>&1
      xcrun simctl launch "${UDID:-FC82900F-FB30-48E1-BBEE-0B672B71A096}" ai.t27.vibee >/dev/null 2>&1
    fi
    rm -rf /tmp/dd
    [ "$built" = "1" ] || echo "СБОРКА НЕ ПРОШЛА — на симулятор ничего не ставил"
    df -k /System/Volumes/Data | awk '{if(NR==2) printf "убрано за сборкой, свободно %d МБ\n", $4/1024}' ;;
  deps)
    # `npm ci`, а НЕ `npm install`.
    #
    # Один набор не грузился из-за отсутствующего `undici` — при том, что в
    # package.json он объявлен. То есть разъехалось node_modules, а не
    # манифест. `npm install` в такой ситуации подтянул новые версии соседей
    # и сломал прогонщик целиком: было 599 зелёных и один нерабочий набор,
    # стало ноль. `npm ci` ставит РОВНО то, что в локе, и вылечил оба разом:
    # 75 наборов, 621 тест.
    (cd "$RENDER" && PATH="$NODE20:$PATH" npm ci) ;;
  loop)
    # С ЧЕГО НАЧИНАЕТСЯ КАЖДЫЙ ВИТОК.
    #
    # Крон бьёт каждые 15 минут, а задача живёт часами. Половина риска
    # автономного цикла не в коде, а в том, что новый виток не знает о
    # прошлом: делает работу заново или поверх неё. Три вопроса разом —
    # где я, что уже занято, что не сделано.
    echo "── где я ──"
    echo "  ветка:  $(git -C "$ROOT" branch --show-current)"
    git -C "$ROOT" log --oneline -3 | sed "s/^/  /"
    N=$(git -C "$ROOT" status --porcelain | wc -l | tr -d " ")
    [ "$N" != "0" ] && echo "  НЕЗАКОММИЧЕНО: $N файл(ов) — следующий виток их не увидит"
    echo
    echo "── что в работе ──"
    sed -n "/^## СЕЙЧАС В РАБОТЕ/,/^## Что уже есть/p" "$LOOPSTATE" |
      grep -v "^## " | sed "/^$/d" | sed "s/^/  /"
    echo
    echo "── не сделано (первые 5) ──"
    grep -n "^- \[ \]" "$LOOPSTATE" | head -5 | sed "s/^/  /" ||
      echo "  всё помечено сделанным — пора писать новый план"
    ;;

  loop-note)
    # ОПЫТ, КОТОРЫЙ ИНАЧЕ ПОТЕРЯЕТСЯ.
    #
    # Виток обрывается внезапно. Всё, что не записано в память, следующая
    # смена выведет заново — а чаще не выведет и наступит на то же место.
    shift
    if [ $# -eq 0 ]; then
      echo "нужен текст: tri loop-note \"что выяснилось\""; exit 2
    fi
    printf "\n- %s: %s\n" "$(date "+%d.%m.%Y %H:%M")" "$*" >> "$LOOPSTATE"
    echo "записано в ${LOOPSTATE#$ROOT/}"
    ;;

  mutate) shift; bash "$ROOT/bin/helpers/mutate.sh" "$@" ;;

  api)    shift; bash "$ROOT/bin/helpers/tg-api.sh" "$CACHE" "$@" ;;

  stale)  shift; bash "$ROOT/bin/helpers/stale.sh" "$ROOT" "$@" ;;
  queue)  shift; bash "$ROOT/bin/helpers/queue.sh" "$ROOT" "$@" ;;
  self)   shift; bash "$ROOT/bin/helpers/self.sh" "$ROOT" "$@" ;;
  rotten) shift; bash "$ROOT/bin/helpers/rotten.sh" "$ROOT" "$@" ;;
  books)  shift; bash "$ROOT/bin/helpers/books.sh" "$ROOT" "$@" ;;
  logins) shift; bash "$ROOT/bin/helpers/logins.sh" "$ROOT" "$@" ;;
  verdicts) shift; bash "$ROOT/bin/helpers/verdicts.sh" "$ROOT" "$@" ;;
  secret) shift; bash "$ROOT/bin/helpers/secret.sh" "$ROOT" "$@" ;;
  traffic) shift; bash "$ROOT/bin/helpers/traffic.sh" "$ROOT" "$@" ;;
  reach) shift; bash "$ROOT/bin/helpers/reach.sh" "$ROOT" "$@" ;;
  bare-fetch) shift; bash "$ROOT/bin/helpers/bare-fetch.sh" "$ROOT" "$@" ;;
  tag) shift; bash "$ROOT/bin/helpers/tag.sh" "$ROOT" "$@" ;;
  alive)  shift; bash "$ROOT/bin/helpers/alive.sh" "$ROOT" "$@" ;;
  vs-main) shift; bash "$ROOT/bin/helpers/vs-main.sh" "$ROOT" "$@" ;;
  wired)  shift; bash "$ROOT/bin/helpers/wired.sh" "$ROOT" "$@" ;;
  rehearse) shift; bash "$ROOT/bin/helpers/rehearse.sh" "$ROOT" "$@" ;;
  boundary) shift; bash "$ROOT/bin/helpers/boundary.sh" "$ROOT" "$@" ;;
  spelling) shift; bash "$ROOT/bin/helpers/spelling.sh" "$ROOT" "$@" ;;
  scan)   shift; bash "$ROOT/bin/helpers/scan.sh" "$ROOT" "$@" ;;
  owners) shift; bash "$ROOT/bin/helpers/owners.sh" "$ROOT" "$@" ;;
  promises) shift; bash "$ROOT/bin/helpers/promises.sh" "$ROOT" "$@" ;;
  waiting) shift; bash "$ROOT/bin/helpers/waiting.sh" "$ROOT" "$@" ;;
  clock)  shift; bash "$ROOT/bin/helpers/clock.sh" "$ROOT" "$@" ;;
  landing) shift; bash "$ROOT/bin/helpers/landing.sh" "$ROOT" "$@" ;;
  facts)  shift; bash "$ROOT/bin/helpers/facts.sh" "$ROOT" "$@" ;;
  sweep)  shift; bash "$ROOT/bin/helpers/sweep.sh" "$ROOT" "$@" ;;
  inflight) shift; bash "$ROOT/bin/helpers/inflight.sh" "$ROOT" ;;
  funnel) shift; bash "$ROOT/bin/helpers/funnel.sh" "$ROOT" "$@" ;;
  headroom) shift; bash "$ROOT/bin/helpers/headroom.sh" "$ROOT" "$@" ;;
  lost)   shift; bash "$ROOT/bin/helpers/lost.sh" "$ROOT" "$@" ;;
  binary) shift; bash "$ROOT/bin/helpers/binary.sh" "$ROOT" "$@" ;;

  doctor)
    echo "── копия ──";     fresh || true
    echo; echo "── диск ──"; bash "$LOOP/check-free-disk.sh" | tail -1; bash "$LOOP/free-disk.sh" | tail -1
    echo; echo "── конвейер ──"; (cd "$RENDER" && npx tsx scripts/pipeline-check.ts | tail -3)
    echo; echo "── влито = выехало ──"; node "$ROOT/scripts/railway-drift.mjs" || true
    # ПОЛ ПРИБОРОВ. Смысл держать его здесь: проверяют его ровно тогда, когда
    # уже подозревают, а подозрение приходит поздно. 08.09.2026 батарея
    # `score-spec-answers` восемь итераций печатала «поверен» с подставным
    # компилятором, и никому не приходило в голову подставить компилятор.
    #
    # Мягко: без t27c или без датасета мерить нечем, и это не повод краснеть
    # доктору. Молчание тут честнее выдуманного вердикта.
    if [ -x "${T27C:-$(command -v t27c)}" ] && [ -f "$HOME/.cache/igla-spec-dataset/eval.jsonl" ]; then
      echo; echo "── пол приборов ──"; "$0" igla floor 2>&1 | tail -3
    fi
    ;;
  # 64 = "not mine", so the root tri can tell an unknown command from a
  # command that ran and failed. Any other exit code is the command's own.
  # Under the bridge the root prints the one usage; two for one typo is noise.
  *) [ -n "${TRI_BRIDGE:-}" ] || usage; exit 64 ;;
esac
