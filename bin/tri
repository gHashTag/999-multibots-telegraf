#!/bin/bash
# tri — командная оболочка проекта Trinity S³AI.
#
# ЗАЧЕМ. Автономный цикл каждые 15 минут начинается с одних и тех же вопросов:
# хватает ли места, сходится ли конвейер, что уже закрыто, какие цены сейчас,
# какие посты в ленте. Раньше каждый ответ собирался заново из пяти команд, и
# половина ошибок цикла была именно в этой сборке: то кириллица в арифметике,
# то устаревшая рабочая копия, то проверка не того дерева.
#
# Каждая команда здесь — это ответ, добытый один раз и записанный, чтобы
# следующая смена его не выводила заново.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RENDER="$ROOT/apps/vibee-editor/render"
LOOP="$ROOT/.claude/loop-opus"
# Память автономного цикла по CRM. Отдельно от $LOOP: там скрипты смены,
# здесь единственный файл, который переживает виток крона.
LOOPSTATE="$ROOT/.claude/loop-state/crm-loop.md"
# Для того, что качается один раз и чему не место в репозитории.
CACHE="$ROOT/.claude/cache"
# Прогонщик тестов требует Node 20; в оболочке по умолчанию 18.
NODE20="$HOME/.nvm/versions/node/v20.19.0/bin"
# ...И ЭТОГО МАЛО, ЕСЛИ ПЕРЕМЕННУЮ ТОЛЬКО ОБЪЯВИТЬ.
#
# Она была объявлена и использовалась не везде: `tri guards` падал с
# `ERR_REQUIRE_ESM`, потому что звал `npx` из PATH, где node 18. Хуже: команда
# при этом печатала пустоту, неотличимую от «сторожа молчат».
#
# Ставим Node 20 в начало PATH ОДИН раз, здесь: тогда любая новая команда
# получает верную версию, не вспоминая об этом.
[ -d "$NODE20" ] && PATH="$NODE20:$PATH" && export PATH

usage() {
  cat <<'U'
tri — оболочка Trinity S³AI

  tri doctor     всё перед началом смены: копия, диск, конвейер
  tri fresh      сверить рабочую копию с origin/main (частая причина ложных диагнозов)
  tri disk       освободить место и проверить сам инструмент чистки
  tri pipeline   проверка конвейера без единой траты кредитов
  tri prices     таблица цен: модель, токены, единица
  tri feed       посты в ленте с id (в интерфейсе ссылок на посты нет)
  tri feed-hide <id>  скрыть все свои посты, кроме одного (обратимо)
  tri loop       с чего начинать виток: где я, что занято, что не сделано
  tri loop-note <текст>   записать вывод витка в память (иначе потеряется)
  tri mutate <файл> <было> <стало> -- <тесты>   убил ли тест мутацию
  tri api <имя>  метод или класс Bot API из справочника Telegram
  tri wired <имя>  зовёт ли кто-то эту функцию из рабочего пути (не из тестов)
  tri self      сама оболочка: достижима ли каждая команда и на месте ли хелпер
  tri rotten [n] какие открытые PR конфликтуют и ПОЧЕМУ — по общей причине
  tri scan       чем этот код может соврать: обзор сторожей и дыр
  tri owners <файл>  кто ещё держит состояние этого модуля между вызовами
  tri promises   обещания в тексте, за которыми стоит число в другом файле
  tri waiting    что лежит в открытом PR и чем рискует — по группам
  tri clock [дней] [render|bot|all]  прогон так, будто прошло N дней:
                 два прогона, фон вычитается — видно только то, что сгниёт
  tri landing    доедет ли работа этой ветки до main и что застрянет с ней
  tri lost       коммиты, до которых не достаёт ни одна ветка (сеть под reset)
  tri binary     исходники, невидимые для grep из-за нулевого байта
  tri facts      на чём стоят факты CRM в ПРОДЕ: не пуст ли журнал под выводом
  tri books      какие факты код читает, а прод НИ РАЗУ не записал
  tri vs-main <команда…>  падает ли это и БЕЗ ваших правок (копия на main)
  tri funnel     воронка владельца одним экраном: этапы, шаги, утечка карточек
  tri headroom   числа, которые говорят про запас, а не про потери (форма 54)
  tri sweep [hive|log] [n]  обходы продавца в проде: журнал улья (навсегда)
                 или лог Railway (с последнего деплоя)
  tri open       что ещё открыто по pipeline-STATUS.md
  tri tests      тесты денег и iOS-модулей
  tri all        ВЕСЬ серверный набор (Node 20) — свои файлы зелёные ≠ зелёный проект
  tri deps       вылечить node_modules: npm ci, а не install
  tri ios        собрать приложение И УБРАТЬ за собой — иначе диск кончится
  tri blind <файл> <было> <стало> <тест>
                 сломать код и посмотреть, покраснеет ли тест
                 (тест, который не может упасть, — не защита, а её изображение)
  tri entry      двери входа: чем отвечают на мусор, есть ли тормоз

  Улей и наблюдение
  tri hive       смотритель, журнал событий, отчёты королевы
  tri session    сессии: срок жизни, ротация, обнаружение повторного использования
  tri pairing    вход по коду: длина, срок, попытки — и совпадают ли клиенты с сервером
  tri throttle   тормоз на входе: по чему считает и кого не заденет
  tri tma        мини-апп: какой ключ уходит с запросом (два сразу = отказ сервера)

  Состояние проекта
  tri schema     таблицы, которые код считает существующими, против настоящих
  tri crm-source какая копия users/payments живая: Supabase или Railway
  tri shipped    уехало ли в прод — и пользуется ли им кто-нибудь
  tri guards     защиты, которые ничего не защищают
  tri space      место на диске: что заняли мы и что можно вернуть
  tri worktrees  брошенные копии репозитория (могут хранить несохранённое)

  CRM и личный продавец
  tri crm-waiting          кто ждёт ответа (прод, от имени владельца, только чтение)
  tri crm-pitch <name> [tokens] [note]  текст предложения, локально, без счёта
  tri tg-as <telegram_id> [tool]  что инструменты Telegram отвечают ЭТОМУ человеку на проде
  tri crm-ingest [dialogs] [depth]  переписки владельца в память CRM (и в Zep, если задан)
  tri crm-leads [n]        кому писать следующему, со счётом и причиной
U
}

# КОПИЯ ОТСТАЁТ — САМАЯ ДОРОГАЯ ИЗ ДЕШЁВЫХ ОШИБОК.
# Однажды проверка упала с «файла нет», и первая мысль была «влил сломанное».
# На деле копия стояла на локальном main на десять коммитов позади.
fresh() {
  git -C "$ROOT" fetch -q origin main
  # ИМЕНА ЛАТИНИЦЕЙ. Первая версия этой функции была написана
  # кириллицей и упала на `local`: bash принимает только
  # [A-Za-z_][A-Za-z0-9_]*. Тот же класс уже ломал free-disk.sh дважды —
  # и печатал ошибку, продолжая работать, поэтому выглядел исправным.
  local here there
  here=$(git -C "$ROOT" rev-parse --short HEAD)
  there=$(git -C "$ROOT" rev-parse --short origin/main)
  if [ "$here" = "$there" ]; then
    echo "✓ копия совпадает с origin/main ($here)"
  else
    echo "✗ КОПИЯ ОТСТАЁТ ИЛИ РАЗОШЛАСЬ: тут $here, origin/main $there"
    echo "  git log --oneline origin/main..HEAD   # что есть только тут"
    echo "  git log --oneline HEAD..origin/main   # чего не хватает"
    return 1
  fi
  local dirty
  dirty=$(git -C "$ROOT" status --short | grep -v '^??' | wc -l | tr -d ' ')
  [ "$dirty" = "0" ] && echo "✓ незакоммиченных правок нет" \
    || echo "! незакоммиченных файлов: $dirty (git status)"
}


# МУТАЦИЯ КАК ЕДИНСТВЕННОЕ ДОКАЗАТЕЛЬСТВО.
#
# За смену 07.09.2026 нашлось семнадцать тестов, которые не могли упасть, —
# две из них написал я сам в тот же день. Проверка «сломай и посмотри» занимает
# минуту и ловит то, чего не видно чтением.
#
# Замена ОБЯЗАНА примениться: молчаливый промах выглядит как «тест поймал»,
# поэтому при ненайденном образце команда отказывается работать.
# ИМЕНА ПЕРЕМЕННЫХ ЗДЕСЬ ЛАТИНСКИЕ, И ЭТО НЕ ВКУСОВЩИНА.
# bash разбирает `К=401` как команду, а не как присваивание: скрипт с
# кириллическими идентификаторами падает строкой «command not found» на пустом
# месте. В комментариях кириллица уместна, в идентификаторах — нет.
mutate() {
  f="$1"; old="$2"; new="$3"; t="$4"
  [ -f "$f" ] || { echo "нет файла: $f"; return 1; }
  cp "$f" /tmp/tri-blind.bak
  BLIND_FILE="$f" BLIND_OLD="$old" BLIND_NEW="$new" python3 -c 'import io,os,sys
p=os.environ["BLIND_FILE"]; было=os.environ["BLIND_OLD"]; стало=os.environ["BLIND_NEW"]
s=io.open(p,encoding="utf-8").read()
if было not in s:
    print("МУТАЦИЯ НЕ ПРИМЕНЕНА: искомого текста нет в файле"); sys.exit(1)
io.open(p,"w",encoding="utf-8").write(s.replace(было,стало,1))' || { cp /tmp/tri-blind.bak "$f"; return 1; }
  echo "— мутация применена, гоняю тест —"
  ( cd "$(dirname "$t")" 2>/dev/null || cd .
    PATH="$HOME/.nvm/versions/node/v20.19.0/bin:$PATH" npx vitest run "$(basename "$t")" 2>&1 | grep -E "Tests +[0-9]" | tail -1 )
  cp /tmp/tri-blind.bak "$f"
  echo "— файл восстановлен —"
}

case "${1:-}" in
  fresh)    fresh ;;
  disk)     bash "$LOOP/check-free-disk.sh" && bash "$LOOP/free-disk.sh" ;;
  pipeline) (cd "$RENDER" && npx tsx scripts/pipeline-check.ts) ;;
  prices)   (cd "$RENDER" && npx tsx scripts/prices.ts) ;;
  feed)
    # В ЛЕНТЕ НЕТ ССЫЛОК НА ПОСТЫ — ни в вебе, ни в приложении. Сослаться на
    # конкретный ролик из интерфейса нечем, поэтому id достаём отсюда.
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    if [ -z "$KEY" ]; then echo "нет RENDER_API_KEY в окружении сервиса"; exit 1; fi
    curl -s -m 30 "https://vibee-render-production.up.railway.app/api/feed?limit=100" \
      -H "X-Api-Key: $KEY" | python3 "$ROOT/bin/helpers/feed.py" ;;
  blind)
    shift
    [ $# -eq 4 ] || { echo "tri blind <файл> <было> <стало> <тест>"; exit 1; }
    mutate "$1" "$2" "$3" "$4"
    ;;

  entry)
    # ДВЕРИ ВХОДА. Пять маршрутов, каждый обязан отказывать мусору внятно, а
    # pair/claim — ещё и тормозить: он не требует личности и не может.
    B="https://vibee-render-production.up.railway.app"
    echo "— чем отвечают на мусор —"
    for P in /api/auth/telegram /api/auth/widget /api/auth/refresh /api/auth/pair/claim; do
      code=$(curl -s -o /tmp/tri-entry -w "%{http_code}" --max-time 25 -X POST "$B$P" -H "Content-Type: application/json" -d "{}")
      printf "%-26s %s  %s\n" "$P" "$code" "$(head -c 90 /tmp/tri-entry)"
    done
    echo
    echo "— тормоз на дверях —"
    for P in pair/claim auth/refresh auth/widget auth/telegram; do
      if grep -q "пуститьВход" apps/vibee-editor/render/session-routes.ts; then
        echo "  $P: тормоз есть"
      else
        echo "  $P: НЕТ — поток ничем не ограничен"
      fi
    done
    echo "— длина кода —"
    grep -n "DIGITS:" apps/vibee-editor/render/session-store.ts | head -1
    ;;

  throttle)
    # ЗА ЧЕЙ АДРЕС СЧИТАЕМ. Урок 07.09.2026, ошибка моя же.
    #
    # Railway обрывает TLS у себя и идёт в контейнер сам, поэтому
    # `remoteAddress` -- адрес ПРОКСИ, один на всех. Лимит, ключом которого
    # служит только он, считает всю платформу за одного человека: десять
    # попыток в минуту -- и вход закрыт всем сразу. Это не защита, это авария,
    # и выглядит она в точности как атака, которую защита должна была отбить.
    #
    # Правильная форма -- два ключа: узкий лимит на клиента (левый
    # X-Forwarded-For, подделываемый) и широкий потолок на соединение
    # (неподделываемый). Команда показывает, какая форма в коде сейчас.
    echo "— ключи лимитов —"
    grep -rn "remoteAddress" apps/vibee-editor/render --include="*.ts" \
      | grep -v node_modules | grep -v ".test.ts" \
      | sed 's|apps/vibee-editor/render/||'
    echo
    echo "— доходит ли X-Forwarded-For до контейнера —"
    # Единственная проверка, которую нельзя сделать из кода: дюжина запросов с
    # одного адреса. 429 после десятого -- заголовок доходит, ключ клиента
    # живой. Сплошные 400 -- заголовка нет, работает только потолок канала.
    B="https://vibee-render-production.up.railway.app"
    printf "  "
    for i in $(seq 1 12); do
      printf "%s " "$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 \
        -X POST "$B/api/auth/refresh" -H 'Content-Type: application/json' -d '{}')"
    done
    echo
    echo "— есть ли разделение клиент/канал —"
    if grep -q "ПОТОЛОК_КАНАЛА" apps/vibee-editor/render/src/entry-throttle.ts 2>/dev/null; then
      grep -n "ПОПЫТОК_В_ОКНЕ = \|ПОТОЛОК_КАНАЛА = \|ОКНО_МС = " \
        apps/vibee-editor/render/src/entry-throttle.ts
    else
      echo "  НЕТ потолка канала: лимит считает всех за прокси как одного"
    fi
    ;;

  session)
    # ЖИЗНЬ СЕССИИ: сроки, окно гонки и то, как на неё отвечают три клиента.
    #
    # Урок 07.09.2026: повторное предъявление refresh-токена читалось как
    # кража и гасило ВСЮ семью. Но две вкладки одного браузера держат общий
    # токен в localStorage и обновляются с разницей в миллисекунды -- то есть
    # человека выкидывало из приложения ежедневно, без злоумышленника.
    # Различает их не факт повтора, а ПРОМЕЖУТОК.
    R=apps/vibee-editor/render
    echo "— сроки —"
    grep -n "ACCESS_TTL_SECONDS = \|REFRESH_TTL_SECONDS = \|REUSE_GRACE_SECONDS = " \
      "$R/session.ts" | sed 's|^|  |'
    echo "— как отвечают на гонку —"
    for F in "$R/session-routes.ts:сервер" \
             "apps/vibee-editor/player/src/lib/appSession.ts:мини-апп" \
             "apps/vibee-ios/Vibee/Identity.swift:iOS"; do
      # ИМЕНА ТОЛЬКО ASCII. Кириллическая переменная в bash -- это "command
      # not found", и цикл продолжает крутиться дальше: здесь он напечатал
      # "НЕТ" про все три клиента, то есть выдал уверенную ложь вместо ошибки.
      FILE="${F%%:*}"; NAME="${F##*:}"
      if [ ! -f "$FILE" ]; then
        echo "  $NAME: файла нет ($FILE) -- проверка НЕ выполнена"
      elif grep -q "auth_refresh_raced" "$FILE"; then
        echo "  $NAME: гонка отличается от кражи"
      else
        echo "  $NAME: НЕТ -- повтор читается как кража, человека выбросит"
      fi
    done
    echo "— выход гасит семью, а не одну сессию —"
    if grep -q "SELECT family_id FROM app_sessions" "$R/session-routes.ts"; then
      echo "  да"
    else
      echo "  НЕТ -- после «Выйти» может остаться живой 60-дневный токен"
    fi
    ;;

  crm-source)
    # ИЗ КАКОЙ КОПИИ CRM СЧИТАЕТ ДЕНЬГИ.
    #
    # `users` и `payments_v2` лежат ДВАЖДЫ: в облачном Supabase и в Postgres
    # на Railway. Замер 08.09.2026: копии разошлись -- платежи в Railway
    # отставали на 12 дней, -- а `crm-tools.ts` читает Supabase, тогда как все
    # остальные таблицы агента (tg_sessions, hive_events, crm_touches) на
    # Railway. Инструмент продаж, смотрящий в отставшую копию, показывает
    # позапрошлую выручку как сегодняшнюю.
    #
    # Код возврата 1, если CRM читает НЕ самую свежую копию.
    railway service postgres-nfrq >/dev/null 2>&1 || {
      echo "нет доступа к сервису базы"; exit 2; }
    DB=$(railway variables --kv 2>/dev/null | grep -E "^DATABASE_PUBLIC_URL=" | head -1 | cut -d= -f2-)
    railway service vibee-render >/dev/null 2>&1 || {
      echo "нет доступа к vibee-render"; exit 2; }
    SU=$(railway variables --kv 2>/dev/null | grep '^SUPABASE_URL=' | head -1 | cut -d= -f2-)
    SK=$(railway variables --kv 2>/dev/null | grep '^SUPABASE_SERVICE_KEY=' | head -1 | cut -d= -f2-)
    if [ -z "$DB" ] || [ -z "$SU" ] || [ -z "$SK" ]; then
      echo "не прочитались доступы -- проверка НЕ выполнена"; exit 2; fi
    (cd "$RENDER" && DB="$DB" SU="$SU" SK="$SK" node "$ROOT/bin/helpers/crm-source.mjs")
    ;;

  schema)
    # СХЕМА В КОДЕ ПРОТИВ СХЕМЫ В БАЗЕ.
    #
    # `CREATE TABLE IF NOT EXISTS` на существующей базе не выполняется вовсе:
    # объявление и прод расходятся молча и живут так годами. Вылезает это в
    # день пересоздания базы -- на новом окружении, на стенде, при
    # восстановлении, -- то есть в худший день из возможных.
    railway service postgres-nfrq >/dev/null 2>&1 || {
      echo "нет доступа к сервису базы"; exit 1; }
    URL=$(railway variables --kv 2>/dev/null | grep -E "^DATABASE_PUBLIC_URL=" | head -1 | cut -d= -f2-)
    if [ -z "$URL" ]; then echo "нет DATABASE_PUBLIC_URL -- проверка НЕ выполнена"; exit 1; fi
    echo "— вход (session-store.ts) —"
    (cd "$RENDER" && DB="$URL" node "$ROOT/bin/helpers/schema-drift.mjs" session-store.ts)
    ;;

  pairing)
    # ДЛИНА КОДА ВХОДА: СЕРВЕР ПРОТИВ КЛИЕНТОВ.
    #
    # Урок 07.09.2026, регрессия моя же. Длину подняли с шести цифр до восьми
    # ради стойкости -- серверной правкой, с тестом и мутацией. Клиентов никто
    # не посмотрел: поле iOS обрезало ввод на шестой цифре, и вход в
    # приложение не работал ВООБЩЕ. Серверное ужесточение убило клиентскую
    # дверь, и это не заметил ни один тест.
    R=apps/vibee-editor/render
    echo "— сервер —"
    grep -n "DIGITS:" "$R/session-store.ts" | sed 's|^|  |'
    echo "— что отвечает живой сервер на пустой код —"
    curl -s --max-time 25 -X POST \
      "https://vibee-render-production.up.railway.app/api/auth/pair/claim" \
      -H "Content-Type: application/json" -d '{"code":""}' | head -c 120; echo
    echo "— копии длины у клиентов (их не должно быть) —"
    python3 "$ROOT/bin/helpers/code-length-copies.py" \
      apps/vibee-ios/Vibee/SignIn.swift \
      apps/vibee-ios/Vibee/Identity.swift \
      apps/vibee-editor/player/src/components/Profile/PairWithApp.tsx \
      src/commands/appLoginCommand.ts
    ;;

  tma)
    # ПОСМОТРЕТЬ ЭКРАНЫ ВХОДА МИНИ-АППА ГЛАЗАМИ.
    #
    # Урок 07.09.2026: вне Telegram мини-апп экраны входа не показывает вовсе,
    # поэтому правки в них шли вслепую -- и дважды стоили входа на iOS. Теперь
    # есть подставка для разработки; команда печатает готовые адреса.
    #
    # Подставка вырезается из ЛЮБОЙ сборки плагином Vite, и это проверяется
    # тестом, который собирает бандл и ищет метку.
    PORT="${VIBEE_PORT:-5174}"
    echo "— адреса (dev-сервер на :$PORT) —"
    echo "  профиль:        http://localhost:$PORT/profile?mock-telegram=144022504"
    echo "  экран кода:     http://localhost:$PORT/profile?mock-telegram=144022504&mock-username=t27_dev&mock-pair-code=12345678"
    echo "  без @имени:     http://localhost:$PORT/profile?mock-telegram=999000111"
    echo
    echo "— жив ли dev-сервер —"
    if curl -s -o /dev/null -m 5 "http://localhost:$PORT/"; then
      echo "  отвечает"
    else
      echo "  НЕ отвечает: npm run dev в apps/vibee-editor/player"
    fi
    echo "— берёт ли мини-апп сессию —"
    # Урок 07.09.2026: /api/auth/telegram не звал никто, и вся работа вокруг
    # сессий касалась только веба. Проверка смотрит, что вызов на месте.
    if grep -q "exchangeTelegramLaunch(initData)" \
      apps/vibee-editor/player/src/components/Telegram/TelegramProvider.tsx; then
      echo "  обмен подписи на сессию есть"
    else
      echo "  НЕТ -- мини-апп работает только по заголовку подписи"
    fi
    echo "— кнопки, которые отменяет соседний код —"
    # Урок 07.09.2026: «Выйти» внутри Telegram чистила память, а автологин
    # возвращал человека за доли секунды. Кнопка не сломана -- она лишняя там,
    # где отменяющий механизм работает.
    if grep -q "onLogout={getAppAccessToken() ? handleLogout : undefined}" \
      apps/vibee-editor/player/src/components/Header/Header.tsx; then
      echo "  выход показывается только при сессии браузера"
    else
      echo "  ВЫХОД БЕЗУСЛОВЕН -- внутри Telegram он не может сработать"
    fi
    echo "— вырезана ли подставка из сборки —"
    if grep -q "вырезатьПодставнойTelegram" apps/vibee-editor/player/vite.config.ts; then
      echo "  плагин на месте (проверка: telegram-dev-mock.test.ts)"
    else
      echo "  НЕТ ПЛАГИНА -- подставка уедет в продакшен"
    fi
    ;;

  shipped)
    # Уехало ли в прод -- и пользуется ли им кто-нибудь. Два разных вопроса.
    bash "$ROOT/bin/helpers/shipped.sh"
    ;;

  space)
    # МЕСТО — БЕЗ ОБХОДА ВСЕГО ДИСКА.
    #
    # 07.09.2026 цикл встал на ENOSPC: оболочка создаёт файл под вывод ДО
    # команды, поэтому при полном диске не стартует ничего, включая чистилку.
    # Смысл этой команды -- увидеть подход к обрыву РАНЬШЕ него.
    #
    # `du` по домашнему каталогу тут не годится: он идёт минутами и сам
    # упирается в тайм-аут. Смотрим только то, что мы же и создаём.
    echo "— тома —"
    df -h / /System/Volumes/Data 2>/dev/null | awk 'NR==1 || /disk/ {print "  "$0}'
    FREE_MB=$(df -m / | awk 'NR==2 {print $4}')
    if [ "${FREE_MB:-0}" -lt 2048 ]; then
      echo "  МАЛО: ${FREE_MB} МБ. Сборка iOS откажется работать (и правильно)."
    fi
    echo "— что создаём мы и можно вернуть —"
    # Стенограммы агентов добавлены 07.09.2026: за один заход они съели 7 ГБ и
    # уронили цикл в ENOSPC ДВАЖДЫ. Прошлая версия списка их не знала, поэтому
    # команда показывала «всё в порядке» ровно тогда, когда всё было не в
    # порядке. Диск забивает не только сборка.
    for D in "$ROOT/apps/vibee-ios/build2" /tmp/dd "$ROOT/.vite-cache" \
             "$ROOT/.claude/worktrees" "$HOME/Library/Developer/Xcode/DerivedData" \
             "/private/tmp/claude-501" \
             "$HOME/.claude/projects"; do
      [ -e "$D" ] && printf "  %-52s %s\n" "$D" "$(du -sh "$D" 2>/dev/null | cut -f1)"
    done
    echo "  (worktrees могут содержать несохранённую работу -- см. tri worktrees)"
    echo "— вернуть место, ничего своего не теряя —"
    echo "  rm -rf /private/tmp/claude-501 \$HOME/.claude/projects/*/*/subagents/workflows/wf_*"
    ;;

  hive)
    # УЛЕЙ: КТО СМОТРИТЕЛЬ, ЖИВ ЛИ ЖУРНАЛ, ИДУТ ЛИ ОТЧЁТЫ.
    #
    # Заведено 07.09.2026. Причина в другом репозитории: в trios лежат два
    # append-only журнала, `gardener_decisions` и `railway_audit_events`, и у
    # ОБОИХ ноль читателей -- ничего из них не выбирает. Журнал умирает не от
    # ошибки, а от того, что в него перестают смотреть. Эта команда и есть
    # способ смотреть.
    echo "— роли —"
    V=$(railway variables --kv 2>/dev/null | grep '^HIVE_KEEPERS=' | cut -d= -f2-)
    if [ -z "$V" ]; then
      echo "  HIVE_KEEPERS НЕ ЗАДАН на vibee-render -- смотрителя нет,"
      echo "  отчёты выключены, супер-админ видит только свои события."
    else
      echo "  смотрителей: $(echo "$V" | tr ',' '\n' | grep -c .) (…${V: -4})"
    fi
    echo "— проверки улья —"
    export PATH="$HOME/.nvm/versions/node/v20.19.0/bin:$PATH"
    npx vitest run apps/vibee-editor/render/hive-*.test.ts 2>&1 |
      grep -E "Tests |FAIL" | sed "s|^|  |"
    echo "— места, откуда события приходят —"
    printf "  %-28s %s\n" "эмиссия в коде:" \
      "$(grep -rn 'записать(pool' apps/vibee-editor/render --include='*.ts' 2>/dev/null | grep -vc test)"
    echo "  (31 место найдено разведкой; подключено меньше -- остальное впереди)"
    ;;

  worktrees)
    # БРОШЕННЫЕ КОПИИ РЕПОЗИТОРИЯ. Обнаружено 07.09.2026: `find` по имени
    # файла вывел копию из `.claude/worktrees/`, и я едва не измерил не тот
    # файл. Плюс 286 МБ на диске, который этот цикл уже забивал до нуля.
    #
    # Команда НЕ УДАЛЯЕТ: в брошенной копии может лежать несохранённая работа.
    # Она показывает, что есть, и оставляет решение человеку.
    echo "— копии репозитория —"
    git worktree list | sed "s|^|  |"
    if [ -d "$ROOT/.claude/worktrees" ]; then
      echo "— вес —"
      du -sh "$ROOT/.claude/worktrees" 2>/dev/null | sed "s|^|  |"
      echo "  удалять: git worktree remove <путь>  (сначала посмотрите git -C <путь> status)"
    fi
    ;;

  guards)
    # ЖИВЫ ЛИ СТОРОЖА. Урок 07.09.2026: пять денежных сторожей падали
    # НЕДЕЛЯМИ, и падение выглядело как находка -- «набор мест, способных
    # списать деньги, изменился». Причина была в скрипте, звавшем
    # process.exit() сразу после печати: вывод обрубался на буфере канала.
    #
    # Отдельная команда нужна потому, что в общем прогоне это тонет: файлов
    # 450, и красное среди них не замечают.
    echo "— перепись мест списания читается целиком —"
    LEN=$(node .claude/loop-opus/money-map.mjs --json 2>/dev/null | wc -c | tr -d ' ')
    if [ "${LEN:-0}" -le 8192 ]; then
      echo "  ОБРЫВ на $LEN байт -- сторожа слепы (ищите process.exit после печати)"
    else
      echo "  целиком: $LEN байт"
    fi
    echo "— исполняется ли приём денег, а не только его форма —"
    # Урок 07.09.2026: вокруг вебхука Робокассы было 32 теста, и ни один не
    # импортировал маршрут; ещё четыре файла читали его ИСХОДНЫЙ ТЕКСТ.
    # Форма -- не поведение: переделка, сохранившая форму, прошла бы насквозь.
    if [ -f src/__tests__/money/robokassa-webhook-behaviour.test.ts ]; then
      echo "  поведенческий тест на месте"
    else
      echo "  НЕТ -- приём денег проверяется только по форме"
    fi
    echo "— удаление чужих файлов проверяется исполнением —"
    # Урок 07.09.2026: защита от «удалить чужое» -- одно условие в запросе, и
    # стереглось оно только по тексту. Текстовый сторож сам писал, что не
    # проверяет верность самой проверки.
    if [ -f "$RENDER/delete-own-photo.test.ts" ]; then
      echo "  поведенческий тест на месте"
    else
      echo "  НЕТ -- чужие файлы охраняются только формой"
    fi
    echo "— денежные сторожа —"
    # ТРЕТЬЕ СОСТОЯНИЕ ОБЯЗАТЕЛЬНО.
    #
    # Первая версия просто фильтровала вывод vitest и при неудаче запуска
    # печатала ПУСТОТУ -- неотличимо от «сторожа молчат». А не запускался он
    # буднично: без нужной версии node в PATH. Сначала проверяем, что прогон
    # вообще состоялся.
    OUT="$(cd "$ROOT" && npx vitest run src/__tests__/money 2>&1)"
    SUMMARY="$(printf '%s' "$OUT" | grep -aE "Tests +[0-9]" | tail -1)"
    if [ -z "$SUMMARY" ]; then
      echo "  прогон НЕ состоялся -- проверка не выполнена"
      printf '%s' "$OUT" | tail -3 | sed "s|^|    |"
    else
      printf '%s' "$OUT" | grep -aE "Test Files|Tests +[0-9]" | tail -2 | sed "s|^|  |"
    fi
    ;;

  feed-hide)
    # СКРЫТЬ ВСЁ, КРОМЕ ОДНОГО. Скрытие обратимо: маршрут ставит `deleted_at`,
    # а повторная публикация того же имени его снимает. Удаления здесь нет и
    # быть не должно — вернуть удалённое неоткуда.
    #
    # id того, что ОСТАЁТСЯ, передаётся руками и обязателен. Угаданный выбор
    # владелец заметит не сразу, а лента — это чужие глаза.
    KEEP="${2:-}"
    if [ -z "$KEEP" ]; then
      echo "нужен id поста, который остаётся: tri feed-hide <id>"; exit 1
    fi
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    if [ -z "$KEY" ]; then echo "нет RENDER_API_KEY в окружении сервиса"; exit 1; fi
    BASE="https://vibee-render-production.up.railway.app"
    # Владельца берём у самого поста, который оставляем: скрывать можно только
    # своё, и сервер это проверяет тем же UPDATE. Мы лишь не шлём заведомо
    # чужие запросы.
    OWNER=$(curl -s -m 30 "$BASE/api/feed/$KEEP" -H "X-Api-Key: $KEY" \
             | python3 -c "import json,sys; print(json.load(sys.stdin).get('telegramId',''))")
    if [ -z "$OWNER" ]; then echo "поста $KEEP нет — ничего не трогаю"; exit 1; fi
    echo "оставляю id $KEEP (владелец $OWNER); остальное скрываю по всем аккаунтам ленты"
    # ВСЕ ВЛАДЕЛЬЦЫ, А НЕ ТОЛЬКО ХОЗЯИН СОХРАНЯЕМОГО ПОСТА.
    #
    # Первая версия брала владельца у сохраняемого поста и трогала только его
    # строки. В ленте после уборки осталось ДВА поста: нужный и чужой — от
    # `@vibee_agent`, аккаунта нашего же агента. Команда о нём промолчала, и
    # «готово» означало «почти готово».
    #
    # Теперь идём по всем аккаунтам, которые видны в ленте, и КАЖДЫЙ называем
    # вслух: скрытие в публичной ленте нельзя делать молча, даже когда
    # скрывать правильно.
    #
    # СПИСОК БЕРЁМ ИЗ ПРОФИЛЯ, А НЕ ИЗ ЛЕНТЫ.
    #
    # Лента с недавних пор отдаёт ОДНУ запись на шаблон — иначе сорок три
    # карточки одного шаблона были спамом. Для скрытия это ровно неверный
    # список: по нему скрылись бы три поста из сорока шести, и выглядело бы
    # как «сработало».
    #
    # Профиль отдаёт все свои, страницами по 20; идём страницами, пока они не
    # кончатся.
    : > /tmp/tri-hide-pairs
    # Аккаунты берём из самой ленты: там видно всех, кто в ней стоит.
    curl -s -m 30 "$BASE/api/feed?limit=200" -H "X-Api-Key: $KEY" \
      | python3 -c "
import json,sys
seen=set()
for t in json.load(sys.stdin).get('templates') or []:
    tid=str(t.get('telegramId') or '')
    if tid and tid not in seen:
        seen.add(tid)
        print(tid, t.get('creatorUsername') or '')
" > /tmp/tri-hide-owners
    while read -r TID UNAME; do
      [ -n "$UNAME" ] || continue
      echo "  аккаунт @$UNAME ($TID)"
      PAGE=0
      while [ "$PAGE" -lt 20 ]; do
        GOT=$(curl -s -m 30 "$BASE/api/users/$UNAME/templates?page=$PAGE&limit=20" \
              | python3 -c "
import json,sys
data=json.load(sys.stdin)
ts=data.get('templates') or []
for t in ts:
    if str(t.get('id'))!='$KEEP':
        print('$TID', t['id'])
sys.stderr.write(str(len(ts)))
" 2>/tmp/tri-hide-count)
        echo "$GOT" >> /tmp/tri-hide-pairs
        [ "$(cat /tmp/tri-hide-count)" = "20" ] || break
        PAGE=$((PAGE + 1))
      done
    done < /tmp/tri-hide-owners
    grep -E '^[0-9]+ [0-9]+$' /tmp/tri-hide-pairs | sort -u | while read -r TID ID; do
        ANSWER=$(curl -s -m 30 -X DELETE "$BASE/api/feed/$ID?telegram_id=$TID" -H "X-Api-Key: $KEY")
        echo "  $ID -> $ANSWER"
      done
    echo "готово. вернуть можно повторной публикацией — скрытие обратимо" ;;
  crm-waiting)
    # Who is waiting for an answer, from production, as the owner. Read-only.
    KEY=$( (railway service vibee-render >/dev/null 2>&1; railway variables --kv 2>/dev/null) \
           | grep -E '^RENDER_API_KEY=' | cut -d= -f2- )
    [ -z "$KEY" ] && { echo "RENDER_API_KEY not readable"; exit 1; }
    # The answer travels in an env var, not on stdin: `python3 -` takes its
    # script from stdin, so a heredoc there would displace the pipe.
    ANSWER=$(curl -s "https://vibee-render-production.up.railway.app/mcp?telegram_id=144022504" \
      -H "X-Api-Key: $KEY" -H 'Content-Type: application/json' \
      -d '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"crm_waiting","arguments":{}}}')
    ANSWER="$ANSWER" python3 - <<'PYEOF'
import json, os
r = json.loads(os.environ['ANSWER']); res = r.get('result', {})
s = res.get('structuredContent') or json.loads(res['content'][0]['text'])
print(f"ждут: {s.get('total')}  ours={s.get('ours')} due={s.get('due')} theirs={s.get('theirs')}")
for w in s.get('waiting', [])[:20]:
    who = w.get('name') or w.get('telegram_id')
    print(f"  [{w.get('waiting')}] {w.get('days')}д  {who}  {w.get('stage')}  — {w.get('because')}")
print(s.get('what_to_do', ''))
PYEOF
    ;;
  crm-pitch)
    # What the personal seller would say, LOCALLY: no network, no invoice
    # minted, no row written. Price from the one scale; the link is a
    # placeholder. Usage: tri crm-pitch <name> [tokens] [note]
    NAME="${2:-}"; TOK="${3:-50}"; NOTE="${4:-}"
    (cd "$RENDER" && npx tsx -e '
      const { composePitch } = require("./src/agent/crm-offer-tool.ts");
      const { ценаТокенов } = require("./src/agent/token-packs.ts");
      const [name, tok, note] = process.argv.slice(1);
