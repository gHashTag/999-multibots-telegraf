# Локальный запуск (make dev). Скопируй в .env.local и заполни РЕАЛЬНЫМИ значениями.
# .env.local в гит НЕ попадает. Значения секретов — из Railway (Raw Editor) или Infisical.

# ── Агент / рендер (A2A-харнесс) ──
# Публичный proxy-URL БД (Railway Postgres → Variables → DATABASE_PUBLIC_URL, Show value):
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
RENDER_API_KEY=            # Railway vibee-render → RENDER_API_KEY
GLM_API_KEY=              # z.ai кодерский ключ
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AGENT_PROVIDER=zai
AGENT_MODEL=glm-5.3
AGENT_KEYS=               # tri_...:telegramId  (для теста A2A/MCP по ключу)
RENDER_AUTH_MODE=warn     # локально мягко; в проде enforce

# ── Порты ──
A2A_PORT=3334
PLAYER_PORT=5173

# ── Бот (если поднимаешь make bot) ──
# 5 переменных Infisical (см. CLAUDE.md), остальное бот тянет из Infisical сам:
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
NODE_ENV=development
