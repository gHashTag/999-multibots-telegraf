#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🛡️ [HUSKY PRE-COMMIT] Запуск проверок безопасности..."

# 1. Проверка на утечку токенов (КРИТИЧЕСКИ ВАЖНО!)
echo "🔒 Проверка на утечку токенов..."
if ./scripts/security-token-guard.sh; then
    echo "✅ Проверка безопасности пройдена"
else
    echo "❌ Проблемы безопасности обнаружены!"
    echo "🚫 Коммит отменен из соображений безопасности"
    exit 1
fi

# 2. Запуск lint-staged для форматирования кода
echo "🎨 Запуск линтера и форматирования..."
pnpm exec lint-staged

echo "✅ Все проверки пройдены - коммит разрешен!"
