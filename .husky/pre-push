#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🛡️ [HUSKY PRE-PUSH] Запуск проверок безопасности..."

# 1. Проверка на утечку токенов (даже в push!)
echo "🔒 Проверка на утечку токенов перед push..."
if ./scripts/security-token-guard.sh; then
    echo "✅ Проверка безопасности пройдена"
else
    echo "❌ Проблемы безопасности обнаружены!"
    echo "🚫 Push отменен из соображений безопасности"
    exit 1
fi

# 2. Защита веток
protected_branches="main production"

echo "[Husky pre-push] Проверка защищенных веток..."

# Читаем стандартный ввод от Git (локальная ветка, локальный sha, удаленная ветка, удаленный sha)
while read local_ref local_sha remote_ref remote_sha; do
  # Извлекаем имя удаленной ветки
  remote_branch=$(echo "$remote_ref" | sed 's!refs/heads/!!')
  echo "[Husky pre-push] Попытка push в удаленную ветку: $remote_branch"

  # Проверяем, совпадает ли с защищенными ветками
  for protected_branch in $protected_branches; do
    if [ "$remote_branch" = "$protected_branch" ]; then
      echo "
⛔️⛔️⛔️ ОШИБКА: Прямой push в ветку '$protected_branch' ЗАПРЕЩЕН! ⛔️⛔️⛔️
" >&2
      echo "💡 Пожалуйста, создайте Pull Request для внесения изменений в '$protected_branch'." >&2
      echo "🔒 Защищенные ветки: $protected_branches" >&2
      exit 1 # Запрещаем push
    fi
  done
done

echo "[Husky pre-push] ✅ Все проверки пройдены. Push разрешен."
exit 0 # Разрешаем push