#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🛡️ [HUSKY PREPARE-COMMIT-MSG] Проверка сообщения коммита..."

# Получаем сообщение коммита
commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Проверяем на наличие потенциальных секретов в сообщении
if echo "$commit_msg" | grep -q -E "(token|secret|password|key|api_key|auth_token)"; then
    echo "⚠️  ВНИМАНИЕ: В сообщении коммита найдены потенциальные секреты!"
    echo "💡 Рекомендуется переписать сообщение без упоминания секретов"
    echo "📝 Текущее сообщение: $commit_msg"
    
    # Не блокируем коммит, но предупреждаем
    echo "⚠️  Продолжаем с предупреждением..."
fi

# Проверяем на наличие URL с токенами
if echo "$commit_msg" | grep -q -E "https?://[^[:space:]]*[?&][^[:space:]]*(token|secret|key|auth)"; then
    echo "🚨 КРИТИЧНО: В сообщении найдены URL с потенциальными токенами!"
    echo "🚫 Коммит заблокирован из соображений безопасности"
    exit 1
fi

echo "✅ Сообщение коммита безопасно"
