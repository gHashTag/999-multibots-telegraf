#!/usr/bin/env sh
# 🛡️ PRE-COMMIT BUILD CHECK HOOK
# Автоматически проверяет билд перед коммитом

. "$(dirname -- "$0")/_/husky.sh"

echo "🛡️ [HUSKY] Проверка билда перед коммитом..."

# Проверить, есть ли изменения в исходном коде
if git diff --cached --name-only | grep -E "\.(ts|tsx|js|jsx)$" > /dev/null; then
    echo "📁 Найдены изменения в коде - запуск проверки билда..."
    
    # Запустить быструю проверку билда
    if ./scripts/quick-build-check.sh; then
        echo "✅ Билд работает - коммит разрешен"
    else
        echo "❌ Билд сломан - коммит отменен"
        echo "💡 Исправьте ошибки или используйте 'git commit --no-verify' для пропуска проверки"
        exit 1
    fi
else
    echo "📝 Изменений в коде нет - пропуск проверки билда"
fi