{
  "agent": {
    "name": "Claude Code Inngest Functions Specialist",
    "version": "1.0.0",
    "description": "Эксперт по созданию Inngest функций для проекта 999-agents-telegraf",
    "specialization": "inngest-functions",
    "author": "Claude Code",
    "created_at": "2025-11-01"
  },
  "project": {
    "root_path": "/Users/playra/999-agents-telegraf/worktrees/transfer-server",
    "inngest_dir": "src/inngest_app",
    "functions_dir": "src/inngest_app/functions",
    "register_file": "src/inngest_app/registerFunctions.ts",
    "rules_file": "INNGEST_DEVELOPMENT_RULES.md"
  },
  "commands": {
    "create": {
      "name": "/inngest-create",
      "description": "Создать новую Inngest функцию по шаблону",
      "usage": "/inngest-create <название> <описание> [категория]",
      "parameters": {
        "название": "Имя функции в camelCase",
        "описание": "Описание назначения функции",
        "категория": "Категория (content|instagram|monitoring|training|generation|payment|broadcast|render|existing)"
      },
      "examples": [
        "/inngest-create generateContentScript \"Генерация скриптов для контента\" content",
        "/inngest-create processUserData \"Обработка данных пользователя\" existing"
      ]
    },
    "test": {
      "name": "/inngest-test",
      "description": "Протестировать существующую Inngest функцию",
      "usage": "/inngest-test <название_функции>",
      "parameters": {
        "название_функции": "Имя функции для тестирования"
      },
      "examples": [
        "/inngest-test generateAIReelsFunction",
        "/inngest-test generateContentScripts"
      ],
      "checks": [
        "Проверка существования файла",
        "Валидация импортов",
        "Проверка структуры функции",
        "Валидация логирования",
        "Проверка регистрации"
      ]
    },
    "analyze": {
      "name": "/inngest-analyze",
      "description": "Анализ существующих функций как образцов",
      "usage": "/inngest-analyze [категория|путь]",
      "parameters": {
        "категория|путь": "Опциональная категория или путь для анализа"
      },
      "examples": [
        "/inngest-analyze content",
        "/inngest-analyze existing",
        "/inngest-analyze /src/inngest_app/functions/monitoring"
      ],
      "output": "Отчет с анализом функций и рекомендациями"
    },
    "register": {
      "name": "/inngest-register",
      "description": "Автоматически зарегистрировать функцию в registerFunctions.ts",
      "usage": "/inngest-register <название_функции>",
      "parameters": {
        "название_функции": "Имя функции для регистрации"
      },
      "examples": [
        "/inngest-register generateContentScript",
        "/inngest-register processUserData"
      ],
      "actions": [
        "Добавить импорт функции",
        "Добавить функцию в массив allInngestFunctions",
        "Обновить статистику категорий"
      ]
    }
  },
  "categories": {
    "content": {
      "path": "content",
      "description": "Функции для работы с контентом",
      "example_events": ["instagram/generate-scripts", "content/analyze"]
    },
    "instagram": {
      "path": "instagram",
      "description": "Функции для работы с Instagram",
      "example_events": ["instagram/scrape", "instagram/monitor"]
    },
    "monitoring": {
      "path": "monitoring",
      "description": "Функции мониторинга и логирования",
      "example_events": ["monitor/errors", "monitor/logs"]
    },
    "training": {
      "path": "training",
      "description": "Функции обучения моделей",
      "example_events": ["training/model", "training/images"]
    },
    "generation": {
      "path": "generation",
      "description": "Функции генерации контента",
      "example_events": ["generation/image", "generation/video"]
    },
    "payment": {
      "path": "payment",
      "description": "Функции обработки платежей",
      "example_events": ["payment/process", "payment/verify"]
    },
    "broadcast": {
      "path": "broadcast",
      "description": "Функции рассылки сообщений",
      "example_events": ["broadcast/message", "broadcast/notify"]
    },
    "render": {
      "path": "render",
      "description": "Функции рендеринга видео",
      "example_events": ["render/video", "render/avatar"]
    },
    "existing": {
      "path": "existing",
      "description": "Существующие функции-шаблоны",
      "example_events": ["ai/reels", "model/training"]
    }
  },
  "templates": {
    "structure": {
      "retries": {
        "attempts": 3,
        "delay": "1s"
      },
      "concurrency": 10,
      "logging": {
        "pattern": "const logger = new Logger('FunctionName')",
        "usage": ["logger.info()", "logger.error()", "logger.warn()", "logger.debug()"]
      }
    },
    "factory_pattern": {
      "enabled": false,
      "description": "Использовать factory pattern для избежания circular dependencies"
    },
    "validation": {
      "zod_schema": true,
      "input_validation": "Обязательно для всех функций"
    }
  },
  "validation": {
    "required_imports": [
      "import { inngest } from '@/core/inngest/clients'",
      "import { logger } from '@/utils/logger'"
    ],
    "required_structure": [
      "inngest.createFunction()",
      "async ({ event, step }) =>",
      "retries configuration",
      "event: 'event.name'"
    ],
    "required_logging": [
      "logger.info() - для логирования запуска",
      "logger.error() - для обработки ошибок",
      "try-catch блок"
    ]
  },
  "safety": {
    "production_deployment": {
      "enabled": false,
      "description": "Агент не может напрямую деплоить в production"
    },
    "testing_requirements": [
      "Обязательное тестирование в main ветке",
      "Проверка всех функций через /inngest-test",
      "Валидация соответствия INNGEST_DEVELOPMENT_RULES.md"
    ],
    "warnings": [
      "Предупреждение о рисках перед внесением изменений",
      "Проверка наличия бэкапов",
      "Рекомендация создания Pull Request"
    ]
  },
  "examples": {
    "good_practices": [
      "Всегда использовать существующие функции как шаблоны",
      "Следовать паттернам логирования из правил",
      "Валидировать входные данные с помощью zod",
      "Использовать step.run() для всех операций",
      "Обрабатывать ошибки с try-catch"
    ],
    "anti_patterns": [
      "Создание функций с нуля без изучения существующих",
      "Изменение установленных паттернов",
      "Игнорирование архитектуры проекта",
      "Использование другого стиля логирования",
      "Изобретение новых паттернов обработки ошибок"
    ]
  },
  "integrations": {
    "logger": {
      "import": "import { logger } from '@/utils/logger'",
      "usage": "logger.info('message', { context })"
    },
    "inngest": {
      "import": "import { inngest } from '@/core/inngest/clients'",
      "usage": "inngest.createFunction(config, event, handler)"
    },
    "zod": {
      "import": "import { z } from 'zod'",
      "usage": "const schema = z.object({ field: z.string() })"
    },
    "supabase": {
      "import": "import { supabase } from '@/core/supabase'",
      "usage": "await supabase.from('table').select('*')"
    }
  }
}
